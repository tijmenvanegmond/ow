rule("Empty Map (For Racetrack Creator)")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		"Change the map to the map you are making a racetrack for"
		Current Map == Map(Busan Stadium);
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Global.Starting = Vector(0, 0, 0);
		Global.Racetrack_Game = Empty Array;
		"Delete all of the actions except for Teleport_Spots1, Teleport_Spots2, 2nd Starting, and 2nd Racetrack_Game (keep the 4 actions below this note)"
		Global.Teleport_Spots1 = Array(Vector(0, 0, 0), Vector(0, 0, 0));
		Global.Teleport_Spots2 = Array(Vector(0, 0, 0), Vector(0, 0, 0));
	}
}

disabled rule("Racetrack Creator --------------------------------------------------------------------------------------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Racetrack Creator Setup")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to add ring", Input Binding String(Button(Interact))),
			Top, 10, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to remove last placed ring", Input Binding String(
			Button(Reload))), Top, 11, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to place starting position", Input Binding String(
			Button(Melee))), Top, 12, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to teleport to starting position",
			Input Binding String(Button(Ultimate))), Top, 13, Color(White), Color(White), Color(White), Visible To and String,
			Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Use {0} to enter/exit noclip", Input Binding String(Button(
			Ability 1))), Top, 10, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		disabled Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to add portal entrance", Input Binding String(Button(
			Primary Fire))), Top, 10, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		disabled Create HUD Text(All Players(All Teams), Null, Null, Custom String("Press {0} to add portal exit", Input Binding String(Button(
			Ability 2))), Top, 10, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String(
			"After finishing the track you want to create:\r\n1: Go to menu and go to Workshop Inspector"), Left, 0, Color(White), Color(
			White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("2: Go to variable target and select Global"), Left, 0, Color(White), Color(
			White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("3: Move left and find the icon with the X"), Left, 0, Color(White), Color(
			White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("4: Click on it to copy the global variables"), Left, 0, Color(White),
			Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("5: Go to the workshop editor"), Left, 0, Color(White), Color(White), Color(
			White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("6: Find the map rule that you created earlier"), Left, 0, Color(White),
			Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("7: Paste the variables and follow directions"), Left, 0, Color(White),
			Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Host Player, Null, Null, Custom String("8: Turn off Racetrack Creator and have fun!"), Left, 0, Color(White),
			Color(White), Color(White), Visible To and String, Default Visibility);
	}
}

rule("Add to Racetrack")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Modify Global Variable(Racetrack_Game, Append To Array, Eye Position(Event Player));
		Create Icon(All Players(All Teams), Eye Position(Event Player), Arrow: Down, Visible To, Color(White), True);
		Global.RacetrackCreator_Icons[Count Of(Global.Racetrack_Game) + -1] = Last Created Entity;
		Create Effect(All Players(All Teams), Good Aura, Color(Green), Eye Position(Event Player), 2.500, None);
		Global.RacetrackCreator_Effects[Count Of(Global.Racetrack_Game) + -1] = Last Created Entity;
	}
}

rule("Remove from Racetrack")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	actions
	{
		Destroy Effect(Last Of(Global.RacetrackCreator_Effects));
		Destroy Icon(Last Of(Global.RacetrackCreator_Icons));
		Modify Global Variable(RacetrackCreator_Effects, Remove From Array By Index, Count Of(Global.RacetrackCreator_Effects) - 1);
		Modify Global Variable(RacetrackCreator_Icons, Remove From Array By Index, Count Of(Global.RacetrackCreator_Icons) - 1);
		Modify Global Variable(Racetrack_Game, Remove From Array By Index, Count Of(Global.Racetrack_Game) - 1);
	}
}

rule("Place Starting Position")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	actions
	{
		Skip If(Global.Starting != 0, 1);
		Set Ultimate Ability Enabled(Event Player, False);
		Create Icon(All Players(All Teams), Global.Starting, Flag, Visible To and Position, Color(White), True);
		Global.Starting = Position Of(Event Player);
	}
}

rule("Teleport to Starting Position")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
	}

	actions
	{
		Skip If(Global.Starting == 0, 3);
		Apply Impulse(Event Player, Velocity Of(Event Player) * -1, 0.001, To World, Cancel Contrary Motion);
		Teleport(Event Player, First Of(Global.Starting));
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Global.Racetrack_Game[0]), To World);
	}
}

rule("Movement Collision Test")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Setting_RacetrackCreator == True;
		Is Using Ability 1(Event Player) == True;
	}

	actions
	{
		Disable Movement Collision With Environment(Event Player, True);
		Wait Until(Is Using Ability 1(Event Player) == False, 99999);
		Enable Movement Collision With Environment(Event Player);
	}
}

disabled rule("Add Portal Entrance")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Global.Setting_RacetrackCreator == True;
	}

	actions
	{
		Modify Global Variable(Teleport_Spots1, Append To Array, Eye Position(Event Player));
		Wait(0.500, Abort When False);
		Modify Global Variable(Teleport_Spots1, Remove From Array By Value, Last Of(Global.Teleport_Spots1));
		Wait(1, Abort When False);
		Modify Global Variable(Teleport_Spots1, Remove From Array By Value, Last Of(Global.Teleport_Spots1));
	}
}

disabled rule("Add Portal Exit")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Global.Setting_RacetrackCreator == True;
	}

	actions
	{
		Modify Global Variable(Teleport_Spots2, Append To Array, Eye Position(Event Player));
		Wait(0.500, Abort When False);
		Modify Global Variable(Teleport_Spots1, Remove From Array By Value, Last Of(Global.Teleport_Spots1));
		Wait(1, Abort When False);
		Modify Global Variable(Teleport_Spots1, Remove From Array By Value, Last Of(Global.Teleport_Spots1));
	}
}

// ── rules/race-extras.ow ────────────────────────────────────────
// ============================================================
// RACE EXTRAS — additive layer on top of 3N0R2 (JPC Racing)
// Live distance/standings HUD and a finish-line celebration.
// Declares no variable slots; reads the import's player
// variables (Racetrack, Racing, Laps_Complete) without writing.
// ============================================================

rule("[Extras:HUD] Next ring distance and live position")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Null, Event Player.Racing == True ? Custom String("Next ring: {0} m", Round To Integer(
			Distance Between(Position Of(Event Player), Event Player.Racetrack[0]), To Nearest)) : Custom String(""), Left, 20,
			Color(White), Color(White), Color(Green), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Event Player.Racing == True ? Custom String("Position: {0} / {1}", 1 + Count Of(
			Filtered Array(All Players(All Teams), Current Array Element.Racing == True && Count Of(Current Array Element.Racetrack)
			< Count Of(Event Player.Racetrack))), Count Of(Filtered Array(All Players(All Teams),
			Current Array Element.Racing == True))) : Custom String(""), Left, 21, Color(White), Color(White), Color(Sky Blue),
			Visible To and String, Default Visibility);
	}
}

rule("[Extras:OnEvent] Finish-line fireworks")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Count Of(Event Player.Racetrack) == 0;
		Event Player.Laps_Complete > 0;
	}

	actions
	{
		Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Position Of(Event Player) + Vector(0, 1, 0), 3);
		Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Position Of(Event Player), 100);
		Wait(0.300, Ignore Condition);
		Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Position Of(Event Player) + Vector(0, 2, 0), 4);
		Wait(0.300, Ignore Condition);
		Play Effect(All Players(All Teams), Ring Explosion, Color(Red), Position Of(Event Player) + Vector(0, 3, 0), 5);
		Small Message(All Players(All Teams), Custom String("{0} finished lap {1}!", Event Player, Event Player.Laps_Complete));
	}
}