// ── imports/3N0R2-jpc-racing.ow ─────────────────────────────────
disabled rule("Setup --------------------------------------------------------------------------------------------------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Workshop Settings")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.Setting_RacetrackCreator = Workshop Setting Toggle(Custom String("Dev Stuff"), Custom String("Racetrack Creator"), False,
			0);
		Global.Setting_RaceSpeedBoost = Workshop Setting Integer(Custom String("Settings"), Custom String("Added Speed Boost During Race"),
			23, 0, 40, 0);
		Global.Setting_InfiniteTime = Workshop Setting Toggle(Custom String("Settings"), Custom String(
			"Infinite Time (Overrides Match Time)"), False, 1);
		Global.Setting_Time = Workshop Setting Integer(Custom String("Settings"), Custom String("Match Time (Minutes)"), 15, 1, 60, 2);
		Global.Setting_RestartDelay = Workshop Setting Toggle(Custom String("Settings"), Custom String("Restart Delay"), True, 3);
		Global.Setting_CameraDelay = Workshop Setting Toggle(Custom String("Settings"), Custom String("Camera Change Delay"), True, 4);
		Global.Setting_SpectateDelay = Workshop Setting Toggle(Custom String("Settings"), Custom String("Spectate Delay"), True, 5);
		Global.Setting_ExpandTimerDelay = Workshop Setting Toggle(Custom String("Settings"), Custom String("Expand Timer Delay"), False,
			6);
	}
}

rule("Game Setup")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("Discord: dsc.gg/jetpack"), Left, 0, Color(White), Color(White),
			Color(White), Visible To and String, Default Visibility);
		Set Match Time(Global.Setting_Time * 60);
		Set Objective Description(All Players(All Teams), Custom String("{0} {1}", Hero Icon String(Hero(Jetpack Cat)), Custom String(
			"Jetpack Cat Racing! - Code: 3N0R2")), Visible To and String);
		Global.Racetrack_Game = Empty Array;
		Global.Lobby_High = Empty Array;
		Global.Teleport_Spots1 = Empty Array;
		Global.Teleport_Spots2 = Empty Array;
		Skip If(Global.Setting_RacetrackCreator == True, 6);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Custom String(""), Left, 0, Color(White), Color(White), Color(
			White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("{0} {1} to restart",
			Global.Setting_RestartDelay == True ? Custom String("Hold") : Custom String("Press"), Input Binding String(Button(Reload))),
			Right, 0, Color(White), Color(White), Color(White), Visible To and String, Visible Never);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("{0} {1} to change camera",
			Global.Setting_CameraDelay == True ? Custom String("Hold") : Custom String("Press"), Input Binding String(Button(Interact))),
			Right, 0, Color(White), Color(White), Color(White), Visible To and String, Visible Never);
		Create HUD Text(Filtered Array(All Players(All Teams), Position Of(Current Array Element) == Vector(200, 1000, 2600)), Null, Null,
			Custom String("\n "), Top, 0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Custom String("Lobby Best: {0} by {2}", Global.Lobby_Best != 0 ? First Of(Sorted Array(
			Global.Lobby_High, Current Array Element)) : Custom String("9999"), Null,
			Global.Lobby_Best != 0 ? Global.Lobby_Best : Custom String("N/A")), Null, Null, Top, 0, Color(White), Color(White), Color(
			White), Visible To and String, Default Visibility);
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.Advanced_Info == 1), Custom String(
			"Lobby Best: {0} by {2}", Global.Lobby_Best != 0 ? Custom String("{0}.{1}", Round To Integer(First Of(Sorted Array(
			Global.Lobby_High, Current Array Element)), Down), String Slice((First Of(Sorted Array(Global.Lobby_High,
			Current Array Element)) - Round To Integer(First Of(Sorted Array(Global.Lobby_High, Current Array Element)), Down) + 1)
			* 1000000, 1, 2)) : Custom String("9999.00"), Null, Global.Lobby_Best != 0 ? Global.Lobby_Best : Custom String("N/A")), Null,
			Null, Top, 0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create Effect(Filtered Array(All Players(All Teams), Global.Teleport_Spots1[0] != 0), Bad Aura, Color(Blue),
			Global.Teleport_Spots1[0], 2.500, Visible To Position Radius and Color);
		Create Effect(Filtered Array(All Players(All Teams), Global.Teleport_Spots1[1] != 0), Bad Aura, Color(Blue),
			Global.Teleport_Spots1[1], 2.500, Visible To Position Radius and Color);
		Create Effect(Filtered Array(All Players(All Teams), Global.Teleport_Spots2[0] != 0), Bad Aura, Color(Blue),
			Global.Teleport_Spots2[0], 2.500, Visible To Position Radius and Color);
		Create Effect(Filtered Array(All Players(All Teams), Global.Teleport_Spots2[1] != 0), Bad Aura, Color(Blue),
			Global.Teleport_Spots2[1], 2.500, Visible To Position Radius and Color);
	}
}

rule("Start")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Teleport(Event Player, Global.Starting);
		Event Player.Racetrack = Global.Racetrack_Game;
		Create Effect(Filtered Array(Event Player, Event Player.Racetrack[0] != 0), Good Aura, Color(Green), Event Player.Racetrack[0],
			2.500, Visible To Position and Radius);
		Create Effect(Filtered Array(Event Player, Event Player.Racetrack[1] != 0), Good Aura, Color(White), Event Player.Racetrack[1],
			2.500, Visible To Position and Radius);
		Create HUD Text(Event Player, Custom String("Time: {0}{1}", Event Player.Timer, Event Player.Timer == 0 ? Custom String(".00")
			: Custom String("")), Null, Null, Left, 1, Color(White), Color(White), Color(White), Visible To and String,
			Default Visibility);
		Create HUD Text(Event Player, Custom String("Best Time: {0}", First Of(Sorted Array(Event Player.High_Score,
			Current Array Element))), Null, Null, Left, 2, Color(White), Color(White), Color(White), Visible To and String,
			Default Visibility);
		Event Player.Timer = 0;
		Event Player.High_Score = Array(9999.001);
		Create In-World Text(Filtered Array(All Players(All Teams), Is Alive(Event Player) == True), Custom String("Best Time: {0}",
			First Of(Sorted Array(Event Player.High_Score, Current Array Element))), Update Every Frame(Eye Position(Event Player)
			+ Vector(0, 0.500, 0)), 1, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
		Event Player.Racing = False;
		Disallow Button(Event Player, Button(Ultimate));
		Set Facing(Event Player, Direction Towards(Global.Starting, Event Player.Racetrack[0]), To World);
		Create HUD Text(Event Player, Custom String("Progress - {0}/{1}", Count Of(Global.Racetrack_Game) - Count Of(
			Event Player.Racetrack), Count Of(Global.Racetrack_Game)), Null, Null, Left, 2, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String("{0} {1} to {2} spectating",
			Global.Setting_SpectateDelay == True ? Custom String("Hold") : Custom String("Press"), Input Binding String(Button(Ultimate)),
			Is Alive(Event Player) ? Custom String("start") : Custom String("stop")), Right, 1, Color(White), Color(White), Color(White),
			Visible To and String, Visible Never);
		Disallow Button(Event Player, Button(Ultimate));
		disabled Create In-World Text(Filtered Array(All Players(All Teams), Is Alive(Event Player) == True), Custom String("Best Time: {0}",
			First Of(Sorted Array(Event Player.High_Score, Current Array Element))), Update Every Frame(Eye Position(Event Player)
			+ Vector(0, 0.500, 0)), 1, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
		disabled Create HUD Text(Filtered Array(Event Player, Event Player.Advanced_Info == 1), Custom String("Time: {0}.{1}{2}", Round To Integer(
			Event Player.Advanced_Info, Down), String Slice((Event Player.Timer - Round To Integer(Event Player.Timer, Down) + 1)
			* 1000000, 1, 6), String Slice((Event Player.Timer - Round To Integer(Event Player.Timer, Down) + 1) * 1000000, 8, 2)), Null,
			Null, Left, 0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String("{0} {1} to {2} HUD", Global.Setting_RestartDelay == True ? Custom String(
			"Press") : Custom String("Press"), Input Binding String(Button(Melee)), Event Player.Advanced_Info == 0 ? Custom String(
			"expand") : Custom String("contract")), Right, 1, Color(White), Color(White), Color(White), Visible To and String,
			Default Visibility);
		disabled Create Icon(Filtered Array(Event Player, Event Player.Racetrack != Empty Array), Event Player.Racetrack[0], Ring Thick,
			Visible To and Position, Color(Green), True);
		Create HUD Text(Filtered Array(Event Player, Event Player.Advanced_Info == True), Custom String("Speed: {0} MPS", Speed Of(
			Event Player)), Null, Null, Left, 10, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Filtered Array(Event Player, Event Player.Advanced_Info == True), Custom String("Laps Completed: {0}",
			Event Player.Laps_Complete), Null, Null, Left, 11, Color(White), Color(White), Color(White), Visible To and String,
			Default Visibility);
		disabled Create HUD Text(Event Player, Custom String("Time: {0}", Event Player.Timer), Null, Null, Left, 1, Color(White), Color(White),
			Color(White), Visible To and String, Default Visibility);
		disabled Create HUD Text(Event Player, Custom String("Time: {0}.{1}", Round To Integer(Event Player.Timer, Down), String Slice(
			Custom String("{0}", Event Player.Timer), 2 + (String Length(Custom String("{0}", Round To Integer(Event Player.Timer, Down)))
			- 1), 2)), Null, Null, Left, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create In-World Text(Filtered Array(Event Player, Event Player.Racetrack[0] != 0), Custom String("o"), Event Player.Racetrack[0],
			2.500, Do Not Clip, Visible To Position and String, Color(Green), Default Visibility);
		Create In-World Text(Filtered Array(Event Player, Event Player.Racetrack[1] != 0), Custom String("o"), Event Player.Racetrack[1],
			1.500, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
	}
}

rule("Infinite Time")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Setting_InfiniteTime == True;
		Is Game In Progress == True;
	}

	actions
	{
		disabled Pause Match Time;
		Set Match Time(1 / 60);
		Disable Built-In Game Mode Completion;
	}
}

disabled rule("Race ---------------------------------------------------------------------------------------------------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Reset")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Reload)) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Skip If(Global.Setting_RestartDelay == False || Event Player.Racing == False, 1);
		Wait(0.500, Abort When False);
		Call Subroutine(Reset);
		Skip If(Is Alive(Event Player) == True, 1);
		Resurrect(Event Player);
	}
}

rule("Reset Subroutine")
{
	event
	{
		Subroutine;
		Reset;
	}

	actions
	{
		Apply Impulse(Event Player, Velocity Of(Event Player) * -1, 0.001, To World, Cancel Contrary Motion);
		Teleport(Event Player, Global.Starting);
		Event Player.Racetrack = Global.Racetrack_Game;
		Event Player.Timer = 0;
		Stop Chasing Player Variable(Event Player, Timer);
		Set Ability 1 Enabled(Event Player, True);
		Set Move Speed(Event Player, 100);
		Event Player.Racing = False;
		Set Facing(Event Player, Direction Towards(Global.Starting, Event Player.Racetrack[0]), To World);
	}
}

rule("Score")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Distance Between(Event Player.Racetrack[0], Eye Position(Event Player)) <= 3.200;
		Is Alive(Event Player) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Modify Player Variable(Event Player, Racetrack, Remove From Array By Index, 0);
		Chase Player Variable At Rate(Event Player, Timer, 100000000, 1, Destination and Rate);
		Event Player.Racing = True;
		Set Ability 1 Enabled(Event Player, False);
		Set Move Speed(Event Player, 100 + Global.Setting_RaceSpeedBoost);
		Skip If(Is Using Ability 1(Event Player) == False, 1);
		Cancel Primary Action(Event Player);
		Play Effect(Event Player, Buff Explosion Sound, Color(White), Eye Position(Event Player), 100);
	}
}

rule("Finish")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Racetrack == Array();
		disabled Event Player.Timer != 0;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Event Player.Racing = False;
		Set Ability Cooldown(Event Player, Button(Ability 1), 2);
		Stop Chasing Player Variable(Event Player, Timer);
		Big Message(Event Player, Custom String("Time: {0} {1}", Event Player.Timer, First Of(Sorted Array(Event Player.High_Score,
			Current Array Element)) == Event Player.Timer ? Custom String("(New Personal Best!)") : Custom String("")));
		Modify Player Variable(Event Player, High_Score, Append To Array, Event Player.Timer);
		Set Ability 1 Enabled(Event Player, True);
		Set Move Speed(Event Player, 100);
		Skip If(Event Player.Timer == 0, 7);
		Event Player.Laps_Complete += 1;
		Modify Global Variable(Lobby_High, Append To Array, Event Player.Timer);
		Global.Lobby_Best = First Of(Sorted Array(Global.Lobby_High, Current Array Element)) == First Of(Sorted Array(
			Event Player.High_Score, Current Array Element)) ? Custom String("{0}", Event Player) : Global.Lobby_Best;
		Skip If(Event Player.Timer != First Of(Sorted Array(Global.Lobby_High, Current Array Element)), 3);
		Small Message(Event Player, Custom String("Lobby Best Beaten!"));
		Big Message(All Players(All Teams), Custom String("New Lobby Best - {0} by {1}", Event Player.Timer, Event Player));
		Play Effect(Event Player, Ring Explosion Sound, Color(White), Eye Position(Event Player), 100);
	}
}

rule("Use Portal")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Distance Between(First Of(Sorted Array(Global.Teleport_Spots1, Distance Between(Current Array Element, Eye Position(
			Event Player)))), Eye Position(Event Player)) <= 3.200;
		Global.Teleport_Spots1 != 0;
		Global.Teleport_Spots2 != 0;
	}

	actions
	{
		Event Player.Current_Speed = Speed Of(Event Player);
		Teleport(Event Player, Global.Teleport_Spots2[Index Of Array Value(Global.Teleport_Spots1, First Of(Sorted Array(
			Global.Teleport_Spots1, Distance Between(Current Array Element, Eye Position(Event Player)))))]);
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Event Player.Racetrack[0]), To World);
		Apply Impulse(Event Player, Velocity Of(Event Player) * -1, 0.001, To World, Cancel Contrary Motion);
		Wait(0.016, Ignore Condition);
		Apply Impulse(Event Player, Direction Towards(First Of(Sorted Array(Global.Teleport_Spots2, Distance Between(Current Array Element,
			Event Player))), Event Player.Racetrack[0]), Event Player.Current_Speed, To World, Cancel Contrary Motion);
		Play Effect(Event Player, Buff Impact Sound, Color(White), Eye Position(Event Player), 100);
	}
}

rule("Ability 1 Message")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Event Player.Racing == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Wait(0.032, Abort When False);
		Small Message(Event Player, Custom String("{0} Ability 1 is unavailable during races", Ability Icon String(Hero(Jetpack Cat),
			Button(Ability 1))));
	}
}

rule("Movement Collision")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Racing == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Disable Movement Collision With Players(Event Player);
		Disallow Button(Event Player, Button(Interact));
		Wait Until(Event Player.Racing == False, 99999);
		Enable Movement Collision With Players(Event Player);
		Allow Button(Event Player, Button(Interact));
	}
}

disabled rule("Commands -----------------------------------------------------------------------------------------------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Change Camera")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Interact)) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Skip If(Global.Setting_CameraDelay == False, 1);
		Wait(0.100 - 0.016, Abort When False);
		Event Player.Z = Event Player.Z == 2 ? 0 : Event Player.Z + 1;
		Wait(0.016, Ignore Condition);
		If(Event Player.Z != 0);
			If(Event Player.Z == 1);
				Start Camera(Event Player, Update Every Frame(Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player)
					+ World Vector Of(Vector(-0.500, 0, 0), Event Player, Rotation) + Facing Direction Of(Event Player) * -4.300, Null,
					Event Player, False) + Direction Towards(Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player)
					+ Facing Direction Of(Event Player) * -4.300 + World Vector Of(Vector(-0.500, 0, 0), Event Player, Rotation), Null,
					Event Player, False), Eye Position(Event Player) + World Vector Of(Vector(-0.500, 0, 0), Event Player, Rotation)) * 0.300),
					Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 1000 + World Vector Of(Vector(-0.500, 0,
					0), Event Player, Rotation)), 10000);
			Else If(Event Player.Z == 2);
				Start Camera(Event Player, Update Every Frame(Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player)
					+ World Vector Of(Vector(0.500, 0, 0), Event Player, Rotation) + Facing Direction Of(Event Player) * -4.300, Null,
					Event Player, False) + Direction Towards(Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player)
					+ Facing Direction Of(Event Player) * -4.300 + World Vector Of(Vector(0.500, 0, 0), Event Player, Rotation), Null,
					Event Player, False), Eye Position(Event Player) + World Vector Of(Vector(0.500, 0, 0), Event Player, Rotation)) * 0.300),
					Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 1000 + World Vector Of(Vector(0.500, 0, 0),
					Event Player, Rotation)), 10000);
			End;
		Else;
			Stop Camera(Event Player);
		End;
	}
}

rule("Spectate")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Skip If(Global.Setting_SpectateDelay == False, 1);
		Wait(0.500 - 0.016, Abort When False);
		If(Is Alive(Event Player) == True);
			Set Respawn Max Time(Event Player, 9999);
			Wait(0.016, Ignore Condition);
			Stop Chasing Player Variable(Event Player, Timer);
			Event Player.Timer = 0;
			Kill(Event Player, Null);
		Else;
			Set Respawn Max Time(Event Player, 0.500);
			Wait(0.016, Ignore Condition);
			Resurrect(Event Player);
			Call Subroutine(Reset);
		End;
	}
}

rule("Expand HUD")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Melee)) == True;
		Global.Setting_RacetrackCreator == False;
	}

	actions
	{
		Skip If(Global.Setting_ExpandTimerDelay == False, 1);
		Wait(0.250, Abort When False);
		Event Player.Advanced_Info = Event Player.Advanced_Info == 0 ? 1 : 0;
	}
}

