// ============================================================
// MOVEMENT — impulse, jump-boost, and throttle helpers
// ============================================================

// Gives every player a small extra upward impulse when they jump
// while on the ground. Tune the speed value (5) to taste.
rule("Jump Boost")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Is On Ground(Event Player) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Up, 5, To World, Cancel Contrary Motion);
		Play Effect(Event Player, Ring Explosion, Color(Blue), Event Player, 0.500);
		Wait(0.500, Ignore Condition);
	}
}

// Launches a player upward when they activate their ultimate.
// Useful for ults that don't provide natural mobility (e.g. Rally).
rule("Ult Launch — Apply Upward Impulse")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Game In Progress == True;
		Is Using Ultimate(Event Player) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Up, 20, To World, Cancel Contrary Motion);
		Play Effect(All Players(All Teams), Good Pickup Effect, Color(Orange), Event Player, 2.500);
	}
}

// Lets a player hold Crouch mid-air to bleed upward momentum.
// Great as a counterpart to Ult Launch.
rule("Air Stabilize — Hold Crouch To Slow Descent")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is In Air(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Down, 2.500, To World, Incorporate Contrary Motion);
	}
}

// Forces a dummy-bot (Slot 2) to walk forward when no allies are nearby.
// Adjust slot, radius, and throttle values for your map.
rule("Bot Patrol — Force Throttle When Alone")
{
	event
	{
		Ongoing - Each Player;
		All;
		Slot 2;
	}

	conditions
	{
		(Is Dummy Bot(Event Player) && Count Of(Players Within Radius(Event Player, 3, Team Of(Event Player), Surfaces))) == 0;
	}

	actions
	{
		Start Forcing Throttle(Event Player, 1, 1, 0, 1, 0, 1);
	}
}
