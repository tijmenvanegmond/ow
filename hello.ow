// Assembled from: lib/match-control.ow, lib/ui.ow, lib/scoring.ow, lib/movement.ow
// DO NOT EDIT — edit the source files and re-run assemble.js


variables
{
	global:
		0: messageCount
}

// ── lib/match-control.ow ────────────────────────────────────────
// ============================================================
// MATCH CONTROL — rules for controlling match flow
// ============================================================

// Skips the hero-select phase by burning down the timer.
rule("Skip Hero Select")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Set Match Time(1);
	}
}

// Immediately starts the match (use in custom lobbies / practice maps).
rule("Quick Start Match")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Set Match Time(0);
	}
}

// Pauses the clock and disables built-in game-mode completion so the
// match runs forever. Flip the score and music lines as needed.
// Enable this rule to activate.
disabled rule("Unlimited Match — Pause Time & Disable Completion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		Pause Match Time;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Scoring;
		disabled Disable Built-In Game Mode Music;
		Set Match Time(260);
	}
}

// Awards +1 score per kill when Unlimited Match is active.
// Enable this rule to activate.
disabled rule("Unlimited Match — Score On Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	actions
	{
		Modify Player Score(Event Player, 1);
	}
}

// ── lib/ui.ow ───────────────────────────────────────────────────
// ============================================================
// UI — HUD text, in-world text, and message helpers
// ============================================================

// Shows a floating in-world "Hello World!" label above the player
// for 3 seconds when they spawn. Replace the string and color freely.
rule("In-World Text — On Spawn (3 s)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Create In-World Text(All Players(All Teams), Custom String("Hello World!"), Event Player + Vector(0, 2, 0), 2,
			Do Not Clip, Visible To Position and String, Color(Yellow), Default Visibility);
		Wait(3, Ignore Condition);
		Destroy In-World Text(Last Text ID);
	}
}

// Persistent left-side HUD with a title + subtitle line.
// Replace string content and colors to match your mode.
rule("HUD — Persistent Left Panel")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Custom String("Workshop Script Running!"), Null, Null,
			Left, 0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
	}
}

// Shows a HUD counter in the bottom-left using a global variable.
// Wire Global.messageCount (or any variable) to the {0} slot.
rule("HUD — Global Counter Display")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Null, Null,
			Custom String("Count: {0}", Global.messageCount), Left, 1, Color(White), Color(White),
			Color(White), Visible To and String, Default Visibility);
	}
}

// Sends a Small Message welcome to each player when they join the match.
rule("Small Message — Welcome On Join")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	actions
	{
		Small Message(Event Player, Custom String("Welcome to the Workshop!"));
	}
}

// Displays a big-screen message and brief HUD tip when a player spawns,
// then clears after a delay. Customize strings and timing as needed.
rule("Big Message + HUD Tip — On Spawn")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Wait(0.250, Ignore Condition);
		Create HUD Text(Event Player, Null, Null, Custom String("PRESS INTERACT TO VIEW INFO"), Left, 0,
			Color(White), Color(White), Color(Orange), Visible To and String, Default Visibility);
		Wait(4, Ignore Condition);
		Big Message(Event Player, Custom String("YOUR BIG MESSAGE HERE"));
	}
}

// Toggleable info panel: press Interact to show rules/tips for 10 s,
// then restore the standard HUD tip. Prevents spam with Disallow Button.
rule("Info Panel — Press Interact To Toggle")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Destroy All HUD Text;
		Disallow Button(Event Player, Button(Interact));
		Wait(0.250, Ignore Condition);
		Create HUD Text(Event Player, Custom String("HERO INFO"), Null, Null, Left, 0,
			Color(Orange), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String("• Tip line 1"), Left, 1,
			Color(Orange), Color(Orange), Color(Orange), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String("• Tip line 2"), Left, 2,
			Color(Orange), Color(Orange), Color(Orange), Visible To and String, Default Visibility);
		Wait(10, Ignore Condition);
		Destroy All HUD Text;
		Wait(5, Ignore Condition);
		Allow Button(Event Player, Button(Interact));
		Create HUD Text(Event Player, Null, Null, Custom String("PRESS INTERACT TO VIEW INFO"), Left, 0,
			Color(White), Color(White), Color(Orange), Visible To and String, Default Visibility);
	}
}

// Clears ALL in-world text for a player via Crouch + Ability 2.
// Handy when BONK-style spam fills the screen.
rule("Clear In-World Text — Crouch + Ability 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Is On Ground(Event Player) == True;
	}

	actions
	{
		Destroy All In-World Text;
	}
}

// ── lib/scoring.ow ──────────────────────────────────────────────
// ============================================================
// SCORING — kill tracking and score display
// ============================================================



// Increments a global counter every time a player joins the match.
rule("Score — Increment Counter On Join")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	actions
	{
		Modify Global Variable(messageCount, Add, 1);
	}
}

// Awards +1 player score per kill. Works alongside Unlimited Match.
rule("Score — +1 Per Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	actions
	{
		Modify Player Score(Event Player, 1);
	}
}

// ── lib/movement.ow ─────────────────────────────────────────────
// ============================================================
// MOVEMENT — impulse, jump-boost, and throttle helpers
// ============================================================

// Gives every player a small extra upward impulse when they jump
// while on the ground. Tune the speed value (5) to taste.
rule("Jump Boost")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Jump)) == True;
		Is On Ground(Event Player) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Up, 5, To World, Cancel Contrary Motion);
		Play Effect(Event Player, Ring Explosion, Color(Blue), Event Player, 0.500);
		Wait(0.500, Ignore Condition);
	}
}

// Launches a player upward when they activate their ultimate.
// Useful for ults that don't provide natural mobility (e.g. Rally).
rule("Ult Launch — Apply Upward Impulse")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Game In Progress == True;
		Is Using Ultimate(Event Player) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Up, 20, To World, Cancel Contrary Motion);
		Play Effect(All Players(All Teams), Good Pickup Effect, Color(Orange), Event Player, 2.500);
	}
}

// Lets a player hold Crouch mid-air to bleed upward momentum.
// Great as a counterpart to Ult Launch.
rule("Air Stabilize — Hold Crouch To Slow Descent")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is In Air(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Apply Impulse(Event Player, Down, 2.500, To World, Incorporate Contrary Motion);
	}
}

// Forces a dummy-bot (Slot 2) to walk forward when no allies are nearby.
// Adjust slot, radius, and throttle values for your map.
rule("Bot Patrol — Force Throttle When Alone")
{
	event
	{
		Ongoing - Each Player;
		All;
		Slot 2;
	}

	conditions
	{
		(Is Dummy Bot(Event Player) && Count Of(Players Within Radius(Event Player, 3, Team Of(Event Player), Surfaces))) == 0;
	}

	actions
	{
		Start Forcing Throttle(Event Player, 1, 1, 0, 1, 0, 1);
	}
}