// Assembled from: lib/match-control.ow, rules/rein-and-weave-rules.ow
// DO NOT EDIT — edit the source files and re-run assemble.js


variables
{
	global:
		0: botsSpawnedT1
		1: botsSpawnedT2
		2: botIdx
		3: chargeTarget
		4: cmdTarget
}

// ── lib/match-control.ow ────────────────────────────────────────
// ============================================================
// MATCH CONTROL — rules for controlling match flow
// ============================================================

// Skips the hero-select phase by burning down the timer.
rule("Skip Hero Select")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Set Match Time(1);
	}
}

// Immediately starts the match (use in custom lobbies / practice maps).
rule("Quick Start Match")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Set Match Time(0);
	}
}

// Pauses the clock and disables built-in game-mode completion so the
// match runs forever. Flip the score and music lines as needed.
// Enable this rule to activate.
disabled rule("Unlimited Match — Pause Time & Disable Completion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		Pause Match Time;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Scoring;
		disabled Disable Built-In Game Mode Music;
		Set Match Time(260);
	}
}

// Awards +1 score per kill when Unlimited Match is active.
// Enable this rule to activate.
disabled rule("Unlimited Match — Score On Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	actions
	{
		Modify Player Score(Event Player, 1);
	}
}

// ── rules/rein-and-weave-rules.ow ───────────────────────────────
// ============================================================
// REIN AND WEAVE — custom rules
// 2x LifeWeaver players each commanding a squad of Rein bots
//
// Team layout (set in lobby):
//   Team 1 — 1 human LifeWeaver  +  3 Rein bots (Slots 1-3)
//   Team 2 — 1 human LifeWeaver  +  3 Rein bots (Slots 1-3)
//
// Controls (LifeWeaver only):
//   Primary Fire  → bots advance toward LW's aim point
//   Secondary     → bots hold position (stop throttle)
//   Ability 1     → bots charge the nearest enemy
//   Ability 2     → bots retreat back toward LW
//   Ultimate      → bots shield-bash (hammer slam + Fire Shield)
// ============================================================

// ── SETUP ────────────────────────────────────────────────────

// Force all human players onto LifeWeaver.
rule("Setup — Lock Humans To LifeWeaver")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) != Hero(Lifeweaver);
	}

	actions
	{
		Start Forcing Player To Be Hero(Event Player, Hero(Lifeweaver));
	}
}

// Announce the mode when a human spawns.
rule("Setup — Spawn Message")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		Wait(0.500, Ignore Condition);
		Big Message(Event Player, Custom String("REIN & WEAVE"));
		Create HUD Text(Event Player, Custom String("Rein & Weave"), Null, Null,
			Left, 0, Color(Orange), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String(
			"Primary: Advance  |  Secondary: Hold  |  Ability 1: Charge  |  Ability 2: Retreat  |  Ult: Slam"),
			Left, 1, Color(White), Color(White), Color(Orange), Visible To and String, Default Visibility);
	}
}

// ── BOT SPAWN ────────────────────────────────────────────────

// Spawn 3 Rein bots on Team 1 as soon as a human LW is on that team.
rule("Bots — Spawn Team 1 Reins")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Count Of(Players On Hero(Hero(Lifeweaver), Team 1)) >= 1;
		Global.botsSpawnedT1 == False;
	}

	actions
	{
		Create Dummy Bot(Hero(Reinhardt), Team 1, 1, Vector(0, 0, 0), Vector(0, 0, 1));
		Create Dummy Bot(Hero(Reinhardt), Team 1, 2, Vector(0, 0, 0), Vector(0, 0, 1));
		Create Dummy Bot(Hero(Reinhardt), Team 1, 3, Vector(0, 0, 0), Vector(0, 0, 1));
		Set Global Variable(botsSpawnedT1, True);
	}
}

// Spawn 3 Rein bots on Team 2.
rule("Bots — Spawn Team 2 Reins")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Count Of(Players On Hero(Hero(Lifeweaver), Team 2)) >= 1;
		Global.botsSpawnedT2 == False;
	}

	actions
	{
		Create Dummy Bot(Hero(Reinhardt), Team 2, 1, Vector(0, 0, 0), Vector(0, 0, 1));
		Create Dummy Bot(Hero(Reinhardt), Team 2, 2, Vector(0, 0, 0), Vector(0, 0, 1));
		Create Dummy Bot(Hero(Reinhardt), Team 2, 3, Vector(0, 0, 0), Vector(0, 0, 1));
		Set Global Variable(botsSpawnedT2, True);
	}
}

// Quick-respawn bots so the army is never wiped permanently.
rule("Bots — Quick Respawn")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
		Is Dead(Event Player) == True;
	}

	actions
	{
		Wait(2, Ignore Condition);
		Respawn(Event Player);
	}
}

// ── COMMAND: PRIMARY FIRE — Advance ──────────────────────────
// Bots walk toward the LifeWeaver's aim position on Primary Fire hold.

rule("Command — Primary Fire: Advance")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Is Game In Progress == True;
	}

	actions
	{
		Set Global Variable At Index(cmdTarget, Slot Of(Event Player),
			Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(Event Player) * 50,
				Null, Event Player, True));
		For Global Variable(botIdx, 1, 4, 1);
			Start Forcing Throttle(
				Players In Slot(Global.botIdx, Team Of(Event Player)),
				1, 1, 0, 1, 0, 1);
			Start Facing(
				Players In Slot(Global.botIdx, Team Of(Event Player)),
				Direction Towards(
					Eye Position(Players In Slot(Global.botIdx, Team Of(Event Player))),
					Global.cmdTarget[Slot Of(Event Player)]),
				400, To World, Direction and Turn Rate);
		End;
	}
}

// ── COMMAND: SECONDARY FIRE — Hold Position ──────────────────

rule("Command — Secondary Fire: Hold")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Is Game In Progress == True;
	}

	actions
	{
		For Global Variable(botIdx, 1, 4, 1);
			Stop Forcing Throttle(Players In Slot(Global.botIdx, Team Of(Event Player)));
			Stop Facing(Players In Slot(Global.botIdx, Team Of(Event Player)));
		End;
	}
}

// ── COMMAND: ABILITY 1 — Charge Nearest Enemy ────────────────

rule("Command — Ability 1: Charge Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Button Held(Event Player, Button(Ability 1)) == True;
		Is Game In Progress == True;
	}

	actions
	{
		For Global Variable(botIdx, 1, 4, 1);
			Set Global Variable(chargeTarget,
				Closest Player To(
					Position Of(Players In Slot(Global.botIdx, Team Of(Event Player))),
					Opposite Team Of(Team Of(Event Player))));
			Start Forcing Throttle(Players In Slot(Global.botIdx, Team Of(Event Player)), 1, 1, 0, 1, 0, 1);
			Start Facing(
				Players In Slot(Global.botIdx, Team Of(Event Player)),
				Direction Towards(
					Position Of(Players In Slot(Global.botIdx, Team Of(Event Player))),
					Position Of(Global.chargeTarget)),
				400, To World, Direction and Turn Rate);
			Press Button(Players In Slot(Global.botIdx, Team Of(Event Player)), Button(Ability 1));
		End;
	}
}

// ── COMMAND: ABILITY 2 — Retreat Toward LW ───────────────────

rule("Command — Ability 2: Retreat")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Is Game In Progress == True;
	}

	actions
	{
		For Global Variable(botIdx, 1, 4, 1);
			Start Forcing Throttle(Players In Slot(Global.botIdx, Team Of(Event Player)), 1, 1, 0, 1, 0, 1);
			Start Facing(
				Players In Slot(Global.botIdx, Team Of(Event Player)),
				Direction Towards(
					Position Of(Players In Slot(Global.botIdx, Team Of(Event Player))),
					Position Of(Event Player)),
				400, To World, Direction and Turn Rate);
		End;
	}
}

// ── COMMAND: ULTIMATE — Hammer Slam ──────────────────────────

rule("Command — Ultimate: Hammer Slam")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Using Ultimate(Event Player) == True;
		Is Game In Progress == True;
	}

	actions
	{
		For Global Variable(botIdx, 1, 4, 1);
			Press Button(Players In Slot(Global.botIdx, Team Of(Event Player)), Button(Ability 2));
		End;
		Play Effect(All Players(All Teams), Good Explosion, Color(Orange),
			Position Of(Event Player), 3);
		Small Message(All Players(All Teams), Custom String("HAMMER SLAM!"));
	}
}

// ── WIN CONDITION ─────────────────────────────────────────────
// A team loses when their LifeWeaver dies (bots without a commander).

rule("Win — LifeWeaver Eliminated")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Is Game In Progress == True;
	}

	actions
	{
		Declare Team Victory(Opposite Team Of(Team Of(Event Player)));
	}
}