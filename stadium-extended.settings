settings
{
	main
	{
		Description: "Practice Range with all heroes"
		Mode Name: "All Heroes in Stadium + Number"
	}

	lobby
	{
		Allow Players Who Are In Queue: Yes
	}

	modes
	{
		disabled Clash
		{
			Capture Speed Modifier: 45%
		}

		Stadium Practice Range

		General
		{
			Respawn Time Scalar: 1%
		}
	}

	heroes
	{
		General
		{
			Passive Health Regeneration: Disabled
			Ultimate Generation - Passive: 0%
		}
	}
}

variables
{
	global:
		0: EnableMimic
		1: MimicButtons
		2: MimicBitMask
		3: EnableInvincibleMimic
		4: EnableMimicRaycast
		5: MimicRaycastButtonPos
		6: EnableFriendlyMimic
		7: FriendlyMimicButtonPos
		10: MimicButtonPos
		11: MimicOffset
		12: EnableMimicMovement
		13: MimicMovementButtonPos
		14: GenericButtonPosArray
		15: CycleMimicDistanceButtonPos
		16: Temp
		17: TIndex
		18: ButtonHitBoxSize
		19: ButtonHitIndex
		20: MimicInvincibleButtonPos
		21: Damage50ButtonPos
		26: DummyFriendBotRef
		27: PlayerEnemyBotRef
		28: FriendlyBotSlot
		30: ShopDamageBtnPos
		31: ShopSpeedBtnPos

	player:
		0: UltTimeStart
		1: UltTimeEnd
		2: PeakHealth
		3: PeakTimer
		4: Tmp_Array
		5: MimicMask
		6: MimicMaskPrev
		7: MimicRayRef
		26: HealTaken
		27: EffectLightSpawn
		28: RayCastFriendBot
		29: DamageTaken
		30: RayCastEnemyBot
		31: DamageInstance1Time
		32: DamageInstanceNTime
		33: DamageText1
		34: DamageText2
		35: LastDamageValue
		36: DamageInstanceN
		37: HealInstance1Time
		38: HealInstanceNTime
		39: HealText1
		40: HealText2
		41: LastHealValue
		42: HealInstanceN
		43: HPText
		44: ShopCash
		45: ShopDamageBoost
		46: ShopSpeedBoost
}

subroutines
{
	0: ResetEnemyBot
	1: ResetFriendlyBot
	2: RenderHPText
	3: ResetUltimate
	4: TrackUltimate
	5: NiceHogNumber
	6: TeleportToHeroMachine
	7: InitMimicMode
	9: MimicMovementAim
	10: FriendlyMimicMovementAim
	11: OnButtonClick
	12: OnDamage50Button
}

rule("[Init] Setup instructions and tracking")
{
	event
	{
		Player Joined Match;
		Team 1;
		Slot 0;
	}

	actions
	{
		Create In-World Text(All Players(All Teams), Custom String("Update the enemy hero bot to support the following features:"), Vector(
			52.111, 5, 28.402), 1, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("Long Press Interact ({0}) to spawn friendly bot to track heal number",
			Input Binding String(Button(Interact))), Vector(52.111, 4.500, 28.402), 1, Clip Against Surfaces,
			Visible To Position and String, Color(White), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("Long Press Reload ({0}) to spawn enemy bot to track damage number",
			Input Binding String(Button(Reload))), Vector(52.111, 4, 28.402), 1, Clip Against Surfaces, Visible To Position and String,
			Color(White), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("Long Press Ultimate ({0}) to change yourself into them",
			Input Binding String(Button(Ultimate))), Vector(52.111, 3.500, 28.402), 1, Clip Against Surfaces,
			Visible To Position and String, Color(White), Default Visibility);
		Create In-World Text(All Players(All Teams), Custom String("Long Press Crouch ({0}) to reset tracking", Input Binding String(
			Button(Crouch))), Vector(52.111, 3, 28.402), 1, Clip Against Surfaces, Visible To Position and String, Color(White),
			Default Visibility);
		Call Subroutine(TrackUltimate);
		Call Subroutine(InitMimicMode);
	}
}

rule("[FriendlyMimic:Loop] Sync inputs to friendly bot")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.EnableFriendlyMimic == 1;
		Is Dummy Bot(Event Player) == True;
		Event Player == Global.DummyFriendBotRef;
		Event Player.PeakHealth != False;
		Is Alive(Event Player) == True;
		Is Alive(Event Player.PeakHealth) == True;
	}

	actions
	{
		Global.MimicButtons = Array(Button(Primary Fire), Button(Secondary Fire), Button(Ability 1), Button(Ability 2), Button(Ultimate),
			Button(Interact), Button(Jump), Button(Crouch), Button(Melee));
		Global.MimicBitMask = Array(1, 2, 4, 8, 16, 32, 64, 128, 256);
		While(Global.EnableFriendlyMimic == 1);
			Wait(0.100, Ignore Condition);
			Call Subroutine(FriendlyMimicMovementAim);
			Event Player.MimicMask = 0;
			For Global Variable(TIndex, 0, Count Of(Global.MimicButtons), 1);
				Event Player.MimicMask += Is Button Held(Event Player.PeakHealth, Global.MimicButtons[Global.TIndex])
					* Global.MimicBitMask[Global.TIndex];
			End;
			If(Event Player.MimicMask != Event Player.MimicMaskPrev);
				For Global Variable(TIndex, 0, Count Of(Global.MimicButtons), 1);
					Global.Temp = Global.MimicButtons[Global.TIndex];
					If(Is Button Held(Event Player.PeakHealth, Global.Temp) && !Is Button Held(Event Player, Global.Temp));
						Start Holding Button(Event Player, Global.Temp);
					End;
					If(!Is Button Held(Event Player.PeakHealth, Global.Temp) && Is Button Held(Event Player, Global.Temp));
						Stop Holding Button(Event Player, Global.Temp);
					End;
				End;
				Event Player.MimicMaskPrev = Event Player.MimicMask;
			End;
		End;
	}
}

rule("[Number:OnEvent] Show damage popup")
{
	event
	{
		Player Took Damage;
		All;
		All;
	}

	actions
	{
		Wait(0.016, Ignore Condition);
		Create In-World Text(All Players(All Teams), Custom String("{0} [+{1} ({2}%)]", Event Player.DamageTaken,
			Event Player.LastDamageValue, Round To Integer(100 * (Event Player.LastDamageValue / Max Health(Event Player)), To Nearest)),
			Eye Position(Event Player) + World Vector Of(Vector(0, 1, 0.200), Event Player, Rotation), 1.500, Clip Against Surfaces,
			Visible To Position and String, Color(White), Default Visibility);
		Event Player.DamageText1 = Last Text ID;
		Create In-World Text(All Players(All Teams), Custom String("Hits: {1} T: {0}s DPS: {2}",
			Event Player.DamageInstanceNTime - Event Player.DamageInstance1Time, Event Player.DamageInstanceN, Event Player.DamageTaken / (
			Event Player.DamageInstanceNTime - Event Player.DamageInstance1Time)), Eye Position(Event Player) + World Vector Of(Vector(0,
			2, 0.200), Event Player, Rotation), 1.500, Clip Against Surfaces, Visible To Position and String, Color(Gray),
			Default Visibility);
		Event Player.DamageText2 = Last Text ID;
		Call Subroutine(RenderHPText);
		Destroy In-World Text(Event Player.DamageText1);
		Destroy In-World Text(Event Player.DamageText2);
	}
}

rule("[Number:OnEvent] Show heal popup")
{
	event
	{
		Player Received Healing;
		All;
		All;
	}

	conditions
	{
		"Event 0 means passive healing"
		Event Ability != 0;
	}

	actions
	{
		Wait(0.016, Ignore Condition);
		Create In-World Text(All Players(All Teams), Custom String("{0} (+{1})", Event Player.HealTaken, Event Player.LastHealValue),
			Eye Position(Event Player) + World Vector Of(Vector(0, 1, 0.200), Event Player, Rotation), 1.500, Clip Against Surfaces,
			Visible To Position and String, Color(White), Default Visibility);
		Event Player.HealText1 = Last Text ID;
		Create In-World Text(All Players(All Teams), Custom String("Hits: {1} T: {0}s HPS: {2}",
			Event Player.HealInstanceNTime - Event Player.HealInstance1Time, Event Player.HealInstanceN, Event Player.HealTaken / (
			Event Player.HealInstanceNTime - Event Player.HealInstance1Time)), Eye Position(Event Player) + World Vector Of(Vector(0,
			1.500, 0.200), Event Player, Rotation), 1.500, Clip Against Surfaces, Visible To Position and String, Color(Gray),
			Default Visibility);
		Event Player.HealText2 = Last Text ID;
		Wait(5, Ignore Condition);
		Destroy In-World Text(Event Player.HealText1);
		Destroy In-World Text(Event Player.HealText2);
	}
}

rule("[Number:OnEvent] Track ult on damage dealt")
{
	event
	{
		Player Dealt Damage;
		Team 1;
		All;
	}

	actions
	{
		Call Subroutine(TrackUltimate);
	}
}

rule("[Number:OnEvent] Track ult on heal dealt")
{
	event
	{
		Player Dealt Healing;
		Team 1;
		All;
	}

	actions
	{
		Call Subroutine(TrackUltimate);
	}
}

rule("[Input:Loop] Track aim raycast")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		(Is Button Held(Event Player, Button(Interact)) || Is Button Held(Event Player, Button(Reload))) == True;
	}

	actions
	{
		If(Is Button Held(Event Player, Button(Interact)));
			Event Player.RayCastFriendBot = Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * 200, All Players(All Teams), Event Player, True);
		Else;
			Event Player.RayCastEnemyBot = Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
				Event Player) * 200, All Players(All Teams), Event Player, True);
		End;
		Global.FriendlyBotSlot = 5;
		Global.DummyFriendBotRef = Players In Slot(Global.FriendlyBotSlot, Team 1);
		Wait(0.050, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("[Input:OnHold] Interact - Spawn friendly bot")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Wait(1, Abort When False);
		Abort If(Is Button Held(Event Player, Button(Interact)) != True);
		Create Effect(Event Player, Light Shaft, Team 1, Event Player.RayCastFriendBot, 0.250, Visible To Position and Radius);
		Event Player.EffectLightSpawn = Last Created Entity;
		Wait Until(Is Button Held(Event Player, Button(Interact)) == False, 10);
		Destroy Effect(Event Player.EffectLightSpawn);
		Wait(0.050, Ignore Condition);
		Destroy Dummy Bot(Team 1, Global.FriendlyBotSlot);
		Wait(0.200, Ignore Condition);
		"Uses the enemy bot to create a friendly bot"
		Create Dummy Bot(Hero Of(Global.PlayerEnemyBotRef), Team 1, Global.FriendlyBotSlot, Event Player.RayCastFriendBot, Event Player);
		Wait(0.250, Ignore Condition);
		Set Player Health(Last Created Entity, 1);
		Play Effect(Event Player, Buff Explosion Sound, Color(White), Event Player, 100);
		Start Facing(Players In Slot(5, Team 1), Direction Towards(Eye Position(Players In Slot(Slot Of(Event Player), Team 2)),
			Eye Position(Event Player)), 10000, To World, None);
		Global.DummyFriendBotRef = Players In Slot(Global.FriendlyBotSlot, Team 1);
		"Mark ownership so friendly mimic loop can run"
		Global.DummyFriendBotRef.PeakHealth = Event Player;
	}
}

rule("[Input:OnHold] Reload - Move enemy bot")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	actions
	{
		Wait(0.750, Abort When False);
		Abort If(Is Button Held(Event Player, Button(Reload)) != True);
		Create Effect(Event Player, Light Shaft, Team 2, Event Player.RayCastEnemyBot, 0.250, Visible To Position and Radius);
		Event Player.EffectLightSpawn = Last Created Entity;
		Wait Until(Is Button Held(Event Player, Button(Reload)) == False, 10);
		Destroy Effect(Event Player.EffectLightSpawn);
		Wait(0.050, Ignore Condition);
		Call Subroutine(ResetEnemyBot);
		Teleport(Players In Slot(0, Team 2), Event Player.RayCastEnemyBot);
		Play Effect(Event Player, Buff Explosion Sound, Color(White), Event Player, 100);
		Start Facing(Players In Slot(0, Team 2), Direction Towards(Eye Position(Players In Slot(Slot Of(Event Player), Team 2)),
			Eye Position(Event Player)), 10000, To World, None);
		Global.PlayerEnemyBotRef.RayCastEnemyBot = Event Player.RayCastEnemyBot;
		Global.PlayerEnemyBotRef.PeakHealth = Event Player;
	}
}

rule("[Bot:Loop] Auto-reset friendly bot to 10 HP")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		Slot 5;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
		(Health(Event Player) >= Max Health(Event Player)) == True;
	}

	actions
	{
		Set Player Health(Event Player, 10);
	}
}

rule("[Bot:OnEvent] Respawn enemy bot on death")
{
	event
	{
		Player Died;
		Team 2;
		All;
	}

	actions
	{
		Wait(1, Ignore Condition);
		Call Subroutine(ResetEnemyBot);
		If(Event Player.RayCastEnemyBot != Null);
			Wait(0.500, Ignore Condition);
			Teleport(Players In Slot(0, Team 2), Event Player.RayCastEnemyBot);
			Play Effect(Event Player, Buff Explosion Sound, Color(White), Event Player, 100);
			Start Facing(Players In Slot(5, Team 1), Direction Towards(Eye Position(Players In Slot(Slot Of(Event Player), Team 2)),
				Eye Position(Event Player)), 10000, To World, None);
		End;
	}
}

rule("[Input:OnHold] Crouch - Reset tracking")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Wait(0.500, Ignore Condition);
		If(Is Button Held(Event Player, Button(Crouch)));
			Play Effect(Event Player, Buff Explosion Sound, Color(White), Event Player, 100);
			Call Subroutine(ResetEnemyBot);
			Call Subroutine(ResetFriendlyBot);
			Call Subroutine(ResetUltimate);
		End;
		Wait(2, Ignore Condition);
		If(Is Button Held(Event Player, Button(Crouch)));
			Play Effect(Event Player, Buff Explosion Sound, Color(White), Event Player, 100);
			Destroy Dummy Bot(Team 1, Global.FriendlyBotSlot);
		End;
	}
}

rule("[Input:OnHold] Ult - Switch to enemy hero")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
	}

	actions
	{
		Wait(1, Ignore Condition);
		Abort If(Is Button Held(Event Player, Button(Ultimate)) == False);
		Call Subroutine(TeleportToHeroMachine);
		Wait(0.250, Ignore Condition);
		Start Forcing Player To Be Hero(Event Player, Hero Of(Players In Slot(0, Team 2)));
		Wait(0.250, Ignore Condition);
		Set Facing(Event Player, Vector(-20, 3.250, 26), To World);
		Stop Forcing Player To Be Hero(Event Player);
	}
}

rule("[Input:OnEvent] Spray - Teleport to hero machine")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Communicating Any Spray(Event Player) == True;
	}

	actions
	{
		Call Subroutine(TeleportToHeroMachine);
	}
}

rule("[Bot:Routine] ResetEnemyBot")
{
	event
	{
		Subroutine;
		ResetEnemyBot;
	}

	actions
	{
		"Team 2 slot 0 is the practice range enemy bot"
		Global.PlayerEnemyBotRef = Players In Slot(0, Team 2);
		Set Player Health(Global.PlayerEnemyBotRef, Max Health(Global.PlayerEnemyBotRef));
		Set Ultimate Charge(Global.PlayerEnemyBotRef, 100);
		Set Ability Cooldown(Global.PlayerEnemyBotRef, Button(Ability 1), 0);
		Set Ability Cooldown(Global.PlayerEnemyBotRef, Button(Ability 2), 0);
		Set Ability Cooldown(Global.PlayerEnemyBotRef, Button(Secondary Fire), 0);
		Global.PlayerEnemyBotRef.DamageInstance1Time = Null;
		Global.PlayerEnemyBotRef.DamageInstanceNTime = Null;
		Global.PlayerEnemyBotRef.DamageInstanceN = 0;
		Global.PlayerEnemyBotRef.LastDamageValue = 0;
		Global.PlayerEnemyBotRef.HealTaken = 0;
		Global.PlayerEnemyBotRef.DamageTaken = 0;
		Global.DummyFriendBotRef.LastHealValue = 0;
		Global.DummyFriendBotRef.HealInstanceN = 0;
		Call Subroutine(NiceHogNumber);
	}
}

rule("[Bot:Routine] ResetFriendlyBot")
{
	event
	{
		Subroutine;
		ResetFriendlyBot;
	}

	actions
	{
		"stop self-healing"
		Damage(Global.DummyFriendBotRef, Null, 1);
		Set Player Health(Global.DummyFriendBotRef, 10);
		Global.DummyFriendBotRef.HealInstance1Time = Null;
		Global.DummyFriendBotRef.HealInstanceNTime = Null;
		Global.DummyFriendBotRef.DamageTaken = 0;
		Global.DummyFriendBotRef.HealTaken = 0;
	}
}

rule("[Number:Routine] RenderHPText")
{
	event
	{
		Subroutine;
		RenderHPText;
	}

	actions
	{
		Create In-World Text(All Players(All Teams), Custom String("{0} / {1} ({2})", Health(Event Player), Max Health(Event Player),
			Custom String("{0}%", Round To Integer(100 * (Health(Event Player) / Max Health(Event Player)), Down))), Eye Position(
			Event Player) + World Vector Of(Vector(0, 1.500, 0.200), Event Player, Rotation), 1.500, Clip Against Surfaces,
			Visible To Position and String, Color(Yellow), Default Visibility);
		Event Player.HPText = Last Text ID;
		Wait(10, Ignore Condition);
		Destroy In-World Text(Event Player.HPText);
	}
}

rule("[Number:Routine] ToggleUltimate")
{
	event
	{
		Subroutine;
		ResetUltimate;
	}

	actions
	{
		If(Ultimate Charge Percent(Event Player) <= 10);
			Set Ultimate Charge(Event Player, 100);
		Else;
			Set Ultimate Charge(Event Player, 0);
		End;
		Call Subroutine(TrackUltimate);
	}
}

rule("[Number:Routine] TrackUltimate")
{
	event
	{
		Subroutine;
		TrackUltimate;
	}

	actions
	{
		If(Ultimate Charge Percent(Event Player) <= 1);
			Event Player.UltTimeStart = Total Time Elapsed;
			Event Player.UltTimeEnd = Null;
		Else If(Ultimate Charge Percent(Event Player) == 100 && Event Player.UltTimeEnd == Null);
			Event Player.UltTimeEnd = Total Time Elapsed;
		End;
	}
}

rule("[Bot:Routine] NiceHogNumber")
{
	event
	{
		Subroutine;
		NiceHogNumber;
	}

	actions
	{
		If(Hero Of(Global.PlayerEnemyBotRef) == Hero(Roadhog));
			"1% fall speed"
			Set Gravity(Players In Slot(Global.PlayerEnemyBotRef, Team 2), 1);
			Set Max Health(Players In Slot(Global.PlayerEnemyBotRef, Team 2), 100 * 5000.010 / 750);
			Set Player Health(Global.PlayerEnemyBotRef, 5000);
		End;
	}
}

rule("[Input:Routine] TeleportToHeroMachine")
{
	event
	{
		Subroutine;
		TeleportToHeroMachine;
	}

	actions
	{
		Wait(1, Ignore Condition);
		Teleport(Event Player, Vector(35.377, 3.253, 16.895));
	}
}

rule("[Mimic:Routine] Sync movement and aim")
{
	event
	{
		Subroutine;
		MimicMovementAim;
	}

	actions
	{
		If(Global.EnableMimicMovement == 1 && Global.EnableMimic == 1);
			"3 z-unit mirror"
			Start Facing(Global.PlayerEnemyBotRef, Direction Towards(Eye Position(Event Player), Eye Position(Event Player.PeakHealth)
				+ Facing Direction Of(Event Player.PeakHealth) * (Z Component Of(Global.MimicOffset) / 2)), 300, To World,
				Direction and Turn Rate);
			Start Throttle In Direction(Global.PlayerEnemyBotRef, Direction Towards(Position Of(Event Player), World Vector Of(
				Global.MimicOffset, Event Player.PeakHealth, Rotation And Translation)), Min(1, Distance Between(Position Of(Event Player),
				World Vector Of(Global.MimicOffset, Event Player.PeakHealth, Rotation And Translation)) / 3), To World,
				Replace existing throttle, Direction and Magnitude);
			"Aim at exact where user is looking at"
			disabled Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Ray Cast Hit Position(Eye Position(
				Event Player.PeakHealth), Eye Position(Event Player.PeakHealth) + Facing Direction Of(Event Player.PeakHealth) * 200,
				All Players(Opposite Team Of(Team Of(Event Player))), Append To Array(Event Player.PeakHealth.Tmp_Array,
				Event Player.PeakHealth), True)), 300, To World, Direction and Turn Rate);
		Else;
			Stop Throttle In Direction(Global.PlayerEnemyBotRef);
			Stop Facing(Global.PlayerEnemyBotRef);
		End;
		If(
			Global.EnableMimicRaycast == 1 && Global.EnableMimicMovement == 1 && Global.EnableMimic == 1 && Global.PlayerEnemyBotRef.MimicRayRef == Null);
			Create Beam Effect(All Players(All Teams), Grapple Beam, Eye Position(Global.PlayerEnemyBotRef), Eye Position(
				Global.PlayerEnemyBotRef) + Direction Towards(Eye Position(Global.PlayerEnemyBotRef), Eye Position(
				Global.PlayerEnemyBotRef.PeakHealth) + Facing Direction Of(Global.PlayerEnemyBotRef.PeakHealth) * (Z Component Of(
				Global.MimicOffset) / 2)) * 20, Color(Red), Visible To Position and Radius);
			Global.PlayerEnemyBotRef.MimicRayRef = Last Created Entity;
		Else If(Global.EnableMimicRaycast == 0 || Global.EnableMimic == 0 || Global.EnableMimicMovement == 0);
			Destroy Effect(Global.PlayerEnemyBotRef.MimicRayRef);
			Global.PlayerEnemyBotRef.MimicRayRef = Null;
		End;
	}
}

rule("[FriendlyMimic:Routine] Sync movement and aim")
{
	event
	{
		Subroutine;
		FriendlyMimicMovementAim;
	}

	actions
	{
		If(
			Global.EnableMimicMovement == 1 && Global.EnableFriendlyMimic == 1 && Global.DummyFriendBotRef != Null && Global.DummyFriendBotRef.PeakHealth != False);
			Start Facing(Global.DummyFriendBotRef, Direction Towards(Eye Position(Global.DummyFriendBotRef), Eye Position(
				Global.DummyFriendBotRef.PeakHealth) + Facing Direction Of(Global.DummyFriendBotRef.PeakHealth) * (Z Component Of(
				Global.MimicOffset) / 2)), 300, To World, Direction and Turn Rate);
			Start Throttle In Direction(Global.DummyFriendBotRef, Direction Towards(Position Of(Global.DummyFriendBotRef), World Vector Of(
				Global.MimicOffset, Global.DummyFriendBotRef.PeakHealth, Rotation And Translation)), Min(1, Distance Between(Position Of(
				Global.DummyFriendBotRef), World Vector Of(Global.MimicOffset, Global.DummyFriendBotRef.PeakHealth, Rotation And Translation))
				/ 3), To World, Replace existing throttle, Direction and Magnitude);
		Else;
			If(Global.DummyFriendBotRef != Null);
				Stop Throttle In Direction(Global.DummyFriendBotRef);
				Stop Facing(Global.DummyFriendBotRef);
			End;
		End;
	}
}

rule("[Button:Loop] Detect interact raycast hits")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Global.Temp = Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(Event Player)
			* 1000, All Players(All Teams), Event Player, True);
		For Global Variable(TIndex, 0, Count Of(Global.GenericButtonPosArray) - 0, 1);
			Log To Inspector(Custom String("[{1}] distance {0}", Distance Between(Global.Temp, Global.GenericButtonPosArray[Global.TIndex]),
				Global.TIndex));
			If(Distance Between(Global.Temp, Global.GenericButtonPosArray[Global.TIndex]) <= Global.ButtonHitBoxSize);
				Global.ButtonHitIndex = Global.TIndex;
				Call Subroutine(OnButtonClick);
				Abort;
			End;
		End;
	}
}

rule("[Button:Routine] OnButtonClick")
{
	event
	{
		Subroutine;
		OnButtonClick;
	}

	actions
	{
		Global.Temp = Global.GenericButtonPosArray[Global.ButtonHitIndex];
		Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Global.MimicButtonPos, 100);
		Play Effect(All Players(All Teams), Ring Explosion, Color(White), Global.Temp, 1);
		If(Global.Temp == Global.MimicButtonPos);
			Global.EnableMimic = 1 - Global.EnableMimic;
		End;
		If(Global.Temp == Global.MimicMovementButtonPos);
			Global.EnableMimicMovement = 1 - Global.EnableMimicMovement;
		End;
		If(Global.Temp == Global.MimicRaycastButtonPos);
			Global.EnableMimicRaycast = 1 - Global.EnableMimicRaycast;
			"If raycast is turned off, immediately clear the existing beam"
			If(Global.EnableMimicRaycast == 0);
				Destroy Effect(Global.PlayerEnemyBotRef.MimicRayRef);
				Global.PlayerEnemyBotRef.MimicRayRef = Null;
			End;
		End;
		If(Global.Temp == Global.CycleMimicDistanceButtonPos);
			Global.Temp = Array(Vector(0, 0, 3), Vector(0, 0, 5), Vector(0, 0, 10));
			For Global Variable(TIndex, 0, Count Of(Global.Temp) - 0, 1);
				If(Global.MimicOffset == Global.Temp[Global.TIndex]);
					Global.TIndex = (Global.TIndex + 1) % Count Of(Global.Temp);
					Global.MimicOffset = Global.Temp[Global.TIndex];
					Abort;
				End;
			End;
		End;
		If(Global.Temp == Global.MimicInvincibleButtonPos);
			Global.EnableInvincibleMimic = 1 - Global.EnableInvincibleMimic;
			Set Damage Received(Global.PlayerEnemyBotRef, Global.EnableInvincibleMimic == 1 ? 0 : 100);
		End;
		If(Global.Temp == Global.FriendlyMimicButtonPos);
			Global.EnableFriendlyMimic = 1 - Global.EnableFriendlyMimic;
			If(Global.EnableFriendlyMimic == 0 && Global.DummyFriendBotRef != Null);
				Stop Throttle In Direction(Global.DummyFriendBotRef);
				Stop Facing(Global.DummyFriendBotRef);
			End;
		End;
		If(Global.Temp == Global.Damage50ButtonPos);
			Call Subroutine(OnDamage50Button);
		End;
		Call Subroutine(MimicMovementAim);
		Call Subroutine(FriendlyMimicMovementAim);
	}
}

rule("[Damage50:Loop] Trigger on player touch")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Distance Between(Position Of(Event Player), Global.Damage50ButtonPos) <= 2;
	}

	actions
	{
		Call Subroutine(OnDamage50Button);
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("[Damage50:Routine] OnDamage50Button")
{
	event
	{
		Subroutine;
		OnDamage50Button;
	}

	actions
	{
		Damage(Event Player, Null, Min(50, Health(Event Player) - 50));
	}
}

rule("[Mimic:Routine] Init")
{
	event
	{
		Subroutine;
		InitMimicMode;
	}

	actions
	{
		"Team 2 slot 0 is the practice range enemy bot"
		Global.PlayerEnemyBotRef = Players In Slot(0, Team 2);
		Global.PlayerEnemyBotRef.PeakHealth = Event Player;
		Global.ButtonHitBoxSize = 1;
		Global.MimicButtonPos = Vector(33.893, 3.450, 18.948);
		Create Effect(All Players(All Teams), Sphere, Global.EnableMimic == 1 ? Color(Green) : Color(Gray), Global.MimicButtonPos, 0.500,
			Color);
		Create In-World Text(All Players(All Teams), Custom String("Enable Mimic "), Global.MimicButtonPos + Vector(0, 1, 0), 1,
			Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Global.MimicMovementButtonPos = Vector(32.519, 3.450, 20.886);
		Global.EnableMimicMovement = 1;
		Create Effect(All Players(All Teams), Sphere, Global.EnableMimicMovement == 1 ? Color(Green) : Color(Gray),
			Global.MimicMovementButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Movement {0}", Global.EnableMimicMovement == 1 ? Custom String("ON")
			: Custom String("OFF")), Global.MimicMovementButtonPos + Vector(0, 1, 0), 1, Do Not Clip, Visible To Position and String,
			Color(White), Default Visibility);
		Global.CycleMimicDistanceButtonPos = Vector(31.280, 3.450, 22.631);
		Global.MimicOffset = Vector(0, 0, 5);
		Create Effect(All Players(All Teams), Sphere, Color(Blue), Global.CycleMimicDistanceButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Follow at {0}m", Z Component Of(Global.MimicOffset)),
			Global.CycleMimicDistanceButtonPos + Vector(0, 1, 0), 1, Do Not Clip, Visible To Position and String, Color(White),
			Default Visibility);
		Global.MimicInvincibleButtonPos = Vector(32.519, 5.450, 20.886);
		Global.EnableInvincibleMimic = 1;
		Create Effect(All Players(All Teams), Sphere, Global.EnableInvincibleMimic == 1 ? Color(Green) : Color(Gray),
			Global.MimicInvincibleButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Invincible Mimic {0}",
			Global.EnableInvincibleMimic == 1 ? Custom String("ON") : Custom String("OFF")), Global.MimicInvincibleButtonPos + Vector(0, 1,
			0), 1, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Global.FriendlyMimicButtonPos = Vector(33.893, 5.450, 18.948);
		Global.EnableFriendlyMimic = 0;
		Create Effect(All Players(All Teams), Sphere, Global.EnableFriendlyMimic == 1 ? Color(Green) : Color(Gray),
			Global.FriendlyMimicButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Friendly Mimic {0}", Global.EnableFriendlyMimic == 1 ? Custom String(
			"ON") : Custom String("OFF")), Global.FriendlyMimicButtonPos + Vector(0, 1, 0), 1, Do Not Clip, Visible To Position and String,
			Color(White), Default Visibility);
		Global.EnableMimicRaycast = 1;
		Global.MimicRaycastButtonPos = Vector(31.280, 5.450, 22.631);
		Create Effect(All Players(All Teams), Sphere, Global.EnableMimicRaycast == 1 ? Color(Green) : Color(Gray),
			Global.MimicRaycastButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Raycast Aim {0}", Global.EnableMimicRaycast == 1 ? Custom String("ON")
			: Custom String("OFF")), Global.MimicRaycastButtonPos + Vector(0, 1, 0), 1, Do Not Clip, Visible To Position and String, Color(
			White), Default Visibility);
		Global.Damage50ButtonPos = Vector(47.843, 3.449, 13.126);
		Create Effect(All Players(All Teams), Sphere, Color(Red), Global.Damage50ButtonPos, 0.500, Color);
		Create In-World Text(All Players(All Teams), Custom String("Damage 50HP"), Global.Damage50ButtonPos + Vector(0, 1, 0), 1,
			Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Global.GenericButtonPosArray = Array(Global.MimicButtonPos, Global.MimicMovementButtonPos, Global.CycleMimicDistanceButtonPos,
			Global.MimicInvincibleButtonPos, Global.MimicRaycastButtonPos, Global.FriendlyMimicButtonPos, Global.Damage50ButtonPos);
	}
}

rule("[Mimic:Loop] Sync inputs to enemy bot")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.EnableMimic == 1;
		Is Dummy Bot(Event Player) == True;
		Event Player == Global.PlayerEnemyBotRef;
		Event Player.PeakHealth != False;
		Is Alive(Event Player) == True;
		Is Alive(Event Player.PeakHealth) == True;
	}

	actions
	{
		Global.MimicButtons = Array(Button(Primary Fire), Button(Secondary Fire), Button(Ability 1), Button(Ability 2), Button(Ultimate),
			Button(Interact), Button(Jump), Button(Crouch), Button(Melee));
		Global.MimicBitMask = Array(1, 2, 4, 8, 16, 32, 64, 128, 256);
		While(Global.EnableMimic == 1);
			Wait(0.100, Ignore Condition);
			Set Damage Received(Event Player, Global.EnableInvincibleMimic == 1 ? 0 : 100);
			Call Subroutine(MimicMovementAim);
			Event Player.MimicMask = 0;
			For Global Variable(TIndex, 0, Count Of(Global.MimicButtons), 1);
				Event Player.MimicMask += Is Button Held(Event Player.PeakHealth, Global.MimicButtons[Global.TIndex])
					* Global.MimicBitMask[Global.TIndex];
			End;
			If(Event Player.MimicMask != Event Player.MimicMaskPrev);
				For Global Variable(TIndex, 0, Count Of(Global.MimicButtons), 1);
					Global.Temp = Global.MimicButtons[Global.TIndex];
					If(Is Button Held(Event Player.PeakHealth, Global.Temp) && !Is Button Held(Event Player, Global.Temp));
						Start Holding Button(Event Player, Global.Temp);
					End;
					If(!Is Button Held(Event Player.PeakHealth, Global.Temp) && Is Button Held(Event Player, Global.Temp));
						Stop Holding Button(Event Player, Global.Temp);
					End;
				End;
				Event Player.MimicMaskPrev = Event Player.MimicMask;
			End;
		End;
	}
}

rule("[Number] Increment Damage Taken (Modulo Logging)")
{
	event
	{
		Player Took Damage;
		All;
		All;
	}

	actions
	{
		Event Player.LastDamageValue = Event Damage;
		Event Player.DamageTaken += Event Damage;
		Event Player.DamageInstanceN += 1;
		If(Event Player.DamageInstance1Time == Null);
			Event Player.DamageInstance1Time = Total Time Elapsed;
			Event Player.DamageInstanceNTime = Total Time Elapsed;
		End;
		disabled If(Event Player.DamageInstanceN % 12 == 1 || Event Player.DamageInstanceN % 12 == 11 || Event Player.DamageInstanceN % 12 == 0);
		Log To Inspector(Custom String("Shot {0} | dt: {1} | {2}", Event Player.DamageInstanceN,
			Total Time Elapsed - Event Player.DamageInstanceNTime, Custom String("Dmg {0} | Tot {1} | DPS {2}",
			Event Player.LastDamageValue, Event Player.DamageTaken, Event Player.DamageTaken / Max(0.001,
			Total Time Elapsed - Event Player.DamageInstance1Time))));
		disabled End;
		Event Player.DamageInstanceNTime = Total Time Elapsed;
	}
}

rule("[Number] Increment Heal Taken")
{
	event
	{
		Player Received Healing;
		All;
		All;
	}

	conditions
	{
		"Event 0 is passive healing"
		Event Ability != 0;
	}

	actions
	{
		Event Player.HealTaken += Event Healing;
		Event Player.LastHealValue = Event Healing;
		Event Player.HealInstanceN += 1;
		If(Event Player.HealInstance1Time == Null);
			Event Player.HealInstance1Time = Total Time Elapsed;
			Event Player.HealInstanceNTime = Total Time Elapsed;
		End;
		disabled If(Event Player.HealInstanceN % 12 == 1 || Event Player.HealInstanceN % 12 == 11 || Event Player.HealInstanceN % 12 == 0);
		Log To Inspector(Custom String("Heal {0} | dt: {1} | {2}", Event Player.HealInstanceN,
			Total Time Elapsed - Event Player.HealInstanceNTime, Custom String("Amt {0} | Tot {1} | HPS {2}", Event Player.LastHealValue,
			Event Player.HealTaken, Event Player.HealTaken / Max(0.001, Total Time Elapsed - Event Player.HealInstance1Time))));
		disabled End;
		Event Player.HealInstanceNTime = Total Time Elapsed;
	}
}

rule("[HUD] Display player information")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Custom String("{0} {1}", Custom String("HP: {0} | Armor: {1} | Shield: {2}", Health Of Type(
			Event Player, Health), Health Of Type(Event Player, Armor), Health Of Type(Event Player, Shields)),
			Event Player.PeakTimer > 0 ? Custom String("| Peak: {0} ({1}s)", Event Player.PeakHealth, Round To Integer(
			Event Player.PeakTimer, Up)) : Custom String("")), Custom String("Speed: {0} m/s ({1}%) | Ult Time: {2} s",
			Horizontal Speed Of(Event Player), Custom String("{0}{1}", Round To Integer(100 * Horizontal Speed Of(Event Player) / (Hero Of(
			Event Player) == Hero(Tracer) || Hero Of(Event Player) == Hero(Genji) || Hero Of(Event Player) == Hero(Anran) ? 6 : 5.500),
			To Nearest) < 10 ? Custom String("00") : (Round To Integer(100 * Horizontal Speed Of(Event Player) / (Hero Of(Event Player)
			== Hero(Tracer) || Hero Of(Event Player) == Hero(Genji) || Hero Of(Event Player) == Hero(Anran) ? 6 : 5.500), To Nearest)
			< 100 ? Custom String("0") : Custom String("")), Round To Integer(100 * Horizontal Speed Of(Event Player) / (Hero Of(
			Event Player) == Hero(Tracer) || Hero Of(Event Player) == Hero(Genji) || Hero Of(Event Player) == Hero(Anran) ? 6 : 5.500),
			To Nearest)), Max(0, Event Player.UltTimeEnd - Event Player.UltTimeStart)), Right, 0, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Custom String("Mimic: {0}", Global.EnableMimic == 1 ? Custom String("ON") : Custom String("OFF")),
			Custom String("Movement: {0}", Global.EnableMimicMovement == 1 ? Custom String("ON") : Custom String("OFF")), Null, Left, 0,
			Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
	}
}

rule("[Number] Update Peak Health & Timer")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
