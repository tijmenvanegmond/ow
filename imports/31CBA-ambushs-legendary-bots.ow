rule("Oasis 3 Hole")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Current Map == Map(Oasis);
		Objective Index == 2;
		Current Game Mode == Game Mode(Control);
		Distance Between(Event Player, Objective Position(Objective Index)) < 3;
		Event Player.BotActive == True;
	}

	actions
	{
		Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Sorted Array(Filtered Array(Global.J,
			Is In Line of Sight(Event Player, Current Array Element, Barriers Do Not Block LOS) == True), Distance Between(Event Player,
			Current Array Element)))), 1, To World, Replace existing throttle, Direction and Magnitude);
		Wait(1.500, Ignore Condition);
	}
}

rule("Fix")
{
	event
	{
		Ongoing - Each Player;
		All;
		Brigitte;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
		Distance Between(Event Player, First Of(Event Player.CurrentTarget)) < 5;
	}

	actions
	{
		Press Button(Event Player, Button(Primary Fire));
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Fix")
{
	event
	{
		Ongoing - Each Player;
		All;
		Reinhardt;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
		Distance Between(Event Player, First Of(Event Player.CurrentTarget)) < 5;
	}

	actions
	{
		Press Button(Event Player, Button(Primary Fire));
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Bot Active start")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.BotActive == False;
		Is Standing(Event Player) == True;
		Is Game In Progress == True;
	}

	actions
	{
		Wait(10, Abort When False);
		Event Player.BotActive = True;
		Create HUD Text(Event Player, Custom String("AI ACTIVE"), Null, Null, Top, 0, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
	}
}

rule("Bot Active start")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
	}

	actions
	{
		Event Player.BotActive = True;
	}
}

rule("Bot Active end")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Event Player.BotActive == True;
	}

	actions
	{
		Event Player.BotActive = False;
		Stop Throttle In Direction(Event Player);
		Stop Facing(Event Player);
		Stop Holding Button(Event Player, Button(Primary Fire));
		Stop Holding Button(Event Player, Button(Secondary Fire));
		Destroy All HUD Text;
	}
}