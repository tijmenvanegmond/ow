rule("Hero AI: Zarya Bot - Deault")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zarya;
	}

	conditions
	{
		Event Player.StopShoot == False;
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Skip If(Distance Between(Eye Position(Event Player), Eye Position(Closest Player To(Event Player, Opposite Team Of(Team Of(
			Event Player))))) > 8, 1);
		Start Holding Button(Event Player, Button(Primary Fire));
		Skip If(Distance Between(Eye Position(Event Player), Eye Position(Closest Player To(Event Player, Opposite Team Of(Team Of(
			Event Player))))) <= 8, 2);
		Stop Holding Button(Event Player, Button(Primary Fire));
		Press Button(Event Player, Button(Secondary Fire));
		Skip If(Event Player.TookDamage == False, 1);
		Press Button(Event Player, Button(Ability 1));
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Zarya Bot - Ally Shield")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zarya;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Alive(Event Player) == True;
		Event Player.CanSeeDamagedAlly == True;
		Event Player.CanSeeEnemy == True;
		(First Of(Event Player.CurrentHealTarget).TookDamage == True) == True;
	}

	actions
	{
		Event Player.StopShoot = True;
		Wait(0.250, Abort When False);
		Press Button(Event Player, Button(Ability 2));
		Loop If(Is Using Ability 2(Event Player) == False);
		Event Player.CanHeal = False;
		Event Player.StopShoot = False;
		Wait(8, Ignore Condition);
		Event Player.CanHeal = True;
	}
}

rule("Hero AI: Zarya Bot - Ult if CC")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zarya;
	}

	conditions
	{
		Event Player.BotActive == True;
		Global.StartBots == True;
		Ultimate Charge Percent(Event Player) == 100;
		(Event Player.L == False) == True;
		Event Player.CurrentTarget.HasCC == True;
	}

	actions
	{
		Press Button(Event Player, Button(Ultimate));
		Event Player.ZaryaUlt = True;
	}
}

rule("Hero AI: Zarya Bot - Ult")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zarya;
	}

	conditions
	{
		Event Player.BotActive == True;
		Global.StartBots == True;
		Ultimate Charge Percent(Event Player) == 100;
		(Event Player.L == False) == True;
		Number Of Players On Objective(Opposite Team Of(Team Of(Event Player))) > 2;
		Event Player.PlayerClosestToObjectiveCenter != Empty Array;
		Is In Line of Sight(Event Player, First Of(Event Player.PlayerClosestToObjectiveCenter), Barriers Do Not Block LOS) == True;
	}

	actions
	{
		Event Player.StopFacing = True;
		Wait(0.250, Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Objective Position(Objective Index)), 10000, To World,
			Direction and Turn Rate);
		Wait(0.250, Ignore Condition);
		Press Button(Event Player, Button(Ultimate));
		Wait(1.500, Ignore Condition);
		Event Player.StopFacing = False;
	}
}

rule("Hero AI: Zenyatta Bot - Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zenyatta;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Is Using Ability 1(Event Player) == False && Event Player.CanSeeDamagedAlly == True);
			Event Player.CanHeal = True;
			Wait(1, Ignore Condition);
			Call Subroutine(Action_Module_001_UseAbility1);
		Else;
			Event Player.CanHeal = False;
		End;
		If(Normalized Health(Event Player) <= 0.500);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		If(Event Player.DealtDamage == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		Call Subroutine(Action_Module_004_UsePrimary_B);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

