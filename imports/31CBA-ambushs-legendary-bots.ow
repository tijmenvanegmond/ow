rule("Action Module: Health Calculator")
{
	event
	{
		Subroutine;
		Action_Module_012_Health;
	}

	actions
	{
		Event Player.Module_008_VeryLowHealth30 = False;
		Event Player.Module_009_HalfHealth50 = False;
		Event Player.Module_010_HighHealth75 = False;
		Event Player.Module_011_OverHealth75 = False;
		If(Normalized Health(Event Player) <= 0.300);
			Event Player.Module_008_VeryLowHealth30 = True;
		End;
		If(Normalized Health(Event Player) <= 0.500);
			Event Player.Module_009_HalfHealth50 = True;
		End;
		If(Normalized Health(Event Player) <= 0.750);
			Event Player.Module_010_HighHealth75 = True;
		End;
		If(Normalized Health(Event Player) > 0.750);
			Event Player.Module_011_OverHealth75 = True;
		End;
	}
}

