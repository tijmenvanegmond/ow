rule("Hero AI: Bastion Bot - Default Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Bastion;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Stop Holding Button(Event Player, Button(Ability 2));
		Skip If(Ultimate Charge Percent(Event Player) == 100, 9);
		If(Event Player.BastionTurretMode == False);
			Call Subroutine(Action_Module_001_UseAbility1);
			Wait(0.500, Ignore Condition);
			If(Event Player.BastionTurretMode == True);
				Abort;
			Else;
				Loop;
			End;
		End;
		Call Subroutine(Action_Module_003_UseUltimate);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Bastion Bot - Default No Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Bastion;
	}

	conditions
	{
		Event Player.CanSeeEnemy == False;
		Event Player.BotActive == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.Module_011_OverHealth75 == False);
			Start Holding Button(Event Player, Button(Ability 2));
			Wait(Event Player.Bot_Waiting_Time, Abort When False);
			Loop If Condition Is True;
		Else;
			Stop Holding Button(Event Player, Button(Ability 2));
		End;
		Wait(3, Abort When False);
		If(Event Player.BastionTurretMode == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Brigitte Bot - Heal Allies")
{
	event
	{
		Ongoing - Each Player;
		All;
		Brigitte;
	}

	conditions
	{
		Event Player.BrigitteBotRepairPackAmmo != 0;
		Event Player.Module_007_DummyBot_SeeDamagedA == True;
	}

	actions
	{
		Event Player.CanHeal = True;
		Call Subroutine(Action_Module_002_UseAbility2);
		If(First Of(Event Player.CurrentHealTarget).TookDamage == True && Distance Between(Event Player, First Of(
			Event Player.CurrentHealTarget)) < 8 && Normalized Health(First Of(Event Player.CurrentHealTarget)) < 0.600);
			Press Button(Event Player, Button(Ultimate));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Brigitte Bot - Repair Pack Ammo Count 1")
{
	event
	{
		Ongoing - Each Player;
		All;
		Brigitte;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Using Ability 2(Event Player) == True;
	}

	actions
	{
		Event Player.BrigitteBotRepairPackAmmo -= 1;
		If(Event Player.BrigitteBotRepairPackAmmo == 0);
			Event Player.CanHeal = False;
		End;
	}
}

rule("Hero AI: Brigitte Bot - Repair Pack Ammo Count 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		Brigitte;
	}

	conditions
	{
		Event Player.BotActive == True;
		Event Player.BrigitteBotRepairPackAmmo < 3;
	}

	actions
	{
		Wait(6, Abort When False);
		Event Player.BrigitteBotRepairPackAmmo += 1;
		Loop If Condition Is True;
	}
}

rule("Hero AI: Brigitte Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Brigitte;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_009_Distance_Info);
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.Module_003_LowRange5m == True && Normalized Health(Event Player) >= 0.500);
			Call Subroutine(Action_Module_001_UseAbility1);
			Wait(0.300, Ignore Condition);
			Stop Holding Button(Event Player, Button(Secondary Fire));
			Call Subroutine(Action_Module_004_UsePrimary_B);
		Else;
			Call Subroutine(Action_Module_007_UseSecondary_A);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: D.Va Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		D.Va;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		Call Subroutine(Action_Module_001_UseAbility1);
		If(Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_003_UseUltimate);
			Wait(0.250, Ignore Condition);
			If(Normalized Health(Event Player) <= 200);
				Stop Holding Button(Event Player, Button(Primary Fire));
				Call Subroutine(Action_Module_007_UseSecondary_A);
			End;
		Else;
			Call Subroutine(Action_Module_006_UsePrimary_A);
		End;
		If(Max Health(Event Player) <= 200 && Event Player.Module_009_HalfHealth50 == True && Is Firing Secondary(Event Player) == False);
			Call Subroutine(Action_Module_006_UsePrimary_A);
		End;
		If(Is Firing Secondary(Event Player) == False && Is Using Ability 1(Event Player) == False);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Doomfist Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Doomfist;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Ultimate Charge Percent(Event Player) == 100 && Event Player.DealtDamage == True);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		If(Distance Between(Event Player, First Of(Event Player.CurrentTarget)) <= 1 && Is Using Ultimate(Event Player) == True);
			Call Subroutine(Action_Module_004_UsePrimary_B);
		End;
		If(Is Using Ultimate(Event Player) == False);
			Call Subroutine(Action_Module_011_StartAction);
			Call Subroutine(Action_Module_009_Distance_Info);
			If(Event Player.Module_006_HighRange20m == True);
				Call Subroutine(Action_Module_007_UseSecondary_A);
				Call Subroutine(Action_Module_008_UseSecondary_S);
				Call Subroutine(Action_Module_001_UseAbility1);
				Call Subroutine(Action_Module_013_Ability1_S);
			End;
			If(Event Player.Module_003_LowRange5m == True);
				Call Subroutine(Action_Module_002_UseAbility2);
				Call Subroutine(Action_Module_014_Ability2_S);
				Call Subroutine(Action_Module_005_UseSecondary_B);
				Call Subroutine(Action_Module_008_UseSecondary_S);
				Call Subroutine(Action_Module_001_UseAbility1);
				Call Subroutine(Action_Module_013_Ability1_S);
			End;
			If(Event Player.Module_004_MidRange10m == True);
				Call Subroutine(Action_Module_001_UseAbility1);
				Call Subroutine(Action_Module_013_Ability1_S);
			End;
			If(Event Player.Module_005_LongRange15m == True);
				Call Subroutine(Action_Module_007_UseSecondary_A);
				Call Subroutine(Action_Module_008_UseSecondary_S);
				Call Subroutine(Action_Module_002_UseAbility2);
				Call Subroutine(Action_Module_014_Ability2_S);
				Call Subroutine(Action_Module_001_UseAbility1);
				Call Subroutine(Action_Module_013_Ability1_S);
			End;
			If(Is Using Ability 1(Event Player) == False && Is Using Ability 2(Event Player) == False && Is Firing Secondary(Event Player)
				== False);
				Call Subroutine(Action_Module_004_UsePrimary_B);
			End;
		Else;
			Call Subroutine(Action_Module_016_Chase_Ult);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Genji Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Genji;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_009_Distance_Info);
		Call Subroutine(Action_Module_012_Health);
		If(
			Event Player.Module_004_MidRange10m == True && Event Player.Module_011_OverHealth75 == True && Event Player.DealtDamage == True);
			Press Button(Event Player, Button(Ultimate));
		End;
		If(Is In Air(Event Player) == True);
			Press Button(Event Player, Button(Jump));
			Wait(0.250, Ignore Condition);
			Start Holding Button(Event Player, Button(Jump));
		Else;
			Stop Holding Button(Event Player, Button(Jump));
		End;
		If(Is Using Ultimate(Event Player) == True);
			Call Subroutine(Action_Module_016_Chase_Ult);
		End;
		If(Event Player.Module_010_HighHealth75 == True && Event Player.TookDamage == True);
			Call Subroutine(Action_Module_002_UseAbility2);
			Call Subroutine(Action_Module_014_Ability2_S);
		End;
		If(Distance Between(Event Player, First Of(Event Player.CurrentTarget)) <= 15 && Health(First Of(Event Player.CurrentTarget))
			<= 50);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Genji Bot - Shoot Logic")
{
	event
	{
		Ongoing - Each Player;
		All;
		Genji;
	}

	conditions
	{
		Event Player.CanSeeEnemy == True;
		Event Player.BotActive == True;
	}

	actions
	{
		If(Distance Between(Event Player, First Of(Event Player.CurrentTarget)) <= 6);
			If(Is Using Ultimate(Event Player) == True);
				Call Subroutine(Action_Module_004_UsePrimary_B);
			Else;
				Call Subroutine(Action_Module_005_UseSecondary_B);
			End;
		Else;
			Call Subroutine(Action_Module_004_UsePrimary_B);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Hanzo Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Hanzo;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_002_UseAbility2);
		If(Is In Air(Event Player) == True);
			Press Button(Event Player, Button(Jump));
			Wait(0.250, Ignore Condition);
			Start Holding Button(Event Player, Button(Jump));
		Else;
			Stop Holding Button(Event Player, Button(Jump));
		End;
		If(Is Using Ability 1(Event Player) == False && Is Using Ability 2(Event Player) == False);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Hanzo Bot - Shoot Logic")
{
	event
	{
		Ongoing - Each Player;
		All;
		Hanzo;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Is Using Ability 2(Event Player) == True);
			Call Subroutine(Action_Module_004_UsePrimary_B);
		Else;
			Call Subroutine(Action_Module_006_UsePrimary_A);
			Wait(1.200, Ignore Condition);
			Stop Holding Button(Event Player, Button(Primary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Hanzo Bot - Use Ult / No Zarya in team")
{
	event
	{
		Ongoing - Each Player;
		All;
		Hanzo;
	}

	conditions
	{
		Event Player.BotActive == True;
		Global.StartBots == True;
		Event Player.StopFacing == False;
		Number Of Players On Objective(All Teams) >= 3;
		Ultimate Charge Percent(Event Player) == 100;
		Players On Hero(Hero(Zarya), Team Of(Event Player)) == Empty Array;
	}

	actions
	{
		Event Player.StopFacing = True;
		Wait(0.250, Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Objective Position(Objective Index)), 10000, To World,
			Direction and Turn Rate);
		Wait(0.250, Ignore Condition);
		Press Button(Event Player, Button(Ultimate));
		Wait(1.500, Ignore Condition);
		Event Player.StopFacing = False;
	}
}

rule("Hero AI: Hanzo Bot - Ult Combo")
{
	event
	{
		Ongoing - Each Player;
		All;
		Hanzo;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Using Ultimate(Filtered Array(Players On Hero(Hero(Zarya), Team Of(Event Player)), Is Dummy Bot(Event Player) == True)) == True;
		Ultimate Charge Percent(Event Player) == 100;
		Event Player.StopFacing == False;
		Has Status(Event Player, Hacked) == False;
	}

	actions
	{
		Event Player.StopFacing = True;
		Wait(0.250, Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Objective Position(Objective Index)), 10000, To World,
			Direction and Turn Rate);
		Wait(0.250, Ignore Condition);
		Press Button(Event Player, Button(Ultimate));
		Wait(1.500, Ignore Condition);
		Event Player.StopFacing = False;
	}
}

rule("Hero AI: Hanzo Bot - Ult Combo 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		Hanzo;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Using Ultimate(Players On Hero(Hero(Zarya), Team Of(Event Player))) == True;
		Ultimate Charge Percent(Event Player) == 100;
		Event Player.StopFacing == False;
		Has Status(Event Player, Hacked) == False;
		(Filtered Array(All Players(Team Of(Event Player)), Current Array Element.ZaryaUlt != True) == Empty Array) == True;
	}

	actions
	{
		Event Player.StopFacing = True;
		Wait(0.250, Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), First Of(Sorted Array(Filtered Array(All Players(Team Of(
			Event Player)), Current Array Element.ZaryaUlt == True), Distance Between(Event Player, Current Array Element)))
			.CurrentTarget), 10000, To World, Direction and Turn Rate);
		Wait(0.250, Ignore Condition);
		Press Button(Event Player, Button(Ultimate));
		Wait(1.500, Ignore Condition);
		Event Player.StopFacing = False;
	}
}

rule("Hero AI: Junkrat Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Junkrat;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		If(Is On Objective(Event Player) == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.TookDamage && Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_001_UseAbility1);
			Wait(0.250, Ignore Condition);
			Call Subroutine(Action_Module_005_UseSecondary_B);
			Call Subroutine(Action_Module_010_Selfuse_End);
			Wait(8, Ignore Condition);
		End;
		If(Ultimate Charge Percent(Event Player) == 100);
			Press Button(Event Player, Button(Ultimate));
			Wait(1, Ignore Condition);
			Wait(0.083 * Distance Between(Event Player, First Of(Event Player.CurrentTarget)), Ignore Condition);
			Press Button(Event Player, Button(Primary Fire));
		End;
		If(Event Player.DealtDamage == True);
			Call Subroutine(Action_Module_005_UseSecondary_B);
			Wait(0.250, Ignore Condition);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		If(Is Using Ultimate(Event Player) == False);
			Call Subroutine(Action_Module_004_UsePrimary_B);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Lucio Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Lúcio;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		If(Is Using Ultimate(All Players(Opposite Team Of(Team Of(Event Player)))) == True && Number Of Players On Objective(Team Of(
			Event Player)) >= 2);
			If(Is On Objective(Event Player) == True);
				Call Subroutine(Action_Module_003_UseUltimate);
			End;
		End;
		If(Is In Air(Event Player) == True);
			Press Button(Event Player, Button(Jump));
			Wait(0.250, Ignore Condition);
			Start Holding Button(Event Player, Button(Jump));
		Else;
			Stop Holding Button(Event Player, Button(Jump));
		End;
		If(Event Player.CanSeeDamagedAlly == True && Distance Between(Event Player, Event Player.CurrentHealTarget) <= 15);
			Call Subroutine(Action_Module_001_UseAbility1);
			Skip If(Is Using Ability 1(Event Player) == False, 1);
			Event Player.LucioAuraMode = 2;
		Else If(Event Player.LucioAuraMode == 2);
			Call Subroutine(Action_Module_001_UseAbility1);
			Skip If(Is Using Ability 1(Event Player) == False, 1);
			Event Player.LucioAuraMode = 1;
		End;
		If(Is On Objective(Event Player) == False && Is In Spawn Room(Event Player) == False && Is Moving(Event Player)
			== True && Event Player.LucioAuraMode == 1);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.CanSeeDamagedAlly == True);
			If(Normalized Health(First Of(Event Player.CurrentHealTarget)) <= 0.600);
				Call Subroutine(Action_Module_002_UseAbility2);
			End;
		End;
		If(Event Player.CanSeeEnemy == True);
			Call Subroutine(Action_Module_006_UsePrimary_A);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mccree Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Cassidy;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		Call Subroutine(Action_Module_009_Distance_Info);
		If(Ultimate Charge Percent(Event Player) == 100 && Distance Between(Event Player, First Of(Event Player.CurrentTarget)) >= 12);
			Press Button(Event Player, Button(Ultimate));
		End;
		If(Event Player.Module_003_LowRange5m == True);
			Call Subroutine(Action_Module_002_UseAbility2);
			If(Is Using Ability 2(Event Player) == True);
				Call Subroutine(Action_Module_005_UseSecondary_B);
				If(Is Firing Secondary(Event Player) == True);
					Call Subroutine(Action_Module_017_Sec_S);
					Call Subroutine(Action_Module_001_UseAbility1);
				End;
			End;
		End;
		If(Event Player.Module_009_HalfHealth50 == True && Event Player.TookDamage == True);
			Call Subroutine(Action_Module_001_UseAbility1);
			Call Subroutine(Action_Module_013_Ability1_S);
		End;
		If(Is Using Ultimate(Event Player) == True);
			Wait(Random Real(3, 4.500), Ignore Condition);
			Press Button(Event Player, Button(Primary Fire));
		End;
		Call Subroutine(Action_Module_004_UsePrimary_B);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mei Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mei;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.Module_009_HalfHealth50 == True);
			Press Button(Event Player, Button(Ability 1));
			If(Is Using Ability 1(Event Player) == False);
				Call Subroutine(Action_Module_010_Selfuse_Start);
				Call Subroutine(Action_Module_002_UseAbility2);
				Wait(0.250, Ignore Condition);
				Call Subroutine(Action_Module_004_UsePrimary_B);
				Call Subroutine(Action_Module_010_Selfuse_End);
			End;
			Call Subroutine(Action_Module_013_Ability1_S);
		End;
		If(Ultimate Charge Percent(Event Player) == 100 && Event Player.Module_004_MidRange10m == True);
			Press Button(Event Player, Button(Ultimate));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mercy Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		If(Is Firing Primary(Event Player) == False && Is Firing Secondary(Event Player) == False);
			Start Holding Button(Event Player, Button(Ability 1));
		Else;
			Stop Holding Button(Event Player, Button(Ability 1));
		End;
		If(Event Player.CanSeeEnemy && Event Player.CanSeeDamagedAlly == True);
			Press Button(Event Player, Button(Ultimate));
		End;
		If(Is Using Ultimate(Event Player) == True);
			Start Holding Button(Event Player, Button(Jump));
		Else;
			If(Is In Air(Event Player) == True && Normalized Health(Event Player) > 0.600);
				Start Holding Button(Event Player, Button(Jump));
			Else;
				Stop Holding Button(Event Player, Button(Jump));
			End;
		End;
		If(Event Player.CanSeeDamagedAlly == False && Event Player.CanSeeAlly == False);
			Call Subroutine(Action_Module_011_StartAction);
			Event Player.StopAutomaticGoTo = False;
			If(Is On Objective(Event Player) == True);
				Start Facing(Event Player, Direction Towards(Eye Position(Event Player), First Of(Event Player.CurrentVisibleWaypoints)), 200,
					To World, Direction and Turn Rate);
			Else;
				Start Facing(Event Player, Direction Towards(Eye Position(Event Player), First Of(Event Player.RandomFacingDirection)),
					Random Real(300, 600), To World, Direction and Turn Rate);
			End;
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mercy Bot - Damaged Ally")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}

	conditions
	{
		Event Player.Module_007_DummyBot_SeeDamagedA == True;
		Event Player.CanSeeDeadAlly == False;
		((Event Player.CanSeeDeadAlly == False && Event Player.Mercy_Rez == True) || (Event Player.Mercy_Rez == False)) == True;
	}

	actions
	{
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(First Of(Event Player.CurrentHealTarget))),
			200, To World, Direction and Turn Rate);
		Event Player.StopAutomaticGoTo = True;
		Call Subroutine(Action_Module_011_StopAction);
		If(Distance Between(Event Player, First Of(Event Player.CurrentHealTarget)) > 1.500);
			Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentHealTarget)), 1, To World,
				Replace existing throttle, Direction and Magnitude);
		Else;
			Stop Throttle In Direction(Event Player);
		End;
		If(Distance Between(Event Player, First Of(Event Player.CurrentHealTarget)) > 7);
			Stop Holding Button(Event Player, Button(Primary Fire));
		Else;
			Stop Holding Button(Event Player, Button(Secondary Fire));
			Start Holding Button(Event Player, Button(Primary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mercy Bot - Ally")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}

	conditions
	{
		Event Player.Module_007_DummyBot_SeeDamagedA == False;
		Event Player.Module_012_DummyBotAlly == True;
		((Event Player.CanSeeDeadAlly == False && Event Player.Mercy_Rez == True) || (Event Player.Mercy_Rez == False)) == True;
	}

	actions
	{
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(First Of(Event Player.CurrentAllyTarget))),
			200, To World, Direction and Turn Rate);
		Event Player.StopAutomaticGoTo = True;
		Call Subroutine(Action_Module_011_StopAction);
		If(Distance Between(Event Player, First Of(Event Player.CurrentAllyTarget)) > 1.500);
			Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentAllyTarget)), 1, To World,
				Replace existing throttle, Direction and Magnitude);
		Else;
			Stop Throttle In Direction(Event Player);
		End;
		If(Distance Between(Event Player, First Of(Event Player.CurrentAllyTarget)) > 7);
			Stop Holding Button(Event Player, Button(Secondary Fire));
		Else;
			Stop Holding Button(Event Player, Button(Primary Fire));
			Start Holding Button(Event Player, Button(Secondary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mercy Bot - Revive")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
		Event Player.CanSeeDeadAlly == True;
		Is Alive(Event Player) == True;
		Event Player.Mercy_Rez == True;
	}

	actions
	{
		Call Subroutine(Action_Module_011_StartAction);
		Event Player.StopAutomaticGoTo = True;
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(First Of(Event Player.CurrentDeadAlly))),
			200, To World, Direction and Turn Rate);
		If(Distance Between(Event Player, First Of(Event Player.CurrentDeadAlly)) > 1);
			Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentDeadAlly)), 1, To World,
				Replace existing throttle, Direction and Magnitude);
		Else;
			Stop Throttle In Direction(Event Player);
			Start Holding Button(Event Player, Button(Ability 2));
			Call Subroutine(Action_Module_014_Ability2_S);
		End;
		Event Player.Mercy_Rez = False;
		Wait(25, Ignore Condition);
		Event Player.Mercy_Rez = True;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Mei Bot - Shoot Logic")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mei;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Distance Between(Event Player, First Of(Event Player.CurrentTarget)) < 6);
			If(Has Status(First Of(Event Player.CurrentTarget), Frozen) == True);
				Press Button(Event Player, Button(Secondary Fire));
			Else;
				Call Subroutine(Action_Module_006_UsePrimary_A);
			End;
		Else;
			Stop Holding Button(Event Player, Button(Primary Fire));
			Press Button(Event Player, Button(Secondary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Moira Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Moira;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		If(Is Using Ultimate(Event Player) == True);
			Event Player.CanHeal = True;
		End;
		If(Event Player.TookDamage == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Moira Bot - Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Moira;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Is Using Ultimate(Event Player) == False);
			Event Player.CanHeal = False;
		End;
		If(Ultimate Charge Percent(Event Player) == 100);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		Call Subroutine(Action_Module_009_Distance_Info);
		If(Event Player.Module_004_MidRange10m == True);
			Stop Holding Button(Event Player, Button(Primary Fire));
			Start Holding Button(Event Player, Button(Secondary Fire));
		Else;
			Stop Holding Button(Event Player, Button(Secondary Fire));
		End;
		If(Event Player.MoiraOrbReady == True);
			Call Subroutine(Action_Module_002_UseAbility2);
			Wait(0.250, Ignore Condition);
			Press Button(Event Player, Button(Secondary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

