rule("Condition: Enemy is in LOS [TRUE]")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
	}

	actions
	{
		Event Player.CurrentTarget = Filtered Array(Filtered Array(Filtered Array(Filtered Array(Filtered Array(Filtered Array(
			Filtered Array(Global.TargetArray, Current Array Element.Stealth == False), Team Of(Current Array Element) == Opposite Team Of(
			Team Of(Event Player))), Has Status(Current Array Element, Unkillable) == False), Has Status(Current Array Element, Invincible)
			== False), Has Status(Event Player, Phased Out) == False), Is Alive(Current Array Element) == True), Is In Line of Sight(
			Event Player, Current Array Element, Barriers Do Not Block LOS) == True);
		Wait(0.120, Ignore Condition);
		Loop;
	}
}

rule("Condition: Enemy is in LOS [TRUE]")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
