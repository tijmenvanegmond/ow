disabled rule("===== HERO AI =====")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Hero AI: Ana Bot - Default Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Ana;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
		Event Player.Module_007_DummyBot_SeeDamagedA == False;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.DealtDamage == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		If(Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_002_UseAbility2);
			Call Subroutine(Action_Module_010_Selfuse_End);
		Else;
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.CanSeeEnemy == True);
			Call Subroutine(Action_Module_006_UsePrimary_A);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Ana Bot - Default Ally")
{
	event
	{
		Player Took Damage;
		All;
		Ana;
	}

	conditions
	{
		Event Player.Module_007_DummyBot_SeeDamagedA == True;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		Call Subroutine(Action_Module_006_UsePrimary_A);
		If(Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_002_UseAbility2);
			Call Subroutine(Action_Module_010_Selfuse_End);
		Else;
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Normalized Health(First Of(Event Player.CurrentHealTarget)) == (First Of(Event Player.CurrentHealTarget).TookDamage == True)
			&& True);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		Call Subroutine(Action_Module_006_UsePrimary_A);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Ashe Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Ashe;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_003_UseUltimate);
		Call Subroutine(Action_Module_009_Distance_Info);
		If(Event Player.Module_004_MidRange10m == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.Module_003_LowRange5m == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		Else If(Event Player.TookDamage == True);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_001_UseAbility1);
			Call Subroutine(Action_Module_010_Selfuse_End);
			Wait(15, Ignore Condition);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Ashe Bot - Shoot Logic")
{
	event
	{
		Ongoing - Each Player;
		All;
		Ashe;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_009_Distance_Info);
		If(Event Player.Module_003_LowRange5m == True);
			Stop Holding Button(Event Player, Button(Secondary Fire));
			Call Subroutine(Action_Module_004_UsePrimary_B);
		Else;
			Call Subroutine(Action_Module_007_UseSecondary_A);
			Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
			Call Subroutine(Action_Module_004_UsePrimary_B);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Baptiste Bot - Deafult Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		Baptiste;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
		Event Player.Module_007_DummyBot_SeeDamagedA == False;
	}

	actions
	{
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.Module_011_OverHealth75 == True && Ultimate Charge Percent(Event Player) == 100);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_003_UseUltimate);
			Call Subroutine(Action_Module_010_Selfuse_End);
		End;
		If(Event Player.Module_010_HighHealth75 == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		If(Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_002_UseAbility2);
			Call Subroutine(Action_Module_010_Selfuse_End);
			Wait(15, Ignore Condition);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Baptiste Bot - Deafult Ally")
{
	event
	{
		Ongoing - Each Player;
		All;
		Baptiste;
	}

	conditions
	{
		Event Player.Module_007_DummyBot_SeeDamagedA == True;
	}

	actions
	{
		If(Normalized Health(First Of(Event Player.CurrentHealTarget)) <= 0.600);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		If(Normalized Health(First Of(Event Player.CurrentHealTarget)) <= 0.400);
			Call Subroutine(Action_Module_010_Selfuse_Start);
			Call Subroutine(Action_Module_002_UseAbility2);
			Call Subroutine(Action_Module_010_Selfuse_End);
			Wait(15, Ignore Condition);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Baptiste Bot - Shoot Logic")
{
	event
	{
		Ongoing - Each Player;
		All;
		Baptiste;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		If(Event Player.CanSeeEnemy == True && Event Player.CanSeeDamagedAlly == False);
			Call Subroutine(Action_Module_004_UsePrimary_B);
		End;
		If(Event Player.CanSeeDamagedAlly == True);
			Call Subroutine(Action_Module_005_UseSecondary_B);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Baptiste Bot - Jump")
{
	event
	{
		Ongoing - Each Player;
		All;
		Baptiste;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Start Holding Button(Event Player, Button(Crouch));
		Wait(Random Real(1.500, 4), Ignore Condition);
		Press Button(Event Player, Button(Jump));
		Stop Holding Button(Event Player, Button(Crouch));
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

