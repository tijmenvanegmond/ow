settings
{
	main
	{
		Description: "Custom Legendary Bots V10.0 (Control Mode only)"
	}

	lobby
	{
		Allow Players Who Are In Queue: Yes
		Map Rotation: After A Game
		Match Voice Chat: Enabled
		Max Spectators: 12
		Max Team 1 Players: 6
		Max Team 2 Players: 6
		Return To Lobby: Never
		Team Balancing: After A Game
		Use Experimental Update If Available: Yes
	}

	modes
	{
		Control
		{
			Score To Win: 1

			disabled maps
			{
				Antarctic Peninsula
				Samoa
			}
		}

		disabled Elimination
		{
			Score To Win: 9
		}

		General
		{
			Game Mode Start: Immediately
			Hero Limit: Off
			Kill Cam: Disabled
			Respawn Time Scalar: 50%
		}
	}

	heroes
	{
		General
		{
			Mercy
			{
				Weapons Enabled: Caduceus Staff Only
			}

			Symmetra
			{
				Sentry Turret: Disabled
			}

			Torbjörn
			{
				Deploy Turret: Disabled
			}

			disabled heroes
			{
				Anran
				Domina
				Emre
				Freja
				Hazard
				Illari
				Jetpack Cat
				Junker Queen
				Juno
				Kiriko
				Lifeweaver
				Mauga
				Mizuki
				Ramattra
				Sierra
				Sojourn
				Vendetta
				Venture
				Wuyang
			}
		}
	}
}

