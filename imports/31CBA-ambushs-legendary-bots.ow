rule("Action Module: Distance Calculator")
{
	event
	{
		Subroutine;
		Action_Module_009_Distance_Info;
	}

	actions
	{
		Event Player.Module_003_LowRange5m = False;
		Event Player.Module_004_MidRange10m = False;
		Event Player.Module_005_LongRange15m = False;
		Event Player.Module_006_HighRange20m = False;
		If(Distance Between(Event Player, Event Player.CurrentTarget) <= 5);
			Event Player.Module_003_LowRange5m = True;
		End;
		If(Distance Between(Event Player, Event Player.CurrentTarget) <= 10);
			Event Player.Module_004_MidRange10m = True;
		End;
		If(Distance Between(Event Player, Event Player.CurrentTarget) <= 15);
			Event Player.Module_005_LongRange15m = True;
		End;
		If(Distance Between(Event Player, Event Player.CurrentTarget) > 20);
			Event Player.Module_006_HighRange20m = True;
		End;
	}
}

