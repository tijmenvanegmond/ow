rule("Action Module: Chase Enemy during ult")
{
	event
	{
		Subroutine;
		Action_Module_016_Chase_Ult;
	}

	actions
	{
		If(Is In Line of Sight(Event Player, First Of(Event Player.CurrentTarget), Barriers Do Not Block LOS)
			== True && Event Player.CurrentTarget != Empty Array);
			Event Player.StopAutomaticGoTo = False;
			Event Player.CurrentGoToTarget = Closest Player To(Event Player, Opposite Team Of(Team Of(Event Player)));
			Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
				Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
				Current Array Element) == False), Distance Between(Current Array Element, First Of(Event Player.CurrentGoToTarget)));
			Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentVisibleWaypoints)), 1,
				To World, Replace existing throttle, Direction and Magnitude);
		Else;
			Event Player.StopAutomaticGoTo = True;
			Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentTarget)), 1, To World,
				Replace existing throttle, Direction and Magnitude);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If(Is Using Ultimate(Event Player) == True);
	}
}

