rule("Communicate: No")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Communicating(Event Player, Ultimate Status) == True;
		Ultimate Charge Percent(Event Player) == 100;
		Event Player.Communicate == True;
	}

	actions
	{
		Wait(Random Real(0.500, 1.500), Ignore Condition);
		If(Ultimate Charge Percent(First Of(Sorted Array(Filtered Array(Global.DummyBots, Team Of(Current Array Element) == Team Of(
			Event Player)), Distance Between(Event Player, Current Array Element)))) < 90);
			Communicate(First Of(Sorted Array(Filtered Array(Global.DummyBots, Team Of(Current Array Element) == Team Of(Event Player)),
				Distance Between(Event Player, Current Array Element))), No);
			Wait(Random Real(0.500, 1.500), Ignore Condition);
			Communicate(First Of(Sorted Array(Filtered Array(Global.DummyBots, Team Of(Current Array Element) == Team Of(Event Player)),
				Distance Between(Event Player, Current Array Element))), Ultimate Status);
		Else;
			Communicate(First Of(Sorted Array(Filtered Array(Global.DummyBots, Team Of(Current Array Element) == Team Of(Event Player)),
				Distance Between(Event Player, Current Array Element))), Ready);
		End;
		Wait(10, Ignore Condition);
	}
}

