}

rule("Hero AI: Widowmaker Bot  - Shoot Without Sniperspot")
{
	event
	{
		Ongoing - Each Player;
		All;
		Widowmaker;
	}

	conditions
	{
		Distance Between(Event Player, First Of(Event Player.CurrentTarget)) <= 5;
		Is Standing(Event Player) == False;
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Stop Holding Button(Event Player, Button(Secondary Fire));
		Start Holding Button(Event Player, Button(Primary Fire));
	}
}

rule("Hero AI: Widowmaker Bot  - Poison Mine + Ult")
{
	event
	{
		Ongoing - Each Player;
		All;
		Widowmaker;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		Skip If(Event Player.CanSeeEnemy == False, 2);
		Skip If(Distance Between(Event Player, First Of(Event Player.CurrentTarget)) > 10, 1);
		Press Button(Event Player, Button(Ability 2));
		Skip If(Event Player.CanSeeEnemy == True, 2);
		Skip If(Ultimate Charge Percent(Event Player) != 100, 1);
		Press Button(Event Player, Button(Ultimate));
		Wait(Random Real(0.100, 0.500), Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Widowmaker Bot - Ultimate")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Using Ultimate(First Of(Players On Hero(Hero(Widowmaker), Team Of(Event Player)))) == True;
		Event Player.CanSeeEnemy == False;
	}

	actions
	{
		Wait(Random Real(0.500, 1.500), Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(Closest Player To(Event Player,
			Opposite Team Of(Team Of(Event Player))))), 500, To World, Direction and Turn Rate);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Winston Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Winston;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Skip If(Event Player.TookDamage == False, 2);
		Skip If(Normalized Health(Event Player) > 0.400, 1);
		Press Button(Event Player, Button(Ultimate));
		Skip If(Event Player.TookDamage == False, 2);
		Press Button(Event Player, Button(Ability 1));
		Skip If(Is On Ground(Event Player) == False, 1);
		Press Button(Event Player, Button(Ability 2));
		Call Subroutine(Action_Module_006_UsePrimary_A);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Wrecking Ball - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Wrecking Ball;
	}

	conditions
	{
		Event Player.Module_002_DummyBot == True;
	}

	actions
	{
		If(Is In Air(Event Player) == True);
			Press Button(Event Player, Button(Crouch));
		End;
		Call Subroutine(Action_Module_009_Distance_Info);
		If(Event Player.CanSeeEnemy == True && Event Player.TookDamage == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.CanSeeEnemy == True && Event Player.Module_003_LowRange5m == True && Is On Objective(Event Player) == True);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		If(Is On Objective(Event Player) == False && Distance Between(Event Player, First Of(Event Player.CurrentVisibleWaypoints)) <= 10);
			Start Holding Button(Event Player, Button(Secondary Fire));
			Wait(2.250, Ignore Condition);
			Stop Holding Button(Event Player, Button(Secondary Fire));
		End;
		If(Event Player.CanSeeEnemy == True);
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

