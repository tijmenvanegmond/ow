		If(Event Player.Module_009_HalfHealth50 == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Event Player.Module_005_LongRange15m == True);
			Call Subroutine(Action_Module_001_UseAbility1);
		End;
		If(Event Player.Module_003_LowRange5m == True);
			Call Subroutine(Action_Module_003_UseUltimate);
