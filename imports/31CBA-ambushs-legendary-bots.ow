rule("Hero AI: Sigma Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Sigma;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Is Firing Secondary(Event Player) == False);
			Call Subroutine(Action_Module_005_UseSecondary_B);
			Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
			If(Is Firing Secondary(Event Player) == True);
				Set Status(Event Player, Null, Rooted, 5);
			End;
		End;
		Call Subroutine(Action_Module_012_Health);
		If(Event Player.TookDamage == True && Event Player.Module_009_HalfHealth50 == True);
			Start Holding Button(Event Player, Button(Ability 1));
			If(Is Using Ability 1(Event Player) == True);
				Wait(Random Real(3, 5), Ignore Condition);
				Stop Holding Button(Event Player, Button(Ability 1));
			End;
		End;
		If(Ultimate Charge Percent(Event Player) == 100);
			Call Subroutine(Action_Module_003_UseUltimate);
		End;
		If(Is Using Ultimate(Event Player) == True);
			Stop Holding Button(Event Player, Button(Primary Fire));
			Start Holding Button(Event Player, Button(Jump));
			Wait(2, Ignore Condition);
			Press Button(Event Player, Button(Ultimate));
		Else;
			Press Button(Event Player, Button(Ability 2));
			Press Button(Event Player, Button(Primary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Soldier: 76 Bot - Default")
{
	event
	{
		Ongoing - Each Player;
		All;
		Soldier: 76;
