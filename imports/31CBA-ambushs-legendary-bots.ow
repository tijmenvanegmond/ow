rule("Current Waypoint 1")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Global.StartBots == 1;
		Event Player.StopAutomaticGoTo == False;
		Event Player.T == False;
		(Hero Of(Event Player) == Hero(Genji) && Is Using Ultimate(Event Player) == True) == False;
	}

	actions
	{
		If(Normalized Health(Event Player) < 0.600 && Event Player.CanSeeEnemy == False);
			Event Player.ClosestHealthpackPosition = Sorted Array(Global.HealthpackLocations, Distance Between(Event Player,
				Current Array Element));
			Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
				Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
				Current Array Element) == False), Distance Between(Current Array Element, First Of(Event Player.ClosestHealthpackPosition)));
		Else;
			If((Hero Of(Event Player) == Hero(Genji) && Is Using Ultimate(Event Player) == True) || (Hero Of(Event Player) == Hero(Doomfist)
				&& Is Using Ultimate(Event Player) == True));
				If(Event Player.CanSeeEnemy == False);
					Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
						Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
						Current Array Element) == False), Distance Between(Current Array Element, Position Of(Closest Player To(Event Player,
						Opposite Team Of(Team Of(Event Player))))));
				Else;
					Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentTarget)), 1, To World,
						Replace existing throttle, Direction and Magnitude);
				End;
			Else;
				If(Number Of Players On Objective(Opposite Team Of(Team Of(Event Player))) == 0 && Control Mode Scoring Team == Team Of(
					Event Player));
					Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
						Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
						Current Array Element) == False), Distance Between(Current Array Element, Position Of(Random Value In Array(All Players(
						Opposite Team Of(Team Of(Event Player)))))));
				Else;
					If(Is On Objective(Event Player) == True);
						Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
							Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
							Current Array Element) == False), Distance Between(Current Array Element, Event Player));
						Event Player.CurrentVisibleWaypoints = Randomized Array(Event Player.CurrentVisibleWaypoints);
					Else;
						Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
							Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
							Current Array Element) == False), Distance Between(Current Array Element, First Of(Event Player.CurrentGoToTarget)));
					End;
				End;
				Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentVisibleWaypoints)), 1,
					To World, Replace existing throttle, Direction and Magnitude);
			End;
		End;
		Wait(Random Integer(1, 2), Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Current Waypoint 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		(Event Player.CurrentVisibleWaypoints != Empty Array) == True;
		Distance Between(Eye Position(Event Player), First Of(Event Player.CurrentVisibleWaypoints)) <= 1;
		Is Game In Progress == True;
		Global.StartBots == 1;
		Event Player.StopAutomaticGoTo == False;
		Event Player.T == False;
	}

	actions
	{
		Modify Player Variable(Event Player, WaypointBlacklist, Append To Array, First Of(Event Player.CurrentVisibleWaypoints));
		If(Normalized Health(Event Player) < 0.600 && Event Player.CanSeeEnemy == False);
			Event Player.ClosestHealthpackPosition = Sorted Array(Global.HealthpackLocations, Distance Between(Event Player,
				Current Array Element));
			Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
				Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
				Current Array Element) == False), Distance Between(Current Array Element, First Of(Event Player.ClosestHealthpackPosition)));
		Else;
			If((Hero Of(Event Player) == Hero(Genji) && Is Using Ultimate(Event Player) == True) || (Hero Of(Event Player) == Hero(Doomfist)
				&& Is Using Ultimate(Event Player) == True));
				If(Event Player.CanSeeEnemy == False);
					Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
						Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
						Current Array Element) == False), Distance Between(Current Array Element, Position Of(Closest Player To(Event Player,
						Opposite Team Of(Team Of(Event Player))))));
				Else;
					Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentTarget)), 1, To World,
						Replace existing throttle, Direction and Magnitude);
				End;
			Else;
				If(Number Of Players On Objective(Opposite Team Of(Team Of(Event Player))) == 0 && Control Mode Scoring Team == Team Of(
					Event Player));
					Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
						Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
						Current Array Element) == False), Distance Between(Current Array Element, Position Of(Random Value In Array(All Players(
						Opposite Team Of(Team Of(Event Player)))))));
				Else;
					If(Is On Objective(Event Player) == True);
						Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
							Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
							Current Array Element) == False), Distance Between(Current Array Element, Event Player));
						Event Player.CurrentVisibleWaypoints = Randomized Array(Event Player.CurrentVisibleWaypoints);
					Else;
						Event Player.CurrentVisibleWaypoints = Sorted Array(Filtered Array(Filtered Array(Global.J, Is In Line of Sight(Event Player,
							Current Array Element, Barriers Do Not Block LOS) == True), Array Contains(Event Player.WaypointBlacklist,
							Current Array Element) == False), Distance Between(Current Array Element, First Of(Event Player.CurrentGoToTarget)));
					End;
				End;
				Start Throttle In Direction(Event Player, Direction Towards(Event Player, First Of(Event Player.CurrentVisibleWaypoints)), 1,
					To World, Replace existing throttle, Direction and Magnitude);
			End;
		End;
		disabled Wait(Random Integer(1, 2), Ignore Condition);
		disabled Loop If Condition Is True;
	}
}

rule("Between Rounds")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Between Rounds == True;
	}

	actions
	{
		Global.StartBots = False;
		Wait(15, Ignore Condition);
		Destroy All Dummy Bots;
	}
}

