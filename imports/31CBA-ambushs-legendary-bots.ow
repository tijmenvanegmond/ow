rule("Hero AI: Orisa Bot - Deafult")
{
	event
	{
		Ongoing - Each Player;
		All;
		Orisa;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		If(Event Player.TookDamage == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Is Using Ability 2(Event Player) == True);
			Stop Holding Button(Event Player, Button(Primary Fire));
			Wait(0.083 * Distance Between(Event Player, First Of(Event Player.CurrentTarget)), Ignore Condition);
			Press Button(Event Player, Button(Primary Fire));
		Else;
			Call Subroutine(Action_Module_001_UseAbility1);
			Call Subroutine(Action_Module_005_UseSecondary_B);
			If(Event Player.DealtDamage == True);
				Call Subroutine(Action_Module_003_UseUltimate);
			End;
			Start Holding Button(Event Player, Button(Primary Fire));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Pharah Bot - Deafult")
{
	event
	{
		Ongoing - Each Player;
		All;
		Pharah;
	}

	conditions
	{
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Call Subroutine(Action_Module_001_UseAbility1);
		Wait(1.300, Abort When False);
		Call Subroutine(Action_Module_002_UseAbility2);
		Skip If(Is In Air(Event Player) == False, 1);
		Press Button(Event Player, Button(Ultimate));
		Call Subroutine(Action_Module_004_UsePrimary_B);
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

