rule("Blacklist - Healthpacks")
{
	event
	{
		Player Received Healing;
		All;
		All;
	}

	conditions
	{
		Event Was Health Pack == True;
		Event Player.BotActive == True;
	}

	actions
	{
		Modify Global Variable(HealthpackBlacklist, Append To Array, First Of(Event Player.ClosestHealthpackPosition));
		Wait(10, Ignore Condition);
		Modify Global Variable(HealthpackBlacklist, Remove From Array By Index, 0);
	}
}

disabled rule("Target: IsOnObjective")
