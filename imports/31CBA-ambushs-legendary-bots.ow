rule("Condition: Ally is in LOS [TRUE]")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
	}

	actions
	{
		Event Player.CurrentAllyTarget = Sorted Array(Filtered Array(Remove From Array(All Living Players(Team Of(Event Player)),
			Event Player), Is In Line of Sight(Event Player, Current Array Element, Barriers Do Not Block LOS) == True), Distance Between(
			Event Player, Current Array Element));
		Wait(1.600, Ignore Condition);
		Loop If Condition Is True;
	}
}

