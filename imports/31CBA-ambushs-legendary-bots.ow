rule("Action: Face Enemy")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Event Player.CanSeeEnemy == True;
		Event Player.StopFacing == False;
		Event Player.L == False;
		Event Player.CanSeeDamagedAlly == False;
		Event Player.CanHeal == True;
		Hero Of(Event Player) != Hero(Mercy);
	}

	actions
	{
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(Last Of(Event Player.CurrentTarget))),
			Random Integer(200, 800), To World, Direction and Turn Rate);
	}
}

