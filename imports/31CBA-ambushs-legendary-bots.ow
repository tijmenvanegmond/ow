			Call Subroutine(Action_Module_005_UseSecondary_B);
		End;
		If(Event Player.TookDamage == True);
			Call Subroutine(Action_Module_002_UseAbility2);
		End;
		If(Is Using Ability 2(Event Player) == True);
			Set Status(Event Player, Null, Rooted, 2);
			Press Button(Event Player, Button(Ultimate));
		End;
		If(Is On Objective(Event Player) == False && Is Moving(Event Player) == True);
			Start Holding Button(Event Player, Button(Ability 1));
		Else;
			Stop Holding Button(Event Player, Button(Ability 1));
		End;
		Wait(Event Player.Bot_Waiting_Time, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Hero AI: Sombra Bot - Hack Healthpack")
{
	event
	{
		Ongoing - Each Player;
		All;
		Sombra;
	}

	conditions
	{
		Event Player.CurrentHealthpack != Empty Array;
		Distance Between(Event Player, First Of(Event Player.CurrentHealthpack)) <= 7.777;
		Event Player.Module_001_DummyBotEnemy == True;
	}

	actions
	{
		Set Status(Event Player, Null, Rooted, 3.500);
		Event Player.StopFacing = True;
		Wait(0.500, Ignore Condition);
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), First Of(Event Player.CurrentHealthpack)), 1000, To World,
			Direction and Turn Rate);
		Start Holding Button(Event Player, Button(Secondary Fire));
		Wait(3.500, Ignore Condition);
		Stop Holding Button(Event Player, Button(Secondary Fire));
		Event Player.StopFacing = False;
		Wait(6, Ignore Condition);
	}
}

rule("Hero AI: Sombra Bot - See Healthpack")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
	}

	actions
	{
		Event Player.CurrentHealthpack = Sorted Array(Filtered Array(Global.HealthpackLocations, Is In Line of Sight(Event Player,
			Current Array Element, Barriers Do Not Block LOS) == True), Distance Between(Event Player, Current Array Element));
		Wait(Random Real(0.100, 0.300), Ignore Condition);
		Loop;
	}
}

