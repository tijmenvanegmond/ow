rule("Behavior: Hack")
{
	event
	{
		Ongoing - Each Player;
		All;
		Sombra;
	}

	conditions
	{
		Event Player.BotActive == True;
		Number Of Players On Objective(Team Of(Event Player)) > 0;
		Number Of Players On Objective(Opposite Team Of(Team Of(Event Player))) == 0;
		Is Game In Progress == True;
		Global.StartBots == True;
	}

	actions
	{
		Event Player.HackTargets = Sorted Array(Filtered Array(Global.HealthpackLocations, Array Contains(Global.HackedHealthpack,
			Current Array Element) == False), Distance Between(Event Player, Current Array Element));
		Event Player.CurrentGoToTarget = First Of(Event Player.HackTargets);
		Wait(Random Real(0.300, 1.500), Ignore Condition);
		Loop If Condition Is True;
		Event Player.CurrentGoToTarget = Objective Position(Objective Index);
	}
}

rule("1::AddHackedPointToList")
{
	event
	{
		Ongoing - Each Player;
		All;
		Sombra;
	}

	conditions
	{
		Is Firing Secondary(Event Player) == True;
		Event Player.BotActive == True;
		Event Player.CanSeeEnemy == False;
		Global.ServerLoadIsHigh == False;
		Event Player.CurrentHealthpack != Empty Array;
		Distance Between(Event Player, First Of(Event Player.CurrentHealthpack)) <= 7.777;
	}

	actions
	{
		Wait(0.500, Abort When False);
		Skip If(Team Of(Event Player) == Team 1, 1);
		Modify Global Variable(HackedHealthpack, Append To Array, First Of(Event Player.ClosestHealthpackPosition));
	}
}

