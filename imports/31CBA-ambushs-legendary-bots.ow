{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.HackedHealthpack != Empty Array;
	}

	actions
	{
		Wait(30, Ignore Condition);
		Modify Global Variable(HackedHealthpack, Remove From Array By Index, 0);
	}
}

