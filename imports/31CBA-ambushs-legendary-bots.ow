		Is In Line of Sight(Event Player, First Of(Event Player.CurrentTarget), Barriers Do Not Block LOS) == True;
		(Event Player.CurrentTarget != Empty Array) == True;
		Event Player.StopFacing == False;
	}

	actions
	{
