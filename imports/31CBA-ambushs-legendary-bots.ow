rule("Spawnpoints")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		If(Current Map == Map(Busan) && Current Game Mode == Game Mode(Control));
			Global.AA = Vector(-43.755, 18.427, -125.365);
			Global.ABC = Vector(139.947, 18.435, -124.747);
		End;
		If(Current Map == Map(Ilios) && Current Game Mode == Game Mode(Control));
			Global.AA = Vector(320.725, -21.519, 47.055);
			Global.ABC = Vector(262.167, -21.516, -96.858);
		End;
		If(Current Map == Map(Lijiang Tower) && Current Game Mode == Game Mode(Control));
			Global.AA = Vector(84.147, 5.783, -29.686);
			Global.ABC = Vector(-82.037, 5.771, -28.487);
		End;
		If(Current Map == Map(Nepal) && Current Game Mode == Game Mode(Control));
			Global.AA = Vector(-158.753, -94.545, -88.471);
			Global.ABC = Vector(-156.696, -94.537, 88.947);
		End;
		If(Current Map == Map(Oasis) && Current Game Mode == Game Mode(Control));
			Global.AA = Vector(66.438, 2.427, 322.563);
			Global.ABC = Vector(219.235, 2.426, 169.563);
		End;
		If(Current Map == Map(Ilios Lighthouse) && Current Game Mode == Game Mode(Elimination));
			Global.AA = Vector(234.271, -22.966, -105.518);
			Global.ABC = Vector(307.357, -22.800, 76.109);
		End;
		If(Current Map == Map(Lijiang Night Market) && Current Game Mode == Game Mode(Elimination));
			Global.AA = Vector(-117.335, 2.926, -26.203);
			Global.ABC = Vector(118.661, 2.927, -26.285);
		End;
		If(Current Map == Map(Lijiang Night Market Lunar New Year) && Current Game Mode == Game Mode(Elimination));
			Global.AA = Vector(-117.335, 2.926, -26.203);
			Global.ABC = Vector(118.661, 2.927, -26.285);
		End;
		If(Current Map == Map(Nepal Village) && Current Game Mode == Game Mode(Elimination));
			Global.AA = Vector(-139.783, -97.573, 116.633);
			Global.ABC = Vector(-139.203, -97.576, -115.279);
		End;
		If(Current Map == Map(Oasis City Center) && Current Game Mode == Game Mode(Elimination));
			Global.AA = Vector(66.438, 2.427, 322.563);
			Global.ABC = Vector(219.235, 2.426, 169.563);
		End;
		If(Current Map == Map(Ilios Lighthouse) && Current Game Mode == Game Mode(Capture the Flag));
			Global.AA = Vector(234.271, -22.966, -105.518);
			Global.ABC = Vector(307.357, -22.800, 76.109);
		End;
		If(Current Map == Map(Lijiang Night Market) && Current Game Mode == Game Mode(Capture the Flag));
			Global.AA = Vector(-117.335, 2.926, -26.203);
			Global.ABC = Vector(118.661, 2.927, -26.285);
		End;
		If(Current Map == Map(Lijiang Night Market Lunar New Year) && Current Game Mode == Game Mode(Capture the Flag));
			Global.AA = Vector(-117.335, 2.926, -26.203);
			Global.ABC = Vector(118.661, 2.927, -26.285);
		End;
		If(Current Map == Map(Nepal Village) && Current Game Mode == Game Mode(Capture the Flag));
			Global.AA = Vector(-139.783, -97.573, 116.633);
			Global.ABC = Vector(-139.203, -97.576, -115.279);
		End;
		If(Current Map == Map(Oasis City Center) && Current Game Mode == Game Mode(Capture the Flag));
			Global.AA = Vector(66.438, 2.427, 322.563);
			Global.ABC = Vector(219.235, 2.426, 169.563);
		End;
	}
}

