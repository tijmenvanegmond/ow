disabled rule("Display server performance characteristics")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), String("{0}: {1}", String("Server Load"), String("{0}%", Server Load)), Null, Null, Left,
			0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), String("{0}: {1}", String("Server Load Average"), String("{0}%", Server Load Average)),
			Null, Null, Left, 1, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), String("{0}: {1}", String("Server Load Peak"), String("{0}%", Server Load Peak)), Null,
			Null, Left, 2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
	}
}

rule("===== Change Bot Teams =====")
{
	event
	{
		Ongoing - Global;
	}
}

disabled rule("Custom Bot Teams - Enable/Disable Custom Bots Team 1")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Wait(32, Ignore Condition);
		Create Dummy Bot(Hero(Ana), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Echo), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Zarya), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Baptiste), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Hanzo), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Sigma), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
	}
}

disabled rule("Custom Bot Teams - Enable/Disable Custom Bots Team 2")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Wait(33, Ignore Condition);
		Create Dummy Bot(Hero(Ana), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Echo), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Roadhog), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Baptiste), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Genji), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Create Dummy Bot(Hero(Sigma), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
	}
}

rule("Game: Spawn Team 1 (change the Value in array to Hero if you want a specific Hero + enable the rule (copy it for more heroes))")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Wait(35, Ignore Condition);
		disabled Create Dummy Bot(Hero(Echo), Team 1, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Skip If(Global.GlobalTeamComp[0] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Tank Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[0] += 1;
		Skip If(Global.GlobalTeamComp[0] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Tank Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[0] += 1;
		Skip If(Global.GlobalTeamComp[2] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Damage Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[2] += 1;
		Skip If(Global.GlobalTeamComp[2] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Damage Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[2] += 1;
		Skip If(Global.GlobalTeamComp[4] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Support Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[4] += 1;
		Skip If(Global.GlobalTeamComp[4] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Support Heroes, Array Contains(Global.AllowedHeroesT1, Current Array Element) == True), Team 1,
			-1, Global.AA, Vector(0, 0, 0));
		Global.GlobalTeamComp[4] += 1;
		Modify Global Variable(AllowedHeroesT1, Remove From Array By Value, Hero Of(Last Created Entity));
	}
}

rule("Game: Spawn Team 2 (change the Value in array to Hero if you want a specific Hero + enable the rule (copy it for more heroes))")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Wait(37, Ignore Condition);
		disabled Create Dummy Bot(Hero(Echo), Team 2, -1, Vector(9999, 9999, 9999), Vector(0, 0, 0));
		Skip If(Global.GlobalTeamComp[1] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Tank Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[1] += 1;
		Skip If(Global.GlobalTeamComp[1] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Tank Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[1] += 1;
		Skip If(Global.GlobalTeamComp[3] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Damage Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[3] += 1;
		Skip If(Global.GlobalTeamComp[3] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Damage Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[3] += 1;
		Skip If(Global.GlobalTeamComp[5] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Support Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
		Global.GlobalTeamComp[5] += 1;
		Skip If(Global.GlobalTeamComp[5] >= 2, 3);
		Create Dummy Bot(Filtered Array(All Support Heroes, Array Contains(Global.AllowedHeroesT2, Current Array Element) == True), Team 2,
			-1, Global.ABC, Vector(0, 0, 0));
		Global.GlobalTeamComp[5] += 1;
		Modify Global Variable(AllowedHeroesT2, Remove From Array By Value, Hero Of(Last Created Entity));
	}
}

rule("Game: Replace Empty Slots Team 1")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Number Of Players(Team 1) != 6;
	}

	actions
	{
		Create Dummy Bot(Random Value In Array(Global.AllowedHeroesT1), Team 1, -1, Global.AA, Vector(0, 0, 0));
		Wait(Random Real(0.300, 1), Ignore Condition);
		Kill(Last Created Entity, Null);
		Loop If Condition Is True;
	}
}

rule("Game: Replace Empty Slots Team 2")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Number Of Players(Team 2) != 6;
	}

	actions
	{
		Create Dummy Bot(Random Value In Array(Global.AllowedHeroesT2), Team 2, -1, Global.ABC, Vector(0, 0, 0));
		Wait(Random Real(0.300, 1), Ignore Condition);
		Kill(Last Created Entity, Null);
		Loop If Condition Is True;
	}
}

rule("===== Bot Core (DONT CHANGE ANYTHING) =====")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Game: Prepare")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.GlobalTeamComp = Append To Array(Append To Array(Append To Array(Append To Array(Append To Array(Append To Array(
			Empty Array, 0), 0), 0), 0), 0), 0);
		Global.DummyBots = Empty Array;
		All Players(All Teams).BotActive = False;
	}
}

rule("Bot: CanHeal?")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		disabled (Hero Of(Event Player) == Hero(Ana) || Hero Of(Event Player) == Hero(Baptiste) || Hero Of(Event Player) == Hero(Mercy)) == True;
		(Hero Of(Event Player) == Hero(Ana) || Hero Of(Event Player) == Hero(Baptiste)) == True;
	}

	actions
	{
		Event Player.CanHeal = True;
	}
}

rule("Picked Hero is Tank")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Array Contains(All Tank Heroes, Hero Of(Event Player)) == True;
	}

	actions
	{
		Skip If(Team Of(Event Player) == Team 2, 1);
		Global.GlobalTeamComp[0] += 1;
		Skip If(Team Of(Event Player) == Team 1, 1);
		Global.GlobalTeamComp[1] += 1;
	}
}

rule("Picked Hero is Attack")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Array Contains(All Damage Heroes, Hero Of(Event Player)) == True;
	}

	actions
	{
		Skip If(Team Of(Event Player) == Team 2, 1);
		Global.GlobalTeamComp[2] += 1;
		Skip If(Team Of(Event Player) == Team 1, 1);
		Global.GlobalTeamComp[3] += 1;
	}
}

rule("Picked Hero is Support")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Array Contains(All Support Heroes, Hero Of(Event Player)) == True;
	}

	actions
	{
		Skip If(Team Of(Event Player) == Team 2, 1);
		Global.GlobalTeamComp[4] += 1;
		Skip If(Team Of(Event Player) == Team 1, 1);
		Global.GlobalTeamComp[5] += 1;
	}
}

rule("Bots dont play same hero as player T1")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Has Spawned(Event Player) == True;
		Is Game In Progress == False;
	}

	actions
	{
		Global.AllowedHeroesT1 = Remove From Array(Global.AllowedHeroesT1, Hero Of(Event Player));
	}
}

rule("Bots dont play same hero as player T2")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Has Spawned(Event Player) == True;
		Is Game In Progress == False;
	}

	actions
	{
		Global.AllowedHeroesT1 = Remove From Array(Global.AllowedHeroesT2, Hero Of(Event Player));
	}
}

disabled rule("===== CORE AI (DONT CHANGE ANYTHING!!! (IT COULD BREAK THE BOTS!!!)) =====")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Random Facing Direction")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Game In Progress == True;
		Event Player.BotActive == True;
		Is Alive(Event Player) == True;
	}

	actions
	{
		Event Player.RandomFacingDirection = Vector(Random Real(-300, 300), Random Real(-15, 15), Random Real(-300, 300));
		Wait(Random Real(0.100, 1), Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Stop Shoot")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Event Player.StopShoot == True;
	}

	actions
	{
		Stop Holding Button(Event Player, Button(Primary Fire));
		Stop Holding Button(Event Player, Button(Secondary Fire));
	}
}

rule("PlayerClosestToObjectiveCenter")
{
	event
	{
		Ongoing - Each Player;
		All;
		Zarya;
	}

	conditions
	{
		Is Game In Progress == True;
		Global.StartBots == True;
		Ultimate Charge Percent(Event Player) >= 90;
		Event Player.BotActive == True;
		Event Player.CanSeeEnemy == True;
	}

	actions
	{
		Event Player.PlayerClosestToObjectiveCenter = Sorted Array(Filtered Array(Filtered Array(All Players On Objective(Opposite Team Of(
			Team Of(Event Player))), Is In Line of Sight(Event Player, Current Array Element, Barriers Do Not Block LOS) == True),
			Distance Between(Current Array Element, Objective Position(Objective Index)) <= 3), Distance Between(Current Array Element,
			Objective Position(Objective Index)));
		Wait(Random Real(0.200, 0.600), Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Debug")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Is Game In Progress == True;
		Is In Spawn Room(Event Player) == True;
	}

	actions
	{
		Set Status(Event Player, Null, Rooted, 2);
		Skip If(Hero Of(Event Player) != Hero(Widowmaker), 1);
		Set Status(Event Player, Null, Rooted, 3);
		Skip If(Hero Of(Event Player) != Hero(Lúcio), 1);
		Event Player.LucioAuraMode = 1;
	}
}

rule("Server L")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Server Load > 230;
		Is Game In Progress == True;
	}

	actions
	{
		Global.ServerLoadIsHigh = True;
	}
}

rule("Server L")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Server Load <= 230;
		Is Game In Progress == True;
	}

	actions
	{
		Global.ServerLoadIsHigh = False;
	}
}

rule("Game: Fast Control unlock")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Is Control Mode Point Locked == True;
	}

	actions
	{
		Set Match Time(20);
	}
}

rule("Game: List Available Bots")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.AllowedHeroesT1 = All Heroes;
		Global.AllowedHeroesT2 = All Heroes;
	}
}

rule("Game: Start Bots")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Game In Progress == True;
		Event Player.BotActive == True;
		Is In Spawn Room(Event Player) == True;
	}

	actions
	{
		Wait(0.250, Ignore Condition);
		Global.StartBots = True;
		Event Player.CurrentWaypoint = 0;
	}
}

rule("Game: Stop Shoot")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.BotActive == True;
		Event Player.CanSeeEnemy == False;
		Hero Of(Event Player) != Hero(Mercy);
		Hero Of(Event Player) != Hero(Moira);
	}

	actions
	{
		Event Player.ChaseEnemy = False;
		Stop Holding Button(Event Player, Button(Primary Fire));
		Stop Holding Button(Event Player, Button(Jump));
		Stop Holding Button(Event Player, Button(Crouch));
		Skip If(Hero Of(Event Player) == Hero(Widowmaker) && Is Standing(Event Player) == True, 1);
		Stop Holding Button(Event Player, Button(Secondary Fire));
	}
}

rule("Game: Reset Spawn Room PV")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is In Spawn Room(Event Player) == True;
	}

	actions
	{
		Event Player.IndexNumber = 0;
		Event Player.RandomizedWaypointArray = Randomized Array(Global.J);
		Event Player.BrigitteBotRepairPackAmmo = 3;
		Event Player.BastionTurretMode = False;
		Event Player.DealtDamage = False;
		Event Player.TookDamage = False;
		Event Player.FocusDamagedAlly = False;
		Event Player.GotElimination = False;
		Event Player.StopAutomaticGoTo = False;
		Event Player.U = False;
		Event Player.T = False;
		Event Player.ClosestHealthpackPosition = Empty Array;
		Event Player.CurrentHealthpack = Empty Array;
		Event Player.TeleportLocation = Empty Array;
		Stop Holding Button(Event Player, Button(Secondary Fire));
		Event Player.VisibleTurretSpots = Empty Array;
		Event Player.PickedUpHealthpack = False;
		Event Player.LucioAuraMode = 1;
		Stop Holding Button(Event Player, Button(Jump));
		Stop Holding Button(Event Player, Button(Crouch));
		Stop Holding Button(Event Player, Button(Secondary Fire));
		Event Player.XX = False;
		Skip If(Hero Of(Event Player) != Hero(Zarya), 1);
		Event Player.CanHeal = True;
		Wait(0.250, Ignore Condition);
		Event Player.Bot_Waiting_Time = Random Real(0.200, 0.600);
		Event Player.Mercy_Rez = True;
		Event Player.Communicate = True;
	}
}

