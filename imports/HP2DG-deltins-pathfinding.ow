			Custom String(
			"⛎⛏⛐⛑⛒⛓⛔⛕⛖⛗⛘⛙⛚⛛⛜⛝⛞⛟⛠⛡⛢⛣⛤⛥⛦⛧⛨⛩⛪⛫⛬⛭⛮⛯⛰⛱⛲⛳⛴⛵⛶⛷⛸⛹⛺⛻⛼⛽⛾⛿✀✁✂✃✄✅✆✇✈✉✊✋✌✍✎✏✐✑✒✓✔✕✖✗✘✙✚✛✜✝✞✟✠✡✢✣✤✥✦✧✨✩✪✫✬✭✮✯✰✱✲✳✴✵✶✷✸✹✺✻✼✽✾✿❀❁❂❃❄❅❆❇❈❉❊❋❌❍"));
	}
}

rule("Decompress map")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.pfDecompress == True;
		Host Player == True;
	}

	actions
	{
		If(Count Of(Global.Nodes_Node_UniqueID));
			Abort;
		End;
		Global._extendedGlobalCollection[3] += 1;
		Call Subroutine(LoadCompressionTable);
		Global.i1 = 0;
		Global.i2 = 0;
		"Decompress nodes"
		For Global Variable(i1, 0, Count Of(First Of(Global.pfDecompress)), 1);
			For Global Variable(i2, 0, String Length(First Of(Global.pfDecompress)[Global.i1]), 3);
				Modify Global Variable(Nodes_Node_UniqueID, Append To Array, Count Of(Global.Nodes_Node_UniqueID));
				Modify Global Variable(Nodes_Node_Position, Append To Array, Vector((Index Of String Char(Host Player.compressionTable,
					Char In String(First Of(Global.pfDecompress)[Global.i1], Global.i2)) * 2 - 4096) / 10, (Index Of String Char(
					Host Player.compressionTable, Char In String(First Of(Global.pfDecompress)[Global.i1], Global.i2 + 1)) * 2 - 4096) / 10, (
					Index Of String Char(Host Player.compressionTable, Char In String(First Of(Global.pfDecompress)[Global.i1], Global.i2 + 2))
					* 2 - 4096) / 10));
				Modify Global Variable(Nodes_Selected, Append To Array, False);
				Wait(0.016, Ignore Condition);
			End;
		End;
		"Decompress neighbors"
		Global.decompressionState = 0;
		Global.currentNode = 0;
		Global.currentNeighbor = 0;
		For Global Variable(i1, 0, Count Of(Global.pfDecompress[1]), 1);
			For Global Variable(i2, 0, String Length(Global.pfDecompress[1][Global.i1]), 1);
				Global.next = Index Of String Char(Host Player.compressionTable, Char In String(Global.pfDecompress[1][Global.i1], Global.i2));
				"Next is the neighbor."
				If(Global.decompressionState == 0);
					"Current node is terminated."
					If(!Global.next);
						Global.currentNode += 1;
					"Next neighbor found."
					Else;
						Global.decompressionState = 1;
						Global.currentNeighbor = Global.next - 1;
						"In the compressed data, each node points to the relevant neighbor.\r\nThe editor is bi-directional so do not add neighbors of earlier nodes\r\nto prevent duplicate paths."
						If(Global.currentNode < Global.currentNeighbor);
							Modify Global Variable(Segments_ID, Append To Array, Count Of(Global.Segments_ID));
							Modify Global Variable(Segments_Node1, Append To Array, Global.currentNode);
							Modify Global Variable(Segments_Node2, Append To Array, Global.currentNeighbor);
						End;
					End;
				"Looking for attributes."
				Else If(Global.decompressionState == 1);
					"Current neighbor is terminated"
					If(!Global.next);
						Global.decompressionState = 0;
					"Next attribute located"
					Else;
						Modify Global Variable(Attributes_Value, Append To Array, Global.next - 1);
						Modify Global Variable(Attributes_ID, Append To Array, Count Of(Global.Attributes_Value));
						Modify Global Variable(Attributes_Node1, Append To Array, Global.currentNode);
						Modify Global Variable(Attributes_Node2, Append To Array, Global.currentNeighbor);
					End;
				End;
				If(!(Global.i2 % 20));
					Wait(0.016, Ignore Condition);
				End;
			End;
			Wait(0.016, Ignore Condition);
		End;
		Host Player.compressionTable = Null;
		Global.NodeUniqueID = Count Of(Global.Nodes_Node_UniqueID);
		Global.SegmentUniqueID = Count Of(Global.Segments_ID);
		Global.AttributeUniqueID = Count Of(Global.Attributes_Value);
		Global._extendedGlobalCollection[3] -= 1;
	}
}

rule("Subroutine: Remove node")
{
	event
	{
		Subroutine;
		RemoveNodeByIndex;
	}

	actions
	{
		Modify Global Variable(Nodes_Node_UniqueID, Remove From Array By Index, Global.index);
		Modify Global Variable(Nodes_Node_Position, Remove From Array By Index, Global.index);
		Modify Global Variable(Nodes_Selected, Remove From Array By Index, Global.index);
	}
}

