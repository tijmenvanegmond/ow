	{
		Global.Nodes_Selected[Global.SelectedNodeIndex] = !Global.Nodes_Selected[Global.SelectedNodeIndex];
	}
}

rule("Editor: Connect node")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		!Global._extendedGlobalCollection[3] == True;
		Is Button Held(Host Player, Button(Primary Fire)) == True;
		Global.editorState == 0;
		Global.SelectedNodeID != -1;
		!Host Player.cm_isInMenu == True;
	}

	actions
	{
		If(Global.connectingFromNode == Global.SelectedNodeIndex);
			Global.connectingFromNode = -1;
			Abort;
		Else If(Global.connectingFromNode != -1);
			If(!Global.attributeMode);
				If(Global.SelectedSegment != -1);
					Event Player.segment_ID = Global.Segments_ID[Global.SelectedSegment];
					Event Player.segment_Node1 = Global.Segments_Node1[Global.SelectedSegment];
					Event Player.segment_Node2 = Global.Segments_Node2[Global.SelectedSegment];
					Event Player.catalogItem_Set = Array(26, Null, Event Player.segment_ID, Event Player.segment_Node1, Event Player.segment_Node2);
					Event Player.catalogItem_Revert = Array(27, Null, Global.SelectedSegment, Event Player.segment_ID, Event Player.segment_Node1,
						Event Player.segment_Node2);
					Call Subroutine(Docment);
				Else;
					Global.SegmentUniqueID += 1;
					Event Player._extendedPlayerCollection[16] = Global.SegmentUniqueID;
					Event Player._extendedPlayerCollection[17] = Global.Nodes_Node_UniqueID[Global.connectingFromNode];
					Event Player._extendedPlayerCollection[18] = Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex];
					Event Player.catalogItem_Set = Array(28, Null, Event Player._extendedPlayerCollection[16],
						Event Player._extendedPlayerCollection[17], Event Player._extendedPlayerCollection[18]);
					Event Player.catalogItem_Revert = Array(29, Null, Event Player._extendedPlayerCollection[16]);
					Call Subroutine(Docment);
				End;
			Else;
				Event Player._extendedPlayerCollection[19] = Global.Nodes_Node_UniqueID[Global.connectingFromNode];
				Event Player._extendedPlayerCollection[20] = Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex];
				Event Player.existingAttributeIndex = Filtered Array(Mapped Array(Global.Attributes_Value, Current Array Index),
					Global.Attributes_Value[Current Array Element] == Global._extendedGlobalCollection[5] && Global.Attributes_Node1[Current Array Element] == Event Player._extendedPlayerCollection[19] && Global.Attributes_Node2[Current Array Element] == Event Player._extendedPlayerCollection[20]);
				If(Count Of(Event Player.existingAttributeIndex));
					Event Player.deleting = Array(Global.Attributes_Value[First Of(Event Player.existingAttributeIndex)],
						Global.Attributes_ID[First Of(Event Player.existingAttributeIndex)], Global.Attributes_Node1[First Of(
						Event Player.existingAttributeIndex)], Global.Attributes_Node2[First Of(Event Player.existingAttributeIndex)]);
					Event Player.catalogItem_Set = Array(30, Null, First Of(Event Player.existingAttributeIndex));
					Event Player.catalogItem_Revert = Array(31, Null, First Of(Event Player.existingAttributeIndex), Event Player.deleting);
					Call Subroutine(Docment);
				Else;
					Global.AttributeUniqueID += 1;
					Event Player._extendedPlayerCollection[21] = Global._extendedGlobalCollection[5];
					Event Player._extendedPlayerCollection[22] = Global.AttributeUniqueID;
					Event Player.catalogItem_Set = Array(32, Null, Event Player._extendedPlayerCollection[21],
						Event Player._extendedPlayerCollection[22], Event Player._extendedPlayerCollection[19],
						Event Player._extendedPlayerCollection[20]);
					Event Player.catalogItem_Revert = Array(33, Null, Event Player._extendedPlayerCollection[22]);
					Call Subroutine(Docment);
				End;
			End;
		End;
		Global.connectingFromNode = Global.SelectedNodeIndex;
	}
}

