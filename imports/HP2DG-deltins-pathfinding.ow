rule("Editor: Exit mirror editing mode")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.editorState != 2;
	}

	actions
	{
		Destroy Effect(Global._extendedGlobalCollection[37]);
		Destroy Effect(Global._extendedGlobalCollection[38]);
	}
}

rule("Close Popup Window")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.popupWindowVisible == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Event Player.releaseInteract = True;
		Event Player.popupWindowVisible = False;
		Disable Game Mode HUD(Event Player);
		Event Player.cm_isInMenu = True;
		Event Player.msgPages = Empty Array;
		Event Player.msgCurrentPage = 0;
		"Destroy hud texts."
		While(Count Of(Event Player.msgHudTexts));
			Destroy HUD Text(First Of(Event Player.msgHudTexts));
			Modify Player Variable(Event Player, msgHudTexts, Remove From Array By Index, 0);
		End;
		"Destroy progress texts."
		While(Count Of(Event Player.msgProgressTexts));
			Destroy Progress Bar HUD Text(First Of(Event Player.msgProgressTexts));
			Modify Player Variable(Event Player, msgProgressTexts, Remove From Array By Index, 0);
		End;
	}
}

rule("Subroutine: Display message")
{
	event
	{
		Subroutine;
		showMessage;
	}

	actions
	{
		Host Player.cm_isInMenu = False;
		Host Player.popupWindowVisible = True;
		If(Global.objectiveDescription != Null);
			Set Objective Description(Host Player, Global.objectiveDescription, Visible To and String);
			Enable Game Mode HUD(Host Player);
		End;
		"Destroy hud texts."
		While(Count Of(Event Player.msgHudTexts));
			Destroy HUD Text(First Of(Event Player.msgHudTexts));
			Modify Player Variable(Event Player, msgHudTexts, Remove From Array By Index, 0);
		End;
		"Destroy progress texts."
		While(Count Of(Event Player.msgProgressTexts));
			Destroy Progress Bar HUD Text(First Of(Event Player.msgProgressTexts));
			Modify Player Variable(Event Player, msgProgressTexts, Remove From Array By Index, 0);
		End;
		"Centers the black background to the center of the screen."
		Create HUD Text(Host Player, Null, Null, Custom String("{0}{0}{0}", Custom String("                                          ")),
			Left, -2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		"Centers the black background to the center of the screen."
		Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
		Create HUD Text(Host Player, Custom String("{0}{1}", Custom String(
			"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n{0}\n{1}\n                           ", Custom String(
			"                       Press   to close"), Custom String("")), Custom String("                           ")), Null, Null,
			Left, -1, Custom Color(255, 0, 255, 255), Color(White), Color(White), Visible To and String, Default Visibility);
		"The black background."
		Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
		Create HUD Text(Host Player, Null, Null, Custom String("{0}{0}{0}", Custom String("                                          ")),
			Right, -2, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		"Centers the black background to the center of the screen."
		Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
		Create HUD Text(Host Player, Custom String("{0}{1}", Custom String(
			"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n{0}\n{1}\n                           ", Custom String(
			"                      〔     F        〕"), Count Of(Event Player.msgPages) ? Custom String("{0}{1}", Custom String(
			"                         ← {0} 〔{1}/{2}", Input Binding String(Button(Ultimate)), Event Player.msgCurrentPage + 1, Count Of(
			Event Player.msgPages)), Custom String("〕 {0} →", Input Binding String(Button(Ability 2)))) : Custom String("")),
			Custom String("                           ")), Null, Null, Right, -1, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
		"The black background."
		Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
		Create HUD Text(Host Player, Null, Null, Custom String("\n "), Top, -1, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
		"Aligns the messages into the box."
		Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
		Global.i_1 = 0;
		For Global Variable(i_1, 0, Count Of(Global.lines_Type), 1);
			"Text"
			If(Global.lines_Type[Global.i_1] == 0);
				Create HUD Text(Host Player, Null, Null, First Of(Global.lines_Content[Global.i_1]), Top, Global.i_1 + 1, Color(White), Color(
					White), Global.lines_Content[Global.i_1][1], Visible To, Default Visibility);
				Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
			"Text with subheader"
			Else If(Global.lines_Type[Global.i_1] == 3);
				Create HUD Text(Host Player, Null, Global.lines_Content[Global.i_1][2], First Of(Global.lines_Content[Global.i_1]), Top,
					Global.i_1 + 1, Color(White), Global.lines_Content[Global.i_1][3], Global.lines_Content[Global.i_1][1], Visible To,
					Default Visibility);
				Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
			"Header"
			Else If(Global.lines_Type[Global.i_1] == 2);
				Create HUD Text(Host Player, First Of(Global.lines_Content[Global.i_1]), Null, Null, Top, Global.i_1 + 1,
					Global.lines_Content[Global.i_1][1], Color(White), Color(White), Visible To, Default Visibility);
				Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
			"Separator"
			Else If(Global.lines_Type[Global.i_1] == 1);
				Create Progress Bar HUD Text(Host Player, 100, First Of(Global.lines_Content[Global.i_1]), Top, Global.i_1 + 1, Custom Color(195,
					14, 150, 100), Global.lines_Content[Global.i_1][1], Visible To, Default Visibility);
				Modify Player Variable(Event Player, msgProgressTexts, Append To Array, Last Text ID);
			"Text with input"
			Else If(Global.lines_Type[Global.i_1] == 4);
				Create HUD Text(Host Player, Null, Null, Custom String("{0}: {1}", Input Binding String(Global.lines_Content[Evaluate Once(
					Global.i_1)][2]), First Of(Global.lines_Content[Evaluate Once(Global.i_1)])), Top, Global.i_1 + 1, Color(White), Color(White),
					Global.lines_Content[Global.i_1][1], Visible To and String, Default Visibility);
				Modify Player Variable(Event Player, msgHudTexts, Append To Array, Last Text ID);
			End;
		End;
	}
}

rule("Message Box: Next page")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.popupWindowVisible == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Event Player.msgCurrentPage < Count Of(Event Player.msgPages) - 1;
	}

	actions
	{
		Event Player.msgCurrentPage += 1;
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.msgPages[Event Player.msgCurrentPage]));
		Call Subroutine(func_group);
		Global.objectiveDescription = Null;
		Global.lines_Type = Global.lambdaValue_0;
		Global.lines_Content = Global.lambdaValue_1;
		Call Subroutine(showMessage);
	}
}

rule("Message Box: Previous page")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.popupWindowVisible == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Event Player.msgCurrentPage > 0;
	}

	actions
	{
		Event Player.msgCurrentPage -= 1;
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.msgPages[Event Player.msgCurrentPage]));
		Call Subroutine(func_group);
		Global.objectiveDescription = Null;
		Global.lines_Type = Global.lambdaValue_0;
		Global.lines_Content = Global.lambdaValue_1;
		Call Subroutine(showMessage);
	}
}

