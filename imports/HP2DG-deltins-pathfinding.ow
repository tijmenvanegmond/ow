				Global.lambdaParameter_0)] ? Color(Green) : Color(White);
		End;
		Global._arrayConstructor = Global._objectVariable_2[Global.actionScrollBar];
		Global._arrayConstructor[Last Of(Global.lambdaParameter_0)] = Global.actionsSelected[Last Of(Global.lambdaParameter_0)] ? Color(
