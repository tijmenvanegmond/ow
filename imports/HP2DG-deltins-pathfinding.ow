			Custom String("You can chase the pfDestination variable to another player's position to make the bot follow them."), Color(
			White)));
		Skip(11);
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		Skip(8);
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		Event Player.cm_isInMenu = False;
		Global.editorState = 2;
		Create Beam Effect(Global._extendedGlobalCollection[35] && !Global._extendedGlobalCollection[36] ? Host Player : Null,
			Moira Orb Heal Beam, Global._extendedGlobalCollection[35] + Vector(0, 0.500, 0), Ray Cast Hit Position(Eye Position(
			Host Player), Eye Position(Host Player) + Facing Direction Of(Host Player) * 100, Null, Null, False) + Vector(0, 0.500, 0),
			Team 2, Visible To Position Radius and Color);
		Global._extendedGlobalCollection[37] = Last Created Entity;
		Create Beam Effect(Global._extendedGlobalCollection[36] ? Host Player : Null, Moira Orb Heal Beam,
			Global._extendedGlobalCollection[35] + Vector(0, 0.500, 0), Global._extendedGlobalCollection[36] + Vector(0, 0.500, 0), Team 1,
			Visible To Position Radius and Color);
		Global._extendedGlobalCollection[38] = Last Created Entity;
		Modify Global Variable(lambdaParameter_0, Remove From Array By Index, Count Of(Global.lambdaParameter_0) - 1);
		Modify Global Variable(func_group, Remove From Array By Index, Count Of(Global.func_group) - 1);
	}
}

rule("Editor: tutorial")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(Host Player.cm_isInMenu ? Null : Host Player, Null, Null, Custom String(
			" \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n "), Right, 0, Color(White), Color(White), Color(White), Visible To,
			Default Visibility);
		Create HUD Text(!Host Player.cm_isInMenu && True ? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}",
			Global.editorState == 1 ? Custom String("Place dummy") : (Global.editorState == 2 ? (
			Global._extendedGlobalCollection[36] ? Custom String("Mirror map with drawn line") : (
			Global._extendedGlobalCollection[35] ? Custom String("Draw end of reflected line") : Custom String(
			"Draw start of reflection line"))) : (Global.SelectedPlayer != Null ? (Global.SelectedPlayer.dummySelected ? Custom String(
			"Unselect player") : Custom String("Select player")) : (Global.SelectedSegment != -1 ? (Global.attributeMode ? Custom String(
			"Connect attribute") : Custom String("Delete path")) : (Global.connectingFromNode != -1 && Global.SelectedNodeID != -1 ? (
			Global.connectingFromNode == Global.SelectedNodeIndex ? (Global.attributeMode ? Custom String("Cancel attribute")
			: Custom String("Cancel path")) : (Global.attributeMode ? Custom String("Connect Attribute") : Custom String("Link path"))) : (
			Global.connectingFromNode == -1 && Global.SelectedNodeID != -1 ? (Global.attributeMode ? Custom String("Create attribute")
			: Custom String("Create path")) : Custom String("Create node")))))), Input Binding String(Button(Primary Fire)), Custom String(
			"                                                        ")), Right, Global.controlTextOrder, Color(White), Color(White),
			Custom Color(255, 255, 255, 162.435), Visible To String and Color, Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && ((
			Global.editorState == 0 && Global.connectingFromNode != -1 && Global.SelectedNodeID == -1) || (Global.editorState == 1)
			|| Global.editorState == 2) ? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}", Global.editorState == 0 ? (
			Global.attributeMode ? Custom String("Cancel attribute") : Custom String("Cancel path")) : (Global.editorState == 2 ? (
			Global._extendedGlobalCollection[35] ? Custom String("undo line") : Custom String("cancel")) : Custom String("Cancel")),
			Input Binding String(Button(Secondary Fire)), Custom String("                                                        ")),
			Right, Global.controlTextOrder, Color(White), Color(White), Custom Color(255, 255, 255, 162.435), Visible To String and Color,
			Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && Global.editorState == 0 && Global.SelectedNodeIndex != -1 ? Host Player : Null, Null,
			Null, Custom String("{0}: {1}{2}{2}{2}{2}", Custom String("Destroy node"), Input Binding String(Button(Ultimate)),
			Custom String("                                                        ")), Right, Global.controlTextOrder, Color(White),
			Color(White), Custom Color(255, 255, 255, 162.435), Visible To String and Color, Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && (Global.connectingFromNode != -1 || Is True For Any(All Players(All Teams),
			Current Array Element.dummySelected)) ? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}",
			Global.connectingFromNode != -1 ? Custom String("Move node") : Custom String("Pathfind to cursor"), Input Binding String(
			Button(Reload)), Custom String("                                                        ")), Right, Global.controlTextOrder,
			Color(White), Color(White), Custom Color(255, 255, 255, 162.435), Visible To String and Color, Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && Is True For Any(All Players(All Teams), Current Array Element.dummySelected)
			? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}", Custom String("Destroy dummy bot"),
			Input Binding String(Button(Ultimate)), Custom String("                                                        ")), Right,
			Global.controlTextOrder, Color(White), Color(White), Custom Color(255, 255, 255, 162.435), Visible To String and Color,
			Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && Is True For Any(All Players(All Teams), Current Array Element.dummySelected)
			? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}", Custom String("Teleport to cursor"),
			Input Binding String(Button(Melee)), Custom String("                                                        ")), Right,
			Global.controlTextOrder, Color(White), Color(White), Custom Color(255, 255, 255, 162.435), Visible To String and Color,
			Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && Is True For Any(All Players(All Teams), Is Dummy Bot(Current Array Element))
			? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}", Is True For Any(All Players(All Teams), Is Dummy Bot(
			Current Array Element) && Current Array Element.dummySelected) ? Custom String("Unselect all bots") : Custom String(
			"Select all bots"), Input Binding String(Button(Ability 2)), Custom String(
			"                                                        ")), Right, Global.controlTextOrder, Color(White), Color(White),
			Custom Color(255, 255, 255, 162.435), Visible To String and Color, Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
		Create HUD Text(!Host Player.cm_isInMenu && True ? Host Player : Null, Null, Null, Custom String("{0}: {1}{2}{2}{2}{2}",
			Custom String("menu"), Input Binding String(Button(Interact)), Custom String(
			"                                                        ")), Right, Global.controlTextOrder, Color(White), Color(White),
			Custom Color(255, 255, 255, 162.435), Visible To String and Color, Default Visibility);
		Modify Global Variable(controlTexts, Append To Array, Last Text ID);
		Global.controlTextOrder += 1;
	}
}

rule("CM: Enable delete action button")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		Is True For Any(Global.actionsSelected, Current Array Element) == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[16])
			] = True;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[16])
			] = Color(Red);
	}
}

rule("CM: Disable delete action button")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		Is True For All(Global.actionsSelected, !Current Array Element) == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[16])
			] = False;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[16])
			] = Custom Color(252, 0, 0, 50.745);
	}
}

rule("CM: Enable Move Actions Up")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		Is True For Any(Global.actionsSelected, Current Array Element) == True;
		!First Of(Global.actionsSelected) == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[17])
			] = True;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[17])
			] = Color(White);
	}
}

rule("CM: Disable Move Actions Up")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		(First Of(Global.actionsSelected) || Is True For All(Global.actionsSelected, !Current Array Element)) == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[17])
			] = False;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[17])
			] = Color(Gray);
	}
}

rule("CM: Enable Move Actions Down")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		Is True For Any(Global.actionsSelected, Current Array Element) == True;
		!Global.actionsSelected[Count Of(Global.Rules_Actions_Data[Global.rulePage]) - 1] == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[18])
			] = True;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[18])
			] = Color(White);
	}
}

rule("CM: Disable Move Actions Down")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		First Of(Event Player._extendedPlayerCollection) == 3;
		Global._extendedGlobalCollection[21] == True;
		(Global.actionsSelected[Count Of(Global.Rules_Actions_Data[Global.rulePage]) - 1] || Is True For All(Global.actionsSelected,
			!Current Array Element)) == True;
	}

	actions
	{
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[18])
			] = False;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[18])
			] = Color(Gray);
	}
}