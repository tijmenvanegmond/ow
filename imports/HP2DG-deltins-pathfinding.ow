rule("Initial Player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	actions
	{
		Event Player._extendedPlayerCollection[7] = Empty Array;
		Event Player._extendedPlayerCollection[8] = True;
		Event Player.buttonCollectionMain = Empty Array;
		Event Player.historyItems_Set = Empty Array;
		Event Player.historyItems_Revert = Empty Array;
		Event Player.dummySavedOutlineState = -1;
		Event Player.msgHudTexts = Empty Array;
		Event Player.msgProgressTexts = Empty Array;
	}
}

rule("Enable inspector")
{
	event
	{
		Subroutine;
		EnableInspector;
	}

	actions
	{
		Global.inspector += 1;
		Enable Inspector Recording;
	}
}

rule("Setup: Inspector, Performance HUD, and Settings")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		If(!Workshop Setting Toggle(Custom String("Pathmap Editor"), Custom String("Enable inspector recording"), False, 1));
			Disable Inspector Recording;
		Else;
			Call Subroutine(EnableInspector);
		End;
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("{0}{1}", Custom String("cap: {0} {1} {2}", Server Load,
			Server Load Average, Server Load Peak), Custom String("\nposition: {0}\n{1}", Position Of(Host Player),
			Global.SelectedNodeIndex == -1 ? Custom String("") : Custom String("Selected node index: {0}", Global.SelectedNodeIndex))),
			Left, 0, Color(White), Color(White), Color(White), Visible To and String, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("{0} Remember to save often!", Icon String(Warning)), Left, 0,
			Color(White), Color(White), Color(Yellow), Visible To and String, Default Visibility);
		Set Objective Description(All Players(All Teams), Custom String(""), Visible To);
		Global._extendedGlobalCollection[0] = Workshop Setting Integer(Custom String("Pathmap Editor"), Custom String(
			"Undo history length"), 20, 0, 100, 0);
		Disable Built-In Game Mode Completion;
		Set Match Time(1);
		Pause Match Time;
	}
}

rule("Player init")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Is Dummy Bot(Event Player) == True;
	}

	actions
	{
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Melee));
		Disable Kill Feed(Event Player);
	}
}

rule("Preload nodes")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global._extendedGlobalCollection[39] = 0;
		Global._extendedGlobalCollection[39] = 0;
		While(Global._extendedGlobalCollection[39] < 20);
			Create Effect(Evaluate Once(Global._extendedGlobalCollection[39]) < Count Of(Host Player.renderingNodes) ? Host Player : Null,
				Sphere, Global.SelectedNodeID == Global.Nodes_Node_UniqueID[Host Player.renderingNodes[Evaluate Once(
				Global._extendedGlobalCollection[39])]] ? (Global.Nodes_Selected[Host Player.renderingNodes[Evaluate Once(
				Global._extendedGlobalCollection[39])]] ? Color(Turquoise) : Color(Blue)) : (
				Global.Nodes_Selected[Host Player.renderingNodes[Evaluate Once(Global._extendedGlobalCollection[39])]] ? Color(Lime Green)
				: Color(White)), Global.Nodes_Node_Position[Host Player.renderingNodes[Evaluate Once(Global._extendedGlobalCollection[39])
				]] + Vector(0, 1.300, 0), 0.300, Visible To Position Radius and Color);
			Global._extendedGlobalCollection[39] += 1;
		End;
		Global._extendedGlobalCollection[39] = 0;
		While(Global._extendedGlobalCollection[39] < 40);
			Create Beam Effect(Update Every Frame(Global.editorState != 0 || Global.attributeMode || Global.SelectedSegment != Evaluate Once(
				Global._extendedGlobalCollection[39]) || Total Time Elapsed % 1 < 0.500 ? All Players(All Teams) : Null),
				Brigitte Flail Chain Beam, Global.Nodes_Node_Position[Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Segments_Node1[Host Player.renderingSegments[Evaluate Once(Global._extendedGlobalCollection[39])]])] + Vector(0, 1.300,
				0), Global.Nodes_Node_Position[Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Segments_Node2[Host Player.renderingSegments[Evaluate Once(Global._extendedGlobalCollection[39])]])] + Vector(0, 1.300,
				0), Color(White), Visible To Position and Radius);
			Global._extendedGlobalCollection[39] += 1;
		End;
	}
}

rule("Subroutine: Update rendering segments")
{
	event
	{
		Subroutine;
		updateRenderingSegments;
	}

	actions
	{
		Global.x = Mapped Array(Array Slice(Host Player.renderingNodes, 0, 10), Global.Nodes_Node_UniqueID[Current Array Element]);
		Host Player.renderingSegments = Filtered Array(Mapped Array(Global.Segments_ID, Current Array Index), Array Contains(Global.x,
			Global.Segments_Node1[Current Array Element]) || Array Contains(Global.x, Global.Segments_Node2[Current Array Element]));
	}
}

rule("Subroutine: Update rendering nodes")
{
	event
	{
		Subroutine;
		updateRenderingNodes;
	}

	actions
	{
		Host Player.renderingNodes = Sorted Array(Mapped Array(Global.Nodes_Node_UniqueID, Current Array Index), Distance Between(
			Global.Nodes_Node_Position[Current Array Element], Host Player));
		Call Subroutine(updateRenderingSegments);
	}
}

rule("Update rendering nodes")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		!Global._extendedGlobalCollection[3] == True;
		Has Spawned(Event Player) == True;
		(!Event Player.lastUpdatePosition || Distance Between(Event Player.lastUpdatePosition, Host Player) > 10) == True;
	}

	actions
	{
		Event Player.lastUpdatePosition = Position Of(Host Player);
		Call Subroutine(updateRenderingNodes);
		Wait(3, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Snapshot")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		!Global.inspector == True;
		!Global._extendedGlobalCollection[3] == True;
	}

	actions
	{
		Enable Inspector Recording;
		"【◈ How to save & load ◈】\r\nClick the (x) button under the timeline.\r\n\r\n`                      ↓\r\n•-   ≡   □   □⃩    (x)\r\n\r\nSave the copied text into a text file. To load it, paste the contents into the first rule in the workshop editor."
		Disable Inspector Recording;
		Wait(5, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Main: Persistant Spawn")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Has Spawned(Host Player) == True;
		Global.savedPlayerLocation == True;
	}

	actions
	{
		Teleport(Host Player, Global.savedPlayerLocation);
		Set Facing(Host Player, Global.savedPlayerDirection, To World);
	}
}

rule("Subroutine: Update attribute visibility")
{
	event
	{
		Subroutine;
		UpdateAttributeVisibility;
	}

	actions
	{
		While(Count Of(Global.AttributeTexts));
			Destroy In-World Text(First Of(Global.AttributeTexts));
			Modify Global Variable(AttributeTexts, Remove From Array By Index, 0);
		End;
		Global._extendedGlobalCollection[40] = Global.SelectedNodeID != -1 ? Global.SelectedNodeID : (
			Global.connectingFromNode != -1 ? Global.Nodes_Node_UniqueID[Global.connectingFromNode] : -1);
		If(Global._extendedGlobalCollection[40] == -1);
			Skip(16);
		End;
		Global.attributeIndices = Filtered Array(Mapped Array(Global.Attributes_Value, Current Array Index),
			Global.Attributes_Node1[Current Array Element] == Global._extendedGlobalCollection[40] || Global.Attributes_Node2[Current Array Element] == Global._extendedGlobalCollection[40]);
		While(Count Of(Global.attributeIndices));
			Global.p1 = Global.Nodes_Node_Position[Index Of Array Value(Global.Nodes_Node_UniqueID, Global.Attributes_Node1[First Of(
				Global.attributeIndices)])] + Vector(0, 1.300, 0);
			Global.p2 = Global.Nodes_Node_Position[Index Of Array Value(Global.Nodes_Node_UniqueID, Global.Attributes_Node2[First Of(
				Global.attributeIndices)])] + Vector(0, 1.300, 0);
			Global.isSource = Global.Attributes_Node1[First Of(Global.attributeIndices)] == Global._extendedGlobalCollection[40];
			Global.group = Filtered Array(Global.attributeIndices, Global.Attributes_Node1[First Of(Global.attributeIndices)
				] == Global.Attributes_Node1[Current Array Element] && Global.Attributes_Node2[First Of(Global.attributeIndices)
				] == Global.Attributes_Node2[Current Array Element]);
			Modify Global Variable(attributeIndices, Remove From Array By Value, Global.group);
			Global._extendedGlobalCollection[41] = Custom String("");
			While(Count Of(Global.group));
				Global._extendedGlobalCollection[41] = Custom String(" {0}\n{1}{2}{1}", Global._extendedGlobalCollection[41],
					Global.isSource ? Custom String("◈") : Custom String(""), Global.Attributes_Value[First Of(Global.group)]);
				Modify Global Variable(group, Remove From Array By Index, 0);
			End;
			Create In-World Text(All Players(All Teams), Global._extendedGlobalCollection[41], Global.p1 + (Global.p2 - Global.p1) * 0.300,
				2.500, Do Not Clip, Visible To, Global.isSource ? Color(Sky Blue) : Custom Color(255, 115, 0, 100), Default Visibility);
			Modify Global Variable(AttributeTexts, Append To Array, Last Text ID);
		End;
	}
}

rule("Main: Selection loop")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Has Spawned(Host Player) == True;
		!Host Player.cm_isInMenu == True;
		!Host Player.popupWindowVisible == True;
		!Global._extendedGlobalCollection[3] == True;
		(Global.savedPlayerLocation != Position Of(Host Player) || Global.savedPlayerDirection != Facing Direction Of(Host Player))
			== True;
		(Count Of(Global.Nodes_Node_UniqueID) || Is True For Any(All Players(All Teams), Is Dummy Bot(Current Array Element))) == True;
	}

	actions
	{
		Global.savedPlayerLocation = Position Of(Host Player);
		Global.savedPlayerDirection = Facing Direction Of(Host Player);
		All Players(All Teams).dummyHighlighted = False;
		Global.SelectedPlayer = Ray Cast Hit Player(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(Host Player)
			* 100, All Players(All Teams), Host Player, False);
		Global.SelectedPlayer.dummyHighlighted = True;
		Global.SelectedNodeIndex = First Of(Append To Array(Filtered Array(Sorted Array(Mapped Array(Global.Nodes_Node_UniqueID,
			Current Array Index), Distance Between(Global.Nodes_Node_Position[Current Array Element] + Vector(0, 1.300, 0), Eye Position(
			Host Player))), Distance Between(Global.Nodes_Node_Position[Current Array Element] + Vector(0, 1.300, 0), Eye Position(
			Host Player) + Facing Direction Of(Host Player) * Distance Between(Global.Nodes_Node_Position[Current Array Element] + Vector(
			0, 1.300, 0), Eye Position(Host Player))) < 0.300), -1));
		If(Global.SelectedPlayer != Null && Global.SelectedNodeIndex != -1);
			If(Distance Between(Global.Nodes_Node_Position[Global.SelectedNodeIndex] + Vector(0, 1.300, 0), Eye Position(Host Player))
				> Distance Between(Position Of(Global.SelectedPlayer), Eye Position(Host Player)));
				Global.SelectedNodeIndex = -1;
			Else;
				Global.SelectedPlayer = Null;
			End;
		End;
		Global.previouslySelectedNodeID = Global.SelectedNodeID;
		If(Global.SelectedNodeIndex == -1);
			Global.SelectedNodeID = -1;
		Else;
			Global.SelectedNodeID = Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex];
		End;
		If(Global.previouslySelectedNodeID != Global.SelectedNodeID);
			Call Subroutine(UpdateAttributeVisibility);
			If(Global.connectingFromNode == -1 || Global.SelectedNodeID == -1);
				Global.SelectedSegment = -1;
			Else;
				Global._extendedGlobalCollection[42] = Filtered Array(Mapped Array(Global.Segments_ID, Current Array Index), (
					Global.Segments_Node1[Current Array Element] == Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex] && Global.Segments_Node2[Current Array Element] == Global.Nodes_Node_UniqueID[Global.connectingFromNode])
					|| (
					Global.Segments_Node2[Current Array Element] == Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex] && Global.Segments_Node1[Current Array Element] == Global.Nodes_Node_UniqueID[Global.connectingFromNode]));
				Global.SelectedSegment = Global._extendedGlobalCollection[42] == Empty Array ? -1 : First Of(Global._extendedGlobalCollection[42]);
			End;
		End;
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Release primary")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
