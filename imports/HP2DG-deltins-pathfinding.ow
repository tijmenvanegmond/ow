rule("Editor: path mode enter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		!Global.attributeMode == True;
		Global.editorState == 0;
	}

	actions
	{
		Call Subroutine(DestroyConnectionBeams);
		Destroy Effect(Global._extendedGlobalCollection[6]);
		Destroy Effect(Global._extendedGlobalCollection[7]);
		Create Beam Effect(Update Every Frame(
			Global.SelectedSegment == -1 && Global.connectingFromNode != -1 && Global.SelectedNodeID != -1 ? All Players(All Teams)
			: Null), Torbjörn Turret Sight Beam, Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0),
			Global.Nodes_Node_Position[Global.SelectedNodeIndex] + Vector(0, 1.300, 0), Color(Team 1),
			Visible To Position Radius and Color);
		Global._extendedGlobalCollection[6] = Last Created Entity;
		Create Beam Effect(Update Every Frame(
			Global.SelectedSegment == -1 && Global.connectingFromNode != -1 && Global.SelectedNodeID == -1 ? All Players(All Teams)
			: Null), Torbjörn Turret Sight Beam, Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0),
			Update Every Frame(Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(
			Host Player) * 100, Null, Null, False)), Color(Team 2), Visible To Position Radius and Color);
		Global._extendedGlobalCollection[7] = Last Created Entity;
	}
}

rule("Editor: attribute mode enter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.attributeMode == True;
		Global.editorState == 0;
	}

	actions
	{
		Call Subroutine(DestroyConnectionBeams);
		Destroy Effect(Global._extendedGlobalCollection[6]);
		Destroy Effect(Global._extendedGlobalCollection[7]);
		Create Beam Effect(Update Every Frame(True && Global.connectingFromNode != -1 && Global.SelectedNodeID != -1 ? All Players(
			All Teams) : Null), Symmetra Turret Beam, Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0),
			Global.Nodes_Node_Position[Global.SelectedNodeIndex] + Vector(0, 1.300, 0), Color(Team 1),
			Visible To Position Radius and Color);
		Global._extendedGlobalCollection[6] = Last Created Entity;
		Create Beam Effect(Update Every Frame(True && Global.connectingFromNode != -1 && Global.SelectedNodeID == -1 ? All Players(
			All Teams) : Null), Symmetra Turret Beam, Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0),
			Update Every Frame(Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(
			Host Player) * 100, Null, Null, False)), Color(Team 2), Visible To Position Radius and Color);
		Global._extendedGlobalCollection[7] = Last Created Entity;
		Create In-World Text(Global.connectingFromNode != -1 && Global.connectingFromNode != Global.SelectedNodeIndex ? All Players(
			All Teams) : Null, Custom String(" \n{0}", Global._extendedGlobalCollection[5]),
			Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0) - Vector(Empty Array, 0.300, Empty Array) + ((
			Global.SelectedNodeID == -1 ? Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(
			Host Player) * 100, Null, Null, False) : Global.Nodes_Node_Position[Global.SelectedNodeIndex] + Vector(0, 1.300, 0)) - (
			Global.Nodes_Node_Position[Global.connectingFromNode] + Vector(0, 1.300, 0))) * 0.300, 2.500, Do Not Clip,
			Visible To Position String and Color, Global.SelectedNodeID == -1 ? Color(Red) : Color(Blue), Default Visibility);
		Global._extendedGlobalCollection[8] = Last Text ID;
	}
}

rule("(Subroutine) Doc Undoable Action")
{
	event
	{
		Subroutine;
		Docment;
	}

	actions
	{
		While(Count Of(Event Player.historyItems_Set) > Event Player.historyPage);
			Modify Player Variable(Event Player, historyItems_Set, Remove From Array By Index, Event Player.historyPage);
			Modify Player Variable(Event Player, historyItems_Revert, Remove From Array By Index, Event Player.historyPage);
		End;
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.catalogItem_Set));
		Call Subroutine(func_group);
		Modify Player Variable(Event Player, historyItems_Set, Append To Array, Array(Event Player.catalogItem_Set));
		Modify Player Variable(Event Player, historyItems_Revert, Append To Array, Array(Event Player.catalogItem_Revert));
		If(Event Player.historyPage == First Of(Global._extendedGlobalCollection));
			Modify Player Variable(Event Player, historyItems_Set, Remove From Array By Index, 0);
			Modify Player Variable(Event Player, historyItems_Revert, Remove From Array By Index, 0);
		Else;
			Event Player.historyPage += 1;
		End;
		Call Subroutine(UpdateUndoInteractability);
	}
}

rule("Editor: Place node")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		!Global._extendedGlobalCollection[3] == True;
		Is Button Held(Host Player, Button(Primary Fire)) == True;
		Global.editorState == 0;
		Global.SelectedNodeID == -1;
		Global.SelectedPlayer == Null;
		!Host Player.releasePrimary == True;
		!Host Player.cm_isInMenu == True;
	}

	actions
	{
		Event Player.pos = Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(Host Player)
			* 100, Null, Null, False);
		"Do not place the node if there are any other close nodes."
		If(Is True For Any(Global.Nodes_Node_UniqueID, Distance Between(Global.Nodes_Node_Position[Current Array Index], Event Player.pos)
			< 0.750));
			Abort;
		End;
		Global.NodeUniqueID += 1;
		Event Player.id = Global.NodeUniqueID;
		Event Player.catalogItem_Set = Array(22, Null, Event Player.pos, Event Player.id);
		Event Player.catalogItem_Revert = Array(23, Null, Event Player.id);
		Call Subroutine(Docment);
	}
}

rule("Editor: Delete node")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		!Global._extendedGlobalCollection[3] == True;
		Is Button Held(Host Player, Button(Ultimate)) == True;
		Global.editorState == 0;
		Global.SelectedNodeID != -1;
		!Host Player.cm_isInMenu == True;
	}

	actions
	{
		Event Player.deleteNode_UniqueID = Global.Nodes_Node_UniqueID[Global.SelectedNodeIndex];
		Event Player.deleteNode_Position = Global.Nodes_Node_Position[Global.SelectedNodeIndex];
		Event Player.deleteSegments = Filtered Array(Mapped Array(Global.Segments_ID, Array(Current Array Index, Current Array Element,
			Global.Segments_Node1[Current Array Index], Global.Segments_Node2[Current Array Index])),
			Global.Segments_Node1[Current Array Index] == Event Player.deleteNode_UniqueID || Global.Segments_Node2[Current Array Index] == Event Player.deleteNode_UniqueID);
		Event Player.deleteAttributes = Filtered Array(Mapped Array(Global.Attributes_ID, Array(Current Array Index, Current Array Element,
			Global.Attributes_Node1[Current Array Index], Global.Attributes_Node2[Current Array Index],
			Global.Attributes_Value[Current Array Index])),
			Current Array Element[2] == Event Player.deleteNode_UniqueID || Current Array Element[3] == Event Player.deleteNode_UniqueID);
		Event Player.catalogItem_Set = Array(24, Null, Event Player.deleteSegments, Event Player.deleteAttributes,
			Global.SelectedNodeIndex);
		Event Player.catalogItem_Revert = Array(25, Null, Global.SelectedNodeIndex, Event Player.deleteNode_UniqueID,
			Event Player.deleteNode_Position, Event Player.deleteSegments, Event Player.deleteAttributes);
		Call Subroutine(Docment);
	}
}

rule("Editor: Select node")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		!Global._extendedGlobalCollection[3] == True;
		Is Button Held(Host Player, Button(Secondary Fire)) == True;
		Global.editorState == 0;
		Global.SelectedNodeID != -1;
		!Host Player.cm_isInMenu == True;
