rule("(Subroutine) dispose scrollbar")
{
	event
	{
		Subroutine;
		Dispose;
	}

	actions
	{
		Global.destroy = Global._objectVariable_4[Global.DisposeStack];
		For Global Variable(i, 0, Count Of(Global.destroy), 1);
			If(Global.destroy[Global.i] != -1);
				Global.buttonID = Global.destroy[Global.i];
				Call Subroutine(DestroyButton);
			End;
		End;
		Global.buttonID = Global._objectVariable_5[Global.DisposeStack];
		Call Subroutine(DestroyButton);
		Global.buttonID = Global._objectVariable_6[Global.DisposeStack];
		Call Subroutine(DestroyButton);
		If(Global.DisposeStack);
			Global._classIndexes[Global.DisposeStack] = 0;
			Global._objectVariable_0[Global.DisposeStack] = 0;
			Global._objectVariable_1[Global.DisposeStack] = 0;
			Global._objectVariable_2[Global.DisposeStack] = 0;
			Global._objectVariable_3[Global.DisposeStack] = 0;
			Global._objectVariable_4[Global.DisposeStack] = 0;
			Global._objectVariable_5[Global.DisposeStack] = 0;
			Global._objectVariable_6[Global.DisposeStack] = 0;
			Global._objectVariable_7[Global.DisposeStack] = 0;
			Global._objectVariable_8[Global.DisposeStack] = 0;
			Global._objectVariable_9[Global.DisposeStack] = 0;
		Else;
			Log To Inspector(Custom String("[Error] Attempted to delete invalid reference in scroll menu.del at line 164"));
		End;
	}
}

rule("CM: Update undo interactability")
{
	event
	{
		Subroutine;
		UpdateUndoInteractability;
	}

	actions
	{
		If(Global._extendedGlobalCollection[1] != -1);
			Global._extendedGlobalCollection[43] = Index Of Array Value(Host Player.cm_buttons_ID, Global._extendedGlobalCollection[1]);
			Host Player.cm_buttons_Interactable[Global._extendedGlobalCollection[43]] = Event Player.historyPage > 0;
			Host Player.cm_buttons_DefaultColor[Global._extendedGlobalCollection[43]] = Event Player.historyPage > 0 ? Color(Aqua) : Color(
				Gray);
			Global._extendedGlobalCollection[44] = Index Of Array Value(Host Player.cm_buttons_ID, Global._extendedGlobalCollection[2]);
			Host Player.cm_buttons_Interactable[Global._extendedGlobalCollection[44]] = Event Player.historyPage < Count Of(
				Event Player.historyItems_Set);
			Host Player.cm_buttons_DefaultColor[Global._extendedGlobalCollection[44]] = Event Player.historyPage < Count Of(
				Event Player.historyItems_Set) ? Color(Yellow) : Color(Gray);
		End;
	}
}

