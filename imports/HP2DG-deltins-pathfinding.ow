rule("Subroutine: Open Add Action menu")
{
	event
	{
		Subroutine;
		OpenActionSelectMenu;
	}

	actions
	{
		Global.newState = 4;
		Call Subroutine(SetMenuState);
		Global.actionScrollBar = Index Of Array Value(Global._classIndexes, 0);
		Global.actionScrollBar = Global.actionScrollBar == -1 ? Count Of(Global._classIndexes) : Global.actionScrollBar;
		Global._classIndexes[Global.actionScrollBar] = 2;
		Global._objectVariable_1[Global.actionScrollBar] = 0;
		Global._objectVariable_0[Global.actionScrollBar] = 0.750;
		Global._objectVariable_3[Global.actionScrollBar] = Host Player._extendedPlayerCollection[11];
		Global._objectVariable_2[Global.actionScrollBar] = Mapped Array(Global._objectVariable_3[Global.actionScrollBar], Color(White));
		Global._objectVariable_4[Global.actionScrollBar] = Mapped Array(Global._objectVariable_3[Global.actionScrollBar], -1);
		Global._objectVariable_9[Global.actionScrollBar] = Array(44, Null);
		Global._objectVariable_7[Global.actionScrollBar] = 8;
		Global.input = Array(Custom String("↑"), Array(18, Global.actionScrollBar, 1), Array(18, Global.actionScrollBar, 8), 0, 0.750,
			0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_5[Global.actionScrollBar] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Custom String("↓"), Array(19, Global.actionScrollBar, 1), Array(19, Global.actionScrollBar, 8), 0, -0.825,
			0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_6[Global.actionScrollBar] = Global.returnValue___createButtonSubrou;
		Global.UpdateStack = Global.actionScrollBar;
		Call Subroutine(Update);
	}
}

