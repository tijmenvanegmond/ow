				[5][Global.waitlessI])), Array(Last Of(Global.func_group)[5][Global.waitlessI][1])), Array Slice(Global.Segments_ID, First Of(
				Last Of(Global.func_group)[5][Global.waitlessI]), 999));
			Global.Segments_Node1 = Append To Array(Append To Array(Array Slice(Global.Segments_Node1, 0, First Of(Last Of(Global.func_group)
				[5][Global.waitlessI])), Array(Last Of(Global.func_group)[5][Global.waitlessI][2])), Array Slice(Global.Segments_Node1,
				First Of(Last Of(Global.func_group)[5][Global.waitlessI]), 999));
			Global.Segments_Node2 = Append To Array(Append To Array(Array Slice(Global.Segments_Node2, 0, First Of(Last Of(Global.func_group)
				[5][Global.waitlessI])), Array(Last Of(Global.func_group)[5][Global.waitlessI][3])), Array Slice(Global.Segments_Node2,
				First Of(Last Of(Global.func_group)[5][Global.waitlessI]), 999));
		End;
		"Insert deleted attributes"
		For Global Variable(waitlessI, 0, Count Of(Last Of(Global.func_group)[6]), 1);
			Global.Attributes_Value = Append To Array(Append To Array(Array Slice(Global.Attributes_Value, 0, First Of(Last Of(
				Global.func_group)[6][Global.waitlessI])), Array(Last Of(Global.func_group)[6][Global.waitlessI][4])), Array Slice(
				Global.Attributes_Value, First Of(Last Of(Global.func_group)[6][Global.waitlessI]), 999));
			Global.Attributes_ID = Append To Array(Append To Array(Array Slice(Global.Attributes_ID, 0, First Of(Last Of(Global.func_group)
				[6][Global.waitlessI])), Array(Last Of(Global.func_group)[6][Global.waitlessI][1])), Array Slice(Global.Attributes_ID,
				First Of(Last Of(Global.func_group)[6][Global.waitlessI]), 999));
			Global.Attributes_Node1 = Append To Array(Append To Array(Array Slice(Global.Attributes_Node1, 0, First Of(Last Of(
