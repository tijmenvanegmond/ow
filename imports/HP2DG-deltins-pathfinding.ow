rule("CM: Make buttons: Main")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
	}

	actions
	{
		For Player Variable(Event Player, b, 0, 2, 1);
			Event Player._extendedPlayerCollection[13] = Custom String("");
			For Player Variable(Event Player, c, 0, 13, 1);
				Event Player._extendedPlayerCollection[13] = Custom String("{0}{1}", Event Player._extendedPlayerCollection[13], Custom String(
					"▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒\n"));
				Wait(0.016, Ignore Condition);
			End;
			Global.input = Array(Event Player._extendedPlayerCollection[13], 0, 0, 0, -0.900 - Event Player.b * 0.100, 0.200, 0.200,
				Custom Color(1, 1, 1, 0.500), Color(Blue), False, True);
			Call Subroutine(__createButtonSubroutine);
			Modify Player Variable At Index(Event Player, _extendedPlayerCollection, 7, Append To Array,
				Global.returnValue___createButtonSubrou);
		End;
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		Global.input = Array(Custom String("main"), 0, 0, 0, 1.150, 0.200, 0.200, Color(Gray), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Event Player._extendedPlayerCollection[6] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Custom String("back"), 1, 0, -2, 1, 0.400, 0.200, Color(Red), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global.input = Array(Custom String("▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒"), 0, 0, 0, 1.375, 0.200, 0.200, Color(Black), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global.input = Array(Custom String("♡              ♡"), 0, 0, 0, 1.375, 0.200, 0.200, Color(Red), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global.input = Array(Custom String("ｈ  ｐ  ／  ｏ  ｉ  ｏ   ｄ  ｔ\n               "), 0, 0, 0.150, 1.205, 0.200, 0.200, Color(White),
			Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global.input = Array(Custom String("ｔ  ｓ  ／  －   ．  ｍ  ｅ  ｉ\n               "), 0, 0, 0.230, 1.205, 0.200, 0.200, Color(White),
			Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global.input = Array(Custom String("ｔ  ：  ｋ  ｆ ｃ    ／  ｌ  ｎ\n               "), 0, 0, 0.310, 1.205, 0.200, 0.200, Color(White),
			Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
	}
}

rule("CM: Freecam increment")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 2;
	}

	actions
	{
		Global.IsNoclipping = !Global.IsNoclipping;
		Call Subroutine(updateFreecamLabel);
	}
}

rule("CM: Undo")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 4;
		Event Player.historyPage > 0;
	}

	actions
	{
		Event Player.historyPage -= 1;
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.historyItems_Revert[Event Player.historyPage]));
		Call Subroutine(func_group);
		Call Subroutine(UpdateUndoInteractability);
	}
}

rule("CM: Redo")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 5;
		Event Player.historyPage < Count Of(Event Player.historyItems_Set);
	}

	actions
	{
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.historyItems_Set[Event Player.historyPage]));
		Call Subroutine(func_group);
		Event Player.historyPage += 1;
		Call Subroutine(UpdateUndoInteractability);
	}
}

rule("CM: Change link mode")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 6;
	}

	actions
	{
		Global.attributeMode = !Global.attributeMode;
	}
}

rule("(Subroutine) CM: Choose hero")
{
	event
	{
		Subroutine;
		chooseHeroMenu;
	}

	actions
	{
		Global.newState = 2;
		Call Subroutine(SetMenuState);
		For Player Variable(Event Player, i, 0, Count Of(All Heroes), 1);
			Global.input = Array(Hero Icon String(All Heroes[Event Player.i]), Array(12, All Heroes[Event Player.i]), 0,
				-2 + Event Player.i % 13 / 3, 0.500 - Round To Integer(Event Player.i / 13, Down) / 2, 0.200, 0.200, Color(White), Color(Blue),
				True, True);
			Call Subroutine(__createButtonSubroutine);
			Modify Player Variable(Event Player, buttonCollectionMain, Append To Array, Global.returnValue___createButtonSubrou);
		End;
		Global._extendedGlobalCollection[4] = Event Player.callback;
	}
}

rule("CM: Add dummy")
{
