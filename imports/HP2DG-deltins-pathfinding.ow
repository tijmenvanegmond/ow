	{
		"If there are any disabled heroes, then turn the switch on.\r\nOtherwise, turn it off."
		Global.Rules_EnabledHeroes[Global.rulePage] = Array(!First Of(Global.Rules_EnabledHeroes[Global.rulePage]) || Count Of(
			Global.Rules_EnabledHeroes[Global.rulePage]) > 1);
		Call Subroutine(updateAllHeroIcons);
