rule("CM: Update rule content")
{
	event
	{
		Subroutine;
		updateRuleContent;
	}

	actions
	{
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[13])
			] = Custom String("{0}{1}", Custom String("rule "), Global.rulePage + 1);
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[14])
			] = Global.rulePage != 0;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[14])
			] = Global.rulePage != 0 ? Color(White) : Color(Gray);
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[15])
			] = Global.rulePage < Count Of(Global.Rules_Actions_Data) - 1;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[15])
			] = Global.rulePage < Count Of(Global.Rules_Actions_Data) - 1 ? Color(White) : Color(Gray);
		If(First Of(Event Player._extendedPlayerCollection) == 3);
			If(Global.actionScrollBar);
				Global.DisposeStack = Global.actionScrollBar;
				Call Subroutine(Dispose);
				Global.actionScrollBar = Null;
			End;
			Call Subroutine(loadActionScrollbar);
		End;
		If(Global.ruleAttributeSelector != Null);
			Global._objectVariable_0[Global.ruleAttributeSelector] = Global.Rules_ExecutesOnAttribute[Global.rulePage];
			Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID,
				Global._objectVariable_1[Global.ruleAttributeSelector])] = Custom String(" {0} ",
				Global._objectVariable_0[Global.ruleAttributeSelector]);
			Modify Global Variable(lambdaParameter_0, Append To Array, Array(Global._objectVariable_0[Global.ruleAttributeSelector]));
			Modify Global Variable(func_group, Append To Array, Array(Global._objectVariable_4[Global.ruleAttributeSelector]));
			Call Subroutine(func_group);
		End;
		Call Subroutine(updateAllHeroIcons);
	}
}

