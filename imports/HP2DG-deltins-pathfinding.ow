rule("CM: Wait time")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(
			Event Player.cm_currActionID == 22 || Event Player.cm_currActionID == 21 || Event Player.cm_currActionID == 24 || Event Player.cm_currActionID == 23)
			== True;
	}

	actions
	{
		If(Event Player.cm_currActionID == 22);
			Global._extendedGlobalCollection[19] -= 0.020;
		Else If(Event Player.cm_currActionID == 21);
			Global._extendedGlobalCollection[19] += 0.020;
		Else If(Event Player.cm_currActionID == 24);
			Global._extendedGlobalCollection[19] -= 0.100;
		Else If(Event Player.cm_currActionID == 23);
			Global._extendedGlobalCollection[19] += 0.100;
		End;
		Modify Global Variable At Index(_extendedGlobalCollection, 19, Max, 0.020);
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[20])
			] = Custom String("{0}{1}{2}", Custom String("wait time: "), Global._extendedGlobalCollection[19], Custom String(" seconds"));
	}
}

rule("CM: Wait confirm")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 25;
	}

	actions
	{
		Event Player._extendedPlayerCollection[31] = Global.rulePage;
		Event Player.catalogItem_Set = Array(42, Null, Event Player._extendedPlayerCollection[31], Array(0,
			Global._extendedGlobalCollection[19]));
		Event Player.catalogItem_Revert = Array(43, Null, Event Player._extendedPlayerCollection[31]);
		Call Subroutine(Docment);
		Global.newState = 3;
		Call Subroutine(SetMenuState);
	}
}

rule("CM: Toggle all")
{
