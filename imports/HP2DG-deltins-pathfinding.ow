			Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(Host Player) * 100, Null,
			Null, False));
	}
}

rule("Subroutine: Dijkstra")
{
	event
	{
		Subroutine;
		Dijkstra;
	}

	actions
	{
		If(Global._extendedGlobalCollection[12]);
			Log To Inspector(Custom String("Error: Attempted to pathfind while already active"));
			Event Player.returnValue_Dijkstra_Parents = Null;
			Skip(30);
		End;
		Global._extendedGlobalCollection[12] = True;
		Global.dijkstraProgressReport = 0;
		Event Player.unvisited = Mapped Array(Global.Nodes_Node_UniqueID, Current Array Index);
		Event Player.distances = Mapped Array(Event Player.unvisited, 9999);
		Event Player.parents = Mapped Array(Event Player.unvisited, -1);
		Event Player.distances[Event Player.source_0] = 0;
		While(True);
			Skip If(!(Count Of(Event Player.unvisited) && (Event Player.targets == Null || Is True For Any(Event Player.targets,
				Array Contains(Event Player.unvisited, Current Array Element)))), 19);
			Event Player.current = First Of(Sorted Array(Event Player.unvisited, Event Player.distances[Current Array Element]));
			Event Player.currentID = Global.Nodes_Node_UniqueID[Event Player.current];
			Modify Player Variable(Event Player, unvisited, Remove From Array By Value, Event Player.current);
			Event Player.neighbors = Filtered Array(Mapped Array(Filtered Array(Mapped Array(Global.Segments_ID, Current Array Index),
				Global.Segments_Node1[Current Array Element] == Event Player.currentID || Global.Segments_Node2[Current Array Element] == Event Player.currentID),
				Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Segments_Node1[Current Array Element] == Event Player.currentID ? Global.Segments_Node2[Current Array Element] : Global.Segments_Node1[Current Array Element])),
				Array Contains(Event Player.unvisited, Current Array Element));
			Event Player._extendedPlayerCollection[23] = 0;
			While(Event Player._extendedPlayerCollection[23] < Count Of(Event Player.neighbors));
				Event Player._extendedPlayerCollection[24] = Event Player.neighbors[Event Player._extendedPlayerCollection[23]];
				Event Player._extendedPlayerCollection[25] = Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[24]];
				Event Player._extendedPlayerCollection[26] = Mapped Array(Filtered Array(Mapped Array(Global.Attributes_Value,
					Current Array Index),
					Global.Attributes_Node1[Current Array Element] == Event Player._extendedPlayerCollection[25] && Global.Attributes_Node2[Current Array Element] == Event Player.currentID),
					Global.Attributes_Value[Current Array Element]);
				Event Player._extendedPlayerCollection[27] = Event Player.distances[Event Player.current] + Distance Between(
					Global.Nodes_Node_Position[Event Player.current], Global.Nodes_Node_Position[Event Player._extendedPlayerCollection[24]]);
				If(Event Player._extendedPlayerCollection[27] < Event Player.distances[Event Player._extendedPlayerCollection[24]] && (Count Of(
					Event Player._extendedPlayerCollection[26]) == 0 || Is True For Any(Event Player._extendedPlayerCollection[26], Array Contains(
					Event Player.attributes, Current Array Element))));
					Event Player.distances[Event Player._extendedPlayerCollection[24]] = Event Player._extendedPlayerCollection[27];
					Event Player.parents[Event Player._extendedPlayerCollection[24]] = Event Player.current;
				End;
				Event Player._extendedPlayerCollection[23] += 1;
			End;
			Global.dijkstraProgressReport += 1;
			Wait(0.016, Ignore Condition);
		End;
		Global._extendedGlobalCollection[12] = False;
		Event Player.returnValue_Dijkstra_Parents = Event Player.parents;
	}
}

rule("Pathfind: Pathfind selected dummies")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Host Player == Event Player;
		Global.connectingFromNode == -1;
		Is Button Held(Host Player, Button(Reload)) == True;
		Count Of(Filtered Array(All Players(All Teams), Is Dummy Bot(Current Array Element) && Current Array Element.dummySelected))
			== True;
		!Global._extendedGlobalCollection[12] == True;
		!Host Player.releaseReload == True;
	}

	actions
	{
		Host Player.releaseReload = True;
		Event Player.destination = Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(
			Host Player) * 100, Null, Null, False);
		Event Player.players = Filtered Array(All Players(All Teams), Is Dummy Bot(Current Array Element)
			&& Current Array Element.dummySelected);
		Event Player.targetNodes = Empty Array;
		Event Player.source = First Of(Sorted Array(Mapped Array(Global.Nodes_Node_UniqueID, Current Array Index), Distance Between(
			Global.Nodes_Node_Position[Current Array Element], Event Player.destination)));
		Play Effect(All Players(All Teams), Ring Explosion, Color(Orange), Event Player.destination, 2);
		For Global Variable(waitlessI, 0, Count Of(Event Player.players), 1);
			Event Player.targetNodes[Global.waitlessI] = First Of(Sorted Array(Mapped Array(Global.Nodes_Node_UniqueID, Current Array Index),
				Distance Between(Global.Nodes_Node_Position[Current Array Element], Position Of(Event Player.players[Global.waitlessI]))));
		End;
		Event Player.source_0 = Event Player.source;
		Event Player.targets = Event Player.targetNodes;
		Event Player.attributes = Global.pathfinderAttributes;
		Call Subroutine(Dijkstra);
		Event Player.dijkstra_Parents = Event Player.returnValue_Dijkstra_Parents;
		Event Player.players.travelPath = Event Player.dijkstra_Parents;
		Event Player.players.isPathfinding = True;
		Event Player.players.pathfindDestination = Event Player.destination;
		For Global Variable(waitlessI, 0, Count Of(Event Player.players), 1);
			Event Player.players[Global.waitlessI].currentPathNode = Event Player.targetNodes[Global.waitlessI];
		End;
	}
}

rule("Pathfind: Begin")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.isPathfinding == True;
	}

	actions
	{
		Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player),
			Event Player.currentPathNode == -1 ? Event Player.pathfindDestination : Global.Nodes_Node_Position[Event Player.currentPathNode]),
			1, To World, Replace existing throttle, Direction and Magnitude);
	}
}

rule("Pathfind: Next node")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.isPathfinding == True;
		Distance Between(Position Of(Event Player), Global.Nodes_Node_Position[Event Player.currentPathNode]) < 0.400;
	}

	actions
	{
		Event Player._extendedPlayerCollection[28] = Event Player.currentPathNode;
		Event Player.currentPathNode = Event Player.travelPath[Event Player.currentPathNode];
		If(Event Player._extendedPlayerCollection[9]);
			Event Player._extendedPlayerCollection[9] = False;
			Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player),
				Event Player.currentPathNode == -1 ? Event Player.pathfindDestination : Global.Nodes_Node_Position[Event Player.currentPathNode]),
				1, To World, Replace existing throttle, Direction and Magnitude);
		End;
		If(Event Player._extendedPlayerCollection[10]);
			Event Player._extendedPlayerCollection[10] = False;
			Stop Holding Button(Event Player, Button(Jump));
		End;
		Event Player.attributes_0 = Mapped Array(Filtered Array(Mapped Array(Global.Attributes_Value, Current Array Index),
			Global.Attributes_Node1[Current Array Element] == Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[28]] && Global.Attributes_Node2[Current Array Element] == Global.Nodes_Node_UniqueID[Event Player.currentPathNode]),
			Global.Attributes_Value[Current Array Element]);
		Event Player.executeRules = Filtered Array(Mapped Array(Global.Rules_Actions_Data, Current Array Index), First Of(
			Global.Rules_EnabledHeroes[Current Array Element]) != Array Contains(Array Slice(
			Global.Rules_EnabledHeroes[Current Array Element], 1, 1000), Hero Of(Event Player)) && Array Contains(
			Event Player.attributes_0, Global.Rules_ExecutesOnAttribute[Current Array Element]));
		If(Count Of(Event Player.executeRules));
			For Player Variable(Event Player, a, 0, Count Of(Global.Rules_Actions_Data[First Of(Event Player.executeRules)]), 1);
				Event Player.ruleAction_Data = Global.Rules_Actions_Data[First Of(Event Player.executeRules)][Event Player.a];
				"Wait"
				If(First Of(Event Player.ruleAction_Data) == 0);
					Wait(Event Player.ruleAction_Data[1], Ignore Condition);
				End;
				"Jump"
				If(First Of(Event Player.ruleAction_Data) == 1);
					Press Button(Event Player, Button(Jump));
				"Start holding jump"
				Else If(First Of(Event Player.ruleAction_Data) == 2);
					Start Holding Button(Event Player, Button(Jump));
					Event Player._extendedPlayerCollection[10] = True;
				"Stop holding jump"
				Else If(First Of(Event Player.ruleAction_Data) == 3);
					Stop Holding Button(Event Player, Button(Jump));
					Event Player._extendedPlayerCollection[10] = False;
				"Ability 1"
				Else If(First Of(Event Player.ruleAction_Data) == 4);
					Press Button(Event Player, Button(Ability 1));
				"Ability 2"
				Else If(First Of(Event Player.ruleAction_Data) == 5);
					Press Button(Event Player, Button(Ability 2));
				"Melee"
				Else If(First Of(Event Player.ruleAction_Data) == 6);
					Press Button(Event Player, Button(Melee));
				"Primary fire"
				Else If(First Of(Event Player.ruleAction_Data) == 7);
					Press Button(Event Player, Button(Primary Fire));
				"Secondary fire"
				Else If(First Of(Event Player.ruleAction_Data) == 8);
					Press Button(Event Player, Button(Secondary Fire));
				"Stop walking"
				Else If(First Of(Event Player.ruleAction_Data) == 9);
					Stop Throttle In Direction(Event Player);
					Event Player._extendedPlayerCollection[9] = True;
				"Walk to destination"
				Else If(First Of(Event Player.ruleAction_Data) == 10);
					Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player),
						Event Player.currentPathNode == -1 ? Event Player.pathfindDestination : Global.Nodes_Node_Position[Event Player.currentPathNode]),
						1, To World, Replace existing throttle, Direction and Magnitude);
					Event Player._extendedPlayerCollection[9] = False;
				"Look at floor"
				Else If(First Of(Event Player.ruleAction_Data) == 11);
					Start Facing(Event Player, Direction From Angles(Horizontal Facing Angle Of(Event Player), 89), 1000, To World, None);
				"Look at destination"
				Else If(First Of(Event Player.ruleAction_Data) == 12);
					Start Facing(Event Player, Direction Towards(Eye Position(Event Player), (
						Event Player.currentPathNode == -1 ? Event Player.pathfindDestination : Global.Nodes_Node_Position[Event Player.currentPathNode])
						+ Vector(0, 1.750, 0)), 1000, To World, Direction and Turn Rate);
				"Wait for ability 1"
				Else If(First Of(Event Player.ruleAction_Data) == 13);
					Wait(Ability Cooldown(Event Player, Button(Ability 1)), Ignore Condition);
				"Wait for ability 2"
				Else If(First Of(Event Player.ruleAction_Data) == 14);
					Wait(Ability Cooldown(Event Player, Button(Ability 2)), Ignore Condition);
				"Wait for secondary fire"
				Else If(First Of(Event Player.ruleAction_Data) == 15);
					Wait(Ability Cooldown(Event Player, Button(Secondary Fire)), Ignore Condition);
				End;
			End;
		End;
	}
}

rule("Pathfind: Destination reached")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.isPathfinding == True;
		Distance Between(Position Of(Event Player), Event Player.pathfindDestination) < 0.400;
	}

	actions
	{
		Event Player.isPathfinding = False;
		Stop Throttle In Direction(Event Player);
	}
}

