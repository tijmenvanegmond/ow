	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		First Of(Event Player.cm_currActionID) == 20;
	}

	actions
	{
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(Index Of Array Value(
			Global._objectVariable_4[Event Player.cm_currActionID[1]], Event Player.cm_currActionID[2])));
		Modify Global Variable(func_group, Append To Array, Array(Global._objectVariable_9[Event Player.cm_currActionID[1]]));
		Call Subroutine(func_group);
	}
}

rule("CM: Number selector: Update")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Array Contains(Array(7, 8, 9, 10), First Of(Event Player.cm_currActionID)) == True;
	}

	actions
	{
		Global._objectVariable_0[Event Player.cm_currActionID[1]] += Array(1, 5, -1, -5)[Index Of Array Value(Array(7, 8, 9, 10), First Of(
			Event Player.cm_currActionID))];
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID,
			Global._objectVariable_1[Event Player.cm_currActionID[1]])] = Custom String(" {0} ",
			Global._objectVariable_0[Event Player.cm_currActionID[1]]);
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(Global._objectVariable_0[Event Player.cm_currActionID[1]]));
		Modify Global Variable(func_group, Append To Array, Array(Global._objectVariable_4[Event Player.cm_currActionID[1]]));
		Call Subroutine(func_group);
	}
}

rule("(Subroutine) CM: Update pathfinder attributes list")
{
	event
	{
		Subroutine;
		UpdatePathfinderAttributesList;
	}

	actions
	{
		Global.result = Custom String("");
		If(Count Of(Global.pathfinderAttributes));
			Global.result = Custom String("{0}", First Of(Global.pathfinderAttributes));
			For Global Variable(waitlessI, 1, Count Of(Global.pathfinderAttributes), 1);
				Global.result = Custom String("{0}, {1}", Global.result, Global.pathfinderAttributes[Global.waitlessI]);
			End;
		End;
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[22])
			] = Global.result;
	}
}

rule("(Subroutine) CM: Update pathfinder attribute selector")
{
	event
	{
		Subroutine;
		UpdatePathfinderAttributeSelecto;
	}

	actions
	{
		If(Array Contains(Global.pathfinderAttributes, Global._objectVariable_0[Global.pathfinderAttributeSelector]));
			Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[23])
				] = Custom String("remove");
			Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[23])
				] = Color(Red);
		Else;
			Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[23])
				] = Custom String("add");
			Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[23])
				] = Color(Green);
		End;
	}
}

rule("CM: Pathfinder settings")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 27;
	}

	actions
	{
		Global.newState = 6;
		Call Subroutine(SetMenuState);
		Global.input = Array(Null, 0, 0, 0, 0.200, 0.200, 0.200, Color(Yellow), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global._extendedGlobalCollection[22] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Null, 28, 0, 0, -0.200, 0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._extendedGlobalCollection[23] = Global.returnValue___createButtonSubrou;
		Modify Player Variable(Event Player, buttonCollectionMain, Append To Array, Array(Global._extendedGlobalCollection[22],
			Global._extendedGlobalCollection[23]));
		Call Subroutine(UpdatePathfinderAttributesList);
		Global.pathfinderAttributeSelector = Index Of Array Value(Global._classIndexes, 0);
		Global.pathfinderAttributeSelector = Global.pathfinderAttributeSelector == -1 ? Count Of(Global._classIndexes)
			: Global.pathfinderAttributeSelector;
		Global._classIndexes[Global.pathfinderAttributeSelector] = 1;
		Global._objectVariable_0[Global.pathfinderAttributeSelector] = 0;
		Global.input = Array(Custom String(" {0} ", 0), 0, 0, 0, 0, 0.200, 0.200, Color(Yellow), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_1[Global.pathfinderAttributeSelector] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Custom String("→"), Array(7, Global.pathfinderAttributeSelector), Array(8,
			Global.pathfinderAttributeSelector), 0.177, 0, 0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_3[Global.pathfinderAttributeSelector] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Custom String("←"), Array(9, Global.pathfinderAttributeSelector), Array(10,
			Global.pathfinderAttributeSelector), -0.177, 0, 0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_2[Global.pathfinderAttributeSelector] = Global.returnValue___createButtonSubrou;
		Global._objectVariable_4[Global.pathfinderAttributeSelector] = Array(45, Null);
		Call Subroutine(UpdatePathfinderAttributeSelecto);
	}
}

rule("CM: Pathfinder settings back")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 1;
		First Of(Event Player._extendedPlayerCollection) == 6;
	}

	actions
	{
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		Global.buttonID = Global._objectVariable_1[Global.pathfinderAttributeSelector];
		Call Subroutine(DestroyButton);
		Global.buttonID = Global._objectVariable_3[Global.pathfinderAttributeSelector];
		Call Subroutine(DestroyButton);
		Global.buttonID = Global._objectVariable_2[Global.pathfinderAttributeSelector];
		Call Subroutine(DestroyButton);
		If(Global.pathfinderAttributeSelector);
			Global._classIndexes[Global.pathfinderAttributeSelector] = 0;
			Global._objectVariable_0[Global.pathfinderAttributeSelector] = 0;
			Global._objectVariable_1[Global.pathfinderAttributeSelector] = 0;
			Global._objectVariable_2[Global.pathfinderAttributeSelector] = 0;
			Global._objectVariable_3[Global.pathfinderAttributeSelector] = 0;
			Global._objectVariable_4[Global.pathfinderAttributeSelector] = 0;
		Else;
			Log To Inspector(Custom String("[Error] Attempted to delete invalid reference in number selector.del at line 80"));
		End;
	}
}

rule("CM: Add or remove pathfinding attribute")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 28;
	}

	actions
	{
		Event Player.index = Index Of Array Value(Global.pathfinderAttributes,
			Global._objectVariable_0[Global.pathfinderAttributeSelector]);
		If(Event Player.index == -1);
			Modify Global Variable(pathfinderAttributes, Append To Array, Global._objectVariable_0[Global.pathfinderAttributeSelector]);
		Else;
			Modify Global Variable(pathfinderAttributes, Remove From Array By Index, Event Player.index);
		End;
		Call Subroutine(UpdatePathfinderAttributeSelecto);
		Call Subroutine(UpdatePathfinderAttributesList);
	}
}

rule("▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒【Josbird's Cursor Menu】▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Global init")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global._extendedGlobalCollection[25] = Workshop Setting Real(Custom String("Josbird's Cursor Menu"), Custom String("Menu Width"),
			5, 0, 10, 1);
		Global._extendedGlobalCollection[26] = Workshop Setting Real(Custom String("Josbird's Cursor Menu"), Custom String("Menu Height"),
			2.500, 0, 5, 2);
		Global._extendedGlobalCollection[27] = Workshop Setting Toggle(Custom String("Josbird's Cursor Menu"), Custom String(
			"Button click sounds"), True, 3);
		Global._extendedGlobalCollection[28] = Workshop Setting Toggle(Custom String("Josbird's Cursor Menu"), Custom String(
			"Debug mode (show button click areas)"), False, 4);
		Global._extendedGlobalCollection[29] = Workshop Setting Toggle(Custom String("Josbird's Cursor Menu"), Custom String(
			"Menu disables game hud"), True, 7);
		Global._extendedGlobalCollection[30] = Array(Custom String("exit menu"), Global._extendedGlobalCollection[25] / 2 - 0.150,
			Global._extendedGlobalCollection[26] / 2 - 0.150, 0.350);
	}
}

rule("Create menu cursor")
{
	event
	{
		Subroutine;
		createCursor;
	}

	actions
	{
		Create In-World Text(Filtered Array(Event Player, Event Player.cm_isInMenu && Total Time Elapsed % 0.032 < 0.016), Custom String(
			"▲"), Update Every Frame(Eye Position(Event Player) + 100 * (Angle Difference(Horizontal Angle From Direction(
			Facing Direction Of(Event Player)), Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)) * Cross Product(
			Facing Direction Of(Event Player), Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90)) + (Angle Difference(Vertical Angle From Direction(
			Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)) - 0.200)
			* Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 3, Do Not Clip,
			Visible To Position String and Color, Color(White), Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Filtered Array(Event Player, Event Player.cm_isInMenu && Total Time Elapsed % 0.032 >= 0.016), Custom String(
			"▲"), Update Every Frame(Eye Position(Event Player) + 100 * (Angle Difference(Horizontal Angle From Direction(
			Facing Direction Of(Event Player)), Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)) * Cross Product(
			Facing Direction Of(Event Player), Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90)) + (Angle Difference(Vertical Angle From Direction(
			Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)) - 0.200)
			* Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 3, Do Not Clip,
			Visible To Position String and Color, Color(White), Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
	}
}

rule("Create menu border corners")
{
	event
	{
		Subroutine;
		createBorderCorners;
	}

	actions
	{
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Custom String("┌"), Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] * -1 / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (Global._extendedGlobalCollection[26] / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Custom String("┐"), Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (Global._extendedGlobalCollection[26] / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Custom String("└"), Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] * -1 / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (Global._extendedGlobalCollection[26] * -1 / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Custom String("┘"), Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (Global._extendedGlobalCollection[26] * -1 / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
	}
}

rule("Create menu border edges")
{
	event
	{
		Subroutine;
		createBorderEdges;
	}

	actions
	{
		Global.stringBuilder = Custom String("");
		For Player Variable(Event Player, cm_i, 0, 4.600 * Global._extendedGlobalCollection[25] - 1, 1);
			Global.stringBuilder = Custom String("{0}{1}", Global.stringBuilder, Custom String("━"));
		End;
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Global.stringBuilder, Update Every Frame(Eye Position(
			Event Player) + 100 * ((Global._extendedGlobalCollection[26] / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Global.stringBuilder, Update Every Frame(Eye Position(
			Event Player) + 100 * ((Global._extendedGlobalCollection[26] * -1 / 2 - 0.200) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4, Do Not Clip, Visible To and Position, Color(White),
			Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Global.stringBuilder = Custom String("");
		For Player Variable(Event Player, cm_i, 0.300, Global._extendedGlobalCollection[26], 0.300);
			Global.stringBuilder = Custom String("{0}{1}", Global.stringBuilder, Custom String("┃\n"));
		End;
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Global.stringBuilder, Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (-0.095 * Round To Integer(Global._extendedGlobalCollection[26] / 0.300, Down)
			- 0.200) * Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4,
			Do Not Clip, Visible To and Position, Color(White), Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		Create In-World Text(Event Player.cm_isInMenu ? Event Player : Null, Global.stringBuilder, Update Every Frame(Eye Position(
			Event Player) + 100 * (Global._extendedGlobalCollection[25] * -1 / 2 * Cross Product(Facing Direction Of(Event Player),
			Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Facing Direction Of(Event Player)) - 90)) + (-0.095 * Round To Integer(Global._extendedGlobalCollection[26] / 0.300, Down)
			- 0.200) * Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 4,
			Do Not Clip, Visible To and Position, Color(White), Default Visibility);
		Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
	}
}

rule("CM: Host Just-In-Time Preload Optimization")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player == Host Player;
	}

	actions
	{
		Event Player._extendedPlayerCollection[32] = 0;
		While(Event Player._extendedPlayerCollection[32] < 50);
			Create In-World Text(Update Every Frame(Event Player.cm_isInMenu && Evaluate Once(Event Player._extendedPlayerCollection[32])
				< Count Of(Event Player.cm_buttons_Label) ? Event Player : Null), Update Every Frame(
				Event Player.cm_buttons_Label[Evaluate Once(Event Player._extendedPlayerCollection[32])]), Update Every Frame(Eye Position(
				Event Player) + 100 * (Event Player.cm_buttons_PosX[Evaluate Once(Event Player._extendedPlayerCollection[32])] * Cross Product(
				Facing Direction Of(Event Player), Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
				Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90)) + (Event Player.cm_buttons_PosY[Evaluate Once(
				Event Player._extendedPlayerCollection[32])] - 0.200) * Direction From Angles(Horizontal Angle From Direction(
				Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(Event Player)) - 90)
				+ 3 * Facing Direction Of(Event Player))), 2.800, Do Not Clip, Visible To Position String and Color,
				Event Player.cm_buttons_Interactable[Evaluate Once(Event Player._extendedPlayerCollection[32])] && Absolute Value(
				Angle Difference(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Horizontal Angle From Direction(
				Event Player.cm_menuOriginalFacing)) - Event Player.cm_buttons_PosX[Evaluate Once(Event Player._extendedPlayerCollection[32])])
				<= Event Player.cm_buttons_ClickWidth[Evaluate Once(Event Player._extendedPlayerCollection[32])] / 2 && Absolute Value(
				Angle Difference(Vertical Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
				Event Player.cm_menuOriginalFacing)) - Event Player.cm_buttons_PosY[Evaluate Once(Event Player._extendedPlayerCollection[32])])
				<= Event Player.cm_buttons_ClickHeight[Evaluate Once(Event Player._extendedPlayerCollection[32])
				] / 2 ? Event Player.cm_buttons_HoverColor[Evaluate Once(Event Player._extendedPlayerCollection[32])
				] : Event Player.cm_buttons_DefaultColor[Evaluate Once(Event Player._extendedPlayerCollection[32])], Default Visibility);
			Wait(0.016, Ignore Condition);
			Event Player._extendedPlayerCollection[32] += 1;
		End;
		Event Player.cm_menuFrame = Empty Array;
		Call Subroutine(createCursor);
		Wait(0.016, Ignore Condition);
		Call Subroutine(createBorderCorners);
		Call Subroutine(createBorderEdges);
	}
}

rule("Toggle menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Is Dummy Bot(Event Player) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		!Is Communicating Any Emote(Event Player) == True;
		!Event Player.popupWindowVisible == True;
		!Event Player.releaseInteract == True;
		!Global._extendedGlobalCollection[3] == True;
	}

	actions
	{
		Event Player.cm_isInMenu = !Event Player.cm_isInMenu;
	}
}

rule("Create exit button")
{
	event
	{
		Subroutine;
		createExitButton;
	}

	actions
	{
		Create Icon(!Global._extendedGlobalCollection[3] ? Event Player : Null, Update Every Frame(Eye Position(Event Player) + 100 * (
			Global._extendedGlobalCollection[30][1] * Cross Product(Facing Direction Of(Event Player), Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90)) + (Global._extendedGlobalCollection[30][2] - 0.250) * Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
			Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), X, Visible To Position and Color, Absolute Value(
			Angle Difference(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Horizontal Angle From Direction(
			Event Player.cm_menuOriginalFacing)) - Global._extendedGlobalCollection[30][1])
			<= Global._extendedGlobalCollection[30][3] / 2 && Absolute Value(Angle Difference(Vertical Angle From Direction(
			Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing))
			- Global._extendedGlobalCollection[30][2]) <= Global._extendedGlobalCollection[30][3] / 2 ? Color(Yellow) : Color(Red), False);
		Event Player._extendedPlayerCollection[12] = Last Created Entity;
	}
}

rule("Create click areas")
{
	event
	{
		Subroutine;
		createClickAreas;
	}

	actions
	{
		For Player Variable(Event Player, cm_i, 0, Count Of(Event Player.cm_buttons_Label), 1);
			Create In-World Text(Event Player, Custom String("┌"), Update Every Frame(Eye Position(Event Player) + 100 * ((
				Event Player.cm_buttons_PosX[Evaluate Once(Event Player.cm_i)] - Event Player.cm_buttons_ClickWidth[Evaluate Once(
				Event Player.cm_i)] / 2) * Cross Product(Facing Direction Of(Event Player), Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
				Event Player)) - 90)) + (Event Player.cm_buttons_PosY[Evaluate Once(Event Player.cm_i)
				] + Event Player.cm_buttons_ClickHeight[Evaluate Once(Event Player.cm_i)] / 2 - 0.200) * Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
				Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 2, Do Not Clip, Visible To and Position,
				!Event Player.cm_buttons_Visible[Evaluate Once(Event Player.cm_i)] ? Custom Color(0, 0, 0, 0) : (
				Event Player.cm_buttons_Interactable[Evaluate Once(Event Player.cm_i)] ? Color(Yellow) : Color(White)), Default Visibility);
			Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
			Create In-World Text(Event Player, Custom String("┘"), Update Every Frame(Eye Position(Event Player) + 100 * ((
				Event Player.cm_buttons_PosX[Evaluate Once(Event Player.cm_i)] + Event Player.cm_buttons_ClickWidth[Evaluate Once(
				Event Player.cm_i)] / 2) * Cross Product(Facing Direction Of(Event Player), Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
				Event Player)) - 90)) + (Event Player.cm_buttons_PosY[Evaluate Once(Event Player.cm_i)
				] - Event Player.cm_buttons_ClickHeight[Evaluate Once(Event Player.cm_i)] / 2 - 0.200) * Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(Facing Direction Of(
				Event Player)) - 90) + 3 * Facing Direction Of(Event Player))), 2, Do Not Clip, Visible To and Position,
				!Event Player.cm_buttons_Visible[Evaluate Once(Event Player.cm_i)] ? Custom Color(0, 0, 0, 0) : (
				Event Player.cm_buttons_Interactable[Evaluate Once(Event Player.cm_i)] ? Color(Yellow) : Color(White)), Default Visibility);
			Modify Player Variable(Event Player, cm_menuFrame, Append To Array, Last Text ID);
		End;
	}
}

rule("Open menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Is Dummy Bot(Event Player) == True;
		Event Player.cm_isInMenu == True;
	}

	actions
	{
		Set Aim Speed(Event Player, 15);
		Event Player.cm_menuOriginalFacing = Facing Direction Of(Event Player);
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		If(Global._extendedGlobalCollection[29]);
			Disable Hero HUD(Event Player);
			Disable Game Mode HUD(Event Player);
		End;
		Call Subroutine(createExitButton);
		Wait(0.016, Ignore Condition);
		If(Global._extendedGlobalCollection[28]);
			Call Subroutine(createClickAreas);
		End;
	}
}

rule("Close menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Is Dummy Bot(Event Player) == True;
		!Event Player.cm_isInMenu == True;
	}

	actions
	{
		Set Aim Speed(Event Player, 100);
		Set Primary Fire Enabled(Event Player, True);
		Set Secondary Fire Enabled(Event Player, True);
		Destroy Icon(Event Player._extendedPlayerCollection[12]);
	}
}

rule("Game mode hud")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Event Player.cm_isInMenu == True;
		!Event Player.popupWindowVisible == True;
	}

	actions
	{
		Enable Hero HUD(Event Player);
	}
}

rule("Detect button press")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_isInMenu == True;
		(Is Button Held(Event Player, Button(Primary Fire)) || Is Button Held(Event Player, Button(Secondary Fire))) == True;
	}

	actions
	{
		Event Player.primary = Is Button Held(Event Player, Button(Primary Fire));
		If(Absolute Value(Angle Difference(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)) - Global._extendedGlobalCollection[30][1])
			<= Global._extendedGlobalCollection[30][3] / 2 && Absolute Value(Angle Difference(Vertical Angle From Direction(
			Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing))
			- Global._extendedGlobalCollection[30][2]) <= Global._extendedGlobalCollection[30][3] / 2);
			Event Player.cm_currActionID = First Of(Global._extendedGlobalCollection[30]);
		End;
		For Player Variable(Event Player, i_0, 0, Count Of(Event Player.cm_buttons_Label), 1);
			If(Event Player.cm_buttons_Interactable[Event Player.i_0] && Absolute Value(Angle Difference(Horizontal Angle From Direction(
				Facing Direction Of(Event Player)), Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing))
				- Event Player.cm_buttons_PosX[Event Player.i_0])
				<= Event Player.cm_buttons_ClickWidth[Event Player.i_0] / 2 && Absolute Value(Angle Difference(Vertical Angle From Direction(
				Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing))
				- Event Player.cm_buttons_PosY[Event Player.i_0]) <= Event Player.cm_buttons_ClickHeight[Event Player.i_0] / 2);
				Event Player.cm_currActionID = Event Player.primary ? Event Player.cm_buttons_PrimaryAction[Event Player.i_0] : Event Player.cm_buttons_SecondaryAction[Event Player.i_0];
			End;
		End;
		If(Event Player.cm_currActionID && Global._extendedGlobalCollection[27]);
			If(Event Player.primary);
				Event Player.releasePrimary = True;
			End;
			Play Effect(Event Player, Explosion Sound, Color(White), Event Player, 30);
		End;
		Wait(0.016, Ignore Condition);
		Event Player.cm_currActionID = Null;
	}
}

rule("Action ID: Exit menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		!Global._extendedGlobalCollection[3] == True;
		Event Player.cm_currActionID == Custom String("exit menu");
	}

	actions
	{
		Event Player.cm_isInMenu = False;
	}
}

rule("Cursor bounds")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_isInMenu == True;
		(Absolute Value(Angle Difference(Horizontal Angle From Direction(Facing Direction Of(Event Player)),
			Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)))
			> Global._extendedGlobalCollection[25] / 2 + 0.050 || Absolute Value(Angle Difference(Vertical Angle From Direction(
			Facing Direction Of(Event Player)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)))
			> Global._extendedGlobalCollection[26] / 2 + 0.050) == True;
	}

	actions
	{
		Set Facing(Event Player, Direction From Angles(Min(Max(Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)
			- Angle Difference(Horizontal Angle From Direction(Facing Direction Of(Event Player)), Horizontal Angle From Direction(
			Event Player.cm_menuOriginalFacing)), Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)
			- Global._extendedGlobalCollection[25] / 2), Horizontal Angle From Direction(Event Player.cm_menuOriginalFacing)
			+ Global._extendedGlobalCollection[25] / 2), Min(Max(Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)
			- Angle Difference(Vertical Angle From Direction(Facing Direction Of(Event Player)), Vertical Angle From Direction(
			Event Player.cm_menuOriginalFacing)), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)
			- Global._extendedGlobalCollection[26] / 2), Vertical Angle From Direction(Event Player.cm_menuOriginalFacing)
			+ Global._extendedGlobalCollection[26] / 2)), To World);
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("CM: Func Primary")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		First Of(Event Player.cm_currActionID) == 35;
	}

	actions
	{
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(True));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.cm_currActionID[1]));
		Call Subroutine(func_group);
	}
}

rule("CM: Func Secondary")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		First Of(Event Player.cm_currActionID) == 36;
	}

	actions
	{
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(False));
		Modify Global Variable(func_group, Append To Array, Array(Event Player.cm_currActionID[1]));
		Call Subroutine(func_group);
	}
}

rule("EXPORT: open export menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 31;
