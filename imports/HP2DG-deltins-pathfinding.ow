rule("CM: Delete action")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cm_currActionID == 26;
	}

	actions
	{
		Event Player.deleting_Data = Empty Array;
		Event Player._extendedPlayerCollection[29] = Empty Array;
		For Global Variable(waitlessI, 0, Count Of(Global.actionsSelected), 1);
			If(Global.actionsSelected[Global.waitlessI]);
				Modify Player Variable(Event Player, deleting_Data, Append To Array, Array(
					Global.Rules_Actions_Data[Global.rulePage][Global.waitlessI]));
				Modify Player Variable At Index(Event Player, _extendedPlayerCollection, 29, Append To Array, Global.waitlessI);
			End;
		End;
		Global.actionsSelected = Empty Array;
		Event Player._extendedPlayerCollection[30] = Global.rulePage;
		Event Player.catalogItem_Set = Array(38, Null, Event Player.deleting_Data, Event Player._extendedPlayerCollection[30],
			Event Player._extendedPlayerCollection[29]);
		Event Player.catalogItem_Revert = Array(39, Null, Event Player.deleting_Data, Event Player._extendedPlayerCollection[30],
			Event Player._extendedPlayerCollection[29]);
		Call Subroutine(Docment);
	}
}

