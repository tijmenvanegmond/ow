		Event Player.catalogItem_Set = Array(36, Null, Event Player.nodeLength, Event Player.segmentLength, Event Player.attributeLength,
			Global._extendedGlobalCollection[35], Global._extendedGlobalCollection[36]);
		Event Player.catalogItem_Revert = Array(37, Null, Event Player.nodeLength, Event Player.segmentLength,
			Event Player.attributeLength);
