rule("CM: Hero ready")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		First Of(Event Player.cm_currActionID) == 12;
		Global._extendedGlobalCollection[4] == True;
	}

	actions
	{
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(Event Player.cm_currActionID[1]));
		Modify Global Variable(func_group, Append To Array, Array(Global._extendedGlobalCollection[4]));
		Call Subroutine(func_group);
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		Global._extendedGlobalCollection[4] = Null;
		Event Player.cm_isInMenu = False;
		Event Player.releasePrimary = True;
	}
}

rule("Editor: node mode enter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		(Global.editorState == 0 || Global.editorState == 2) == True;
	}

	actions
	{
		Destroy Effect(Global._extendedGlobalCollection[9]);
		Destroy In-World Text(Global._extendedGlobalCollection[10]);
		Create Effect(Filtered Array(All Players(All Teams), Global.SelectedNodeID == -1 && !Host Player.cm_isInMenu), Sphere,
			Global.editorState == 0 ? Color(Orange) : Color(Purple), Update Every Frame(Ray Cast Hit Position(Eye Position(Host Player),
			Eye Position(Host Player) + Facing Direction Of(Host Player) * 100, Null, Null, False)), 0.200,
			Visible To Position Radius and Color);
		Global._extendedGlobalCollection[9] = Last Created Entity;
	}
}

rule("Editor: dummy mode enter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.editorState == 1;
	}

	actions
	{
		Destroy Effect(Global._extendedGlobalCollection[9]);
		Destroy In-World Text(Global._extendedGlobalCollection[10]);
		Create Effect(!Host Player.cm_isInMenu && Global.SelectedPlayer == Null && Global.SelectedNodeID == -1 ? All Players(All Teams)
			: Null, Ring, Color(Sky Blue), Update Every Frame(Ray Cast Hit Position(Eye Position(Host Player), Eye Position(Host Player)
			+ Facing Direction Of(Host Player) * 100, Null, Null, False)), 0.500, Visible To Position Radius and Color);
		Global._extendedGlobalCollection[9] = Last Created Entity;
		Create In-World Text(!Host Player.cm_isInMenu && Global.SelectedPlayer == Null && Global.SelectedNodeID == -1 ? All Players(
			All Teams) : Null, Hero Icon String(Global._extendedGlobalCollection[11]), Update Every Frame(Ray Cast Hit Position(
			Eye Position(Host Player), Eye Position(Host Player) + Facing Direction Of(Host Player) * 100, Null, Null, False)), 2,
			Do Not Clip, Visible To and Position, Color(White), Default Visibility);
		Global._extendedGlobalCollection[10] = Last Text ID;
	}
}

rule("Subroutine: Destroy connection beams")
{
	event
	{
