rule("(Subroutine) CM: Update scrollbar")
{
	event
	{
		Subroutine;
		Update;
	}

	actions
	{
		For Global Variable(i_0, 0, Count Of(Global._objectVariable_3[Global.UpdateStack]), 1);
			If(
				Global.i_0 < Global._objectVariable_8[Global.UpdateStack] || Global.i_0 >= Global._objectVariable_8[Global.UpdateStack] + Global._objectVariable_7[Global.UpdateStack]);
				If(Global._objectVariable_4[Global.UpdateStack][Global.i_0] != -1);
					Global.buttonID = Global._objectVariable_4[Global.UpdateStack][Global.i_0];
					Call Subroutine(DestroyButton);
					Global._arrayConstructor = Global._objectVariable_4[Global.UpdateStack];
					Global._arrayConstructor[Global.i_0] = -1;
					Global._objectVariable_4[Global.UpdateStack] = Global._arrayConstructor;
				End;
			Else;
				Global._extendedGlobalCollection[49] = Global._objectVariable_0[Global.UpdateStack] - (
					Global.i_0 - Global._objectVariable_8[Global.UpdateStack] + 1) * 0.175;
				If(Global._objectVariable_4[Global.UpdateStack][Global.i_0] == -1);
					Global.input = Array(Global._objectVariable_3[Global.UpdateStack][Global.i_0], Array(20, Global.UpdateStack,
						Global._extendedGlobalCollection[24] + 1), 0, Global._objectVariable_1[Global.UpdateStack],
						Global._extendedGlobalCollection[49], 1.400, 0.175, Global._objectVariable_2[Global.UpdateStack][Global.i_0], Color(Blue),
						True, True);
					Call Subroutine(__createButtonSubroutine);
					Global._arrayConstructor = Global._objectVariable_4[Global.UpdateStack];
					Global._arrayConstructor[Global.i_0] = Global.returnValue___createButtonSubrou;
					Global._objectVariable_4[Global.UpdateStack] = Global._arrayConstructor;
				Else;
					Event Player.cm_buttons_PosY[Index Of Array Value(Event Player.cm_buttons_ID,
						Global._objectVariable_4[Global.UpdateStack][Global.i_0])] = Global._extendedGlobalCollection[49];
				End;
			End;
		End;
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._objectVariable_5[Global.UpdateStack])
			] = Global._objectVariable_8[Global.UpdateStack] > 0;
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._objectVariable_5[Global.UpdateStack])
			] = Global._objectVariable_8[Global.UpdateStack] > 0 ? Color(White) : Color(Gray);
		Event Player.cm_buttons_Interactable[Index Of Array Value(Event Player.cm_buttons_ID, Global._objectVariable_6[Global.UpdateStack])
			] = Global._objectVariable_8[Global.UpdateStack] < Count Of(Global._objectVariable_3[Global.UpdateStack])
			- Global._objectVariable_7[Global.UpdateStack];
		Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID, Global._objectVariable_6[Global.UpdateStack])
			] = Global._objectVariable_8[Global.UpdateStack] < Count Of(Global._objectVariable_3[Global.UpdateStack])
			- Global._objectVariable_7[Global.UpdateStack] ? Color(White) : Color(Gray);
	}
}

rule("(Subroutine) CM: Load action scrollbar")
{
	event
	{
		Subroutine;
		loadActionScrollbar;
	}

	actions
	{
		Global.actionScrollBar = Index Of Array Value(Global._classIndexes, 0);
		Global.actionScrollBar = Global.actionScrollBar == -1 ? Count Of(Global._classIndexes) : Global.actionScrollBar;
		Global._classIndexes[Global.actionScrollBar] = 2;
		Global._objectVariable_1[Global.actionScrollBar] = -1.500;
		Global._objectVariable_0[Global.actionScrollBar] = 0.500;
		Global._objectVariable_3[Global.actionScrollBar] = Mapped Array(Global.Rules_Actions_Data[Global.rulePage], Custom String(
			"{0} {1}", Host Player._extendedPlayerCollection[11][First Of(Current Array Element)], Current Array Element[1]));
		Global._objectVariable_2[Global.actionScrollBar] = Mapped Array(Global._objectVariable_3[Global.actionScrollBar], Color(White));
		Global._objectVariable_4[Global.actionScrollBar] = Mapped Array(Global._objectVariable_3[Global.actionScrollBar], -1);
		Global._objectVariable_9[Global.actionScrollBar] = Array(15, Null);
		Global._objectVariable_7[Global.actionScrollBar] = 6;
		Global.input = Array(Custom String("↑"), Array(18, Global.actionScrollBar, 1), Array(18, Global.actionScrollBar, 6), -1.500, 0.500,
			0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_5[Global.actionScrollBar] = Global.returnValue___createButtonSubrou;
		Global.input = Array(Custom String("↓"), Array(19, Global.actionScrollBar, 1), Array(19, Global.actionScrollBar, 6), -1.500,
			-0.725, 0.200, 0.200, Color(White), Color(Blue), True, True);
		Call Subroutine(__createButtonSubroutine);
		Global._objectVariable_6[Global.actionScrollBar] = Global.returnValue___createButtonSubrou;
		Global.UpdateStack = Global.actionScrollBar;
		Call Subroutine(Update);
	}
}

rule("Subroutine: Update hero icon")
{
	event
	{
		Subroutine;
		updateHeroIcon;
	}

	actions
	{
		Event Player._extendedPlayerCollection[15] = First Of(Global.Rules_EnabledHeroes[Global.rulePage]) != Array Contains(Array Slice(
			Global.Rules_EnabledHeroes[Global.rulePage], 1, 1000), All Heroes[Event Player._extendedPlayerCollection[14]]);
		"Update button color"
		If(
			Event Player._extendedPlayerCollection[14] >= Global._objectVariable_8[Global.heroScrollBar] && Event Player._extendedPlayerCollection[14] < Global._objectVariable_8[Global.heroScrollBar] + Global._objectVariable_7[Global.heroScrollBar]);
			Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID,
				Global._objectVariable_4[Global.heroScrollBar][Event Player._extendedPlayerCollection[14]])
				] = Event Player._extendedPlayerCollection[15] ? Color(Green) : Color(Red);
		End;
		Global._arrayConstructor = Global._objectVariable_2[Global.heroScrollBar];
		Global._arrayConstructor[Event Player._extendedPlayerCollection[14]] = Event Player._extendedPlayerCollection[15] ? Color(Green)
			: Color(Red);
		Global._objectVariable_2[Global.heroScrollBar] = Global._arrayConstructor;
		"Update button label"
		If(
			Event Player._extendedPlayerCollection[14] >= Global._objectVariable_8[Global.heroScrollBar] && Event Player._extendedPlayerCollection[14] < Global._objectVariable_8[Global.heroScrollBar] + Global._objectVariable_7[Global.heroScrollBar]);
			Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID,
				Global._objectVariable_4[Global.heroScrollBar][Event Player._extendedPlayerCollection[14]])] = Custom String("{0} {1}",
				Hero Icon String(All Heroes[Event Player._extendedPlayerCollection[14]]),
				Event Player._extendedPlayerCollection[15] ? Custom String("yes") : Custom String("no"));
		End;
		Global._arrayConstructor = Global._objectVariable_3[Global.heroScrollBar];
		Global._arrayConstructor[Event Player._extendedPlayerCollection[14]] = Custom String("{0} {1}", Hero Icon String(
			All Heroes[Event Player._extendedPlayerCollection[14]]), Event Player._extendedPlayerCollection[15] ? Custom String("yes")
			: Custom String("no"));
		Global._objectVariable_3[Global.heroScrollBar] = Global._arrayConstructor;
	}
}

