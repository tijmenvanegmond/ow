rule("Disable inspector")
{
	event
	{
		Subroutine;
		DisableInspector;
	}

	actions
	{
		Global.inspector -= 1;
		If(Global.inspector == 0);
			Disable Inspector Recording;
		End;
	}
}

rule("Subroutine: Start Long Running Task")
{
	event
	{
		Subroutine;
		StartLongRunningTask;
	}

	actions
	{
		Global._extendedGlobalCollection[3] += 1;
		Event Player.cm_isInMenu = True;
		Global.newState = 10;
		Call Subroutine(SetMenuState);
		Global.input = Array(Global.message, 0, 0, 0, 0, 0.200, 0.200, Color(White), Color(Blue), False, True);
		Call Subroutine(__createButtonSubroutine);
		Modify Player Variable(Event Player, buttonCollectionMain, Append To Array, Global.returnValue___createButtonSubrou);
	}
}

rule("Subroutine: Doc_ment action move")
{
	event
	{
		Subroutine;
		MoveSelectedActions;
	}

	actions
	{
		If((Global._extendedGlobalCollection[51] && First Of(Global.actionsSelected)) || (
			!Global._extendedGlobalCollection[51] && Global.actionsSelected[Count Of(Global.Rules_Actions_Data[Global.rulePage]) - 1]));
			Skip(4);
		End;
		Event Player.catalogItem_Set = Array(46, Null, Global.actionsSelected, Global._extendedGlobalCollection[51], Global.rulePage);
		Event Player.catalogItem_Revert = Array(47, Null, Global.actionsSelected, Global._extendedGlobalCollection[51], Global.rulePage);
		Call Subroutine(Docment);
	}
}

rule("Subroutine: Execute action move")
{
	event
	{
		Subroutine;
		DoMove;
	}

	actions
	{
		If(First Of(Event Player._extendedPlayerCollection)
			== 3 && Global._extendedGlobalCollection[21] && Global.actionScrollBar && Global._extendedGlobalCollection[54] == Global.rulePage);
			Global.actionsSelected = Empty Array;
		End;
		Global.direction = Global._extendedGlobalCollection[53] ? -1 : 1;
		Global.step = Global.isUndo ? Global.direction * -1 : 0;
		Global.i_2 = Global._extendedGlobalCollection[53] ? 0 : Count Of(Global._extendedGlobalCollection[52]) - 1;
		While(Global._extendedGlobalCollection[53] ? Global.i_2 < Count Of(Global._extendedGlobalCollection[52]) : Global.i_2 >= 0);
			If(Global._extendedGlobalCollection[52][Global.i_2]);
				Global.action_Data = Global.Rules_Actions_Data[Global.rulePage][Global.i_2 + Global.step];
				Modify Global Variable At Index(Rules_Actions_Data, Global.rulePage, Remove From Array By Index, Global.i_2 + Global.step);
				Global.Rules_Actions_Data[Global.rulePage] = Append To Array(Append To Array(Array Slice(
					Global.Rules_Actions_Data[Global.rulePage], 0, Global.i_2 + Global.step + Global.direction), Array(Global.action_Data)),
					Array Slice(Global.Rules_Actions_Data[Global.rulePage], Global.i_2 + Global.step + Global.direction, 999));
				If(First Of(Event Player._extendedPlayerCollection)
					== 3 && Global._extendedGlobalCollection[21] && Global.actionScrollBar && Global._extendedGlobalCollection[54] == Global.rulePage);
					Modify Global Variable At Index(_objectVariable_3, Global.actionScrollBar, Remove From Array By Index, Global.i_2 + Global.step);
					If(Global._objectVariable_4[Global.actionScrollBar][Global.i_2 + Global.step] != -1);
						Global.buttonID = Global._objectVariable_4[Global.actionScrollBar][Global.i_2 + Global.step];
						Call Subroutine(DestroyButton);
					End;
					Modify Global Variable At Index(_objectVariable_4, Global.actionScrollBar, Remove From Array By Index, Global.i_2 + Global.step);
					Modify Global Variable At Index(_objectVariable_2, Global.actionScrollBar, Remove From Array By Index, Global.i_2 + Global.step);
					Global.UpdateStack = Global.actionScrollBar;
					Call Subroutine(Update);
					Global._objectVariable_3[Global.actionScrollBar] = Append To Array(Append To Array(Array Slice(
						Global._objectVariable_3[Global.actionScrollBar], 0, Global.i_2 + Global.step + Global.direction), Array(Custom String(
						"{0} {1}", Host Player._extendedPlayerCollection[11][First Of(Global.action_Data)], Global.action_Data[1]))), Array Slice(
						Global._objectVariable_3[Global.actionScrollBar], Global.i_2 + Global.step + Global.direction, 999));
					Global._objectVariable_2[Global.actionScrollBar] = Append To Array(Append To Array(Array Slice(
						Global._objectVariable_2[Global.actionScrollBar], 0, Global.i_2 + Global.step + Global.direction), Array(Color(White))),
						Array Slice(Global._objectVariable_2[Global.actionScrollBar], Global.i_2 + Global.step + Global.direction, 999));
					Global._objectVariable_4[Global.actionScrollBar] = Append To Array(Append To Array(Array Slice(
						Global._objectVariable_4[Global.actionScrollBar], 0, Global.i_2 + Global.step + Global.direction), Array(-1)), Array Slice(
						Global._objectVariable_4[Global.actionScrollBar], Global.i_2 + Global.step + Global.direction, 999));
					Global.UpdateStack = Global.actionScrollBar;
					Call Subroutine(Update);
					Global.actionsSelected[Global.i_2 + Global.direction + Global.step] = !Global.isUndo;
					If(
						Global.i_2 + Global.step + Global.direction >= Global._objectVariable_8[Global.actionScrollBar] && Global.i_2 + Global.step + Global.direction < Global._objectVariable_8[Global.actionScrollBar] + Global._objectVariable_7[Global.actionScrollBar]);
						Event Player.cm_buttons_DefaultColor[Index Of Array Value(Event Player.cm_buttons_ID,
							Global._objectVariable_4[Global.actionScrollBar][Global.i_2 + Global.step + Global.direction])
							] = Global.actionsSelected[Global.i_2 + Global.step + Global.direction] ? Color(Green) : Color(White);
					End;
					Global._arrayConstructor = Global._objectVariable_2[Global.actionScrollBar];
					Global._arrayConstructor[Global.i_2 + Global.step + Global.direction] = Global.actionsSelected[Global.i_2 + Global.step + Global.direction] ? Color(
						Green) : Color(White);
					Global._objectVariable_2[Global.actionScrollBar] = Global._arrayConstructor;
				End;
			End;
			Global.i_2 -= Global.direction;
		End;
	}
}

rule("Subroutine: Delete rule")
{
	event
	{
		Subroutine;
		DeleteRule;
	}

	actions
	{
		Event Player.catalogItem_Set = Array(48, Null, Global.rulePage);
		Event Player.catalogItem_Revert = Array(49, Null, Global.rulePage, Global.Rules_Actions_Data[Global.rulePage],
			Global.Rules_ExecutesOnAttribute[Global.rulePage], Global.Rules_EnabledHeroes[Global.rulePage]);
		Call Subroutine(Docment);
	}
}

rule("Subroutine: On Rule Added")
{
	event
	{
		Subroutine;
		OnRuleAdded;
	}

	actions
	{
		"Update the visible rule content if the rule menu is opened."
		If(First Of(Event Player._extendedPlayerCollection) == 3);
			Call Subroutine(initiatePager);
			Call Subroutine(updateRuleContent);
		End;
	}
}

rule("Subroutine: On Rule Removed")
{
	event
	{
		Subroutine;
		OnRuleRemoved;
	}

	actions
	{
		"Update UI after removing rule if the rule menu is opened."
		If(First Of(Event Player._extendedPlayerCollection) == 3 && Global._extendedGlobalCollection[21]);
			"No more rules, remove the pager."
			If(Count Of(Global.Rules_Actions_Data) == 0);
				Global.actionsSelected = Empty Array;
				While(Count Of(Global.pagerButtons));
					Global.buttonID = First Of(Global.pagerButtons);
					Call Subroutine(DestroyButton);
					Modify Global Variable(pagerButtons, Remove From Array By Index, 0);
				End;
				Global._extendedGlobalCollection[21] = False;
				If(Global.actionScrollBar);
					Global.DisposeStack = Global.actionScrollBar;
					Call Subroutine(Dispose);
					Global.actionScrollBar = Null;
				End;
				If(Global.ruleAttributeSelector != Null);
					Global.buttonID = Global._objectVariable_1[Global.ruleAttributeSelector];
					Call Subroutine(DestroyButton);
					Global.buttonID = Global._objectVariable_3[Global.ruleAttributeSelector];
					Call Subroutine(DestroyButton);
					Global.buttonID = Global._objectVariable_2[Global.ruleAttributeSelector];
					Call Subroutine(DestroyButton);
					If(Global.ruleAttributeSelector);
						Global._classIndexes[Global.ruleAttributeSelector] = 0;
						Global._objectVariable_0[Global.ruleAttributeSelector] = 0;
						Global._objectVariable_1[Global.ruleAttributeSelector] = 0;
						Global._objectVariable_2[Global.ruleAttributeSelector] = 0;
						Global._objectVariable_3[Global.ruleAttributeSelector] = 0;
						Global._objectVariable_4[Global.ruleAttributeSelector] = 0;
					Else;
						Log To Inspector(Custom String("[Error] Attempted to delete invalid reference in number selector.del at line 80"));
					End;
					Global.ruleAttributeSelector = Null;
				End;
				If(Global.heroScrollBar != Null);
					Global.DisposeStack = Global.heroScrollBar;
					Call Subroutine(Dispose);
					Global.heroScrollBar = Null;
				End;
			"Switch the currently visible rule to the next visible rule."
			Else;
				"Ensure that the rule page is in range."
				Modify Global Variable(rulePage, Min, Count Of(Global.Rules_Actions_Data) - 1);
				"Update the visible rule content."
				Call Subroutine(updateRuleContent);
			End;
		End;
	}
}

rule("EXPORT: Export")
{
	event
	{
		Subroutine;
		ExportRules;
	}

	actions
	{
		For Player Variable(Event Player, i_1, 0, Count Of(Global.Rules_Actions_Data), 1);
			"Rule syntax"
			Log To Inspector(Array(Custom String("*/ rule(\"【Generated】Custom pathfinding rule #{0}\") { /*", Event Player.i_1 + 1),
				Custom String("*/ rule: \"【Generated】Custom pathfinding rule #{0}\" /*", Event Player.i_1 + 1), Custom String(
				"*/\nrule \"【Generated】Custom pathfinding rule #{0}\": @Event eachPlayer /*", Event Player.i_1 + 1))[Global.outputLanguage]);
			"Get the number of enabled heroes."
			Event Player._extendedPlayerCollection[34] = First Of(Global.Rules_EnabledHeroes[Event Player.i_1]) ? Count Of(All Heroes) - (
				Count Of(Global.Rules_EnabledHeroes[Event Player.i_1]) - 1) : Count Of(Global.Rules_EnabledHeroes[Event Player.i_1]) - 1;
			"Store the first toggled hero. This is effectively the first enabled hero since\r\nanything using this value ensures that the switch is off. This will be null if no heroes are toggled."
			Event Player._extendedPlayerCollection[35] = Global.Rules_EnabledHeroes[Event Player.i_1][1];
			"Add event (ow)"
			If(Global.outputLanguage == 0);
				Log To Inspector(Custom String("*/ event { Ongoing - Each Player; All; {0}; } /*",
					Event Player._extendedPlayerCollection[34] != 1 ? Custom String("All") : Event Player._extendedPlayerCollection[35]));
			"Add event (ostw)"
			Else If(Global.outputLanguage == 1);
				Log To Inspector(Custom String("*/ Event.OngoingPlayer /*"));
				If(Event Player._extendedPlayerCollection[34] == 1);
					Log To Inspector(Custom String("*/ Player.{0} /*", String Replace(String Replace(String Replace(String Replace(String Replace(
						Custom String("{0}", Event Player._extendedPlayerCollection[35]), Custom String(" "), Custom String("")), Custom String(":"),
						Custom String("")), Custom String("ú"), Custom String("")), Custom String("."), Custom String("")), Custom String("ö"),
						Custom String(""))));
				End;
			"Add event (overpy)"
			Else If(Global.outputLanguage == 2 && Event Player._extendedPlayerCollection[34] == 1);
				Log To Inspector(Custom String("*/\n    @Hero {0} /*", Array(Custom String("reaper"), Custom String("tracer"), Custom String(
					"mercy"), Custom String("hanzo"), Custom String("torbjorn"), Custom String("reinhardt"), Custom String("pharah"),
					Custom String("winston"), Custom String("widowmaker"), Custom String("bastion"), Custom String("symmetra"), Custom String(
					"zenyatta"), Custom String("genji"), Custom String("roadhog"), Custom String("mccree"), Custom String("junkrat"),
					Custom String("zarya"), Custom String("soldier"), Custom String("lucio"), Custom String("dva"), Custom String("mei"),
					Custom String("sombra"), Custom String("doomfist"), Custom String("ana"), Custom String("orisa"), Custom String("brigitte"),
					Custom String("moira"), Custom String("wreckingball"), Custom String("sojourn"), Custom String("ashe"), Custom String("echo"),
					Custom String("baptiste"), Custom String("kiriko"), Custom String("junkerqueen"), Custom String("sigma"), Custom String(
					"ramattra"), Custom String("lifeweaver"))[Index Of Array Value(All Heroes, Event Player._extendedPlayerCollection[35])]));
			End;
			Event Player._extendedPlayerCollection[36] = Array Slice(Global.Rules_EnabledHeroes[Event Player.i_1], 1, 1000);
			Event Player._extendedPlayerCollection[37] = Null;
			Event Player._extendedPlayerCollection[38] = Event Player._extendedPlayerCollection[34] > 1 && Event Player._extendedPlayerCollection[34] < Count Of(
				All Heroes);
			If(Event Player._extendedPlayerCollection[38]);
				Event Player._extendedPlayerCollection[39] = Custom String("");
				Event Player._extendedPlayerCollection[40] = 0;
				While(Event Player._extendedPlayerCollection[40] < Count Of(Event Player._extendedPlayerCollection[36]));
					If(Global.outputLanguage == 0);
						Event Player.lambda = Custom String("Hero({0})",
							Event Player._extendedPlayerCollection[36][Event Player._extendedPlayerCollection[40]]);
						Skip(9);
					End;
					If(Global.outputLanguage == 1);
						Event Player.lambda = Custom String("Hero.{0}", String Replace(String Replace(String Replace(String Replace(String Replace(
							Custom String("{0}", Event Player._extendedPlayerCollection[36][Event Player._extendedPlayerCollection[40]]), Custom String(
							" "), Custom String("")), Custom String(":"), Custom String("")), Custom String("ú"), Custom String("")), Custom String("."),
							Custom String("")), Custom String("ö"), Custom String("")));
						Skip(5);
					End;
					If(Global.outputLanguage == 2);
						Event Player.lambda = Custom String("Hero.{0}", Array(Custom String("reaper"), Custom String("tracer"), Custom String("mercy"),
							Custom String("hanzo"), Custom String("torbjorn"), Custom String("reinhardt"), Custom String("pharah"), Custom String(
							"winston"), Custom String("widowmaker"), Custom String("bastion"), Custom String("symmetra"), Custom String("zenyatta"),
							Custom String("genji"), Custom String("roadhog"), Custom String("mccree"), Custom String("junkrat"), Custom String("zarya"),
							Custom String("soldier"), Custom String("lucio"), Custom String("dva"), Custom String("mei"), Custom String("sombra"),
							Custom String("doomfist"), Custom String("ana"), Custom String("orisa"), Custom String("brigitte"), Custom String("moira"),
							Custom String("wreckingball"), Custom String("sojourn"), Custom String("ashe"), Custom String("echo"), Custom String(
							"baptiste"), Custom String("kiriko"), Custom String("junkerqueen"), Custom String("sigma"), Custom String("ramattra"),
							Custom String("lifeweaver"))[Index Of Array Value(All Heroes,
							Event Player._extendedPlayerCollection[36][Event Player._extendedPlayerCollection[40]])]);
						Skip(1);
					End;
					Event Player._extendedPlayerCollection[39] = Custom String("{0}{1}{2}", Event Player._extendedPlayerCollection[39],
						Event Player.lambda, Event Player._extendedPlayerCollection[40] != Count Of(Event Player._extendedPlayerCollection[36])
						- 1 ? Custom String(", ") : Custom String(""));
					Wait(0.016, Ignore Condition);
					Event Player._extendedPlayerCollection[40] += 1;
				End;
				Event Player._extendedPlayerCollection[37] = Event Player._extendedPlayerCollection[39];
			End;
			Event Player._extendedPlayerCollection[41] = !First Of(Global.Rules_EnabledHeroes[Event Player.i_1]);
			"Workshop condition"
			If(Global.outputLanguage == 0);
				Log To Inspector(Custom String("*/ conditions { /*"));
				Log To Inspector(Custom String("*/     Array Contains(Event Player.pfAttributes, {0}) == True; /*",
					Global.Rules_ExecutesOnAttribute[Event Player.i_1]));
				"Multiple heroes"
				If(Event Player._extendedPlayerCollection[38]);
					Log To Inspector(Custom String("*/     Array Contains(Array({0}), Hero Of(Event Player)) == {1}; /*",
						Event Player._extendedPlayerCollection[37], Event Player._extendedPlayerCollection[41]));
				End;
				Log To Inspector(Custom String("*/ } actions { /*"));
			"OSTW condition"
			Else If(Global.outputLanguage == 1);
				Log To Inspector(Custom String("*/ if (pfAttributes.Contains({0})) /*", Global.Rules_ExecutesOnAttribute[Event Player.i_1]));
				"Multiple heroes"
				If(Event Player._extendedPlayerCollection[38]);
					Log To Inspector(Custom String("*/ if ({0}[{1}].Contains(HeroOf())) /*",
						Event Player._extendedPlayerCollection[41] ? Custom String("") : Custom String("!"),
						Event Player._extendedPlayerCollection[37]));
				End;
				"Start rule block"
				Log To Inspector(Custom String("*/ { /*"));
			"Overpy condition"
			Else If(Global.outputLanguage == 2);
				Log To Inspector(Custom String("*/\n    @Condition {0} in eventPlayer.pfAttributes /*",
					Global.Rules_ExecutesOnAttribute[Event Player.i_1]));
				"Multiple heroes"
				If(Event Player._extendedPlayerCollection[38]);
					Log To Inspector(Custom String("*/\n    @Condition eventPlayer.getCurrentHero() {0} [{1}] /*",
						Event Player._extendedPlayerCollection[41] ? Custom String("in") : Custom String("not in"),
						Event Player._extendedPlayerCollection[37]));
				End;
			End;
			"Loop through each action in the rule."
			For Player Variable(Event Player, a_0, 0, Count Of(Global.Rules_Actions_Data[Event Player.i_1]), 1);
				"Extract the action ID."
				Event Player.data = Global.Rules_Actions_Data[Event Player.i_1][Event Player.a_0];
				"Wait"
				If(First Of(Event Player.data) == 0);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Wait({0}, Ignore Condition);", Event Player.data[1])), Custom String("{0}{1}", Custom String("     "), Custom String(
						"Wait({0});", Event Player.data[1])), Custom String("{0}{1}", Custom String("\n    "), Custom String("wait({0})",
						Event Player.data[1])))[Global.outputLanguage]));
				"Jump"
				Else If(First Of(Event Player.data) == 1);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Jump));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.Jump);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.JUMP)")))[Global.outputLanguage]));
				"Start holding jump"
				Else If(First Of(Event Player.data) == 2);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Start Holding Button(Event Player, Button(Jump));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"StartHoldingButton(EventPlayer(), Button.Jump);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.startForcingButton(Button.JUMP)")))[Global.outputLanguage]));
				"Stop holding jump"
				Else If(First Of(Event Player.data) == 3);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Stop Holding Button(Event Player, Button(Jump));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"StopHoldingButton(EventPlayer(), Button.Jump);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.stopForcingButton(Button.JUMP)")))[Global.outputLanguage]));
				"Ability 1"
				Else If(First Of(Event Player.data) == 4);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Ability 1));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.Ability1);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.ABILITY_1)")))[Global.outputLanguage]));
				"Ability 2"
				Else If(First Of(Event Player.data) == 5);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Ability 2));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.Ability2);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.ABILITY_2)")))[Global.outputLanguage]));
				"Melee"
				Else If(First Of(Event Player.data) == 6);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Melee));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.Melee);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.MELEE)")))[Global.outputLanguage]));
				"Primary fire"
				Else If(First Of(Event Player.data) == 7);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Primary Fire));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.PrimaryFire);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.PRIMARY_FIRE)")))[Global.outputLanguage]));
				"Secondary fire"
				Else If(First Of(Event Player.data) == 8);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Press Button(Event Player, Button(Secondary Fire));")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"PressButton(EventPlayer(), Button.SecondaryFire);")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.forceButtonPress(Button.SECONDARY_FIRE)")))[Global.outputLanguage]));
				"Stop walking"
				Else If(First Of(Event Player.data) == 9);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Stop Throttle In Direction(Event Player);")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"StopThrottleInDirection();")), Custom String("{0}{1}", Custom String("\n    "), Custom String(
						"eventPlayer.stopThrottleInDirection()")))[Global.outputLanguage]));
				"Walk to destination"
				Else If(First Of(Event Player.data) == 10);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Call Subroutine(pfWalkToDestination);")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"pfWalkToDestination();")), Custom String("{0}{1}", Custom String("\n    "), Custom String("pfWalkToDestination()")))
						[Global.outputLanguage]));
				"Look at floor"
				Else If(First Of(Event Player.data) == 11);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Start Facing(Event Player, Direction From Angles(Horizontal Facing Angle Of(Event Player), 89), 1000, To World, None);")),
						Custom String("{0}{1}", Custom String("     "), Custom String(
						"StartFacing(EventPlayer(), DirectionFromAngles(HorizontalFacingAngleOf(), 89), 1000, Relative.ToWorld, FacingRev.None);")),
						Custom String("{0}{1}", Custom String("\n    "), Custom String("{0}{1}", Custom String(
						"eventPlayer.startFacing(angleToDirection(eventPlayer.getHorizontalFacingAngle(), 89), 1000, Relativity.TO_WORLD,"),
						Custom String(" FacingReeval.NONE)"))))[Global.outputLanguage]));
				"Look at destination"
				Else If(First Of(Event Player.data) == 12);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Call Subroutine(pfLookAtDestination);")), Custom String("{0}{1}", Custom String("     "), Custom String(
						"pfLookAtDestination();")), Custom String("{0}{1}", Custom String("\n    "), Custom String("pfLookAtDestination()")))
						[Global.outputLanguage]));
				"Wait for ability 1"
				Else If(First Of(Event Player.data) == 13);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Wait(Ability Cooldown(Event Player, Button(Ability 1)), Ignore Condition);")), Custom String("{0}{1}", Custom String("     "),
						Custom String("Wait(AbilityCooldown(eventPlayer, Button.Ability1));")), Custom String("{0}{1}", Custom String("\n    "),
						Custom String("wait(eventPlayer.getAbilityCooldown(Button.ABILITY_1))")))[Global.outputLanguage]));
				"Wait for ability 2"
				Else If(First Of(Event Player.data) == 14);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Wait(Ability Cooldown(Event Player, Button(Ability 2)), Ignore Condition);")), Custom String("{0}{1}", Custom String("     "),
						Custom String("Wait(AbilityCooldown(eventPlayer, Button.Ability2));")), Custom String("{0}{1}", Custom String("\n    "),
						Custom String("wait(eventPlayer.getAbilityCooldown(Button.ABILITY_2))")))[Global.outputLanguage]));
				"Wait for secondary fire"
				Else If(First Of(Event Player.data) == 15);
					Log To Inspector(Custom String("*/{0} /*", Array(Custom String("{0}{1}", Custom String(" "), Custom String(
						"Wait(Ability Cooldown(Event Player, Button(Secondary Fire)), Ignore Condition);")), Custom String("{0}{1}", Custom String(
						"     "), Custom String("Wait(AbilityCooldown(eventPlayer, Button.SecondaryFire));")), Custom String("{0}{1}", Custom String(
						"\n    "), Custom String("wait(eventPlayer.getAbilityCooldown(Button.SECONDARY_FIRE))")))[Global.outputLanguage]));
				End;
				Wait(0.016, Ignore Condition);
			End;
			"End rule & actions for the c-like languages"
			If(Global.outputLanguage == 0);
				Log To Inspector(Custom String("*/ } } /*"));
			Else If(Global.outputLanguage == 1);
				Log To Inspector(Custom String("*/ } /*"));
			End;
			Wait(0.016, Ignore Condition);
		End;
	}
}

rule("LogCurrentStub")
{
	event
	{
		Subroutine;
		LogCurrentStub;
	}

	actions
	{
		Log To Inspector(Custom String("{0}{1}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}",
			Custom String("*/ "), !Global.outputLanguage ? Custom String("Custom String(") : Custom String(""), Custom String("\"")),
			Event Player.printCompressedDataCurrentString, Custom String("\"")), !Global.outputLanguage ? Custom String(")")
			: Custom String(""), Global.isFinalItem ? Custom String("") : Custom String(", ")), Custom String(" /*")));
	}
}

rule("Print compressed nodes")
{
	event
	{
		Subroutine;
		PrintCompressedNodes;
	}

	actions
	{
		Event Player.printCompressedDataCurrentString = Custom String("");
		For Player Variable(Event Player, printCompressedDataIndex, 0, Count Of(Global.Nodes_Node_UniqueID), 1);
			Event Player.printCompressedDataCurrentString = Custom String("{0}{1}", Event Player.printCompressedDataCurrentString,
				Custom String("{0}{1}{2}", Char In String(Event Player.compressionTable, (X Component Of(
				Global.Nodes_Node_Position[Event Player.printCompressedDataIndex]) * 10 + 4096) / 2), Char In String(
				Event Player.compressionTable, (Y Component Of(Global.Nodes_Node_Position[Event Player.printCompressedDataIndex]) * 10 + 4096)
				/ 2), Char In String(Event Player.compressionTable, (Z Component Of(
				Global.Nodes_Node_Position[Event Player.printCompressedDataIndex]) * 10 + 4096) / 2)));
			If((Event Player.printCompressedDataIndex && Event Player.printCompressedDataIndex % 42 == 0) || (
				Event Player.printCompressedDataIndex == Count Of(Global.Nodes_Node_UniqueID) - 1));
				Global.isFinalItem = Event Player.printCompressedDataIndex == Count Of(Global.Nodes_Node_UniqueID) - 1;
				Call Subroutine(LogCurrentStub);
				Event Player.printCompressedDataCurrentString = Custom String("");
			End;
			Wait(0.016, Ignore Condition);
		End;
	}
}

rule("Add to compressed neighbor data")
{
	event
	{
		Subroutine;
		AddToCompressedNeighborData;
	}

	actions
	{
		If(!Global.value || String Length(Event Player.printCompressedDataCurrentString) >= 128);
			Global.isFinalItem = Global.isFinalItem_0;
			Call Subroutine(LogCurrentStub);
			Event Player.printCompressedDataCurrentString = Global.value;
		Else;
			Event Player.printCompressedDataCurrentString = Custom String("{0}{1}", Event Player.printCompressedDataCurrentString,
				Global.value);
		End;
		Wait(0.016, Ignore Condition);
	}
}

rule("Print compressed neighbors")
{
	event
	{
		Subroutine;
		PrintCompressedNeighbors;
	}

	actions
	{
		Event Player.printCompressedDataCurrentString = Custom String("");
		"For each node"
		For Global Variable(n, 0, Count Of(Global.Nodes_Node_UniqueID), 1);
			"Get the segments connected to the current node."
			Global.connected = Filtered Array(Mapped Array(Global.Segments_ID, Current Array Index),
				Global.Segments_Node1[Current Array Element] == Global.Nodes_Node_UniqueID[Global.n] || Global.Segments_Node2[Current Array Element] == Global.Nodes_Node_UniqueID[Global.n]);
			"For each connection"
			For Global Variable(s, 0, Count Of(Global.connected), 1);
				"Add the neighbor ID to the compressed data."
				Global.value = Char In String(Event Player.compressionTable, 1 + Index Of Array Value(Global.Nodes_Node_UniqueID,
					Global.Segments_Node1[Global.connected[Global.s]] == Global.Nodes_Node_UniqueID[Global.n] ? Global.Segments_Node2[Global.connected[Global.s]] : Global.Segments_Node1[Global.connected[Global.s]]));
				Global.isFinalItem_0 = False;
				Call Subroutine(AddToCompressedNeighborData);
				"Get attributes"
				Global.attributes = Mapped Array(Filtered Array(Mapped Array(Global.Attributes_Value, Current Array Index),
					Global.Nodes_Node_UniqueID[Global.n] == Global.Attributes_Node2[Current Array Element] && (
					Global.Attributes_Node1[Current Array Element] == Global.Segments_Node1[Global.connected[Global.s]] || Global.Attributes_Node1[Current Array Element] == Global.Segments_Node2[Global.connected[Global.s]])),
					Global.Attributes_Value[Current Array Element]);
				For Global Variable(a, 0, Count Of(Global.attributes), 1);
					Global.value = Char In String(Event Player.compressionTable, 1 + Global.attributes[Global.a]);
					Global.isFinalItem_0 = False;
					Call Subroutine(AddToCompressedNeighborData);
				End;
				"End segment"
				Global.value = Char In String(Event Player.compressionTable, 0);
				Global.isFinalItem_0 = False;
				Call Subroutine(AddToCompressedNeighborData);
			End;
			"End node"
			Global.value = Char In String(Event Player.compressionTable, 0);
			Global.isFinalItem_0 = Global.n == Count Of(Global.Nodes_Node_UniqueID) - 1;
			Call Subroutine(AddToCompressedNeighborData);
		End;
		Global.value = Null;
		Global.isFinalItem_0 = True;
		Call Subroutine(AddToCompressedNeighborData);
	}
}

rule("Subroutine: Export Neighbors Pattern")
{
	event
	{
		Subroutine;
		ExportNeighborsPattern;
	}

	actions
	{
		Disable Inspector Recording;
		"For each attribute"
		For Player Variable(Event Player, n, 0, Count Of(Global.Nodes_Node_UniqueID), 1);
			"Get connected segments."
			Event Player.connected = Filtered Array(Mapped Array(Global.Segments_ID, Current Array Index),
				Global.Segments_Node1[Current Array Element] == Global.Nodes_Node_UniqueID[Event Player.n] || Global.Segments_Node2[Current Array Element] == Global.Nodes_Node_UniqueID[Event Player.n]);
			Event Player._extendedPlayerCollection[42] = Custom String("");
			Event Player._extendedPlayerCollection[43] = 0;
			While(Event Player._extendedPlayerCollection[43] < Count Of(Event Player.connected));
				"Find the attributes from node A to node B.\r\nThe core pathfinding code travels from the goal to the player's position,\r\nso attr.Node1 and attr.Node2 are flipped here."
				Event Player.attributes_1 = Mapped Array(Filtered Array(Mapped Array(Global.Attributes_Value, Current Array Index),
					Global.Nodes_Node_UniqueID[Event Player.n] == Global.Attributes_Node2[Current Array Element] && (
					Global.Attributes_Node1[Current Array Element] == Global.Segments_Node1[Event Player.connected[Event Player._extendedPlayerCollection[43]]] || Global.Attributes_Node1[Current Array Element] == Global.Segments_Node2[Event Player.connected[Event Player._extendedPlayerCollection[43]]])),
					Global.Attributes_Value[Current Array Element]);
				"If there are no attributes, use the empty array term."
				Event Player.attrString = Event Player.emptyArray;
				If(Count Of(Event Player.attributes_1) != 0);
					Event Player._extendedPlayerCollection[44] = Custom String("");
					Event Player._extendedPlayerCollection[45] = 0;
					While(Event Player._extendedPlayerCollection[45] < Count Of(Event Player.attributes_1));
						Event Player._extendedPlayerCollection[44] = Custom String("{0}{1}{2}", Event Player._extendedPlayerCollection[44],
							Event Player.attributes_1[Event Player._extendedPlayerCollection[45]], Event Player._extendedPlayerCollection[45] != Count Of(
							Event Player.attributes_1) - 1 ? Custom String(",") : Custom String(""));
						Wait(0.016, Ignore Condition);
						Event Player._extendedPlayerCollection[45] += 1;
					End;
					Event Player.attrString = Custom String("{0}{1}{2}", Event Player.beginArray, Event Player._extendedPlayerCollection[44],
						Event Player.endArray);
				End;
				Event Player._extendedPlayerCollection[42] = Custom String("{0}{1}{2}", Event Player._extendedPlayerCollection[42], Custom String(
					"{0}{1}", Custom String("{0}{1}, {2}", Event Player.beginArray, Index Of Array Value(Global.Nodes_Node_UniqueID,
					Global.Segments_Node1[Event Player.connected[Event Player._extendedPlayerCollection[43]]] == Global.Nodes_Node_UniqueID[Event Player.n] ? Global.Segments_Node2[Event Player.connected[Event Player._extendedPlayerCollection[43]]] : Global.Segments_Node1[Event Player.connected[Event Player._extendedPlayerCollection[43]]]),
					Event Player.attrString), Custom String("{0}", Event Player.endArray)), Event Player._extendedPlayerCollection[43] != Count Of(
					Event Player.connected) - 1 ? Custom String(",") : Custom String(""));
				Wait(0.016, Ignore Condition);
				Event Player._extendedPlayerCollection[43] += 1;
			End;
			Enable Inspector Recording;
			Log To Inspector(Custom String("{0}{1}", Custom String("*/ {0}{1}{2}", Event Player.beginArray,
				Event Player._extendedPlayerCollection[42], Event Player.endArray), Custom String("{0} /*", Event Player.n == Count Of(
				Global.Nodes_Node_UniqueID) - 1 ? Custom String("") : Custom String(","))));
			Disable Inspector Recording;
			Wait(0.030, Ignore Condition);
		End;
		Enable Inspector Recording;
	}
}

rule("Subroutine: Generate map code.")
{
	event
	{
		Subroutine;
		Export;
	}

	actions
	{
		Global.message = Custom String("Exporting, please wait...");
		Call Subroutine(StartLongRunningTask);
		"Enable inspector so we can log the exported code to it."
		Call Subroutine(EnableInspector);
		"Export introduction."
		Log To Inspector(Custom String("Place the following text into your {0} script:{1}\n/*", Array(Custom String("workshop"),
			Custom String("ostw"), Custom String("overpy"))[Global.outputLanguage], Custom String(
			"\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯")));
		Event Player._extendedPlayerCollection[33] = Custom String("{0}{1}", Custom String(
			"\nIn order to pathfind, you must add the core pathfinding code to your gamemode from the following link:\r\nhttps://github.com/Its"),
			Custom String("{0}{1}", Custom String("Deltin/Pathmap-editor/blob/main/pathfinder/core."), Array(Custom String("ow"),
			Custom String("ostw"), Custom String("opy"))[Global.outputLanguage]));
		"1. Export the rules."
		If(Global.buildToggles[1]);
			Call Subroutine(ExportRules);
		End;
		"2. Export the map."
		If(First Of(Global.buildToggles));
			"Export map to workshop."
			If(Global.outputLanguage == 0);
				"Compressed"
				If(Global.buildToggles[2]);
					"Attributes rule"
					Log To Inspector(Custom String("*/ rule(\"【Map】{0} ({1})\") { event { Ongoing - Global; } /*", Current Map, Custom String(
						"compressed")));
					"Conditions"
					Log To Inspector(Custom String("*/ conditions { /*"));
					"Make sure this is the correct map"
					Log To Inspector(Custom String("*/     Current Map == Map({0}); /*", Current Map));
					"Start actions"
					Log To Inspector(Custom String("*/ } actions { /*"));
					"Set pfDecompress"
					Log To Inspector(Custom String("*/     global.pfDecompress = Array(Array( /*"));
					Call Subroutine(LoadCompressionTable);
					"Export nodes"
					Call Subroutine(PrintCompressedNodes);
					"End nodes data array, start neighbors data array"
					Log To Inspector(Custom String("*/ ), Array( /*"));
					"Print compressed neighbors."
					Call Subroutine(PrintCompressedNeighbors);
					Host Player.compressionTable = Null;
					"End array"
					Log To Inspector(Custom String("*/ )); /*"));
					"End action & rule block"
					Log To Inspector(Custom String("{0}{1}", Custom String("*/ } }"), False ? Custom String(" /*") : Custom String("")));
				"Uncompressed"
				Else;
					"Attributes rule"
					Log To Inspector(Custom String("*/ rule(\"【Map】{0} ({1})\") { event { Ongoing - Global; } /*", Current Map, Custom String(
						"nodes")));
					"Conditions"
					Log To Inspector(Custom String("*/ conditions { /*"));
					"Make sure this is the correct map"
					Log To Inspector(Custom String("*/     Current Map == Map({0}); /*", Current Map));
					"Start actions"
					Log To Inspector(Custom String("*/ } actions { /*"));
					"Set loadedMap_segments"
					Log To Inspector(Custom String("*/     global.pfLoadedMap_nodes = Array( /*"));
					"For each attribute"
					For Player Variable(Event Player, exportArrayNumA, 0, Count Of(Global.Nodes_Node_UniqueID), 10);
						Event Player.exportArrayStub = Custom String("");
						For Player Variable(Event Player, exportArrayNumB, Event Player.exportArrayNumA, Min(Event Player.exportArrayNumA + 10, Count Of(
							Global.Nodes_Node_UniqueID)), 1);
							Event Player.exportArrayStub = Custom String("{0}{1}", Event Player.exportArrayStub, Custom String("Vector{0}{1}",
								Global.Nodes_Node_Position[Event Player.exportArrayNumB], Event Player.exportArrayNumB == Count Of(Global.Nodes_Node_UniqueID)
								- 1 ? Custom String("") : Custom String(", ")));
						End;
						Log To Inspector(Custom String("*/{0}/*", Event Player.exportArrayStub));
						Wait(0.016, Ignore Condition);
					End;
					"End pathfinder segments"
					Log To Inspector(Custom String("*/ ); /*"));
					"End action & rule block"
					Log To Inspector(Custom String("{0}{1}", Custom String("*/ } }"), True ? Custom String(" /*") : Custom String("")));
					"Attributes rule"
					Log To Inspector(Custom String("*/ rule(\"【Map】{0} ({1})\") { event { Ongoing - Global; } /*", Current Map, Custom String(
						"neighbors")));
					"Conditions"
					Log To Inspector(Custom String("*/ conditions { /*"));
					"Make sure this is the correct map"
					Log To Inspector(Custom String("*/     Current Map == Map({0}); /*", Current Map));
					"Start actions"
					Log To Inspector(Custom String("*/ } actions { /*"));
					"Set loadedMap_neighors"
					Log To Inspector(Custom String("*/     global.pfLoadedMap_neighbors = Array( /*"));
					Event Player.beginArray = Custom String("Array(");
					Event Player.endArray = Custom String(")");
					Event Player.emptyArray = Custom String("Empty Array");
					Call Subroutine(ExportNeighborsPattern);
					"End array"
					Log To Inspector(Custom String("*/ ); /*"));
					"End action & rule block"
					Log To Inspector(Custom String("{0}{1}", Custom String("*/ } }"), False ? Custom String(" /*") : Custom String("")));
				End;
			"Export map to ostw."
			Else If(Global.outputLanguage == 1);
				"This exported code should be placed in the ostw file."
				If(Global.buildToggles[2]);
					Log To Inspector(Custom String("{0}{1}{2}", Custom String("*/"), Custom String("{0}{1}{2}", Custom String(
						"\nrule: \"【Map】{0} ({1})\"\n", Current Map, Custom String("compressed")), Custom String("if (CurrentMap() == Map.{0}) {\n",
						Host Player.langMaps_ostwName[Index Of Array Value(Host Player.langMaps_map, Current Map)]), Custom String(
						"    {0} = import(\"{1}.jsonc\"){2};\n}", Custom String("pfDecompress"), Current Map, Custom String(""))), Custom String(
						"\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯")));
				Else;
					Log To Inspector(Custom String("{0}{1}{2}", Custom String("*/"), Custom String("{0}{1}{2}", Custom String(
						"\nrule: \"【Map】{0} ({1})\"\n", Current Map, Custom String("nodes")), Custom String("if (CurrentMap() == Map.{0}) {\n",
						Host Player.langMaps_ostwName[Index Of Array Value(Host Player.langMaps_map, Current Map)]), Custom String(
						"    {0} = import(\"{1}.jsonc\"){2};\n}", Custom String("pfLoadedMap.nodes"), Current Map, Custom String(".nodes"))),
						Custom String("/*")));
					Log To Inspector(Custom String("{0}{1}{2}", Custom String("*/"), Custom String("{0}{1}{2}", Custom String(
						"\nrule: \"【Map】{0} ({1})\"\n", Current Map, Custom String("neighbors")), Custom String("if (CurrentMap() == Map.{0}) {\n",
						Host Player.langMaps_ostwName[Index Of Array Value(Host Player.langMaps_map, Current Map)]), Custom String(
						"    {0} = import(\"{1}.jsonc\"){2};\n}", Custom String("pfLoadedMap.neighbors"), Current Map, Custom String(".neighbors"))),
						Custom String("\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯")));
				End;
				"Introduction message"
				Log To Inspector(Custom String("Place the following text into a file named \"{0}.jsonc\":{1}\n/*", Current Map, Custom String(
					"\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯")));
				If(Global.buildToggles[2]);
					Log To Inspector(Custom String("*/ [[ /*"));
					Call Subroutine(LoadCompressionTable);
					Call Subroutine(PrintCompressedNodes);
					Log To Inspector(Custom String("*/ ], [ /*"));
					Call Subroutine(PrintCompressedNeighbors);
					Host Player.compressionTable = Null;
					Log To Inspector(Custom String("*/ ]]"));
				Else;
					"Export Ostw nodes"
					Log To Inspector(Custom String("*/ { \"nodes\": [ /*"));
					For Player Variable(Event Player, exportArrayNumA, 0, Count Of(Global.Nodes_Node_UniqueID), 10);
						Event Player.exportArrayStub = Custom String("");
						For Player Variable(Event Player, exportArrayNumB, Event Player.exportArrayNumA, Min(Event Player.exportArrayNumA + 10, Count Of(
							Global.Nodes_Node_UniqueID)), 1);
							Event Player.exportArrayStub = Custom String("{0}{1}", Event Player.exportArrayStub, Custom String("{0}{1}", Custom String(
								"{\"x\":{0}, \"y\":{1}, \"z\":{2}", X Component Of(Global.Nodes_Node_Position[Event Player.exportArrayNumB]), Y Component Of(
								Global.Nodes_Node_Position[Event Player.exportArrayNumB]), Z Component Of(
								Global.Nodes_Node_Position[Event Player.exportArrayNumB])), Custom String("}{0}", Event Player.exportArrayNumB == Count Of(
								Global.Nodes_Node_UniqueID) - 1 ? Custom String("") : Custom String(", "))));
						End;
						Log To Inspector(Custom String("*/{0}/*", Event Player.exportArrayStub));
						Wait(0.016, Ignore Condition);
					End;
					"Export Ostw segments"
					Log To Inspector(Custom String("*/ ], \"neighbors\": [ /*"));
					Event Player.beginArray = Custom String("[");
					Event Player.endArray = Custom String("]");
					Event Player.emptyArray = Custom String("[]");
					Call Subroutine(ExportNeighborsPattern);
					"Conclude JSON"
					Log To Inspector(Custom String("*/ ] }"));
				End;
			"Export map to overpy."
			Else If(Global.outputLanguage == 2);
				If(Global.buildToggles[2]);
					Log To Inspector(Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}",
						Custom String("*/\nrule \"【Map】"), Current Map, Custom String(" (")), Custom String("compressed"), Custom String(
						")\":\r\n    @Condition getCurrentMap() == Map.")), Host Player.langMaps_overpyName[Index Of Array Value(
						Host Player.langMaps_map, Current Map)], Custom String("\r\n    ")), Custom String("pfDecompress = [["), Custom String(
						" /*")));
					Call Subroutine(LoadCompressionTable);
					Call Subroutine(PrintCompressedNodes);
					Log To Inspector(Custom String("*/ ], [ /*"));
					Call Subroutine(PrintCompressedNeighbors);
					Host Player.compressionTable = Null;
					Log To Inspector(Custom String("*/ ]]"));
					Skip(17);
				End;
				"Export Overpy nodes"
				Log To Inspector(Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}",
					Custom String("*/\nrule \"【Map】"), Current Map, Custom String(" (")), Custom String("nodes"), Custom String(
					")\":\r\n    @Condition getCurrentMap() == Map.")), Host Player.langMaps_overpyName[Index Of Array Value(
					Host Player.langMaps_map, Current Map)], Custom String("\r\n    ")), Custom String("pfLoadedMap_nodes = ["), Custom String(
					" /*")));
				For Player Variable(Event Player, exportArrayNumA, 0, Count Of(Global.Nodes_Node_UniqueID), 10);
					Event Player.exportArrayStub = Custom String("");
					For Player Variable(Event Player, exportArrayNumB, Event Player.exportArrayNumA, Min(Event Player.exportArrayNumA + 10, Count Of(
						Global.Nodes_Node_UniqueID)), 1);
						Event Player.exportArrayStub = Custom String("{0}{1}", Event Player.exportArrayStub, Custom String("{0}{1}", Custom String(
							"vect({0}, {1}, {2}", X Component Of(Global.Nodes_Node_Position[Event Player.exportArrayNumB]), Y Component Of(
							Global.Nodes_Node_Position[Event Player.exportArrayNumB]), Z Component Of(
							Global.Nodes_Node_Position[Event Player.exportArrayNumB])), Custom String("){0}", Event Player.exportArrayNumB == Count Of(
							Global.Nodes_Node_UniqueID) - 1 ? Custom String("") : Custom String(","))));
					End;
					Log To Inspector(Custom String("*/{0}/*", Event Player.exportArrayStub));
					Wait(0.016, Ignore Condition);
				End;
				Log To Inspector(Custom String("*/ ] /*"));
				"Export Overpy neighors"
				Log To Inspector(Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}", Custom String("{0}{1}{2}",
					Custom String("*/\nrule \"【Map】"), Current Map, Custom String(" (")), Custom String("neighbors"), Custom String(
					")\":\r\n    @Condition getCurrentMap() == Map.")), Host Player.langMaps_overpyName[Index Of Array Value(
					Host Player.langMaps_map, Current Map)], Custom String("\r\n    ")), Custom String("pfLoadedMap_neighbors = ["), Custom String(
					" /*")));
				Event Player.beginArray = Custom String("[");
				Event Player.endArray = Custom String("]");
				Event Player.emptyArray = Custom String("[]");
				Call Subroutine(ExportNeighborsPattern);
				Log To Inspector(Custom String("*/ ]"));
			End;
		End;
		Log To Inspector(Custom String("{0}{1}", Custom String("\n⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"),
			Event Player._extendedPlayerCollection[33]));
		"Disable inspector."
		Call Subroutine(DisableInspector);
		Global._extendedGlobalCollection[3] -= 1;
		Global.newState = 1;
		Call Subroutine(SetMenuState);
		"Show code generation completed message."
		Global.objectiveDescription = Custom String("Pathfinding code generated!");
		Global.lines_Type = Array(1, 0, 1, 0);
		Global.lines_Content = Array(Array(Custom String(
			"Your code has been generated, and you are almost ready to start pathfinding players!\n\n"), Color(Lime Green)), Array(
			Custom String("{0}{1}{2}", Custom String(
			"Open the inspector and click the \"Copy To Workshop All Log\" button to copy the generated code to your clipboard.\n"),
			Custom String("Paste the contents into a text editor{0}\n\n", Global.outputLanguage == 0 ? Custom String(
			". Remove the first timestamp and then you can paste the workshop\ncode directly into your game.") : Custom String(
			", then follow the instructions in the text to use the pathfinder.\n")), Event Player._extendedPlayerCollection[33]), Color(
			White)), Array(Custom String(""), Color(White)), Array(Custom String("{0}{1}", Custom String(
			"It is recommended to restart the game instance before doing another export\n"), Custom String(
			"because the copy will include *all* exports. Remember to save your map beforehand\nby copying the action set code!")), Color(
			White)));
		Call Subroutine(showMessage);
	}
}

rule("Subroutine: Execute map mirror")
{
	event
	{
		Subroutine;
		executeMapMirror;
	}

	actions
	{
		Event Player.iterI = 0;
		"0 = nodes, 1 = segments, 2 = attributes"
		Event Player.step = 0;
		"Create mirror progress HUD"
		Create Progress Bar HUD Text(All Players(All Teams), Event Player.iterI / Array(Event Player.nodeLength_0,
			Event Player.segmentLength_0, Event Player.attributeLength_0)[Event Player.step] * 100, Array(Custom String(
			"Mirroring nodes {0}/{1} (1/3)", Event Player.iterI, Event Player.nodeLength_0), Custom String("Mirroring paths {0}/{1} (2/3)",
			Event Player.iterI, Event Player.segmentLength_0), Custom String("Mirroring attributes {0}/{1} (3/3)", Event Player.iterI,
			Event Player.attributeLength_0))[Event Player.step], Top, 100, Color(Orange), Color(White), Visible To and Values,
			Default Visibility);
		Event Player.progressHud = Last Text ID;
		Event Player.center = (Event Player.mirrorStart + Event Player.mirrorEnd) / 2;
		Event Player.flip = Normalize(Cross Product(Normalize(Direction Towards(Event Player.mirrorStart, Event Player.mirrorEnd) * Vector(
			1, Empty Array, 1)), Up));
		"The index of a node's mirrored node can be obtained by doing\r\n`nodeMirrors[nodeIndex]`"
		Event Player.nodeMirrors = Empty Array;
		For Player Variable(Event Player, iterI, 0, Event Player.nodeLength_0, 1);
			If(!(Event Player.iterI % 10));
				Wait(0.016, Ignore Condition);
			End;
			Event Player.pos_0 = Event Player.center + (Global.Nodes_Node_Position[Event Player.iterI] - Event Player.center - 2 * Dot Product(
				Global.Nodes_Node_Position[Event Player.iterI] - Event Player.center, Event Player.flip) * Event Player.flip);
			If(Distance Between(Event Player.pos_0, Global.Nodes_Node_Position[Event Player.iterI]) < 2);
				Event Player.nodeMirrors[Event Player.iterI] = Event Player.iterI;
				Skip(11);
			End;
			Event Player.inRadius = Sorted Array(Array Slice(Global.Nodes_Node_Position, 0, Event Player.nodeLength_0), Distance Between(
				Current Array Element, Event Player.pos_0));
			If(Count Of(Event Player.inRadius) && Distance Between(First Of(Event Player.inRadius), Event Player.pos_0) < 2);
				Event Player.nodeMirrors[Event Player.iterI] = Index Of Array Value(Global.Nodes_Node_Position, First Of(Event Player.inRadius));
				Skip(6);
			End;
			Event Player.nodeMirrors[Event Player.iterI] = Count Of(Global.Nodes_Node_UniqueID);
			Global.NodeUniqueID += 1;
			Modify Global Variable(Nodes_Node_UniqueID, Append To Array, Global.NodeUniqueID);
			Modify Global Variable(Nodes_Node_Position, Append To Array, Event Player.pos_0);
			Modify Global Variable(Nodes_Selected, Append To Array, True);
		End;
		Event Player.step += 1;
		"Mirror segments"
		For Player Variable(Event Player, iterI, 0, Event Player.segmentLength_0, 1);
			If(!(Event Player.iterI % 10));
				Wait(0.016, Ignore Condition);
			End;
			Event Player._extendedPlayerCollection[46] = Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Segments_Node1[Event Player.iterI]);
			Event Player._extendedPlayerCollection[47] = Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Segments_Node2[Event Player.iterI]);
			Event Player._extendedPlayerCollection[48] = Event Player.nodeMirrors[Event Player._extendedPlayerCollection[46]];
			Event Player._extendedPlayerCollection[49] = Event Player.nodeMirrors[Event Player._extendedPlayerCollection[47]];
			If(
				Event Player._extendedPlayerCollection[48] == Event Player._extendedPlayerCollection[46] && Event Player._extendedPlayerCollection[49] == Event Player._extendedPlayerCollection[47]);
				Skip(20);
			End;
			Event Player.mirrorNode1Id = Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[48]];
			Event Player.mirrorNode2Id = Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[49]];
			For Player Variable(Event Player, i_2, 0, Event Player.segmentLength_0, 1);
				If((
					Global.Segments_Node1[Event Player.i_2] == Event Player.mirrorNode1Id && Global.Segments_Node2[Event Player.i_2] == Event Player.mirrorNode2Id)
					|| (
					True && Global.Segments_Node1[Event Player.i_2] == Event Player.mirrorNode2Id && Global.Segments_Node2[Event Player.i_2] == Event Player.mirrorNode1Id));
					Event Player.returnValue_anyWithWait = True;
					Skip(6);
				End;
				If(!(Event Player.i_2 % 40));
					Wait(0.016, Ignore Condition);
				End;
			End;
			Event Player.returnValue_anyWithWait = False;
			If(Event Player.returnValue_anyWithWait);
				Skip(5);
			End;
			Global.SegmentUniqueID += 1;
			Modify Global Variable(Segments_ID, Append To Array, Global.SegmentUniqueID);
			Modify Global Variable(Segments_Node1, Append To Array, Event Player.mirrorNode1Id);
			Modify Global Variable(Segments_Node2, Append To Array, Event Player.mirrorNode2Id);
		End;
		Event Player.step += 1;
		"Mirror attributes"
		For Player Variable(Event Player, iterI, 0, Event Player.attributeLength_0, 1);
			If(!(Event Player.iterI % 10));
				Wait(0.016, Ignore Condition);
			End;
			Event Player._extendedPlayerCollection[50] = Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Attributes_Node1[Event Player.iterI]);
			Event Player._extendedPlayerCollection[51] = Index Of Array Value(Global.Nodes_Node_UniqueID,
				Global.Attributes_Node2[Event Player.iterI]);
			Event Player._extendedPlayerCollection[52] = Event Player.nodeMirrors[Event Player._extendedPlayerCollection[50]];
			Event Player._extendedPlayerCollection[53] = Event Player.nodeMirrors[Event Player._extendedPlayerCollection[51]];
			If(
				Event Player._extendedPlayerCollection[52] == Event Player._extendedPlayerCollection[50] && Event Player._extendedPlayerCollection[53] == Event Player._extendedPlayerCollection[51]);
				Skip(21);
			End;
			Event Player.mirrorNode1Id_0 = Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[52]];
			Event Player.mirrorNode2Id_0 = Global.Nodes_Node_UniqueID[Event Player._extendedPlayerCollection[53]];
			For Player Variable(Event Player, i_3, 0, Event Player.attributeLength_0, 1);
				If((
					Global.Attributes_Node1[Event Player.i_3] == Event Player.mirrorNode1Id_0 && Global.Attributes_Node2[Event Player.i_3] == Event Player.mirrorNode2Id_0)
					|| (
					False && Global.Attributes_Node1[Event Player.i_3] == Event Player.mirrorNode2Id_0 && Global.Attributes_Node2[Event Player.i_3] == Event Player.mirrorNode1Id_0));
					Event Player.returnValue_anyWithWait_0 = True;
					Skip(6);
				End;
				If(!(Event Player.i_3 % 40));
					Wait(0.016, Ignore Condition);
				End;
			End;
			Event Player.returnValue_anyWithWait_0 = False;
			If(Event Player.returnValue_anyWithWait_0);
				Skip(6);
			End;
			Global.AttributeUniqueID += 1;
			Modify Global Variable(Attributes_Value, Append To Array, Global.Attributes_Value[Event Player.iterI]);
			Modify Global Variable(Attributes_ID, Append To Array, Global.AttributeUniqueID);
			Modify Global Variable(Attributes_Node1, Append To Array, Event Player.mirrorNode1Id_0);
			Modify Global Variable(Attributes_Node2, Append To Array, Event Player.mirrorNode2Id_0);
		End;
		"Destroy progess hud"
		Destroy Progress Bar HUD Text(Event Player.progressHud);
		"Notify user"
		Small Message(All Players(All Teams), Custom String("Added {0} nodes", Count Of(Global.Nodes_Node_UniqueID)
			- Event Player.nodeLength_0));
		Small Message(All Players(All Teams), Custom String("Added {0} segments", Count Of(Global.Segments_ID)
			- Event Player.segmentLength_0));
		Small Message(All Players(All Teams), Custom String("Added {0} attributes", Count Of(Global.Attributes_Value)
			- Event Player.attributeLength_0));
		"Update visiblity"
		Call Subroutine(updateRenderingNodes);
	}
}

rule("Subroutine: show multi page message")
{
	event
	{
		Subroutine;
		showPagedMessage;
	}

	actions
	{
		Event Player.msgPages = Global.pages;
		Event Player.msgCurrentPage = 0;
		Modify Global Variable(lambdaParameter_0, Append To Array, Array(0));
		Modify Global Variable(func_group, Append To Array, Array(First Of(Global.pages)));
		Call Subroutine(func_group);
		Global.objectiveDescription = Null;
		Global.lines_Type = Global.lambdaValue_0;
		Global.lines_Content = Global.lambdaValue_1;
		Call Subroutine(showMessage);
	}
}

