		"Insert deleted node"
		Global.Nodes_Node_UniqueID = Append To Array(Append To Array(Array Slice(Global.Nodes_Node_UniqueID, 0, Last Of(Global.func_group)
			[2]), Array(Last Of(Global.func_group)[3])), Array Slice(Global.Nodes_Node_UniqueID, Last Of(Global.func_group)[2], 999));
		Global.Nodes_Node_Position = Append To Array(Append To Array(Array Slice(Global.Nodes_Node_Position, 0, Last Of(Global.func_group)
			[2]), Array(Last Of(Global.func_group)[4])), Array Slice(Global.Nodes_Node_Position, Last Of(Global.func_group)[2], 999));
		Global.Nodes_Selected = Append To Array(Append To Array(Array Slice(Global.Nodes_Selected, 0, Last Of(Global.func_group)[2]),
			Array(False)), Array Slice(Global.Nodes_Selected, Last Of(Global.func_group)[2], 999));
		"Insert deleted segments"
		For Global Variable(waitlessI, 0, Count Of(Last Of(Global.func_group)[5]), 1);
