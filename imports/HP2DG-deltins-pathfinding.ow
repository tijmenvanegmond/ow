		For Global Variable(waitlessI, Count Of(Last Of(Global.func_group)[2]) - 1, -1, -1);
			Global.index_0 = First Of(Last Of(Global.func_group)[2][Global.waitlessI]);
			Call Subroutine(RemoveSegmentByIndex);
		End;
		"Delete attributes"
		For Global Variable(waitlessI, Count Of(Last Of(Global.func_group)[3]) - 1, -1, -1);
			Global.index_1 = First Of(Last Of(Global.func_group)[3][Global.waitlessI]);
