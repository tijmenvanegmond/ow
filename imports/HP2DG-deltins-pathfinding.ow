rule("Editor: path mode exit")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		(Global.attributeMode || Global.editorState != 0) == True;
	}

	actions
	{
		Call Subroutine(DestroyConnectionBeams);
	}
}

