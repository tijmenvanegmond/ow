rule("Subroutine: Set Language Select Labels")
{
	event
	{
		Subroutine;
		SetLanguageSelectLabels;
	}

	actions
	{
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[31])
			] = Global.outputLanguage == 0 ? Custom String("【Workshop】") : Custom String("Workshop");
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[32])
			] = Global.outputLanguage == 1 ? Custom String("【Ostw】") : Custom String("Ostw");
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[33])
			] = Global.outputLanguage == 2 ? Custom String("【Overpy】") : Custom String("Overpy");
		Event Player.cm_buttons_Label[Index Of Array Value(Event Player.cm_buttons_ID, Global._extendedGlobalCollection[34])
			] = Custom String("{0}Generate code for {1}{0}", Ability Icon String(Hero(Torbjörn), Button(Ability 2)), Array(Custom String(
			"the workshop"), Custom String("ostw"), Custom String("overpy"))[Global.outputLanguage]);
	}
}

