rule("(Subroutine) CM: Update menu")
{
	event
	{
		Subroutine;
		SetMenuState;
	}

	actions
	{
		If(Global.newState == First Of(Event Player._extendedPlayerCollection));
			Skip(149);
		End;
		If(Event Player._extendedPlayerCollection[5]);
			Global.buttonID = Global._objectVariable_1[Event Player._extendedPlayerCollection[5]];
			Call Subroutine(DestroyButton);
			Global.buttonID = Global._objectVariable_3[Event Player._extendedPlayerCollection[5]];
			Call Subroutine(DestroyButton);
			Global.buttonID = Global._objectVariable_2[Event Player._extendedPlayerCollection[5]];
			Call Subroutine(DestroyButton);
			If(Event Player._extendedPlayerCollection[5]);
				Global._classIndexes[Event Player._extendedPlayerCollection[5]] = 0;
				Global._objectVariable_0[Event Player._extendedPlayerCollection[5]] = 0;
				Global._objectVariable_1[Event Player._extendedPlayerCollection[5]] = 0;
				Global._objectVariable_2[Event Player._extendedPlayerCollection[5]] = 0;
				Global._objectVariable_3[Event Player._extendedPlayerCollection[5]] = 0;
				Global._objectVariable_4[Event Player._extendedPlayerCollection[5]] = 0;
			Else;
				Log To Inspector(Custom String("[Error] Attempted to delete invalid reference in number selector.del at line 80"));
			End;
			Event Player._extendedPlayerCollection[5] = Null;
		End;
		While(Count Of(Event Player.buttonCollectionMain));
			Global.buttonID = First Of(Event Player.buttonCollectionMain);
			Call Subroutine(DestroyButton);
			Modify Player Variable(Event Player, buttonCollectionMain, Remove From Array By Index, 0);
		End;
		If(First Of(Event Player._extendedPlayerCollection) == 3);
			Global.actionsSelected = Empty Array;
			While(Count Of(Global.pagerButtons));
				Global.buttonID = First Of(Global.pagerButtons);
				Call Subroutine(DestroyButton);
				Modify Global Variable(pagerButtons, Remove From Array By Index, 0);
			End;
			Global._extendedGlobalCollection[21] = False;
			If(Global.actionScrollBar);
				Global.DisposeStack = Global.actionScrollBar;
				Call Subroutine(Dispose);
				Global.actionScrollBar = Null;
			End;
			If(Global.ruleAttributeSelector != Null);
				Global.buttonID = Global._objectVariable_1[Global.ruleAttributeSelector];
				Call Subroutine(DestroyButton);
				Global.buttonID = Global._objectVariable_3[Global.ruleAttributeSelector];
				Call Subroutine(DestroyButton);
				Global.buttonID = Global._objectVariable_2[Global.ruleAttributeSelector];
				Call Subroutine(DestroyButton);
				If(Global.ruleAttributeSelector);
					Global._classIndexes[Global.ruleAttributeSelector] = 0;
					Global._objectVariable_0[Global.ruleAttributeSelector] = 0;
					Global._objectVariable_1[Global.ruleAttributeSelector] = 0;
					Global._objectVariable_2[Global.ruleAttributeSelector] = 0;
					Global._objectVariable_3[Global.ruleAttributeSelector] = 0;
					Global._objectVariable_4[Global.ruleAttributeSelector] = 0;
				Else;
					Log To Inspector(Custom String("[Error] Attempted to delete invalid reference in number selector.del at line 80"));
				End;
				Global.ruleAttributeSelector = Null;
			End;
			If(Global.heroScrollBar != Null);
				Global.DisposeStack = Global.heroScrollBar;
				Call Subroutine(Dispose);
				Global.heroScrollBar = Null;
			End;
		End;
		Event Player._extendedPlayerCollection[0] = Global.newState;
		If(Global.newState == 1 || Global.newState == 3);
			If(Global._extendedGlobalCollection[1] == -1);
				Global.input = Array(Custom String("← undo"), 4, 0, -2.100, -1, 0.400, 0.300, Color(Yellow), Color(Blue), True, True);
				Call Subroutine(__createButtonSubroutine);
				Global._extendedGlobalCollection[1] = Global.returnValue___createButtonSubrou;
				Global.input = Array(Custom String("redo →"), 5, 0, -1.500, -1, 0.400, 0.300, Color(Aqua), Color(Blue), True, True);
				Call Subroutine(__createButtonSubroutine);
				Global._extendedGlobalCollection[2] = Global.returnValue___createButtonSubrou;
				Call Subroutine(UpdateUndoInteractability);
			End;
		Else If(Global._extendedGlobalCollection[1] != -1);
			Global.buttonID = Global._extendedGlobalCollection[1];
			Call Subroutine(DestroyButton);
			Global.buttonID = Global._extendedGlobalCollection[2];
			Call Subroutine(DestroyButton);
			Global._extendedGlobalCollection[1] = -1;
			Global._extendedGlobalCollection[2] = -1;
		End;
		If(Global.newState == 1);
			Global.input = Array(Custom String("〔?〕"), Array(35, Array(1, Null, Null, Array(1, 0, 1, 0, 1, 0, 1, 0), Array(Array(Custom String(
				"{0} Rule Editor {0}", Ability Icon String(Hero(Torbjörn), Button(Ability 2))), Color(Rose)), Array(Custom String(
				"Create workshop rules that will execute upon reaching a path tagged with an attribute."), Color(White)), Array(Custom String(
				"{0} Export {0}", Ability Icon String(Hero(Bastion), Button(Ability 1))), Color(Lime Green)), Array(Custom String(
				"Generates the pathfinding code that you can add to your workshop gamemode."), Color(White)), Array(Custom String(
				"{0} Add Dummy Bot {0}", Ability Icon String(Hero(Echo), Button(Ultimate))), Color(Violet)), Array(Custom String(
				"Spawn dummy bots that you can use to test your map."), Color(White)), Array(Custom String("{0} Pathfinder Settings {0}",
				Ability Icon String(Hero(Kiriko), Button(Ability 1))), Color(Yellow)), Array(Custom String(
				"Set which attributes the dummy bots will use when testing your map."), Color(White))))), Array(36, Array(1, Null, Null, Array(
				1, 0, 1, 0, 1, 0, 1, 0), Array(Array(Custom String("{0} Rule Editor {0}", Ability Icon String(Hero(Torbjörn), Button(
				Ability 2))), Color(Rose)), Array(Custom String(
				"Create workshop rules that will execute upon reaching a path tagged with an attribute."), Color(White)), Array(Custom String(
