		Event Player.Ability_Hud_Check = True;
		Event Player.Heal_Position = Position Of(Event Player);
		Event Player.Heal_Visual_Check = All Players(All Teams);
		For Player Variable(Event Player, Healpack_forloop, 0, 10, 1);
			Heal(Players Within Radius(Event Player.Heal_Position, 10, Team 1, Off), Null, Max Health(Event Player) / 10);
			Wait(0.500, Ignore Condition);
		End;
		Event Player.Heal_Visual_Check = Null;
		Event Player.Heal_Position = Null;
		Event Player.Ability_Hud_Check = False;
	}
}

