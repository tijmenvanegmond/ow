rule("Solo Ana Nano")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		Ana;
	}

	conditions
	{
		Number Of Players(Team 1) == 1;
		Ultimate Charge Percent(Event Player) >= 100;
		Is Button Held(Event Player, Button(Ultimate)) == True;
	}

	actions
	{
		Set Ultimate Charge(Event Player, Ultimate Charge Percent(Event Player) - 100);
		Call Subroutine(Player_Damage_Calc);
		Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Event Player, 100);
		Create Effect(All Players(All Teams), Ana Nano Boosted Effect, Color(Blue), Event Player, 1.500, Visible To Position and Radius);
		Event Player.Solo_Effect_Vis = Last Created Entity;
		Set Damage Dealt(Event Player, Event Player.Damage * 1.500);
		Set Damage Received(Event Player, Global.Rain_Difficulty == 0 ? 70 : (Global.Rain_Difficulty == 1 ? 100 : 130 / 2));
		Heal(Event Player, Null, 250);
		Wait(8, Ignore Condition);
		Destroy Effect(Event Player.Solo_Effect_Vis);
		Call Subroutine(Player_Damage_Calc);
		Set Damage Received(Event Player, Global.Rain_Difficulty == 0 ? 70 : (Global.Rain_Difficulty == 1 ? 100 : 130));
	}
}

