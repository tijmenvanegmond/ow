rule("Ability Visual Effect")
{
	event
	{
		Subroutine;
		Change_Ability_Effects;
	}

	actions
	{
		If(Event Player.Player_Ability_Check == 2);
			Create Effect(Event Player.Heal_Visual_Check, Ring, Color(Yellow), Event Player.Heal_Position, 10, Visible To Position and Radius);
			Event Player.Heal_Effect_IDS = Last Created Entity;
			Create Effect(Event Player.Heal_Visual_Check, Cloud, Color(Yellow), Event Player.Heal_Position, 10,
				Visible To Position and Radius);
			Modify Player Variable(Event Player, Heal_Effect_IDS, Append To Array, Last Created Entity);
			Destroy Effect(Event Player.Drone_id);
			Event Player.Drone_id = Null;
		Else If(Event Player.Player_Ability_Check == 3);
			Create Projectile Effect(Event Player.Drone_Check == True ? All Players(All Teams) : Null, Roadhog Scrap Ball, Null,
				Event Player.Drone_Position, Facing Direction Of(Event Player), 0, Visible To Position Direction and Size);
			Event Player.Drone_id = Last Created Entity;
			Destroy Effect(Index Of Array Value(Event Player.Heal_Effect_IDS, 0));
			Destroy Effect(Index Of Array Value(Event Player.Heal_Effect_IDS, 1));
			Event Player.Heal_Effect_IDS = Null;
		Else;
		End;
	}
}

