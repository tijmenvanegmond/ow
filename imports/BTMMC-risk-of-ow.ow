rule("Player Took Damage; On-Damage Effects")
{
	event
	{
		Player Took Damage;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.isProcessingDamage == False;
		Victim != Attacker;
		Attacker != Null;
		Is Alive(Event Player) == True;
	}

	actions
	{
		Event Player.isProcessingDamage = True;
		"Regen Bandage On-Damage"
		If(Victim.Player_Item_Array[4] > 0);
			Start Rule(Play_Regen_Bandage, Do Nothing);
		End;
		"Truffle Triage On-Damage"
		If(Victim.Player_Item_Array[8] > 0);
			Victim.TruffleTriageTimeStamp = Total Time Elapsed;
			Start Rule(Play_Truffle_Triage, Do Nothing);
		End;
		"Guardian Soul On-Damage"
		If(Victim.Player_Item_Array[10] > 0 && Health(Victim) <= Max Health(Victim) / 4 && Victim.Guardian_Check == True);
			Start Rule(Play_Guardian_Soul, Do Nothing);
		End;
		"Warden Soul On-Damage"
		If(Victim.Player_Item_Array[12] > 0);
			Victim.WardenSoulTimeStamp = Total Time Elapsed;
			Start Rule(Play_Warden_Soul, Do Nothing);
		End;
		"Knuckle Duster On-Damage"
		If(Victim.Player_Item_Array[19] > 0 && Attacker.Knuckleduster_Check == (False || 0));
			Start Rule(Play_Vintage_Knuckleduster, Do Nothing);
		End;
		"Holy Barrier Break On-Damage"
		If(Victim.Player_Item_Array[28] > 0);
			Victim.HolyBarrierTimeStamp = Total Time Elapsed + 2;
			Start Rule(Play_Holy_Barrier, Do Nothing);
		End;
		"Sunfire Cape Proc On-Damage"
		If(Victim.Player_Item_Array[31] > 0);
			Start Rule(Play_SunFire_Cape, Do Nothing);
		End;
		"Desperate Times On-Damage"
		If(Victim.Player_Item_Array[32] > 0 && Health(Victim) <= Max Health(Victim) / 4);
			Start Rule(Play_Desperate_Times, Do Nothing);
		End;
		"Heal-Bane On-Hit (doesnt need items)"
		If(Attacker.Enemy_Class == Custom String("Heal-Bane "));
			Victim.HealBaneTimeStamp = Total Time Elapsed;
			Start Rule(Play_Heal_Bane_Effect, Do Nothing);
		End;
		Wait(0.320, Ignore Condition);
		Event Player.isProcessingDamage = False;
	}
}

