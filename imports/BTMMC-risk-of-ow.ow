rule("Call For Spawn every X seconds")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Spawn_Director == Global.Spawn_Director_Time;
		Global.Game_State != 0;
		Global.Teleporter_Event_Check != 2;
	}

	actions
	{
		Global.Max_Budget = Global.Difficulty_Value / 2 + Max(Number Of Living Players(Team 1) * 3, 4);
		"Stop Spawning if Too Many Enemies"
		If(Number Of Players(Team 2) >= Global.Max_Enemies || Global.Current_Budget >= Global.Max_Budget);
			Global.Spawn_Director = 0;
			Abort;
		End;
		Call Subroutine(Spawn_Enemies);
		Global.Spawn_Director = 0;
		Wait Until(Global.Game_State != 4, 99999);
	}
}

rule("Spawn Enemy Loop")
{
	event
	{
		Subroutine;
		Spawn_Enemies;
	}

	actions
	{
		"0 - normal 1 - summoning 2 - gamble summoning 3 - gamble mini-boss 4- moths 5 - moth infest 6 - pain 7 - balls 8 - summoning mini-boss 9 - Worship 10 - forsaken"
		Stop Chasing Global Variable(Spawn_Director);
		Call Subroutine(Spawn_Amount);
		"Loop for Each Spawn"
		For Global Variable(Spawn_Counter, 0, Global.Spawn_Amount, 1);
			"Abort if Enemy Cap or Max Budget is Reached"
			If(Number Of Players(Team 2) >= Global.Max_Enemies || (Global.Max_Budget <= Global.Current_Budget && Global.Spawning_Type == 0));
				Global.Spawn_Director = 0 + 0.160 * (Global.Spawn_Counter - 1);
				Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
				Global.Spawning_Type = 0;
				Abort;
			End;
			Call Subroutine(Enemy_Group_Select);
			Call Subroutine(Choose_Enemy_Spawned);
			Create Dummy Bot(Global.Enemy_Chooser, Team 2, -1, Global.Enemy_Temp_Spawn, Host Player);
			Global.Current_Spawned_Enemy = Last Created Entity;
			Wait(0.160, Ignore Condition);
			Call Subroutine(Enemy_Type_DropChance_SubClass);
			Call Subroutine(Health_Damage_Calc);
			If(Global.Current_Spawned_Enemy.Enemy_Class == True);
				Call Subroutine(Class_Assignment);
			End;
			Call Subroutine(Enemy_Name_Size_Speed);
			If(Array Contains(Array(3, 8, 10), Global.Spawning_Type));
				Call Subroutine(Mini_Boss_Cooldowns);
			End;
			If(Global.Reality_Checker[12] == True);
				Set Gravity(Global.Current_Spawned_Enemy, 50);
			End;
			Global.Enemy_Spawn_Target = Random Value In Array(Global.Possible_Enemy_Targets);
			Global.Current_Budget += Global.Current_Spawned_Enemy.Enemy_Budget / (Global.Reality_Checker[8] == True ? 2 : 1);
			Call Subroutine(Teleport_Enemy);
			Wait(0.160, Ignore Condition);
		End;
		Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Global.Spawning_Type = 0;
	}
}

rule("Spawn Amount")
{
	event
	{
		Subroutine;
		Spawn_Amount;
	}

	actions
	{
		If(Global.Spawning_Type == 0);
			Global.Spawn_Amount = Random Integer(2, 3);
			If(Number Of Living Players(Team 1) > 1);
				Global.Spawn_Amount += 1 * (Number Of Players(Team 1) - 1);
			End;
		Else If(Array Contains(Array(1, 2), Global.Spawning_Type));
			Global.Spawn_Amount = 1 + 1 * Number Of Living Players(Team 1);
		Else If(Array Contains(Array(3, 8, 10), Global.Spawning_Type));
			Global.Spawn_Amount = 1;
		Else If(Array Contains(Array(4, 5), Global.Spawning_Type));
			Global.Spawn_Amount = 2 + Round To Integer(0.500 * Number Of Living Players(Team 1), Up);
		Else If(Array Contains(Array(6, 7), Global.Spawning_Type));
			Global.Spawn_Amount = 1 + Number Of Living Players(Team 1);
		Else If(Global.Spawning_Type == 9);
			Global.Spawn_Amount = 6;
		End;
		If(Global.Reality_Checker[8] == True);
			Global.Spawn_Amount *= 2;
		End;
	}
}

rule("Select Enemy Group")
{
	event
	{
		Subroutine;
		Enemy_Group_Select;
	}

	actions
	{
		If(Global.Spawning_Type >= 3);
			disabled Log To Inspector(Custom String("No Choosing Group"));
			Abort;
		End;
		If(Global.Reality_Checker[2] == True && Global.Harmony_Hero == 0);
			Global.Harmony_Hero = Random Value In Array(Array(Hero(Brigitte), Hero(Reinhardt), Hero(Torbjörn), Hero(Pharah), Hero(Roadhog),
				Hero(Widowmaker), Hero(Reaper), Hero(Soldier: 76), Hero(Winston)));
			Global.Horde_Enemy = Global.Harmony_Hero;
			Global.Tank_Enemy = Global.Harmony_Hero;
			Global.Glass_Enemy = Global.Harmony_Hero;
			Log To Inspector(Custom String("Checking Harmony"));
			Abort;
		Else If(Global.Reality_Checker[2] == True && Global.Harmony_Hero != 0);
			Abort;
		End;
		Skip If(Global.Reality_Checker[1] == True, 21);
		"IF First Stage"
		If(Global.Stage_Number == 1);
			Global.Horde_Enemy = Hero(Brigitte);
			Global.Tank_Enemy = Hero(Reinhardt);
			Global.Glass_Enemy = Hero(Pharah);
		"IF Second Stage"
		Else If(Global.Stage_Number == 2);
			Global.Horde_Enemy = Hero(Torbjörn);
			Global.Tank_Enemy = Hero(Roadhog);
			Global.Glass_Enemy = Hero(Widowmaker);
		"IF Third Stage"
		Else If(Global.Stage_Number == 3);
			Global.Horde_Enemy = Hero(Reaper);
			Global.Tank_Enemy = Hero(Winston);
			Global.Glass_Enemy = Hero(Soldier: 76);
		"IF Forth Stage"
		Else If(Global.Stage_Number == 4);
			Global.Horde_Enemy = Hero(Reaper);
			Global.Tank_Enemy = Hero(Reinhardt);
			Global.Glass_Enemy = Hero(Widowmaker);
		"IF Fifth Stage"
		Else If(Global.Stage_Number == 5);
			Global.Horde_Enemy = Hero(Brigitte);
			Global.Tank_Enemy = Hero(Roadhog);
			Global.Glass_Enemy = Hero(Soldier: 76);
		"Every round after fifth Stage"
		Else;
			"Choose Random Horde Enemy"
			Global.Horde_Enemy = Random Value In Array(Array(Hero(Brigitte), Hero(Torbjörn), Hero(Reaper)));
			"Choose Random Tank Enemy"
			Global.Tank_Enemy = Random Value In Array(Array(Hero(Reinhardt), Hero(Roadhog), Hero(Winston)));
			"Choose Random Glass Enemy"
			Global.Glass_Enemy = Random Value In Array(Array(Hero(Pharah), Hero(Widowmaker), Hero(Soldier: 76)));
		End;
	}
}

rule("Choose Enemy")
{
	event
	{
		Subroutine;
		Choose_Enemy_Spawned;
	}

	actions
	{
		If(Global.Spawning_Type == 3 || Global.Spawning_Type == 8);
			Global.Enemy_Chooser = Random Value In Array(Array(Hero(Bastion), Hero(Mercy), Hero(Orisa), Hero(Wrecking Ball), Hero(Moira)));
		Else If(Global.Spawning_Type == 4 || Global.Spawning_Type == 5);
			Global.Enemy_Chooser = Hero(Echo);
		Else If(Global.Spawning_Type == 6);
			Global.Enemy_Chooser = Global.Tank_Enemy;
		Else If(Global.Spawning_Type == 7);
			Global.Enemy_Chooser = Hero(Jetpack Cat);
		Else If(Global.Spawning_Type == 9);
			Global.Enemy_Chooser = Random Value In Array(Array(Hero(Echo), Hero(Jetpack Cat)));
		Else If(Global.Spawning_Type == 10);
			Global.Enemy_Chooser = Hero Of(Global.Boss);
		Else;
			"Choose Random Enemy Type"
			Global.Enemy_Chooser = Random Integer(0, 4);
			Global.Enemy_Chooser = Global.Enemy_Chooser <= 2 ? Global.Horde_Enemy : (
				Global.Enemy_Chooser == 3 ? Global.Tank_Enemy : Global.Glass_Enemy);
		End;
		disabled Global.Enemy_Chooser = Hero(Roadhog);
	}
}

rule("Enemy Player Type, Drop Rate, Sub-Class Chance, Type Effect")
{
	event
	{
		Subroutine;
		Enemy_Type_DropChance_SubClass;
	}

	actions
	{
		If(Global.Reality_Checker[6] == True);
			Global.Current_Spawned_Enemy.Player_Type = String("Corrupt");
			Global.Current_Spawned_Enemy.Item_Drop_Chance = 2;
		End;
		If(Global.Spawning_Type == 1 || Global.Spawning_Type == 2);
			Global.Current_Spawned_Enemy.Player_Type = String("Vortex");
			Global.Current_Spawned_Enemy.Item_Drop_Chance = 1;
			Global.Current_Spawned_Enemy.Enemy_Budget += 1;
		Else If(Array Contains(Array(3, 8, 10), Global.Spawning_Type));
			Global.Current_Spawned_Enemy.Player_Type = String("Warning");
			Global.Current_Spawned_Enemy.Item_Drop_Chance = 0;
			Global.Current_Spawned_Enemy.Enemy_Budget += 5;
		Else If(Array Contains(Array(4, 5, 7, 9), Global.Spawning_Type));
			Global.Current_Spawned_Enemy.Player_Type = String("Allies");
			Global.Current_Spawned_Enemy.Item_Drop_Chance = 8;
			Global.Current_Spawned_Enemy.Enemy_Budget += 0.500;
		Else If(Global.Spawning_Type == 6);
			Global.Current_Spawned_Enemy.Player_Type = String("Money");
			Global.Current_Spawned_Enemy.Item_Drop_Chance = -1;
			Global.Current_Spawned_Enemy.Enemy_Budget += 2;
		Else;
			Skip If(Global.Reality_Checker[6] == True, 8);
			Global.Corrupt_Random_Chance = Random Integer(0, 5);
			"Set Corruption Chance"
			If(Global.Corrupt_Random_Chance == 0);
				Global.Current_Spawned_Enemy.Player_Type = String("Corrupt");
				Global.Current_Spawned_Enemy.Item_Drop_Chance = 2;
				Global.Current_Spawned_Enemy.Enemy_Budget += 0.500;
			Else;
				Global.Current_Spawned_Enemy.Player_Type = String("Average");
				Global.Current_Spawned_Enemy.Item_Drop_Chance = 4;
			End;
		End;
		"Add Sub-Class"
		If(Global.Game_Loop_Number >= 1 && Random Integer(0, 3) <= Global.Game_Loop_Number);
			Global.Current_Spawned_Enemy.Enemy_Class = True;
		End;
		"Add Enemy Effect"
		If(Global.Current_Spawned_Enemy.Player_Type == String("Warning"));
			Create Effect(All Players(All Teams), Bad Aura, Color(Red), Evaluate Once(Global.Current_Spawned_Enemy), 2.500,
				Visible To Position and Radius);
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Corrupt"));
			Create Effect(All Players(All Teams), Bad Aura, Color(Purple), Evaluate Once(Global.Current_Spawned_Enemy), 1.500,
				Visible To Position and Radius);
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Vortex"));
			Create Effect(All Players(All Teams), Bad Aura, Color(Green), Evaluate Once(Global.Current_Spawned_Enemy), 1.500,
				Visible To Position and Radius);
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Money"));
			Create Effect(All Players(All Teams), Bad Aura, Color(Yellow), Evaluate Once(Global.Current_Spawned_Enemy), 2,
				Visible To Position and Radius);
		End;
		Global.Current_Spawned_Enemy.Haste_Check = Last Created Entity;
	}
}

rule("Health & Damage Calc")
{
	event
	{
		Subroutine;
		Health_Damage_Calc;
	}

	actions
	{
		Global.Current_Spawned_Enemy.Base_Health = Max Health(Global.Current_Spawned_Enemy);
		"Horde Settings"
		If(Hero Of(Global.Current_Spawned_Enemy) == Global.Horde_Enemy);
			Evaluate Once(Global.Current_Spawned_Enemy).Enemy_Budget += 1;
			Global.Current_Spawned_Enemy.Damage = Global.Horde_Base_Stats[2] + Global.Horde_Base_Stats[3] * Global.Difficulty_Value;
			Global.Current_Spawned_Enemy.Health = (Global.Horde_Base_Stats[0] + Global.Difficulty_Value * Global.Horde_Base_Stats[1]) * (
				Global.Current_Spawned_Enemy.Player_Type == String("Corrupt") ? 1.500 : (Global.Current_Spawned_Enemy.Player_Type == String(
				"Vortex") ? 2 : 1));
		"Tank Settings"
		Else If(Hero Of(Global.Current_Spawned_Enemy) == Global.Tank_Enemy);
			Evaluate Once(Global.Current_Spawned_Enemy).Enemy_Budget += 2;
			Set Knockback Dealt(Global.Current_Spawned_Enemy, 10);
			Global.Current_Spawned_Enemy.Damage = Global.Tank_Base_Stats[2] + Global.Tank_Base_Stats[3] * Global.Difficulty_Value;
			Global.Current_Spawned_Enemy.Health = (Global.Tank_Base_Stats[0] + Global.Difficulty_Value * Global.Tank_Base_Stats[1]) * (
				Array Contains(Array(String("Vortex"), String("Money")), Global.Current_Spawned_Enemy.Player_Type) ? 2 : (
				Global.Current_Spawned_Enemy.Player_Type == String("Corrupt") ? 1.500 : 1));
		"Glass Settings"
		Else If(Hero Of(Global.Current_Spawned_Enemy) == Global.Glass_Enemy);
			Evaluate Once(Global.Current_Spawned_Enemy).Enemy_Budget += 2;
			Set Projectile Speed(Global.Current_Spawned_Enemy, 60);
			Global.Current_Spawned_Enemy.Damage = Global.Glass_Base_Stats[2] + Global.Glass_Base_Stats[3] * Global.Difficulty_Value;
			Global.Current_Spawned_Enemy.Health = (Global.Glass_Base_Stats[0] + Global.Difficulty_Value * Global.Glass_Base_Stats[1]) * (
				Global.Current_Spawned_Enemy.Player_Type == String("Corrupt") ? 1.500 : (Global.Current_Spawned_Enemy.Player_Type == String(
				"Vortex") ? 2 : 1));
		"Mini-Boss Settings"
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Warning"));
			Global.Current_Spawned_Enemy.Damage = Global.Boss_Base_Stats[2] + Global.Boss_Base_Stats[3] * Global.Difficulty_Value;
			Global.Current_Spawned_Enemy.Health = (Global.Boss_Base_Stats[0] + Global.Difficulty_Value * Global.Boss_Base_Stats[1])
				* Number Of Living Players(Team 1) * 0.500;
		"Minion Settings"
		Else;
			Set Projectile Speed(Global.Current_Spawned_Enemy, 60);
			Global.Current_Spawned_Enemy.Damage = Global.Minion_Base_Stats[2] + Global.Minion_Base_Stats[3] * Global.Difficulty_Value;
			Global.Current_Spawned_Enemy.Health = Global.Minion_Base_Stats[0] + Global.Minion_Base_Stats[1] * Global.Difficulty_Value;
		End;
		If(Global.Reality_Checker[8] == True);
			Global.Current_Spawned_Enemy.Health /= 2;
		End;
		Add Health Pool To Player(Global.Current_Spawned_Enemy, Health,
			Global.Current_Spawned_Enemy.Health - Global.Current_Spawned_Enemy.Base_Health, True, False);
		Set Damage Dealt(Global.Current_Spawned_Enemy, Global.Current_Spawned_Enemy.Damage);
		disabled Log To Inspector(Custom String("Budget added: {0}", Global.Current_Spawned_Enemy.Enemy_Budget));
	}
}

rule("Health & Damage Calc Boss")
{
	event
	{
		Subroutine;
		Health_Damage_Calc_Boss;
	}

	actions
	{
		Global.Boss.Base_Health = Max Health(Global.Boss);
		Global.Boss.Damage = Global.Boss_Base_Stats[2] + Global.Difficulty_Value * Global.Boss_Base_Stats[3] * (Hero Of(Global.Boss)
			!= Hero(Doomfist) ? 1 : 1.500);
		Global.Boss.Health = (Global.Boss_Base_Stats[0] + Global.Difficulty_Value * Global.Boss_Base_Stats[1]) * Max(
			Number Of Living Players(Team 1) * 0.750, 1) * (Hero Of(Global.Boss) == Hero(Doomfist) ? 2.250 : (
			Global.Challenge_Toggle == True && Global.Altar_Type_Array[0] == 0 ? 2 : 1));
		Add Health Pool To Player(Global.Boss, Health, Global.Boss.Health - Global.Boss.Base_Health, True, False);
		Set Damage Dealt(Global.Boss, Global.Boss.Damage);
		If(Global.Boss.Health > 10000);
			Global.OverFlow_Boss_Health = Global.Boss.Health;
			Global.OverFlow_Boss_Health -= 10000;
			While(Global.OverFlow_Boss_Health >= 0);
				Add Health Pool To Player(Global.Boss, Health, Global.OverFlow_Boss_Health, True, False);
				Global.OverFlow_Boss_Health -= 10000;
				Wait(0.016, Ignore Condition);
			End;
			Wait(0.016, Ignore Condition);
		End;
		Set Player Health(Global.Boss, Global.Boss.Health);
		Heal(Event Player, Null, Global.Boss.Health);
	}
}

rule("Class Assignment")
{
	event
	{
		Subroutine;
		Class_Assignment;
	}

	actions
	{
		Global.Enemy_Classes = Array(1, 2, 3, 4, 5);
		Modify Global Variable(Enemy_Classes, Remove From Array By Value, Null);
		Global.Current_Spawned_Enemy.Enemy_Class = Random Value In Array(Global.Enemy_Classes);
		If(Global.Current_Spawned_Enemy.Enemy_Class == 1);
			Global.Current_Spawned_Enemy.Enemy_Class = Custom String("Armoured ");
			Add Health Pool To Player(Global.Current_Spawned_Enemy, Armor, Global.Current_Spawned_Enemy.Health / 2, True, True);
		Else If(Global.Current_Spawned_Enemy.Enemy_Class == 2);
			Global.Current_Spawned_Enemy.Enemy_Class = Custom String("Speedy ");
		Else If(Global.Current_Spawned_Enemy.Enemy_Class == 3);
			Global.Current_Spawned_Enemy.Enemy_Class = Custom String("Heal-Bane ");
		Else If(Global.Current_Spawned_Enemy.Enemy_Class == 4);
			Global.Current_Spawned_Enemy.Enemy_Class = Custom String("Explosive ");
		Else If(Global.Current_Spawned_Enemy.Enemy_Class == 5);
			Global.Current_Spawned_Enemy.Enemy_Class = Custom String("Deadly ");
			Set Damage Dealt(Global.Current_Spawned_Enemy, Global.Current_Spawned_Enemy.Damage * 1.500);
		End;
	}
}

rule("Enemy Name, Size And Speed")
{
	event
	{
		Subroutine;
		Enemy_Name_Size_Speed;
	}

	actions
	{
		"Size of Enemy"
		Start Scaling Player(Evaluate Once(Global.Current_Spawned_Enemy), Global.Current_Spawned_Enemy.Player_Type == String("Vortex")
			? 1.500 : (Global.Current_Spawned_Enemy.Player_Type == String("Money") ? 1.500 : (
			Global.Current_Spawned_Enemy.Player_Type == String("Corrupt") ? 1.250 : (Global.Current_Spawned_Enemy.Player_Type == String(
			"Allies") ? 0.400 : 1))), False);
		"Names of Enemies (Mini Boss)"
		If(Global.Current_Spawned_Enemy.Player_Type == String("Warning"));
			Start Forcing Dummy Bot Name(Global.Current_Spawned_Enemy, Custom String("{0}{1}",
				Global.Current_Spawned_Enemy.Enemy_Class != 0 ? Global.Current_Spawned_Enemy.Enemy_Class : String(""), Hero Of(
				Global.Current_Spawned_Enemy) == Hero(Bastion) ? Custom String("Metal Squire") : (Hero Of(Global.Current_Spawned_Enemy)
				== Hero(Mercy) ? Custom String("Mothling") : (Hero Of(Global.Current_Spawned_Enemy) == Hero(Orisa) ? Custom String(
				"Warframe Initiate") : (Hero Of(Global.Current_Spawned_Enemy) == Hero(Wrecking Ball) ? Custom String("Medium Marble")
				: Custom String("Weeb Doctor"))))));
		"Names of Enemies"
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Allies"));
			Start Forcing Dummy Bot Name(Global.Current_Spawned_Enemy, Custom String("{0}{1}",
				Global.Current_Spawned_Enemy.Enemy_Class == 0 ? String("") : Global.Current_Spawned_Enemy.Enemy_Class, Hero Of(
				Global.Current_Spawned_Enemy) == Hero(Echo) ? Custom String("Moth") : Custom String("Evil Kitty")));
		Else;
			Start Forcing Dummy Bot Name(Global.Current_Spawned_Enemy, Custom String("{2}{0}{1}",
				Global.Current_Spawned_Enemy.Player_Type == String("Corrupt") ? Custom String("{0}TX C00000000003FCF> ", Global.holygrail) : (
				Global.Current_Spawned_Enemy.Player_Type == String("Vortex") ? Custom String("{0}TX C0000000002A9EC> ", Global.holygrail) : (
				Global.Current_Spawned_Enemy.Player_Type == String("Money") ? Custom String("{0}TX C00000000008E02> ", Global.holygrail)
				: Custom String(""))), Global.Enemy_Chooser, Global.Current_Spawned_Enemy.Enemy_Class == 0 ? Custom String("")
				: Global.Current_Spawned_Enemy.Enemy_Class));
		End;
		"Speed of Enemies"
		If(Array Contains(Array(String("Corrupt"), String("Vortex"), String("Money")), Global.Current_Spawned_Enemy.Player_Type));
			Global.Current_Spawned_Enemy.Movespeed = 70 + 1 * Global.Difficulty_Value;
		Else If(Global.Current_Spawned_Enemy.Player_Type == String("Allies"));
			Global.Current_Spawned_Enemy.Movespeed = 80 + 1 * Global.Difficulty_Value;
		Else;
			Global.Current_Spawned_Enemy.Movespeed = 60 + 1 * Global.Difficulty_Value;
		End;
		Set Move Speed(Global.Current_Spawned_Enemy, Global.Current_Spawned_Enemy.Enemy_Class == Custom String("Speedy ")
			? Global.Current_Spawned_Enemy.Movespeed * 1.500 : Global.Current_Spawned_Enemy.Movespeed);
	}
}

rule("Teleport Enemy to spawn Point")
{
	event
	{
		Subroutine;
		Teleport_Enemy;
	}

	actions
	{
		Wait(0.160, Ignore Condition);
		If(Array Contains(Array(1, 8, 9, 10), Global.Spawning_Type));
			Teleport(Global.Current_Spawned_Enemy, Nearest Walkable Position(Global.Event_Reference_Locations[2] + Vector(Random Real(-20, 20),
				0, Random Real(-20, 20))));
		Else If(Array Contains(Array(2, 3, 4, 6), Global.Spawning_Type));
			Teleport(Global.Current_Spawned_Enemy, Nearest Walkable Position(Global.Event_Reference_Locations[3] + Vector(Random Real(-20, 20),
				0, Random Real(-20, 20))));
		Else If(Array Contains(Array(5, 7), Global.Spawning_Type));
			Teleport(Global.Current_Spawned_Enemy, Nearest Walkable Position(Global.Boss + Vector(Random Real(-10, 10), 0, Random Real(-10,
				10))));
		Else;
			Global.Potential_Spawns = Filtered Array(Global.Spawn_Point_List, Is In Line of Sight(Global.Enemy_Spawn_Target,
				Current Array Element, All Barriers Block LOS) && Distance Between(Global.Enemy_Spawn_Target, Current Array Element) > 10);
			If(Count Of(Global.Potential_Spawns) == 0);
				Global.Potential_Spawns = Filtered Array(Global.Spawn_Point_List, Distance Between(Global.Enemy_Spawn_Target,
					Current Array Element) < 40 && Distance Between(Global.Enemy_Spawn_Target, Current Array Element) > 10);
			End;
			Global.Chosen_Spawn_Point = Random Value In Array(Global.Potential_Spawns);
			If(Global.Chosen_Spawn_Point == 0);
				Teleport(Global.Current_Spawned_Enemy, Nearest Walkable Position(Global.Event_Reference_Locations[0]));
			Else;
				Teleport(Global.Current_Spawned_Enemy, Global.Chosen_Spawn_Point);
			End;
			disabled Log To Inspector(Global.Chosen_Spawn_Point);
			Set Facing(Global.Current_Spawned_Enemy, Direction Towards(Global.Current_Spawned_Enemy, Global.Enemy_Spawn_Target.Enemy_Target),
				To Player);
	}
}

rule("Move Enemy if not in line of sight and too far away")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Event Player.Player_Type != String("Boss");
		Is True For All(All Living Players(Team 1), Is In Line of Sight(Current Array Element, Event Player, Barriers Do Not Block LOS)
			== False) == True;
	}

	actions
	{
		Wait(Random Real(5, 10), Abort When False);
		Event Player.Enemy_Target = Player Closest To Reticle(Event Player, Team 1);
		Event Player.Potential_Respawns = Filtered Array(Global.Spawn_Point_List, Is In Line of Sight(Current Array Element,
			Event Player.Enemy_Target, All Barriers Block LOS) && Distance Between(Current Array Element, Event Player.Enemy_Target) > 10);
		If(Event Player.Potential_Respawns == 0);
			Event Player.Potential_Respawns = Filtered Array(Global.Spawn_Point_List, Is In Line of Sight(Current Array Element,
				Event Player.Enemy_Target, All Barriers Block LOS) && Distance Between(Current Array Element, Event Player.Enemy_Target) > 10);
		End;
		Event Player.Respawn_Location = Random Value In Array(Event Player.Potential_Respawns);
		Teleport(Event Player, Nearest Walkable Position(Event Player.Respawn_Location));
		Set Facing(Event Player, Direction Towards(Event Player, Event Player.Enemy_Target), To Player);
		Loop If Condition Is True;
	}
}

rule("General Enemy Walking Script")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Event Player != Global.Boss;
		(Event Player.Player_Type != String("Warning")) == True;
		Is Alive(Event Player) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If(Array Contains(Array(Hero(Brigitte), Hero(Reinhardt), Hero(Torbjörn), Hero(Roadhog), Hero(Winston), Hero(Reaper), Hero(Echo),
			Hero(Jetpack Cat)), Hero Of(Event Player)));
			If(Speed Of(Event Player) == 0);
				Start Throttle In Direction(Event Player, Forward, 1, To Player, Replace existing throttle, Direction and Magnitude);
			End;
		Else If(Array Contains(Array(Hero(Pharah), Hero(Soldier: 76)), Hero Of(Event Player)));
			If(Speed Of(Event Player) == 0);
				Start Throttle In Direction(Event Player, Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
					> 15 ? Forward : Backward, 1, To Player, Replace existing throttle, Direction and Magnitude);
			End;
		Else If(Array Contains(Array(Hero(Widowmaker)), Hero Of(Event Player)));
		Else;
			Log To Inspector(Custom String("Unknown Enemy??? Movement"));
			Stop Throttle In Direction(Event Player);
			Wait Until(1 == 0, 99999);
		End;
	}
}

rule("General Enemy Targeting Script")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Event Player != Global.Boss;
		(Event Player.Player_Type != String("Warning")) == True;
		Is Alive(Event Player) == True;
		Global.Game_State != 0;
	}

	actions
	{
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(First Of(Sorted Array(
			Global.Possible_Enemy_Targets, Distance Between(Event Player, Current Array Element)))) * 0.750 + Position Of(First Of(
			Sorted Array(Global.Possible_Enemy_Targets, Distance Between(Event Player, Current Array Element)))) * 0.250), 300, To World,
			Direction and Turn Rate);
		Call Subroutine(Range_Set_Up);
	}
}

rule("Enemy Range Set-up")
{
	event
	{
		Subroutine;
		Range_Set_Up;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Brigitte));
			Event Player.Enemy_Attack_Range = 6;
		Else If(Hero Of(Event Player) == Hero(Reinhardt));
			Event Player.Enemy_Attack_Range = 5;
		Else If(Hero Of(Event Player) == Hero(Pharah));
			Event Player.Enemy_Attack_Range = 30;
		Else If(Hero Of(Event Player) == Hero(Torbjörn));
			Event Player.Enemy_Attack_Range = 2.500;
		Else If(Hero Of(Event Player) == Hero(Roadhog));
			Event Player.Enemy_Attack_Range = 15;
		Else If(Hero Of(Event Player) == Hero(Widowmaker));
			Event Player.Enemy_Attack_Range = 45;
		Else If(Hero Of(Event Player) == Hero(Reaper));
			Event Player.Enemy_Attack_Range = 7;
		Else If(Hero Of(Event Player) == Hero(Winston));
			Event Player.Enemy_Attack_Range = 2.500;
		Else If(Hero Of(Event Player) == Hero(Soldier: 76));
			Event Player.Enemy_Attack_Range = 30;
		Else If(Hero Of(Event Player) == Hero(Echo));
			Event Player.Enemy_Attack_Range = 30;
		Else If(Hero Of(Event Player) == Hero(Jetpack Cat));
			Event Player.Enemy_Attack_Range = 30;
		End;
	}
}

rule("General Enemy Attacking Script")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Event Player != Global.Boss;
		(Event Player.Player_Type != String("Warning")) == True;
		Is Alive(Event Player) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If((Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
			< Event Player.Enemy_Attack_Range && Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, Team 1),
			Barriers Do Not Block LOS)) == True);
			If(Hero Of(Event Player) == Hero(Soldier: 76));
				Press Button(Event Player, Button(Primary Fire));
				Wait(0.330, Ignore Condition);
				Press Button(Event Player, Button(Primary Fire));
				Wait(0.330, Ignore Condition);
				Press Button(Event Player, Button(Primary Fire));
				Wait(0.330, Ignore Condition);
			Else If(Hero Of(Event Player) == Hero(Widowmaker));
				If(Is Button Held(Event Player, Button(Secondary Fire)) == False);
					Start Holding Button(Event Player, Button(Secondary Fire));
				End;
				Wait Until(Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, All Teams), Barriers Do Not Block LOS)
					== False, 3);
				Press Button(Event Player, Button(Primary Fire));
			Else If(Hero Of(Event Player) == Hero(Reaper));
				Press Button(Event Player, Button(Primary Fire));
				Wait(1, Ignore Condition);
			Else If(Hero Of(Event Player) == Hero(Winston));
				Press Button(Event Player, Button(Melee));
				Wait(1, Ignore Condition);
			Else If(Hero Of(Event Player) == Hero(Roadhog));
				Press Button(Event Player, Button(Primary Fire));
				Wait(1, Ignore Condition);
			Else If(Array Contains(Array(Hero(Brigitte), Hero(Reinhardt), Hero(Torbjörn), Hero(Pharah), Hero(Echo), Hero(Jetpack Cat)),
					Hero Of(Event Player)));
				Start Holding Button(Event Player, Button(Primary Fire));
				Wait Until(Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
					> Event Player.Enemy_Attack_Range || !Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, Team 1),
					Barriers Do Not Block LOS), 99999);
				Stop Holding Button(Event Player, Button(Primary Fire));
			Else;
				Log To Inspector(Custom String("Unknown Enemy??? Attacking"));
				Wait Until(1 == 0, 99999);
			End;
		End;
		Wait(0.160, Ignore Condition);
		Wait Until(Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
			< Event Player.Enemy_Attack_Range && Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, Team 1),
			Barriers Do Not Block LOS), 99999);
		Loop;
	}
}

