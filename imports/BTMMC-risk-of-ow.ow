rule("Calculate Player Damage")
{
	event
	{
		Subroutine;
		Player_Damage_Calc;
	}

	actions
	{
		Event Player.Damage = 100 + Event Player.Player_Item_Array[2] * 20 + Event Player.Player_Item_Array[21] * 50 + (Is True For Any(
			Global.Ammo_Amplifer_Bugged_Heroes, Hero Of(Event Player) == Current Array Element)
			? Event Player.Player_Item_Array[6] * 5 : 0);
		If(Event Player.Form_Change_Ammo_Flag == True && Hero Of(Event Player) == Hero(D.Va));
			Event Player.Damage = 100 + Event Player.Player_Item_Array[2] * 20 + Event Player.Player_Item_Array[21] * 50;
		Else If(Event Player.Form_Change_Ammo_Flag == False && Hero Of(Event Player) == Hero(Ramattra));
			Event Player.Damage = 100 + Event Player.Player_Item_Array[2] * 20 + Event Player.Player_Item_Array[21] * 50;
		Else If(Event Player.Form_Change_Ammo_Flag == True);
			Event Player.Damage = 100 + Event Player.Player_Item_Array[2] * 20 + Event Player.Player_Item_Array[21] * 50 + Event Player.Player_Item_Array[6] * 5;
		End;
		Set Damage Dealt(Event Player, Event Player.Damage);
	}
}

