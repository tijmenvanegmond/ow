rule("Ammo Amplifer - Max Ammo Bugged Heroes")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Item_Array[6] > 0;
		Is Reloading(Event Player) == True;
	}

	actions
	{
		disabled Small Message(All Players(All Teams), Custom String("Reloading"));
		"These are the heroes that max ammo cannot be changed but ammo can be read and changed; the wait values are the reload times to make it look nice"
		If(Hero Of(Event Player) == Hero(Pharah));
			Wait(0.600, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Reaper));
			Wait(0.800, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Zarya));
			Wait(1.200, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Sombra));
			Wait(0.600, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Roadhog));
			Wait(1, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Ashe));
			Wait(0.750, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(D.Va));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Cassidy));
			Wait(1.200, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Echo));
			Wait(1.200, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Widowmaker));
			Wait(1.500, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Ana));
			Wait(1.300, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Illari));
			Wait(1.800, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Wait Until(Ammo(Event Player, 0) == Max Ammo(Event Player, 0), 9999);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Hazard));
			Wait(1.600, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Junker Queen));
			Wait(0.750, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Ramattra));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Freja));
			Wait(1.200, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Mei));
			Wait(1.200, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Juno));
			Wait(1, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Kiriko));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 1, Event Player.Max_Ammo_Secondary);
		Else If(Hero Of(Event Player) == Hero(Domina));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Emre));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Else If(Hero Of(Event Player) == Hero(Sierra));
			Wait(0.900, Ignore Condition);
			Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		End;
	}
}

