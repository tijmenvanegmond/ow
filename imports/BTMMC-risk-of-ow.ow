rule("Convert Seconds into Minute")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Timer_Seconds == 60;
	}

	actions
	{
		Global.Timer_Minutes += 1;
		Global.Timer_Seconds = 0;
	}
}

rule("Time Scaling")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		(Global.Scaling_Difficulty_Tracker == Global.Scaling_Difficulty_Time) == True;
		Global.Game_State != 0;
	}

	actions
	{
		Global.Difficulty_Value += 1;
		Global.Scaling_Difficulty_Tracker = 0;
		Small Message(All Players(Team 1), Custom String("   Enemies Leveled up!"));
		Play Effect(All Players(Team 1), Debuff Impact Sound, Color(White), All Players(All Teams), 100);
		Log To Inspector(Custom String("MAX Budget: {0}", Global.Max_Budget));
	}
}

rule("Revival Effects")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Game_State == 1;
		Global.Reality_Checker[0] == True;
	}

	actions
	{
		Wait(0.500, Ignore Condition);
		Create Effect(Event Player.Player_Type == String("Down") ? All Players(All Teams) : Null, Ring, Color(Yellow), Position Of(
			Event Player), 3, Visible To Position and Radius);
		Event Player.Revival_Ring = Last Created Entity;
		Create In-World Text(Event Player.Player_Type == String("Down") ? Filtered Array(All Players(Team 1),
			Current Array Element != Event Player) : Null, Hero Icon String(Hero Of(Event Player)), Position Of(Event Player), 3,
			Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Event Player.Revival_Icon = Last Text ID;
		Create Progress Bar HUD Text(Event Player.Player_Type == String("Down") && Event Player.Revival_Progress ? Players Within Radius(
			Event Player, 3, Team 1, Off) : Null, Event Player.Revival_Progress, Custom String("Revivial Time"), Top, 100, Color(Yellow),
			Color(White), Visible To Values and Color, Default Visibility);
		Event Player.Revive_Progress_Bar_ID = Last Text ID;
	}
}

rule("Downed Player")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Type == String("Down");
	}

	actions
	{
		Disable Hero HUD(Event Player);
		Disable Messages(Event Player);
		Disable Built-In Game Mode Respawning(All Players(All Teams));
	}
}

rule("Revive Player")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Type == String("Down");
		Count Of(Filtered Array(Players Within Radius(Event Player, 3, Team 1, Off), Current Array Element.Player_Type != String("Down")))
			>= 1;
	}

	actions
	{
		Event Player.Revive_Time = 3 + Event Player.Revival_Count * 2;
		Chase Player Variable Over Time(Event Player, Revival_Progress, 100, Event Player.Revive_Time, Destination and Duration);
		While(Event Player.Revival_Progress != 100);
			Wait(0.160, Ignore Condition);
			Abort If Condition Is False;
			Abort If(Global.Game_State == 4);
		End;
		Stop Chasing Player Variable(Event Player, Revival_Progress);
		Enable Hero HUD(Event Player);
		Enable Messages(Event Player);
		Resurrect(Event Player);
		Event Player.Player_Type = String("Normal");
		Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
		Set Status(Event Player, Null, Burning, 3);
		Set Status(Event Player, Null, Invincible, 3);
		Wait(3, Ignore Condition);
		Clear Status(Event Player, Invincible);
		Clear Status(Event Player, Burning);
	}
}

rule("Stop Reviving Player")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Type == String("Down");
		Count Of(Filtered Array(Players Within Radius(Event Player, 3, Team 1, Off), Current Array Element.Player_Type != String("Down")))
			< 1;
	}

	actions
	{
		Wait(0.160, Abort When False);
		Stop Chasing Player Variable(Event Player, Revival_Progress);
		Event Player.Revival_Progress = 0;
	}
}

rule("Revival Mercy Fix")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Type == String("Down");
		Is Alive(Event Player) == True;
	}

	actions
	{
		Event Player.Player_Type = String("Normal");
		Enable Hero HUD(Event Player);
		Enable Messages(Event Player);
		Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
		Stop Chasing Player Variable(Event Player, Revival_Progress);
	}
}

rule("When Pressed Crouch; use ability")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Total Time Elapsed >= Event Player.Ability_CD + Event Player.Ability_CD_Value;
		Global.Reality_Checker[3] == False;
		Event Player.Player_Type != String("Down");
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		If(Event Player.Player_Ability_Check == 0);
			Start Rule(Player_Ability_Dash, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 1);
			Start Rule(Player_Ability_Cloak, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 2);
			Start Rule(Player_Ability_Healpack, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 3);
			Start Rule(Player_Ability_ScrapDrone, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 4);
			Start Rule(Player_Ability_JadeBurst, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 5);
			Start Rule(Player_Abiltiy_Haste, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 6);
			Start Rule(Player_Ability_HeathWager, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 7);
			Start Rule(Player_Ability_Veil, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 8);
			Start Rule(Player_Ability_Teleport, Do Nothing);
		Else If(Event Player.Player_Ability_Check == 9);
			Start Rule(Player_Ability_Lullaby, Do Nothing);
		Else;
		End;
		Event Player.Ability_CD = Total Time Elapsed - 1;
	}
}

rule("Ability CD")
{
	event
	{
		Subroutine;
		Player_Ability_Calculate_CD;
	}

	actions
	{
		Event Player.Ability_CD = Total Time Elapsed;
		If(Event Player.Player_Ability_Check == 2);
			Event Player.Ability_CD_Value = 12;
		Else If(Event Player.Player_Ability_Check == 3);
			Event Player.Ability_CD_Value = 20;
		Else If(Event Player.Player_Ability_Check == 4);
			Event Player.Ability_CD_Value = 8;
		Else;
			Event Player.Ability_CD_Value = 15;
		End;
		Event Player.Ability_CD = Total Time Elapsed - Event Player.Ability_CD_Value - 1;
	}
}

rule("Player Ability - Dash")
{
	event
	{
		Subroutine;
		Player_Ability_Dash;
	}

	actions
	{
		Disable Movement Collision With Players(Event Player);
		Set Status(Event Player, Null, Invincible, 1);
		Event Player.Dash_Ending_Location = Ray Cast Hit Position(Eye Position(Event Player), Eye Position(Event Player)
			+ Facing Direction Of(Event Player) * 20, Null, Event Player, True);
		Event Player.Dash_Current = Position Of(Event Player);
		Set Status(Event Player, Null, Burning, 1);
		Start Forcing Player Position(Event Player, Event Player.Dash_Current, True);
		Chase Player Variable At Rate(Event Player, Dash_Current, Event Player.Dash_Ending_Location, 60, Destination and Rate);
		Wait Until(Event Player.Dash_Ending_Location == Event Player.Dash_Current - 8, 0.400);
		Stop Forcing Player Position(Event Player);
		Enable Movement Collision With Players(Event Player);
	}
}

rule("Player Ability - Cloak")
{
	event
	{
		Subroutine;
		Player_Ability_Cloak;
	}

	actions
	{
		Event Player.Ability_Hud_Check = True;
		Apply Impulse(Event Player, Up, 10, To World, Cancel Contrary Motion);
		Set Invisible(Event Player, All);
		Modify Global Variable(Possible_Enemy_Targets, Remove From Array By Value, Event Player);
		Wait(5, Ignore Condition);
		Play Effect(All Players(All Teams), Good Explosion, Color(White), Event Player, 2);
		Set Invisible(Event Player, None);
		Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
		Event Player.Ability_Hud_Check = False;
	}
}

