settings
{
	main
	{
		Description: "A Risk of Rain 2 Inspired Gamemode!\r\nFind the Teleporter\r\nDefeat the Boss\r\nGo to the Next Stage\r\nRepeat!\r\n\r\n[Code:] BTMMC\r\n[Creator:] Clewster22#2775\r\n[Discord:] https://discord.gg/py6YytZmrM\r\n[Last Updated:] 02/06/2026"
		Mode Name: "Risk of Overwatch"
	}

	lobby
	{
		Allow Players Who Are In Queue: Yes
		Match Voice Chat: Enabled
		Max Team 1 Players: 4
		Max Team 2 Players: 0
		Return To Lobby: Never
		Swap Teams After Match: No
	}

	modes
	{
		Skirmish
		{
			enabled maps
			{
				Aatlis 972777519512068153
				New Junk City 972777519512068154
				Suravasa 972777519512068154
			}
		}

		General
		{
			Enable Perks: On
			Game Mode Start: Immediately
			Hero Limit: Off
			Kill Cam: Disabled
			Kill Feed: Disabled
			Limit Valid Control Points: Third
			Spawn Health Packs: Enabled
		}
	}

	heroes
	{
		Team 2
		{
			Health: 10%
			Passive Health Regeneration: Disabled

			Torbjörn
			{
				Weapons Enabled: Forge Hammer Only
			}
		}
	}

	workshop
	{
		Anti Crash - Mininum Slow Thershold: 200
		Anti Crash - Slow Amount: 20
		Auto Restart Timer: 90
		Enemy Damage: 100
		Enemy Health: 100
		Force Specific Item Drop: Off
		Guaranteed Item Drop: Off
		Item Stacks Per Item: 1
	}

	extensions
	{
		Energy Explosion Effects
		Buff Status Effects
		Spawn More Dummy Bots
		Projectiles
	}
}

