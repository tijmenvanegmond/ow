			Explosion Sound, 0, 125, 5, 0, 0, 0);
		Create Projectile(Orisa Fusion Driver, Event Player, Eye Position(Event Player), Facing Direction Of(Event Player)
			+ World Vector Of(Left, Event Player, Rotation) * 0.100, To World, Damage, Team 2, 20, 1, 0, Bad Explosion, Explosion Sound, 0,
			125, 5, 0, 0, 0);
		Create Projectile(Orisa Fusion Driver, Event Player, Eye Position(Event Player), Facing Direction Of(Event Player)
			+ World Vector Of(Left, Event Player, Rotation) * -0.100, To World, Damage, Team 2, 20, 1, 0, Bad Explosion, Explosion Sound,
			0, 125, 5, 0, 0, 0);
		Wait(0.500, Ignore Condition);
		Loop If(Event Player.Jade_Burst_Count < 3);
		Event Player.Jade_Burst_Count = 0;
	}
}

