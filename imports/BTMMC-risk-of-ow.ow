rule("Holy Barrier Effect")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Player_Item_Array[28] > 0;
	}

	actions
	{
		Event Player.Holy_Barrier_Check = True;
		Set Damage Received(Event Player, 0.100);
		Wait Until(Event Player.Holy_Barrier_Check == False, 99999);
		Set Status(Event Player, Null, Invincible, 2);
		Set Status(Event Player, Null, Burning, 2);
		Wait(2, Ignore Condition);
		Clear Status(Event Player, Invincible);
		Clear Status(Event Player, Burning);
		Set Damage Received(Event Player, Global.Rain_Difficulty == 0 ? 70 : (Global.Rain_Difficulty == 1 ? 100 : 130));
		Wait Until(Event Player.Holy_Barrier_Check == True, 99999);
		Loop;
	}
}

rule("Player Took Damage; On-hit Effects")
{
	event
	{
		Player Took Damage;
		Team 2;
		All;
	}

	conditions
	{
		Event Player.isProcessingDamage == False;
		Victim != Attacker;
		Attacker != Null;
		Is Alive(Event Player) == True;
	}

	actions
	{
		Event Player.isProcessingDamage = True;
		Log To Inspector(Custom String("Processing Damage for: {0}", Victim));
		"Icicle Spear On-Hit"
		If(Attacker.Player_Item_Array[5] > 0 && Victim.Player_Type != String("Boss") && Victim != Has Status(Victim, Frozen));
			Start Rule(Play_Icicle_Spear, Do Nothing);
		End;
		"Resin Explosive On-Hit"
		If(Attacker.Player_Item_Array[7] > 0 && Victim.Resin_Check == False);
			Start Rule(Play_Resin_Explosive, Do Nothing);
		End;
		"Moth Soul On-Hit"
		If(Attacker.Player_Item_Array[11] > 0);
			Start Rule(Play_Moth_Soul, Do Nothing);
		End;
		"Relic Scope On-Hit"
		If(Attacker.Player_Item_Array[16] > 0);
			Start Rule(Play_Relic_Scope, Do Nothing);
		End;
		"Dragon's Fang On-Hit"
		If(Attacker.Player_Item_Array[22] > 0 && Event Damage >= 80);
			Start Rule(Play_Dragon_Fang, Do Nothing);
		End;
		"Vital-Point-Reader On-Hit"
		If(Attacker.Player_Item_Array[24] > 0 && Event Was Critical Hit);
			Start Rule(Play_Vital_Point_Reader, Do Nothing);
		End;
		"Titan's Catalyst Boost On-Hit"
		If(Attacker.Player_Item_Array[26] > 0 && Victim.Player_Type == String("Boss"));
			Start Rule(Play_Titan_Catalyst, Do Nothing);
		End;
		"Sippy Straw LifeSteal On-Hit"
		If(Attacker.Player_Item_Array[27] > 0 && Health(Attacker) < Max Health(Attacker));
			Start Rule(Play_Sippy_Straw, Do Nothing);
		End;
		"Demon Seal Execute On-Hit"
		If(Attacker.Player_Item_Array[30] > 0 && Victim.Player_Type == String("Corrupt"));
			Start Rule(Play_Demon_Seal, Do Nothing);
		End;
		Wait(0.320, Ignore Condition);
		Event Player.isProcessingDamage = False;
		Log To Inspector(Custom String("End Processing Damage for: {0}", Victim));
	}
}

rule("Play Icicle Spear Effect")
{
	event
	{
		Subroutine;
		Play_Icicle_Spear;
	}

	actions
	{
		Log To Inspector(Custom String("Running Icicle Spear for: {0}", Victim));
		If(Random Integer(1, 100) <= Min(100, Max(10, 7.500 + Attacker.Player_Item_Array[5] * 2.500)));
			Log To Inspector(Custom String("Icicle Success for: {0}", Victim));
			Set Status(Victim, Attacker, Frozen, 0.500);
		End;
		Wait(0.500, Ignore Condition);
	}
}

rule("Play Resin Explosive Effect")
{
	event
	{
		Subroutine;
		Play_Resin_Explosive;
	}

	actions
	{
		Log To Inspector(Custom String("Running Resin Explosive for: {0}", Victim));
		If(Random Integer(1, 100) <= Min(100, Max(10, 7.500 + Attacker.Player_Item_Array[7] * 2.500)));
			Log To Inspector(Custom String("Resin Explosive for: {0}", Victim));
			Create Projectile Effect(All Players(All Teams), Echo Sticky Bomb, Attacker, Eye Position(Victim) + Up, Victim, 0,
				Visible To Position Direction and Size);
			Victim.Resin_Check = Last Created Entity;
			Wait Until(Is Dead(Victim), 2);
			Damage(Players Within Radius(Position Of(Victim), 2.500, Team Of(Victim), Surfaces), Attacker, Attacker.Resin_Explosive_Damage);
			Play Effect(All Players(All Teams), Sigma Hypersphere Implosion Effect, Team Of(Attacker), Victim, 2.500);
			Destroy Effect(Victim.Resin_Check);
		End;
		Victim.Resin_Check = False;
		Wait(0.500, Ignore Condition);
	}
}

rule("Play Moth Soul Effect")
{
	event
	{
		Subroutine;
		Play_Moth_Soul;
	}

	actions
	{
		If(Random Integer(1, 100) <= Min(100, 15 + (Attacker.Player_Item_Array[11] - 1) * 1));
			Create Beam Effect(All Players(All Teams), Bad Beam, Victim + Up * 20, Victim, Color(Yellow), Visible To Position and Radius);
			Victim.Moth_Soul_Effect_id = Last Created Entity;
			Wait(0.160, Ignore Condition);
			Damage(Players Within Radius(Victim, 7, Team Of(Victim), Surfaces), Attacker, 90 + Attacker.Player_Item_Array[11] * 10);
			Play Effect(All Players(All Teams), Explosion Sound, Color(White), Victim.Moth_Soul_Targeting, 50);
			Play Effect(All Players(All Teams), Ring Explosion, Color(Yellow), Victim, 20);
			Play Effect(All Players(All Teams), Zarya Particle Cannon Explosion Effect, Team 1, Victim, 50);
			Wait(0.160, Ignore Condition);
			Destroy Effect(Victim.Moth_Soul_Effect_id);
		End;
		Wait(0.500, Ignore Condition);
	}
}

