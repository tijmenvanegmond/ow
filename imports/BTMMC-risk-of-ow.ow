rule("Player Kill Effects")
{
	event
	{
		Player Earned Elimination;
		Team 1;
		All;
	}

	conditions
	{
		Victim != Attacker;
	}

	actions
	{
		"Soul Burn - on kill"
		If(Attacker.Player_Item_Array[3] > 0);
			Start Rule(Play_Soul_Burn, Do Nothing);
		End;
		"Marble Soul - on kill"
		If(Attacker.Player_Item_Array[13] > 0);
			Attacker.MarbleSoulTimeStamp = Total Time Elapsed;
			Start Rule(Play_Marble_Soul, Do Nothing);
		End;
		"Gen Soul - on kill"
		If(Event Player.Player_Item_Array[14] > 0);
			Start Rule(Play_Geneticist_Soul, Do Nothing);
		End;
		"Arcane Pendant - on kill"
		If(Attacker.Player_Item_Array[18] > 0);
			Start Rule(Play_Arcane_Pendent, Do Nothing);
		End;
		"Spooky Ghost - on kill"
		If(Attacker.Player_Item_Array[23] > 0);
			Start Rule(Play_Spooky_Ghost, Do Nothing);
		End;
		"Scavenger - on kill"
		If(Attacker.Player_Item_Array[33] > 0);
			Start Rule(Play_Scavenger, Do Nothing);
		End;
	}
}

rule("Play Soul Burn Effect")
{
	event
	{
		Subroutine;
		Play_Soul_Burn;
	}

	actions
	{
		Play Effect(All Players(All Teams), Good Explosion, Color(Blue), Victim, 10);
		Start Damage Over Time(Filtered Array(Players Within Radius(Victim, 10, Team Of(Victim), Surfaces), Is Alive(Current Array Element)
			== True), Attacker, 3, Attacker.Soul_Burn_Damage_Calc);
		Set Status(Filtered Array(Players Within Radius(Victim, 10, Team Of(Victim), Surfaces), Is Alive(Current Array Element) == True),
			Attacker, Burning, 3);
		Wait(3, Ignore Condition);
	}
}

rule("Play Marble Soul Effect")
{
