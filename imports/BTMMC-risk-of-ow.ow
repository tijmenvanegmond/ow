		Stop Chasing Player Variable(Event Player, Drone_Position);
	}
}

rule("If Drone is in Line of sight of enemy")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Is In Line of Sight(Event Player.Drone_Position, Eye Position(Player Closest To Reticle(Event Player, Team 2)),
			Barriers Do Not Block LOS) == True;
		Event Player.Drone_Check == True;
	}

	actions
	{
		Event Player.Drone_Firing_Position = (Eye Position(Player Closest To Reticle(Event Player, Team 2)) + Position Of(
			Player Closest To Reticle(Event Player, Team 2))) / 2;
		Create Projectile(Roadhog Scrap, Event Player, Event Player.Drone_Position, Direction Towards(Event Player.Drone_Position,
			Event Player.Drone_Firing_Position), To World, Damage, Team 2, 10, 1, 0, Bad Explosion, Explosion Sound, 0, 80, 5, 0, 0, 0);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), Event Player, 1);
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Drone Appear and Disappear Effects")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Event Player.Drone_Check == True;
	}

	actions
	{
		Play Effect(All Players(All Teams), Good Explosion, Color(Black), Event Player.Drone_Position, 1);
		Wait(8, Ignore Condition);
		Play Effect(All Players(All Teams), DVa Micro Missiles Explosion Effect, Color(Black), Event Player.Drone_Position, 1);
		Event Player.Drone_Check = False;
		Event Player.Ability_Hud_Check = False;
	}
}

rule("Event Location Chooser")
{
	event
	{
		Subroutine;
		Event_Location_Chooser;
	}

	actions
	{
		Global.Event_Location = Global.Teleporter_Locations;
		Global.Event_Location_Name = Global.Teleporter_Locations_Name;
		Global.Temp_Location_Pool = Global.Event_Location;
		Global.Temp_Name_Pool = Global.Event_Location_Name;
		Global.Event_Reference_Locations = Empty Array;
		Global.Event_Reference_Name = Empty Array;
		"Choose Teleporter"
		Global.Teleporter_Chooser = Random Integer(0, 4);
		Modify Global Variable(Event_Reference_Locations, Append To Array, Global.Temp_Location_Pool[Global.Teleporter_Chooser]);
		Modify Global Variable(Event_Reference_Name, Append To Array, Global.Temp_Name_Pool[Global.Teleporter_Chooser]);
		Modify Global Variable(Temp_Location_Pool, Remove From Array By Index, Global.Teleporter_Chooser);
		Modify Global Variable(Temp_Name_Pool, Remove From Array By Index, Global.Teleporter_Chooser);
		Wait(0.016, Ignore Condition);
		"Choose Queen"
		Global.Event_Chooser = Random Integer(0, 3);
		Modify Global Variable(Event_Reference_Locations, Append To Array, Global.Temp_Location_Pool[Global.Event_Chooser]);
		Modify Global Variable(Event_Reference_Name, Append To Array, Global.Temp_Name_Pool[Global.Event_Chooser]);
		Modify Global Variable(Temp_Location_Pool, Remove From Array By Index, Global.Event_Chooser);
		Modify Global Variable(Temp_Name_Pool, Remove From Array By Index, Global.Event_Chooser);
		Global.Altar_Type_Array[0] = Random Integer(0, 2);
		Global.Event_Names[1] = Custom String("{0} Challenge", Global.Altar_Type_Array[0] == 0 ? Custom String("Queen's") : (
			Global.Altar_Type_Array[0] == 1 ? Custom String("Banker's") : Custom String("Monk's")));
		Global.Event_Colours[1] = Custom String("{0}fg{1}FF>", Global.holygrail, Global.Altar_Type_Array[0] == 0 ? Custom String("A020F0")
			: (Global.Altar_Type_Array[0] == 1 ? Custom String("FFA500") : Custom String("87CEEB")));
		Wait(0.016, Ignore Condition);
		"Choose Summoner"
		Global.Event_Chooser = Random Integer(0, 2);
		Modify Global Variable(Event_Reference_Locations, Append To Array, Global.Temp_Location_Pool[Global.Event_Chooser]);
		Modify Global Variable(Event_Reference_Name, Append To Array, Global.Temp_Name_Pool[Global.Event_Chooser]);
		Modify Global Variable(Temp_Location_Pool, Remove From Array By Index, Global.Event_Chooser);
		Modify Global Variable(Temp_Name_Pool, Remove From Array By Index, Global.Event_Chooser);
		Global.Altar_Type_Array[1] = Random Integer(0, 2);
		Global.Event_Names[2] = Custom String("{0} Altar", Global.Altar_Type_Array[1] == 0 ? Custom String("Summoning") : (
			Global.Altar_Type_Array[1] == 1 ? Custom String("Worshipping") : Custom String("Forsaken")));
		Global.Event_Colours[2] = Custom String("{0}fg{1}FF>", Global.holygrail, Global.Altar_Type_Array[1] == 0 ? Custom String("00FF00")
			: (Global.Altar_Type_Array[1] == 1 ? Custom String("32CD32") : Custom String("808080")));
		Wait(0.016, Ignore Condition);
		"Choose Gamble"
		Global.Event_Chooser = Random Integer(0, 1);
		Modify Global Variable(Event_Reference_Locations, Append To Array, Global.Temp_Location_Pool[Global.Event_Chooser]);
		Modify Global Variable(Event_Reference_Name, Append To Array, Global.Temp_Name_Pool[Global.Event_Chooser]);
		Modify Global Variable(Temp_Location_Pool, Remove From Array By Index, Global.Event_Chooser);
		Modify Global Variable(Temp_Name_Pool, Remove From Array By Index, Global.Event_Chooser);
		Global.Altar_Type_Array[2] = Random Integer(0, 2);
		Global.Event_Names[3] = Custom String("{0} Altar", Global.Altar_Type_Array[2] == 0 ? Custom String("Gamble") : (
			Global.Altar_Type_Array[2] == 1 ? Custom String("Sacrifice") : Custom String("Transmutation")));
		Global.Event_Colours[3] = Custom String("{0}fg{1}FF>", Global.holygrail, Global.Altar_Type_Array[2] == 0 ? Custom String("FFFF00")
			: (Global.Altar_Type_Array[2] == 1 ? Custom String("8F00FF") : Custom String("FF007F")));
		Wait(0.016, Ignore Condition);
		Modify Global Variable(Event_Reference_Locations, Append To Array, Global.Temp_Location_Pool[0]);
		Modify Global Variable(Event_Reference_Name, Append To Array, Global.Temp_Name_Pool[0]);
		Global.Temp_Location_Pool = Empty Array;
		Global.Temp_Name_Pool = Empty Array;
		"Cryptic Altar"
		If(Global.Crypic_Tracker == 5);
			Small Message(All Players(All Teams), Custom String("   There is a Slight Chill in the Air"));
			Global.Altar_Type_Array[3] = 2;
		Else If(Random Integer(0, 2) == 0);
			Small Message(All Players(All Teams), Custom String("   The Air Feels Static"));
			Global.Altar_Type_Array[3] = 1;
		Else;
			Global.Altar_Type_Array[3] = 0;
		End;
		Global.Event_Names[4] = Custom String("{0} Altar", Global.Altar_Type_Array[3] == 0 ? Custom String("Treasure") : (
			Global.Altar_Type_Array[3] == 1 ? Custom String("Ancient") : Custom String("Cryptic")));
		Global.Event_Colours[4] = Custom String("{0}fg{1}FF>", Global.holygrail, Global.Altar_Type_Array[3] == 0 ? Custom String("FFFFFF")
			: (Global.Altar_Type_Array[3] == 1 ? Custom String("0000FF") : Custom String("000000")));
		Global.Event_Found_Check = Array(0, 0, 0, 0, 0);
	}
}

rule("Event Item Locations")
{
	event
	{
		Subroutine;
		Generate_Event_Item_Locations;
	}

	actions
	{
		Global.Event_Item_Location_Array = Empty Array;
		For Global Variable(For_Loop_Counter, 0, 7, 1);
			Global.Temp_Location = Vector(X Component Of(Global.Event_Reference_Locations[0]) + 8 * Cosine From Degrees(
				45 * Global.For_Loop_Counter), Y Component Of(Global.Event_Reference_Locations[0]), Z Component Of(
				Global.Event_Reference_Locations[0]) + 8 * Sine From Degrees(45 * Global.For_Loop_Counter));
			Wait(0.160, Ignore Condition);
			Modify Global Variable(Event_Item_Location_Array, Append To Array, Nearest Walkable Position(Global.Temp_Location));
		End;
	}
}

rule("Found Event")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		!Is True For Any(Global.Event_Found_Check, Current Array Element == -1) == True;
		!Is True For All(Global.Event_Found_Check, Current Array Element >= 1) == True;
		Is True For Any(Global.Event_Reference_Locations, Distance Between(Position Of(Event Player), Current Array Element)
			< Global.Teleporter_Circle_Size) == True;
		Has Spawned(Event Player) == True;
		(Global.Game_State > 0.500 && Global.Game_State < 2) == True;
	}

	actions
	{
		Event Player.AltarTouchIndex = Index Of Array Value(Global.Event_Reference_Locations, First Of(Sorted Array(
			Global.Event_Reference_Locations, Distance Between(Position Of(Event Player), Current Array Element))));
		Abort If(Global.Event_Found_Check[Event Player.AltarTouchIndex] >= 1);
		Log To Inspector(Custom String("{1} discovered {0}", Global.Event_Reference_Locations[Event Player.AltarTouchIndex],
			Event Player));
		Big Message(All Players(All Teams), Custom String("{2} Found {0} At {1}!", Custom String("{1}{0}{2}",
			Global.Event_Names[Event Player.AltarTouchIndex], Global.Event_Colours[Event Player.AltarTouchIndex], Custom String("{0}/fg>",
			Global.holygrail)), Global.Event_Reference_Name[Event Player.AltarTouchIndex], Event Player));
		Global.Event_Found_Check[Event Player.AltarTouchIndex] = 1;
		If(Global.Event_Found_Check[0] > 0);
			Set Objective Description(All Players(All Teams), Custom String("Activate the {2} {0}{1}Teleporter{0}/fg> {2}", Global.holygrail,
				Custom String("fgFF0000FF>"), Icon String(Diamond)), Visible To and String);
		End;
	}
}

rule("Start Event")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Game_State == 1;
		Is True For Any(All Living Players(Team 1), Is Button Held(Current Array Element, Button(Interact))) == True;
	}

	actions
	{
		If(Global.Teleporter_Event_Check == 2 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(Current Array Element,
			Button(Interact)) == True), Global.Event_Reference_Locations[0]) < Global.Teleporter_Circle_Size);
			Play Effect(All Players(All Teams), Good Explosion, Color(White), Global.Event_Reference_Locations[0], 100);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), All Players(Team 1), 100);
			Big Message(All Players(All Teams), Custom String("Teleporting to next Stage..."));
			Wait(2.840, Ignore Condition);
			Filtered Array(All Players(Team 1), Current Array Element.ThirdPersonCamera == 1).ThirdPersonCamera = 2;
			Wait(0.160, Ignore Condition);
			Call Subroutine(Next_Stage);
		Else If(Global.Teleporter_Event_Check == 0 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[0]) < Global.Teleporter_Circle_Size);
			Call Subroutine(Teleporter_Event);
		Else If(Global.Teleporter_Event_Check == 0 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[1]) < Global.Teleporter_Circle_Size);
			Call Subroutine(Second_Altar_Start);
		Else If(Global.Event_Found_Check[2] == 1 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[2]) < Global.Teleporter_Circle_Size);
			Call Subroutine(Third_Altar_Start);
		Else If(Global.Event_Found_Check[2] == 3 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[2]) < Global.Teleporter_Circle_Size);
			Small Message(Filtered Array(All Players(Team 1), Is Button Held(Current Array Element, Button(Interact)) == True), Custom String(
				"   This Altar has already been used!"));
		Else If(Global.Event_Found_Check[3] == 1 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[3]) < Global.Teleporter_Circle_Size);
			Call Subroutine(Fourth_Altar_Start);
		Else If(Global.Event_Found_Check[3] == 3 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[3]) < Global.Teleporter_Circle_Size);
			Small Message(Filtered Array(All Players(Team 1), Is Button Held(Current Array Element, Button(Interact)) == True), Custom String(
				"   This Altar has already been used!"));
		Else If(Global.Event_Found_Check[4] == 1 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[4]) < Global.Teleporter_Circle_Size);
			Call Subroutine(Fifth_Altar_Start);
		Else If(Global.Event_Found_Check[4] == 3 && Distance Between(Filtered Array(All Players(Team 1), Is Button Held(
				Current Array Element, Button(Interact)) == True), Global.Event_Reference_Locations[4]) < Global.Teleporter_Circle_Size);
			Small Message(Filtered Array(All Players(Team 1), Is Button Held(Current Array Element, Button(Interact)) == True), Custom String(
				"   This Altar has already been used!"));
		End;
	}
}

rule("Teleporter Start")
{
	event
	{
		Subroutine;
		Teleporter_Event;
	}

	actions
	{
		Play Effect(All Players(All Teams), Explosion Sound, Color(White), Global.Event_Reference_Locations[0], 100);
		Global.Teleporter_Event_Check = 3;
		Stop Chasing Global Variable(Spawn_Director);
		Play Effect(All Players(All Teams), Ring Explosion, Global.Cryptic_Toggle == 1 ? Color(Black) : Color(White),
			Global.Event_Reference_Locations[0], 100);
		Play Effect(All Players(All Teams), Ring Explosion Sound, Global.Cryptic_Toggle == 1 ? Color(Black) : Color(White),
			Global.Event_Reference_Locations[0], 100);
		Chase Global Variable At Rate(Teleporter_Circle, Global.Teleporter_Circle_Size, 4, Destination and Rate);
		Wait Until(Global.Teleporter_Circle == Global.Teleporter_Circle_Size, 99999);
		Global.Teleporter_Event_Check = 1;
		Call Subroutine(Spawn_Boss);
		Stop Chasing Global Variable(Teleporter_Circle);
		Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Big Message(All Players(All Teams), Custom String("Defeat {0} and Charge the Teleporter!", Global.Boss));
		Set Objective Description(All Players(All Teams), Custom String("Defeat {0}{1}The Boss{0}/fg>", Global.holygrail, Custom String(
			"fgFF0000FF>")), Visible To and String);
		If(Global.Challenge_Toggle == True && Global.Altar_Type_Array[0] == 1);
			For Global Variable(For_Loop_Counter, 0, Count Of(All Players(Team 1)), 1);
				Global.Temp_Player = All Players(Team 1)[Global.For_Loop_Counter];
				Global.Temp_Player.Banker_Values[0] = Random Value In Array(Remove From Array(Mapped Array(Global.Temp_Player.Player_Item_Array,
					Current Array Element ? Current Array Index : -1), -1));
				Global.Temp_Player.Banker_Values[1] = Global.Temp_Player.Player_Item_Array[Global.Temp_Player.Banker_Values[0]];
				Global.Temp_Player.Player_Item_Array[Global.Temp_Player.Banker_Values[0]] = 0;
				Small Message(All Players(Team 1), Custom String("   {1}'s {0} has been put in the bank!",
					Global.Item_Names[Global.Temp_Player.Banker_Values[0]], Global.Temp_Player));
				Call Subroutine(Destroy_Item);
				Wait(0.160, Ignore Condition);
			End;
		End;
		If(Global.Challenge_Toggle == True && Global.Altar_Type_Array[0] == 2);
			Set Ultimate Ability Enabled(All Players(Team 1), False);
		End;
	}
}

rule("Second Altar Start")
{
	event
	{
		Subroutine;
		Second_Altar_Start;
	}

	actions
	{
		If(Global.Challenge_Toggle == False);
			Global.Challenge_Toggle = True;
			Small Message(All Players(Team 1), Custom String("   {0} Challenge Accepted!", Global.Altar_Type_Array[0] == 0 ? Custom String(
				"Queen's") : (Global.Altar_Type_Array[0] == 1 ? Custom String("Banker's") : Custom String("Monk's"))));
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Global.Event_Reference_Locations[1], 100);
			Wait(0.500, Ignore Condition);
			Small Message(All Players(Team 1), Custom String("   {0}", Global.Altar_Type_Array[0] == 0 ? Custom String(
				"Defeat the Empowered Boss for more items!") : (Global.Altar_Type_Array[0] == 1 ? Custom String(
				"Stores an item at the bank, get it back plus interest when you beat the boss!") : Custom String(
				"Disables Ultimate when fighting the boss, Get a free common item when boss is defeated!"))));
		Else;
			Global.Challenge_Toggle = False;
			Small Message(All Players(Team 1), Custom String("   {0} Challenge Declined!", Global.Altar_Type_Array[0] == 0 ? Custom String(
				"Queen's") : (Global.Altar_Type_Array[0] == 1 ? Custom String("Banker's") : Custom String("Monk's"))));
			Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Global.Event_Reference_Locations[1], 100);
			Wait(0.500, Ignore Condition);
			Small Message(All Players(Team 1), Custom String("   CHICKEN LOL!"));
		End;
	}
}

rule("Third Altar Start")
{
	event
	{
		Subroutine;
		Third_Altar_Start;
	}

	actions
	{
		Stop Chasing Global Variable(Spawn_Director);
		For Global Variable(For_Loop_Counter, 0, 3, 1);
			Play Effect(All Players(All Teams), Ring Explosion, Global.Altar_Type_Array[1] == 0 ? Color(Green) : (
				Global.Altar_Type_Array[1] == 1 ? Color(Lime Green) : Color(Gray)), Global.Event_Reference_Locations[2], 25);
			Play Effect(All Players(All Teams), Ring Explosion Sound, Color(Green), Global.Event_Reference_Locations[2], 100);
			Wait(1, Ignore Condition);
		End;
		If(Global.Altar_Type_Array[1] == 0);
			If(Random Integer(1, 4) == 1);
				Global.Spawning_Type = 8;
				Call Subroutine(Spawn_Enemies);
				Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
				Global.Event_Found_Check[2] = 3;
			Else;
				Global.Spawning_Type = 1;
				Call Subroutine(Spawn_Enemies);
				Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
				Global.Event_Found_Check[2] = 3;
			End;
		Else If(Global.Altar_Type_Array[1] == 1);
			Global.Spawning_Type = 9;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
			Global.Event_Found_Check[2] = 3;
		Else;
			Global.Spawning_Type = 10;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
			Global.Event_Found_Check[2] = 3;
		End;
	}
}

rule("Fourth Altar Start")
{
	event
	{
		Subroutine;
		Fourth_Altar_Start;
	}

	actions
	{
		For Global Variable(For_Loop_Counter, 0, 3, 1);
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Global.Event_Reference_Locations[3], 100);
			Play Effect(All Players(All Teams), Ring Explosion, Global.Altar_Type_Array[2] == 0 ? Color(Yellow) : (
				Global.Altar_Type_Array[2] == 1 ? Color(Violet) : Color(Rose)), Global.Event_Reference_Locations[3], 25);
			Wait(1, Ignore Condition);
		End;
		If(Global.Altar_Type_Array[2] == 0);
			Big Message(All Players(Team 1), Custom String("You get....."));
			Global.Event_Found_Check[3] = 2;
			Call Subroutine(Gamble_Event_Chooser);
			If(Random Integer(1, 3) == 1);
				Global.Event_Found_Check[3] = 1;
				Big Message(All Players(Team 1), Custom String("AND A REROLL"));
			Else;
				Global.Event_Found_Check[3] = 3;
			End;
		Else If(Global.Altar_Type_Array[2] == 1);
			Damage(All Players(Team 1), Null, 100);
			Global.Gamble_Item_Trigger = 1;
			Global.Event_Found_Check[3] = 3;
		Else;
			Global.Transmute_Trigger = 1;
			Global.Event_Found_Check[3] = 3;
		End;
	}
}

rule("Fifth Altar Start")
{
	event
	{
		Subroutine;
		Fifth_Altar_Start;
	}

	actions
	{
		If(Global.Altar_Type_Array[3] <= 1);
			Global.Event_Found_Check[4] = 2;
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Global.Event_Reference_Locations[4], 100);
			Play Effect(All Players(All Teams), Good Explosion, Global.Altar_Type_Array[3] == 0 ? Color(White) : Color(Blue),
				Global.Event_Reference_Locations[4], 25);
			Global.Fifth_Altar_Item_Trigger = 1;
			Global.Event_Found_Check[4] = 3;
		Else;
			If(Global.Cryptic_Toggle == False);
				Global.Cryptic_Toggle = True;
				Small Message(All Players(Team 1), Custom String("   The Teleporter Shifts..."));
				Play Effect(All Players(All Teams), Buff Impact Sound, Color(Black), Global.Event_Reference_Locations[4], 100);
			Else;
				Global.Cryptic_Toggle = False;
				Small Message(All Players(Team 1), Custom String("   The Teleporter Realigns itself..."));
				Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Global.Event_Reference_Locations[4], 100);
			End;
	}
}

rule("Charge Teleporter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Teleporter_Event_Check == 1;
		Global.Teleporter_Charge != 100;
		Count Of(Players Within Radius(Global.Event_Reference_Locations[0], Global.Teleporter_Circle_Size, Team 1, Off)) > 0;
	}

	actions
	{
		Chase Global Variable At Rate(Teleporter_Charge, 100, 3 * (Count Of(Filtered Array(All Living Players(Team 1), Distance Between(
			Current Array Element, Global.Event_Reference_Locations[0]) <= Global.Teleporter_Circle_Size)) / Max(1, Count Of(
			All Living Players(Team 1)))), Destination and Rate);
		Wait Until(Players Within Radius(Global.Event_Reference_Locations[0], Global.Teleporter_Circle, Team 1, Off)
			< 1 || Global.Teleporter_Charge == 100, 99999);
		Stop Chasing Global Variable(Teleporter_Charge);
		Wait(0.160, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Teleporter Event Finish")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Teleporter_Event_Check == 1;
		Global.Teleporter_Charge == 100;
		(Is Dead(Global.Boss) || Is Hero Being Played(Hero(Ana), Team 2)) == True;
	}

	actions
	{
		Global.Teleporter_Event_Check = 2;
		Play Effect(All Players(All Teams), Good Pickup Effect, Color(White), Global.Event_Reference_Locations[0], 100);
		Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Global.Event_Reference_Locations[0], 100);
		Global.Teleporter_Circle = 0;
		Global.Teleporter_Charge = 0;
		Set Objective Description(All Players(All Teams), Custom String("Go To the Next Stage"), Visible To and String);
		Start Rule(Teleporter_Reminder, Do Nothing);
	}
}

rule("Teleporter_Reminder")
{
	event
	{
		Subroutine;
		Teleporter_Reminder;
	}

	actions
	{
		Wait(10, Ignore Condition);
		Abort If(Global.Teleporter_Event_Check != 2);
		Small Message(All Players(All Teams), Custom String("  Press [{0}] to teleport to the next stage", Input Binding String(Button(
			Interact))));
		Small Message(All Players(All Teams), Custom String("  Go to the teleporter!"));
		Loop If(Global.Teleporter_Event_Check == 2);
	}
}

rule("Gamble Event Chooser")
{
	event
	{
		Subroutine;
		Gamble_Event_Chooser;
	}

	actions
	{
		Global.Gamble_Luck = Random Integer(0, 9);
		If(Global.Gamble_Luck < 5);
			Play Effect(All Players(All Teams), Buff Impact Sound, Color(White), Global.Event_Reference_Locations[3], 100);
			Play Effect(All Players(All Teams), Good Explosion, Color(Green), Global.Event_Reference_Locations[3], 25);
		Else;
			Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Global.Event_Reference_Locations[3], 100);
			Play Effect(All Players(All Teams), Bad Explosion, Color(Red), Global.Event_Reference_Locations[3], 25);
		End;
		If(Global.Gamble_Luck == 0);
			Big Message(All Players(Team 1), Custom String("ITEMS"));
			Global.Gamble_Item_Trigger = 1;
		Else If(Global.Gamble_Luck == 1);
			Big Message(All Players(Team 1), Custom String("SHEILDS!"));
			Add Health Pool To Player(All Players(Team 1), Health, 100, False, False);
		Else If(Global.Gamble_Luck == 2);
			Big Message(All Players(Team 1), Custom String("ANCIENT ITEMS"));
			Global.Gamble_Item_Trigger = 2;
		Else If(Global.Gamble_Luck == 3);
			Big Message(All Players(Team 1), Custom String("BOSS SOUL"));
			Global.Gamble_Item_Trigger = 3;
		Else If(Global.Gamble_Luck == 4);
			Big Message(All Players(Team 1), Custom String("JACKPOT!!"));
			Global.Gamble_Item_Trigger = 4;
		Else If(Global.Gamble_Luck == 5);
			Big Message(All Players(Team 1), Custom String("NOTHING"));
		Else If(Global.Gamble_Luck == 6);
			Big Message(All Players(Team 1), Custom String("SUMMONING ALTAR"));
			Global.Spawning_Type = 2;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Else If(Global.Gamble_Luck == 7);
			Big Message(All Players(Team 1), Custom String("MINI BOSS"));
			Global.Spawning_Type = 3;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Else If(Global.Gamble_Luck == 8);
			Big Message(All Players(Team 1), Custom String("MOTH INFESTATION"));
			Global.Spawning_Type = 4;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Else;
			Big Message(All Players(Team 1), Custom String("PAIN!"));
			Global.Spawning_Type = 6;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		End;
	}
}

rule("Gamble Item Trigger")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Gamble_Item_Trigger >= 1;
	}

	actions
	{
		If(Global.Gamble_Item_Trigger == 1);
			Event Player.Current_Item_Value = Random Integer(1, 10);
			Call Subroutine(Call_Item);
		Else If(Global.Gamble_Item_Trigger == 2);
			Event Player.Current_Item_Value = Random Integer(16, 26);
			Call Subroutine(Call_Item);
		Else If(Global.Gamble_Item_Trigger == 3);
			Event Player.Current_Item_Value = Random Integer(11, 15);
			Call Subroutine(Call_Item);
		Else If(Global.Gamble_Item_Trigger == 4);
			Event Player.Current_Item_Value = Random Integer(1, 10);
			Call Subroutine(Call_Item);
			Wait(0.160, Ignore Condition);
			Event Player.Current_Item_Value = Random Integer(16, 26);
			Call Subroutine(Call_Item);
			Wait(0.160, Ignore Condition);
			Event Player.Current_Item_Value = Random Integer(11, 15);
			Call Subroutine(Call_Item);
		Else;
		End;
		Wait(0.160, Ignore Condition);
		Global.Gamble_Item_Trigger = 0;
	}
}

rule("Fifth Item Trigger")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Fifth_Altar_Item_Trigger == 1;
	}

	actions
	{
		If(Global.Altar_Type_Array[3] == 0);
			Event Player.Current_Item_Value = Random Integer(1, 5) == 1 ? Random Integer(25, 35) : Random Integer(1, 10);
			Call Subroutine(Call_Item);
			Wait(0.160, Ignore Condition);
			Global.Fifth_Altar_Item_Trigger = 0;
		Else If(Global.Altar_Type_Array[3] == 1);
			Event Player.Current_Item_Value = Random Integer(16, 25);
			Call Subroutine(Call_Item);
			Wait(0.160, Ignore Condition);
			Global.Fifth_Altar_Item_Trigger = 0;
		End;
	}
}

rule("Banker Challenge Trigger")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Altar_Type_Array[0] == 1;
		Global.Challenge_Toggle == True;
		Is Dead(Global.Boss) == True;
	}

	actions
	{
		Event Player.Player_Item_Array[Event Player.Banker_Values[0]] += Event Player.Banker_Values[1] + 1;
		Small Message(Event Player, Custom String("   Banker Returned your {0}", Global.Item_Names[Event Player.Banker_Values[0]]));
		Event Player.Current_Item_Value = -1;
		Call Subroutine(Call_Item);
		Wait(0.160, Ignore Condition);
		Global.Challenge_Toggle = False;
	}
}

rule("Monk Challenge Trigger")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Altar_Type_Array[0] == 2;
		Global.Challenge_Toggle == True;
		Is Dead(Global.Boss) == True;
	}

	actions
	{
		Global.Challenge_Toggle = False;
		Wait(0.160, Ignore Condition);
		Set Ultimate Ability Enabled(All Players(All Teams), True);
		Event Player.Current_Item_Value = Random Integer(1, 10);
		Big Message(Event Player, Custom String("The monk thanks you"));
		Call Subroutine(Call_Item);
	}
}

rule("Transmute Trigger")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Global.Transmute_Trigger == 1;
	}

	actions
	{
		If(Is True For All(Event Player.Player_Item_Array, Current Array Element == 0));
			Small Message(Event Player, Custom String("   No Items to transform!", Global.Item_Names[Event Player.Transmute_Values[0]],
				Global.Item_Names[Event Player.Transmute_Values[2]]));
			Global.Transmute_Trigger = 0;
			Abort;
		End;
		Event Player.Transmute_Values[0] = Random Value In Array(Remove From Array(Mapped Array(Event Player.Player_Item_Array,
			Current Array Element ? Current Array Index : -1), -1));
		Event Player.Transmute_Values[1] = Event Player.Player_Item_Array[Event Player.Transmute_Values[0]];
		Event Player.Transmute_Values[2] = Random Integer(0, 34);
		Event Player.Player_Item_Array[Event Player.Transmute_Values[0]] = 0;
		If(Event Player.Transmute_Values[0] == Event Player.Transmute_Values[2]);
			Small Message(Event Player, Custom String("   Transmutation Failed! {0} was destroyed!",
				Global.Item_Names[Event Player.Transmute_Values[0]]));
			Call Subroutine(Destroy_Item);
			Global.Transmute_Trigger = 0;
			Abort;
		End;
		Event Player.Player_Item_Array[Event Player.Transmute_Values[2]] += Event Player.Transmute_Values[1];
		Small Message(Event Player, Custom String("   {0} has been transformed into {1}!",
			Global.Item_Names[Event Player.Transmute_Values[0]], Global.Item_Names[Event Player.Transmute_Values[2]]));
		Call Subroutine(Destroy_Item);
		Event Player.Current_Item_Value = Event Player.Transmute_Values[2] + 1;
		Event Player.Current_Item_Value = -1;
		Call Subroutine(Call_Item);
		Global.Transmute_Trigger = 0;
		Abort;
	}
}

rule("Item Drop Chance on Kill")
{
	event
	{
		Player Dealt Final Blow;
		Team 1;
		All;
	}

	conditions
	{
		Global.Game_State == 1;
	}

	actions
	{
		Global.Death_Location = Nearest Walkable Position(Position Of(Victim));
		If(Victim.Item_Drop_Chance == -1);
			disabled Log To Inspector(Custom String("No Item Drop"));
			Abort;
		Else;
			If(Workshop Setting Toggle(Custom String("Game Settings"), Custom String("Guaranteed Item Drop"), False, 0) == True);
				Global.Random_Drop_Chance = 0;
			Else;
				Global.Random_Drop_Chance = Random Integer(0, Victim.Item_Drop_Chance);
			End;
			If(Global.Random_Drop_Chance == 0 || Global.Pity >= 40);
				Call Subroutine(Roll_Item_Value);
				Global.Pity = 0;
			Else;
				Global.Death_Location = Null;
				Global.Pity += Victim.Item_Drop_Chance;
			End;
		End;
	}
}

rule("Enemy Died - Remove from Game")
{
	event
	{
		Player Died;
		Team 2;
		All;
	}

	actions
	{
		If(Event Player.Enemy_Class == Custom String("Explosive "));
			Play Effect(All Players(All Teams), Orisa Halt Implosion Effect, Team 2, Position Of(Event Player), 1);
			Wait(1, Ignore Condition);
			Play Effect(All Players(All Teams), Sigma Hypersphere Implosion Effect, Team 2, Position Of(Event Player), 1);
			Damage(Players Within Radius(Position Of(Event Player), 5, All Teams, Off), Event Player, Event Player.Health / 4);
		End;
		If(Victim.Player_Type == String("Boss") && Global.Game_State == 1);
			Global.Current_Budget -= Global.Challenge_Toggle == True ? 14 : 7;
			Call Subroutine(Boss_Defeated);
		Else If(Victim.Player_Type == String("Boss") && Global.Game_State == 2);
			Global.Game_State = 3;
			Global.Countdown = 90;
			Chase Global Variable At Rate(Countdown, 0, 1, Destination and Rate);
			Global.Ship_Location = Random Value In Array(Global.Teleporter_Locations);
			Set Objective Description(All Players(All Teams), Custom String("Find The Ship"), Visible To and String);
			Small Message(All Players(All Teams), Custom String("   You need to get out of here before the planet Explodes!"));
			Wait(0.500, Ignore Condition);
			Destroy Dummy Bot(Team 2, Slot Of(Event Player));
			Small Message(All Players(All Teams), Custom String("   Maybe look where the teleporters have been..."));
		Else;
			Destroy Effect(Event Player.Haste_Check);
			Global.Current_Budget -= Event Player.Enemy_Budget;
			Wait(0.500, Ignore Condition);
			Destroy Dummy Bot(Team 2, Slot Of(Event Player));
		End;
	}
}

rule("Roll Item")
{
	event
	{
		Subroutine;
		Roll_Item_Value;
	}

	actions
	{
		Play Effect(All Players(All Teams), Good Pickup Effect, Color(White), Victim, 100);
		If(Victim == Global.Boss);
			For Global Variable(For_Loop_Counter, 0, Global.Challenge_Toggle == True && Global.Altar_Type_Array[0] == 0 ? Number Of Players(
				Team 1) * 2 : Number Of Players(Team 1), 1);
				Global.Boss_Random_Select = Random Integer(1, 5);
				If(Global.Boss_Random_Select == 1);
					Global.Random_Item_Gen = Hero Of(Global.Boss) == Hero(Bastion) ? 11 : (Hero Of(Global.Boss) == Hero(Mercy) ? 12 : (Hero Of(
						Global.Boss) == Hero(Orisa) ? 13 : (Hero Of(Global.Boss) == Hero(Wrecking Ball) ? 14 : 15)));
					Call Subroutine(Drop_Item_Teleporter_Event);
				Else;
					Global.Boss_Random_Select = Random Integer(1, 10);
					Global.Random_Item_Gen = Global.Boss_Random_Select == 1 ? Random Integer(16, 26) : (
						Global.Boss_Random_Select <= 3 ? Random Integer(27, 34) : Random Integer(1, 10));
					Call Subroutine(Drop_Item_Teleporter_Event);
				End;
			End;
		Else If(Victim.Player_Type == String("Warning"));
			Global.Random_Item_Gen = Hero Of(Victim) == Hero(Bastion) ? 11 : (Hero Of(Victim) == Hero(Mercy) ? 12 : (Hero Of(Victim) == Hero(
				Orisa) ? 13 : (Hero Of(Victim) == Hero(Wrecking Ball) ? 14 : 15)));
			Call Subroutine(Drop_Item);
		Else;
			Global.Boss_Random_Select = Random Integer(1, 10);
			Global.Random_Item_Gen = Global.Boss_Random_Select == 1 ? Random Integer(16, 26) : (
				Global.Boss_Random_Select <= 3 ? Random Integer(27, 34) : Random Integer(1, 10));
			Call Subroutine(Drop_Item);
		End;
	}
}

rule("Drop Item")
{
	event
	{
		Subroutine;
		Drop_Item;
	}

	actions
	{
		If(Workshop Setting Toggle(Custom String("Game Settings"), Custom String("Force Specific Item Drop"), False, 0) == True);
			Small Message(All Players(All Teams), Custom String("  Forced Item Drop"));
			Global.Random_Item_Gen = Event Player.Glossary_Text_Value + 1;
		End;
		Create Effect(All Players(All Teams), Sphere, Global.Item_Colour[Global.Random_Item_Gen - 1], Global.Death_Location, 0.500, None);
		If(Global.Item_Positions == Empty Array);
			Global.Item_Positions = Array(Global.Death_Location);
			Global.Item_Held_Value = Array(Global.Random_Item_Gen);
			Global.Item_Visual_ID = Array(Last Created Entity);
		Else;
			Modify Global Variable(Item_Positions, Append To Array, Global.Death_Location);
			Modify Global Variable(Item_Held_Value, Append To Array, Global.Random_Item_Gen);
			Modify Global Variable(Item_Visual_ID, Append To Array, Last Created Entity);
		End;
		Call Subroutine(Drop_Item_Text);
	}
}

rule("Drop Item Teleporter Event")
{
	event
	{
		Subroutine;
		Drop_Item_Teleporter_Event;
	}

	actions
	{
		Create Effect(All Players(All Teams), Sphere, Global.Item_Colour[Global.Random_Item_Gen - 1],
			Global.Event_Item_Location_Array[Global.For_Loop_Counter], 0.500, None);
		If(Global.Item_Positions == Empty Array);
			Global.Item_Positions = Array(Global.Event_Item_Location_Array[Global.For_Loop_Counter]);
			Global.Item_Held_Value = Array(Global.Random_Item_Gen);
			Global.Item_Visual_ID = Array(Last Created Entity);
		Else;
			Modify Global Variable(Item_Positions, Append To Array, Global.Event_Item_Location_Array[Global.For_Loop_Counter]);
			Modify Global Variable(Item_Held_Value, Append To Array, Global.Random_Item_Gen);
			Modify Global Variable(Item_Visual_ID, Append To Array, Last Created Entity);
		End;
		Call Subroutine(Drop_Item_Text);
	}
}

rule("Drop Item Text")
{
	event
	{
		Subroutine;
		Drop_Item_Text;
	}

	actions
	{
		If(Count Of(Global.Item_Positions) == 0);
			Global.Drop_Item_Index = 0;
		Else;
			Global.Drop_Item_Index = Count Of(Global.Item_Positions) - 1;
		End;
		If(Global.Reality_Checker[11] == True);
			Create In-World Text(All Players(All Teams), Icon String(Question Mark), Global.Item_Positions[Global.Drop_Item_Index], 2,
				Do Not Clip, None, Color(White), Default Visibility);
		Else;
			Create In-World Text(All Players(All Teams), Global.Item_Icons[Global.Item_Held_Value[Global.Drop_Item_Index] - 1],
				Global.Item_Positions[Global.Drop_Item_Index], 2, Do Not Clip, None, Color(White), Default Visibility);
		End;
		If(Global.Item_Text_ID_List == Empty Array);
			Global.Item_Text_ID_List = Last Text ID;
		Else;
			Modify Global Variable(Item_Text_ID_List, Append To Array, Last Text ID);
		End;
	}
}

rule("Pick Up Item")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
		Global.Game_State != 0;
		Is True For Any(Global.Item_Positions, Distance Between(Current Array Element, Position Of(Event Player)) < 2) == True;
		Global.Item_Positions != Empty Array;
	}

	actions
	{
		Event Player.Current_Item = Index Of Array Value(Global.Item_Positions, First Of(Sorted Array(Global.Item_Positions,
			Distance Between(Position Of(Event Player), Current Array Element))));
		Event Player.Current_Item_Value = Global.Item_Held_Value[Event Player.Current_Item];
		Play Effect(All Players(Team 1), Good Pickup Effect, Color(White), Global.Item_Positions[Event Player.Current_Item], 100);
		Play Effect(All Players(Team 1), Buff Impact Sound, Color(White), Global.Item_Positions[Event Player.Current_Item], 100);
		Destroy In-World Text(Global.Item_Text_ID_List[Event Player.Current_Item]);
		Destroy Effect(Global.Item_Visual_ID[Event Player.Current_Item]);
		Call Subroutine(Call_Item);
		Global.Item_Positions[Event Player.Current_Item] = Null;
		Global.Item_Held_Value[Event Player.Current_Item] = Null;
		Global.Item_Visual_ID[Event Player.Current_Item] = Null;
		Global.Item_Text_ID_List[Event Player.Current_Item] = Null;
		Modify Global Variable(Item_Positions, Remove From Array By Index, Event Player.Current_Item);
		Modify Global Variable(Item_Held_Value, Remove From Array By Index, Event Player.Current_Item);
		Modify Global Variable(Item_Visual_ID, Remove From Array By Index, Event Player.Current_Item);
		Modify Global Variable(Item_Text_ID_List, Remove From Array By Index, Event Player.Current_Item);
		If(Global.Item_Positions == Array(0));
			Log To Inspector(Custom String("There are no items on the field"));
			Global.Item_Positions = Empty Array;
			Global.Item_Held_Value = Empty Array;
			Global.Item_Visual_ID = Empty Array;
			Global.Item_Text_ID_List = Empty Array;
		End;
		Wait(0.160, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Call Item")
{
	event
	{
		Subroutine;
		Call_Item;
	}

	actions
	{
		If(Event Player.Current_Item_Value == -1);
			Abort;
		End;
		Small Message(Event Player, Custom String("   Picked up {1}{2}{0}{1}/fg>", Global.Item_Names[Event Player.Current_Item_Value - 1],
			Global.holygrail, Custom String("fg{0}>", Event Player.Current_Item_Value <= 10 ? Custom String("a5a5a5FF") : (
			Event Player.Current_Item_Value <= 15 ? Custom String("00ec00ff") : (Event Player.Current_Item_Value >= 26 ? Custom String(
			"000ffff") : Custom String("ffa500ff"))))));
		Event Player.Player_Item_Array[Event Player.Current_Item_Value - 1] += Workshop Setting Integer(Custom String("Game Settings"),
			Custom String("Item Stacks Per Item"), 1, 1, 5, 0);
		"Armour Plate"
		If(Event Player.Player_Item_Array[0] > Event Player.Player_Item_Compare[0] && Event Player.Armour_ID == 0);
			Add Health Pool To Player(Event Player, Armor, 50 * Event Player.Player_Item_Array[0], True, True);
			Event Player.Armour_ID = Last Created Health Pool;
		Else If(Event Player.Player_Item_Array[0] > Event Player.Player_Item_Compare[0]);
			Remove Health Pool From Player(Event Player.Armour_ID);
			Add Health Pool To Player(Event Player, Armor, 50 * Event Player.Player_Item_Array[0], True, True);
			Event Player.Armour_ID = Last Created Health Pool;
		End;
		"Crimson Cow"
		If(Event Player.Player_Item_Array[1] > Event Player.Player_Item_Compare[1]);
			Event Player.Movespeed = Max(110, 100 + 10 * Event Player.Player_Item_Array[1]);
			Set Move Speed(Event Player, Event Player.Movespeed);
			If(Event Player.Warden_Check == True);
				Set Move Speed(Event Player, Event Player.Movespeed + 100);
			End;
		End;
		"Serrated Dagger"
		If(Event Player.Player_Item_Array[2] > Event Player.Player_Item_Compare[2]);
			Call Subroutine(Player_Damage_Calc);
		End;
		"Soul Burn"
		If(Event Player.Player_Item_Array[3] > Event Player.Player_Item_Compare[3]);
			Event Player.Soul_Burn_Damage_Calc = Max(30, 25 + Event Player.Player_Item_Array[3] * 5);
		End;
		"Regen Bandage"
		If(Event Player.Player_Item_Array[4] > Event Player.Player_Item_Compare[4]);
			Event Player.Regen_Bandage_Heal = Max(25, 22.500 + 2.500 * Event Player.Player_Item_Array[4]);
			Call Subroutine(Play_Regen_Bandage);
		End;
		"Ammo Amplifer - Ignore Icicle Spear"
		If(Event Player.Player_Item_Array[6] > Event Player.Player_Item_Compare[6]);
			Call Subroutine(Add_Ammo_Amplifier);
		End;
		"Resin Explosive"
		If(Event Player.Player_Item_Array[7] > Event Player.Player_Item_Compare[7]);
			Event Player.Resin_Explosive_Damage = 80 + 8 * Event Player.Player_Item_Array[7];
		End;
		"Truffle Triage"
		If(Event Player.Player_Item_Array[8] > Event Player.Player_Item_Compare[8]);
			Event Player.Truffle_Triage_CD = Max(0.500, 2.100 - Event Player.Player_Item_Array[8] * 0.100);
			Event Player.Truffle_Triage_Percent = Min(1, 0.450 + Event Player.Player_Item_Array[8] * 0.050);
		End;
		"Areo Accelerant"
		If(Event Player.Player_Item_Array[9] > Event Player.Player_Item_Compare[9]);
			Set Projectile Speed(Event Player, Max(150, 140 + 10 * Event Player.Player_Item_Array[9]));
		End;
		"Guardian Soul"
		If(Event Player.Player_Item_Array[10] > Event Player.Player_Item_Compare[10]);
			Event Player.Guardian_Check = True;
			Event Player.Guardian_Soul_Health = 0.750 + 0.050 * Event Player.Player_Item_Array[10];
			Event Player.Guardian_Soul_CD = Max(5, 35 - 5 * Event Player.Player_Item_Array[10]);
			Event Player.Guardian_Soul_TimeStamp = 0;
		End;
		"Warden Soul - Ignore Moth Soul"
		If(Event Player.Player_Item_Array[12] > Event Player.Player_Item_Compare[12]);
			Event Player.Warden_Soul_CD = Max(1, 5.100 - Event Player.Player_Item_Array[12] * 0.100);
			Event Player.Warden_Check = True;
			Set Move Speed(Event Player, Event Player.Movespeed + 100);
		End;
		"Marble Soul"
		If(Event Player.Player_Item_Array[13] > Event Player.Player_Item_Compare[13]);
			Event Player.Marble_Soul_Boost = 30 * Event Player.Player_Item_Array[13];
		End;
		"Gentistic Soul"
		If(Event Player.Player_Item_Array[14] > Event Player.Player_Item_Compare[14] && Event Player.Gen_soul_Health_ID == 0);
			Add Health Pool To Player(Event Player, Health, Event Player.Geneticist_Soul_Essense, True, True);
			Event Player.Gen_soul_Health_ID = Last Created Health Pool;
		Else If(Event Player.Player_Item_Array[14] > Event Player.Player_Item_Compare[14]);
			Remove Health Pool From Player(Event Player.Gen_soul_Health_ID);
			Add Health Pool To Player(Event Player, Health, Event Player.Geneticist_Soul_Essense, True, True);
			Event Player.Gen_soul_Health_ID = Last Created Health Pool;
		End;
		"Ancient Shield"
		If(Event Player.Player_Item_Array[15] > Event Player.Player_Item_Compare[15] && Event Player.Shield_ID == 0);
			Add Health Pool To Player(Event Player, Shields, 100 * Event Player.Player_Item_Array[15], True, True);
			Event Player.Shield_ID = Last Created Health Pool;
		Else If(Event Player.Player_Item_Array[15] > Event Player.Player_Item_Compare[15]);
			Remove Health Pool From Player(Event Player.Shield_ID);
			Add Health Pool To Player(Event Player, Shields, 100 * Event Player.Player_Item_Array[15], True, True);
			Event Player.Shield_ID = Last Created Health Pool;
		End;
		"Mossy Moth Wing - Ignore Relic Scope"
		If(Event Player.Player_Item_Array[17] > Event Player.Player_Item_Compare[17]);
			Set Jump Vertical Speed(Event Player, 100 + 25 + 25 * Event Player.Player_Item_Array[17]);
		End;
		"Arcane Pendant"
		If(Event Player.Player_Item_Array[18] > Event Player.Player_Item_Compare[18]);
			Event Player.Arcane_Pendant_Heal = 50 * Event Player.Player_Item_Array[18];
		End;
		"Vintage Knuckleduster"
		If(Event Player.Player_Item_Array[19] > Event Player.Player_Item_Compare[19]);
			Event Player.Knuckleduster_Damage = Max(60, 55 + 5 * Event Player.Player_Item_Array[19]);
		End;
		"Gold-Coated Machette"
		If(Event Player.Player_Item_Array[21] > Event Player.Player_Item_Compare[21]);
			Call Subroutine(Player_Damage_Calc);
		End;
		"Dragon's Fang"
		If(Event Player.Player_Item_Array[22] > Event Player.Player_Item_Compare[22]);
			Event Player.Dragon_Fang_Damage = Max(0.500, 0.250 + 0.250 * Event Player.Player_Item_Array[22]);
		End;
		"Vital Point Reader"
		If(Event Player.Player_Item_Array[24] > Event Player.Player_Item_Compare[24]);
			Event Player.Vital_Point_Damage = Max(0.500, 0.300 + 0.200 * Event Player.Player_Item_Array[24]);
		End;
		"Power Reserve"
		If(Event Player.Player_Item_Array[25] > Event Player.Player_Item_Compare[25]);
			Event Player.Power_Reserve_Charge = Min(50, 10 + 5 * Event Player.Player_Item_Array[25]);
		End;
		"Titan's Catalyst"
		If(Event Player.Player_Item_Array[26] > Event Player.Player_Item_Compare[26]);
			Event Player.Titans_Catalyst_Damage = 0.300 * Event Player.Player_Item_Array[26];
		End;
		"Sippy Straw"
		If(Event Player.Player_Item_Array[27] > Event Player.Player_Item_Compare[27]);
			Event Player.Sippy_Straw_Lifesteal = Min(50, 5 * Event Player.Player_Item_Array[27]);
		End;
		"Holy Barrier"
		If(Event Player.Player_Item_Array[28] > Event Player.Player_Item_Compare[28]);
			Event Player.Holy_Barrier_CD = Max(1.500, 10.500 - Event Player.Player_Item_Array[28] * 0.500);
		End;
		"Demon Seal"
		If(Event Player.Player_Item_Array[30] > Event Player.Player_Item_Compare[30]);
			Attacker.Demon_Execute_Damage = Max(50, 45 + 5 * Attacker.Player_Item_Array[30]);
		End;
		"SunFire Cape"
		If(Event Player.Player_Item_Array[31] > Event Player.Player_Item_Compare[31]);
			Event Player.Sunfire_Cape_Damage = Max(25, 15 + 10 * Event Player.Player_Item_Array[31]);
		End;
		"Opps I Fell Up"
		If(Event Player.Player_Item_Array[34] > Event Player.Player_Item_Compare[34]);
			Event Player.Oops_Jump_Power = Max(10, 9 + Event Player.Player_Item_Array[34]);
			Event Player.Oops_Check = True;
		End;
		Event Player.Player_Item_Compare = Event Player.Player_Item_Array;
	}
}

rule("Destroy Item")
{
	event
	{
		Subroutine;
		Destroy_Item;
	}

	actions
	{
		If(Event Player != Null);
			If(Event Player.Transmute_Values[0] == 0);
				Remove Health Pool From Player(Event Player.Armour_ID);
			Else If(Event Player.Transmute_Values[0] == 1);
				Event Player.Movespeed = 100;
				Set Move Speed(Event Player, Event Player.Movespeed);
			Else If(Event Player.Transmute_Values[0] == 2);
				Event Player.Damage = 100 + Event Player.Player_Item_Array[2] * 20 + Event Player.Player_Item_Array[21] * 50 + (Is True For Any(
					Global.Ammo_Amplifer_Bugged_Heroes, Hero Of(Event Player) == Current Array Element)
					? Event Player.Player_Item_Array[6] * 5 : 0);
				Set Damage Dealt(Event Player, Event Player.Damage);
			Else If(Event Player.Transmute_Values[0] == 4);
				Stop Heal Over Time(Event Player.Ren_Bandage_ID);
			Else If(Event Player.Transmute_Values[0] == 6);
				Set Max Ammo(Event Player, 0, Event Player.Base_Max_Ammo);
				Set Ammo(Event Player, 0, Event Player.Base_Max_Ammo);
				Set Damage Dealt(Global.Temp_Player, Event Player.Damage);
			Else If(Event Player.Transmute_Values[0] == 9);
				Set Projectile Speed(Event Player, 100);
			Else If(Event Player.Transmute_Values[0] == 12);
				Set Healing Received(Event Player, 100);
			Else If(Event Player.Transmute_Values[0] == 13);
				Event Player.Marble_Soul_Boost = 0;
			Else If(Event Player.Transmute_Values[0] == 14);
				Remove Health Pool From Player(Event Player.Gen_soul_Health_ID);
			Else If(Event Player.Transmute_Values[0] == 15);
				Remove Health Pool From Player(Event Player.Shield_ID);
			Else If(Event Player.Transmute_Values[0] == 17);
				Set Jump Vertical Speed(Event Player, 100);
			Else If(Event Player.Transmute_Values[0] == 21);
				Call Subroutine(Player_Damage_Calc);
			Else If(Event Player.Transmute_Values[0] == 25);
				Event Player.Power_Reserve_Charge = 0;
			Else If(Event Player.Transmute_Values[0] == 26);
				Event Player.Titans_Catalyst_Damage = 0;
			Else If(Event Player.Transmute_Values[0] == 27);
				Event Player.Sippy_Straw_Lifesteal = 0;
			Else If(Event Player.Transmute_Values[0] == 35);
				Event Player.Oops_Check = False;
			Else;
				If(Global.Temp_Player.Banker_Values[0] == 0);
					Remove Health Pool From Player(Global.Temp_Player.Armour_ID);
				Else If(Global.Temp_Player.Banker_Values[0] == 1);
					Global.Temp_Player.Movespeed = 100;
					Set Move Speed(Global.Temp_Player, Global.Temp_Player.Movespeed);
				Else If(Global.Temp_Player.Banker_Values[0] == 2);
					Global.Temp_Player.Damage = 100 + Global.Temp_Player.Player_Item_Array[2] * 20 + Global.Temp_Player.Player_Item_Array[21] * 50 + (
						Is True For Any(Global.Ammo_Amplifer_Bugged_Heroes, Hero Of(Global.Temp_Player) == Current Array Element)
						? Global.Temp_Player.Player_Item_Array[6] * 5 : 0);
					Set Damage Dealt(Global.Temp_Player, Global.Temp_Player.Damage);
				Else If(Global.Temp_Player.Banker_Values[0] == 4);
					Stop Heal Over Time(Global.Temp_Player.Ren_Bandage_ID);
				Else If(Global.Temp_Player.Banker_Values[0] == 6);
					Set Max Ammo(Global.Temp_Player, 0, Global.Temp_Player.Base_Max_Ammo);
					Set Ammo(Global.Temp_Player, 0, Global.Temp_Player.Base_Max_Ammo);
					Set Damage Dealt(Global.Temp_Player, Global.Temp_Player.Damage);
				Else If(Global.Temp_Player.Banker_Values[0] == 9);
					Set Projectile Speed(Global.Temp_Player, 100);
				Else If(Global.Temp_Player.Banker_Values[0] == 12);
					Set Healing Received(Global.Temp_Player, 100);
				Else If(Global.Temp_Player.Banker_Values[0] == 13);
					Global.Temp_Player.Marble_Soul_Boost = 0;
				Else If(Global.Temp_Player.Banker_Values[0] == 14);
					Remove Health Pool From Player(Global.Temp_Player.Gen_soul_Health_ID);
				Else If(Global.Temp_Player.Banker_Values[0] == 15);
					Remove Health Pool From Player(Global.Temp_Player.Shield_ID);
				Else If(Global.Temp_Player.Banker_Values[0] == 17);
					Set Jump Vertical Speed(Global.Temp_Player, 100);
				Else If(Global.Temp_Player.Banker_Values[0] == 21);
					Call Subroutine(Player_Damage_Calc);
				Else If(Global.Temp_Player.Banker_Values[0] == 25);
					Global.Temp_Player.Power_Reserve_Charge = 0;
				Else If(Global.Temp_Player.Banker_Values[0] == 26);
					Global.Temp_Player.Titans_Catalyst_Damage = 0;
				Else If(Global.Temp_Player.Banker_Values[0] == 27);
					Global.Temp_Player.Sippy_Straw_Lifesteal = 0;
				Else If(Global.Temp_Player.Banker_Values[0] == 35);
					Global.Temp_Player.Oops_Check = False;
				End;
			End;
	}
}

rule("Add Ammo Amplifer")
{
	event
	{
		Subroutine;
		Add_Ammo_Amplifier;
	}

	actions
	{
		Log To Inspector(Custom String("Running Ammo Amplifer"));
		Call Subroutine(Player_Damage_Calc);
		If(Is True For All(Global.Ammo_Amplifer_Bugged_Heroes, Current Array Element != Hero Of(Event Player)));
			If(Event Player.Player_Item_Array[6] == 0);
				Log To Inspector(Custom String("No Ammo Amp "));
				Event Player.Player_Hero = Hero Of(Event Player);
				Event Player.Base_Max_Ammo = Max Ammo(Event Player, 0);
			End;
			Log To Inspector(Custom String("Adding Ammo"));
			Call Subroutine(Ammo_Amplifer_Calc);
		End;
		If(Event Player.Form_Change_Ammo_Flag == True);
			Call Subroutine(Ammo_Amplifer_Calc);
		End;
	}
}

rule("Ammo Ampilfer - Calc")
{
	event
	{
		Subroutine;
		Ammo_Amplifer_Calc;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Venture));
			Event Player.Max_Ammo = Round To Integer(8 + Event Player.Player_Item_Array[6] * 1.600, Up);
		Else If(Hero Of(Event Player) == Hero(Baptiste));
			Event Player.Max_Ammo = Round To Integer(36 + Event Player.Player_Item_Array[6] * 7.200, Up);
			Event Player.Max_Ammo_Secondary = Round To Integer(10 + Event Player.Player_Item_Array[6] * 2, Up);
		Else If(Hero Of(Event Player) == Hero(Kiriko));
			Event Player.Max_Ammo = Round To Integer(10 + Event Player.Player_Item_Array[6] * 2, Up);
			Event Player.Max_Ammo_Secondary = Round To Integer(15 + Event Player.Player_Item_Array[6] * 3, Up);
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Event Player.Max_Ammo = Round To Integer(4 + Event Player.Player_Item_Array[6] * 1, Up);
		Else;
			Event Player.Max_Ammo = Round To Integer(Event Player.Base_Max_Ammo + Event Player.Player_Item_Array[6] * (
				Event Player.Base_Max_Ammo / 5), Up);
			disabled Log To Inspector(Custom String("Testing"));
		End;
		Set Max Ammo(Event Player, 0, Event Player.Max_Ammo);
		Set Ammo(Event Player, 0, Event Player.Max_Ammo);
		Set Max Ammo(Event Player, 1, Event Player.Max_Ammo_Secondary);
		Set Ammo(Event Player, 1, Event Player.Max_Ammo_Secondary);
	}
}

rule("If Player hero Changed; Run Max Ammo Again; Recheck Ammo; Recheck Damage")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Hero Of(Event Player) != Event Player.Player_Hero;
		Has Spawned(Event Player) == True;
		Event Player.Player_Hero != Null;
	}

	actions
	{
		Event Player.Player_Hero = Hero Of(Event Player);
		Event Player.PlayerHero = Custom String("{0}", Hero Of(Event Player));
		Event Player.Base_Max_Ammo = Max Ammo(Event Player, 0);
		If(Event Player.Player_Item_Array[6] > 0);
			Call Subroutine(Player_Damage_Calc);
			Call Subroutine(Ammo_Amplifer_Calc);
		End;
		Event Player.Form_Change_Ammo_Flag = False;
	}
}

rule("D.va Change Form")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		D.Va;
	}

	conditions
	{
		Global.Game_State >= 1;
		Is In Alternate Form(Event Player) == True;
	}

	actions
	{
		Event Player.Form_Change_Ammo_Flag = True;
		If(Event Player.Player_Item_Array[6] > 0);
			Call Subroutine(Player_Damage_Calc);
			Call Subroutine(Ammo_Amplifer_Calc);
		End;
		Wait Until(!Is In Alternate Form(Event Player), 99999);
		Event Player.Form_Change_Ammo_Flag = False;
		If(Event Player.Player_Item_Array[6] > 0);
			Call Subroutine(Player_Damage_Calc);
			Call Subroutine(Ammo_Amplifer_Calc);
		End;
	}
}

