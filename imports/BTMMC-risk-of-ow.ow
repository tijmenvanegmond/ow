rule("Anticrash on")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Server Load >= Global.svrloadmin;
	}

	actions
	{
		Set Slow Motion(100 - (Global.svrslowamount * Server Load - Global.svrloadmin) / 105);
	}
}

rule("Anticrash off")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Server Load < Global.svrloadmin;
	}

	actions
	{
		Set Slow Motion(100);
	}
}

rule("Pre-Game Setup; 0 = Lobby, 1 = Game, 2 = Final boss, 3 = Ship, 4 = Scoreboard")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Thank you Zezombye for this!"
		Create Dummy Bot(All Heroes, Host Player, False, Null, Null);
		Start Forcing Dummy Bot Name(Last Created Entity, Custom String(
			"______________________________________________________________________________________________________________________________〼"));
		Global.holygrail = String Split(First Of(Last Created Entity), Empty Array);
		Start Forcing Dummy Bot Name(Last Created Entity, Custom String(
			"______________________________________________________________________________________________________________________________ࡀ"));
		Global.holygrail = String Slice(String Replace(Custom String(
			"______________________________________________________________________________________________________________________________〼"),
			Global.holygrail, First Of(Last Created Entity)), 126, True);
		Destroy All Dummy Bots;
		"Serverload required to activate anti-crash rules"
		Global.svrloadmin = Workshop Setting Integer(Custom String("Other Settings"), Custom String("Anti Crash - Mininum Slow Thershold"),
			200, 150, 250, 0);
		"Serverload required to activate anti-crash rules"
		Global.svrslowamount = Workshop Setting Integer(Custom String("Other Settings"), Custom String("Anti Crash - Slow Amount"), 20, 10,
			30, 0);
		If(0 == 0);
			Log To Inspector(Custom String("Inspector Log Disabled!"));
			Disable Inspector Recording;
		Else;
			Log To Inspector(Custom String("Inspector Log Enabled!"));
		End;
		Global.Game_State = 0;
		Global.Teleporter_Circle_Size = 20;
		Global.Spawn_Director_Time = 15;
		Global.Rain_Difficulty = Custom String("Normal");
		Global.Scaling_Difficulty_Time = 60;
		Global.Passive_Regen_Value = 10;
		Global.Challenge_Toggle = False;
		Pause Match Time;
		Set Match Time(0);
		Global.Item_Positions = Empty Array;
		Global.Item_Held_Value = Empty Array;
		Global.Item_Text_ID_List = Empty Array;
		Global.Cryptic_Toggle = False;
		Global.Teleporter_Event_Check = 0;
		Call Subroutine(Item_Variables);
		Wait(0.250, Ignore Condition);
		Call Subroutine(Map_Specific_Variables);
		Wait(0.250, Ignore Condition);
		Call Subroutine(Alternate_Realities_Setup);
		Wait(0.250, Ignore Condition);
		Call Subroutine(Lobby_Creation_Setup);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Create_Lobby_Rings);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Create_Boss);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Player_Abilities_Setup);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Generate_Enemy_Base_Stats);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Game_Hud_Setup);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Event_Icons_and_Hints_Setup);
		Wait(0.200, Ignore Condition);
		Call Subroutine(Player_Item_Hud_Setup);
		Set Objective Description(All Players(All Teams), Custom String("Players Voting: {0} / {1}", Global.Player_Start_Vote,
			Number Of Players(Team 1)), Visible To and String);
		Create In-World Text(Global.Loading_Text == Custom String("") ? Null : All Players(All Teams), Global.Loading_Text, Vector(5, 1000,
			5), 4, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Global.Loading_Text = Custom String("");
		Disable Built-In Game Mode Respawning(All Players(All Teams));
		Global.Anti_Crash = False;
	}
}

