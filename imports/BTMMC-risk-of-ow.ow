rule("Teleport Boss to Fight")
{
	event
	{
		Subroutine;
		Spawn_Boss;
	}

	actions
	{
		Resurrect(Global.Boss);
		Call Subroutine(Boss_Cooldowns);
		Set Invisible(Global.Boss, None);
		Clear Status(Global.Boss, Invincible);
		Start Scaling Player(Global.Boss, 3, True);
		Call Subroutine(Health_Damage_Calc_Boss);
		Global.Current_Budget += Global.Challenge_Toggle == True ? 14 : 7;
		Wait(0.160, Ignore Condition);
		Teleport(Global.Boss, Nearest Walkable Position(Global.Event_Reference_Locations[0] + Vector(Random Real(-10, 10), 0, Random Real(
			-10, 10))));
	}
}

rule("Select Boss")
{
	event
	{
		Subroutine;
		Select_Boss;
	}

	actions
	{
		If(Global.Boss_Random_Select == String("Final Enemy"));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Doomfist));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("Warlord Kragg"));
			Global.Boss_Name = Custom String("Warlord Kragg");
			Abort;
		End;
		Global.Selected_Bosses = Random Value In Array(Array(Hero(Bastion), Hero(Mercy), Hero(Orisa), Hero(Wrecking Ball), Hero(Moira)));
		Wait(0.500, Ignore Condition);
		If(Global.Selected_Bosses == Hero(Bastion));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Bastion));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("The Metal Guardian"));
			Global.Boss_Name = Custom String("The Metal Guardian");
		Else If(Global.Selected_Bosses == Hero(Mercy));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Mercy));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("The Moth Queen"));
			Global.Boss_Name = Custom String("The Moth Queen");
		Else If(Global.Selected_Bosses == Hero(Orisa));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Orisa));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("The Warframe Warden"));
			Global.Boss_Name = Custom String("The Warframe Warden");
		Else If(Global.Selected_Bosses == Hero(Wrecking Ball));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Wrecking Ball));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("The Marble Majesty"));
			Global.Boss_Name = Custom String("The Marble Majesty");
			Wait(0.250, Ignore Condition);
			Press Button(Global.Boss, Button(Ability 1));
		Else If(Global.Selected_Bosses == Hero(Moira));
			Start Forcing Player To Be Hero(Global.Boss, Hero(Moira));
			Start Forcing Dummy Bot Name(Global.Boss, Custom String("The Otaku Geneticist"));
			Global.Boss_Name = Custom String("The Otaku Geneticist");
		End;
	}
}

rule("Set Boss Cooldowns")
{
	event
	{
		Subroutine;
		Boss_Cooldowns;
	}

	actions
	{
		If(Hero Of(Global.Boss) == Hero(Mercy));
			Global.Boss.Boss_Ability1_CD = 10;
			Global.Boss.Boss_Ability2_CD = 15;
			Global.Boss.Boss_Ability3_CD = 0;
		Else If(Hero Of(Global.Boss) == Hero(Wrecking Ball));
			Global.Boss.Boss_Ability1_CD = 0.500;
			Global.Boss.Boss_Ability2_CD = 15;
			Global.Boss.Boss_Ability3_CD = 20;
		Else;
			Global.Boss.Boss_Ability1_CD = 10;
			Global.Boss.Boss_Ability2_CD = 15;
			Global.Boss.Boss_Ability3_CD = 30;
		End;
		Global.Boss.Boss_Ability_1 = Total Time Elapsed;
		Global.Boss.Boss_Ability_2 = Total Time Elapsed;
		Global.Boss.Boss_Ability_3 = Total Time Elapsed;
	}
}

rule("Set Mini-Boss Cooldowns")
{
	event
	{
		Subroutine;
		Mini_Boss_Cooldowns;
	}

	actions
	{
		If(Hero Of(Global.Current_Spawned_Enemy) == Hero(Mercy));
			Global.Current_Spawned_Enemy.Boss_Ability1_CD = 10;
			Global.Current_Spawned_Enemy.Boss_Ability2_CD = 15;
			Global.Current_Spawned_Enemy.Boss_Ability3_CD = 0;
		Else If(Hero Of(Global.Current_Spawned_Enemy) == Hero(Wrecking Ball));
			Global.Current_Spawned_Enemy.Boss_Ability1_CD = 0.500;
			Global.Current_Spawned_Enemy.Boss_Ability2_CD = 15;
			Global.Current_Spawned_Enemy.Boss_Ability3_CD = 20;
		Else;
			Global.Current_Spawned_Enemy.Boss_Ability1_CD = 10;
			Global.Current_Spawned_Enemy.Boss_Ability2_CD = 15;
			Global.Current_Spawned_Enemy.Boss_Ability3_CD = 30;
		End;
		Global.Current_Spawned_Enemy.Boss_Ability_1 = Total Time Elapsed;
		Global.Current_Spawned_Enemy.Boss_Ability_2 = Total Time Elapsed;
		Global.Current_Spawned_Enemy.Boss_Ability_3 = Total Time Elapsed;
	}
}

rule("Boss Died")
{
	event
	{
		Subroutine;
		Boss_Defeated;
	}

	actions
	{
		Call Subroutine(Roll_Item_Value);
		Global.Boss.Boss_Warning = False;
		If(Global.Challenge_Toggle == True);
			Small Message(All Players(All Teams), Custom String("    You Won The Challenge!"));
		End;
		Wait(0.500, Ignore Condition);
		Teleport(Global.Boss, Global.Enemy_Temp_Spawn);
		Start Scaling Player(Global.Boss, 1, True);
		Remove All Health Pools From Player(Global.Boss);
		Set Damage Dealt(Global.Boss, 100);
		Stop Holding Button(Global.Boss, Button(Primary Fire));
	}
}

rule("General Boss Aiming Script")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Distance Between(Event Player, Global.Enemy_Temp_Spawn) > 4;
		(Event Player.Player_Type == String("Warning") || Event Player == Global.Boss) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Bastion));
			Event Player.Player_Aim_Speed = 100;
			Event Player.Enemy_Attack_Range = 40;
		Else If(Hero Of(Event Player) == Hero(Mercy));
			Event Player.Player_Aim_Speed = 100;
			Event Player.Enemy_Attack_Range = 40;
		Else If(Hero Of(Event Player) == Hero(Orisa));
			Event Player.Player_Aim_Speed = 100;
			Event Player.Enemy_Attack_Range = 40;
		Else If(Hero Of(Event Player) == Hero(Wrecking Ball));
			Event Player.Player_Aim_Speed = 0;
			Event Player.Enemy_Attack_Range = 0;
		Else If(Hero Of(Event Player) == Hero(Moira));
			Event Player.Player_Aim_Speed = 100;
			Event Player.Enemy_Attack_Range = 40;
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Event Player.Player_Aim_Speed = 3000;
			Event Player.Enemy_Attack_Range = 25;
		End;
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(First Of(Sorted Array(
			Global.Possible_Enemy_Targets, Distance Between(Event Player, Current Array Element)))) * 0.750 + Position Of(First Of(
			Sorted Array(Global.Possible_Enemy_Targets, Distance Between(Event Player, Current Array Element)))) * 0.250),
			Event Player.Player_Aim_Speed, To World, Direction and Turn Rate);
	}
}

rule("General Boss Primary Attack Script")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Distance Between(Event Player, Global.Enemy_Temp_Spawn) > 4;
		(Event Player.Player_Type == String("Warning") || Event Player == Global.Boss) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If((Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
			< Event Player.Enemy_Attack_Range && Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, Team 1),
			Barriers Do Not Block LOS)) == True);
			If(Hero Of(Event Player) == Hero(Bastion));
				Start Holding Button(Event Player, Button(Primary Fire));
				Wait Until(Count Of(Players Within Radius(Event Player, Event Player.Enemy_Attack_Range, Team 1, Off)) == 0 || Is In Line of Sight(
					Event Player, Player Closest To Reticle(Event Player, Team 1), Barriers Do Not Block LOS) != True, 99999);
				Stop Holding Button(Event Player, Button(Primary Fire));
			Else If(Hero Of(Event Player) == Hero(Mercy));
				Start Holding Button(Event Player, Button(Primary Fire));
				Wait Until(Count Of(Players Within Radius(Event Player, Event Player.Enemy_Attack_Range, Team 1, Off)) == 0 || Is In Line of Sight(
					Event Player, Player Closest To Reticle(Event Player, Team 1), Barriers Do Not Block LOS) != True, 99999);
				Stop Holding Button(Event Player, Button(Primary Fire));
			Else If(Hero Of(Event Player) == Hero(Orisa));
				Start Holding Button(Event Player, Button(Primary Fire));
				Wait Until(Count Of(Players Within Radius(Event Player, Event Player.Enemy_Attack_Range, Team 1, Off)) == 0 || Is In Line of Sight(
					Event Player, Player Closest To Reticle(Event Player, Team 1), Barriers Do Not Block LOS) != True, 99999);
				Stop Holding Button(Event Player, Button(Primary Fire));
			Else If(Hero Of(Event Player) == Hero(Moira));
				Start Holding Button(Event Player, Button(Secondary Fire));
				Wait Until(Count Of(Players Within Radius(Event Player, Event Player.Enemy_Attack_Range, Team 1, Off)) == 0 || Is In Line of Sight(
					Event Player, Player Closest To Reticle(Event Player, Team 1), Barriers Do Not Block LOS) != True, 99999);
				Stop Holding Button(Event Player, Button(Secondary Fire));
			Else If(Hero Of(Event Player) == Hero(Doomfist));
				Start Holding Button(Event Player, Button(Primary Fire));
				Wait Until(Count Of(Players Within Radius(Event Player, Event Player.Enemy_Attack_Range, Team 1, Off)) == 0 || Is In Line of Sight(
					Event Player, Player Closest To Reticle(Event Player, Team 1), Barriers Do Not Block LOS) != True, 99999);
				Stop Holding Button(Event Player, Button(Primary Fire));
			End;
		End;
		Wait(0.160, Ignore Condition);
		Wait Until(Distance Between(Event Player, Player Closest To Reticle(Event Player, Team 1))
			< Event Player.Enemy_Attack_Range && Is In Line of Sight(Event Player, Player Closest To Reticle(Event Player, Team 1),
			Barriers Do Not Block LOS), 99999);
		Loop;
	}
}

rule("Boss Ability One")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Total Time Elapsed > Event Player.Boss_Ability_1 + Event Player.Boss_Ability1_CD;
		Distance Between(Event Player, Global.Enemy_Temp_Spawn) > 4;
		(Event Player.Player_Type == String("Warning") || Event Player == Global.Boss) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Bastion));
			For Global Variable(For_Loop_Counter, 0, 3, 1);
				Global.Boss_Random_Select = Random Value In Array(Global.Possible_Enemy_Targets);
				Create Homing Projectile(Pharah Rocket, Event Player, Null, Direction Towards(Eye Position(Event Player), Eye Position(
					Global.Boss_Random_Select)), To World, Damage, Team 1, 40, 1, 3, Bad Explosion, Explosion Sound, 0, 20, 5, 0,
					Global.Boss_Random_Select, 0.500);
				Wait(0.160, Ignore Condition);
			End;
		Else If(Hero Of(Event Player) == Hero(Mercy));
			For Global Variable(For_Loop_Counter, 0, 3, 1);
				Global.Boss_Random_Select = Position Of(Random Value In Array(Global.Possible_Enemy_Targets));
				Create Effect(All Players(All Teams), Light Shaft, Color(Purple), Global.Boss_Random_Select, 3, Visible To Position and Radius);
				Play Effect(All Players(All Teams), Ring Explosion Sound, Color(White), Global.Boss_Random_Select, 100);
				Global.Boss_Attack_Effect = Last Created Entity;
				Wait(1.500, Ignore Condition);
				Destroy Effect(Global.Boss_Attack_Effect);
				Create Beam Effect(All Players(All Teams), Bad Beam, Global.Boss_Random_Select + Vector(0, 5, 0), Global.Boss_Random_Select, Color(
					Red), Visible To Position and Radius);
				Damage(Players Within Radius(Global.Boss_Random_Select, 3, Team 1, Off), Global.Boss, 100);
				Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Global.Boss_Random_Select, 100);
				Play Effect(All Players(All Teams), Zarya Particle Cannon Explosion Effect, Color(Yellow), Global.Boss_Random_Select, 7);
				Global.Boss_Attack_Effect = Last Created Entity;
				Wait(0.250, Ignore Condition);
				Destroy Effect(Global.Boss_Attack_Effect);
			End;
		Else If(Hero Of(Event Player) == Hero(Orisa));
			Press Button(Event Player, Button(Ability 2));
			Global.Boss_Random_Select = Random Value In Array(Global.Possible_Enemy_Targets);
			For Global Variable(For_Loop_Counter, 0, 5, 1);
				Create Homing Projectile(Reinhardt Fire Strike, Event Player, Null, Direction Towards(Eye Position(Event Player), Eye Position(
					Global.Boss_Random_Select)), To World, Damage, Team 1, 40, 1, 3, Bad Explosion, Explosion Sound, 0, 25, 30, 0,
					Global.Boss_Random_Select, 0.700);
				Wait(0.160, Ignore Condition);
			End;
		Else If(Hero Of(Event Player) == Hero(Wrecking Ball));
			Global.Boss_Random_Select = Random Value In Array(Global.Possible_Enemy_Targets);
			Create Projectile(Moira Heal Orb, Event Player, Null, Direction Towards(Eye Position(Event Player), Eye Position(
				Global.Boss_Random_Select)), To World, Damage, Team 1, 60, 1, 5, Bad Explosion, Explosion Sound, 0, 50, 5, 0, 0, 0);
			Wait(0.160, Ignore Condition);
		Else If(Hero Of(Event Player) == Hero(Moira));
			Global.Boss_Random_Select = Random Value In Array(Global.Possible_Enemy_Targets);
			For Global Variable(For_Loop_Counter, 0, 10, 1);
				Create Projectile(Moira Heal Orb, Event Player, Null, Direction Towards(Eye Position(Event Player), Eye Position(
					Global.Boss_Random_Select)), To World, Damage, Team 1, 50, 1, 0, Bad Explosion, Explosion Sound, 0, 50, 5, 0, 0, 0);
				Wait(0.200, Ignore Condition);
			End;
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Press Button(Event Player, Button(Jump));
			Press Button(Event Player, Button(Ability 1));
			Apply Impulse(Event Player, Up, 20, To World, Cancel Contrary Motion);
		End;
		Event Player.Boss_Ability_1 = Total Time Elapsed;
	}
}

rule("Boss Ability Two")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Total Time Elapsed > Event Player.Boss_Ability_2 + Event Player.Boss_Ability2_CD;
		Distance Between(Event Player, Global.Enemy_Temp_Spawn) > 4;
		(Event Player.Player_Type == String("Warning") || Event Player == Global.Boss) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Bastion));
			Event Player.Boss_Warning = True;
			Play Effect(All Players(All Teams), Hanzo Sonic Arrow Initial Pulse Effect, Color(White), Event Player, 100);
			Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Event Player, 200);
			Wait(1, Ignore Condition);
			Play Effect(All Players(All Teams), Hanzo Sonic Arrow Initial Pulse Effect, Color(White), Event Player, 100);
			Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Event Player, 200);
			Wait(1, Ignore Condition);
			Play Effect(All Players(All Teams), Hanzo Sonic Arrow Initial Pulse Effect, Color(White), Event Player, 100);
			Play Effect(All Players(All Teams), Debuff Impact Sound, Color(White), Event Player, 200);
			Wait(1, Ignore Condition);
			Play Effect(All Players(All Teams), DVa Self Destruct Explosion Effect, Color(Red), Event Player, 20);
			Damage(Players Within Radius(Event Player, 20, Team 1, Surfaces And Enemy Barriers), Event Player, Max Health(Event Player) / 5);
			Event Player.Boss_Warning = False;
			Wait(0.160, Ignore Condition);
		Else If(Hero Of(Event Player) == Hero(Mercy));
			Global.Spawning_Type = 5;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
			Wait(0.160, Ignore Condition);
		Else If(Hero Of(Event Player) == Hero(Orisa));
			For Global Variable(For_Loop_Counter, 0, 3, 1);
				Global.Boss_Random_Select = Evaluate Once(Position Of(Random Value In Array(Global.Possible_Enemy_Targets)));
				Create Effect(All Players(All Teams), Light Shaft, Color(Purple), Global.Boss_Random_Select, 3, Visible To Position and Radius);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Effect, Color(White), Global.Boss_Random_Select, 100);
				Global.Boss_Attack_Effect = Last Created Entity;
				Wait(1.500, Ignore Condition);
				Destroy Effect(Global.Boss_Attack_Effect);
				Create Projectile Effect(All Players(All Teams), Mei Icicle, Null, Global.Boss_Random_Select + Vector(0, 7, 0), Down, 0.400,
					Visible To Position Direction and Size);
				Damage(Players Within Radius(Global.Boss_Random_Select, 3, Team 1, Off), Global.Boss, 40);
				Set Status(Players Within Radius(Global.Boss_Random_Select, 3, Team 1, Off), Null, Frozen, 0.750);
				Play Effect(All Players(All Teams), Explosion Sound, Color(White), Global.Boss_Random_Select, 100);
				Play Effect(All Players(All Teams), Bad Explosion, Color(Yellow), Global.Boss_Random_Select, 7);
				Global.Boss_Attack_Effect = Last Created Entity;
				Wait(0.250, Ignore Condition);
				Destroy Effect(Global.Boss_Attack_Effect);
			End;
		Else If(Hero Of(Event Player) == Hero(Wrecking Ball));
			Global.Spawning_Type = 7;
			Call Subroutine(Spawn_Enemies);
			Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
			Wait(0.160, Ignore Condition);
			Event Player.Boss_Ability_2 = Event Player.Boss_Ability2_CD;
		Else If(Hero Of(Event Player) == Hero(Moira));
			Set Invisible(Event Player, None);
			Set Status(Event Player, Null, Invincible, 0.500);
			Play Effect(All Players(All Teams), Moira Fade Disappear Effect, Color(White), Event Player, 1);
			Global.Boss_Random_Select = Random Value In Array(Global.Possible_Enemy_Targets);
			Wait(0.500, Ignore Condition);
			Teleport(Event Player, Global.Boss_Random_Select);
			Play Effect(All Players(All Teams), Moira Fade Reappear Effect, Color(White), Event Player, 1);
			Wait(0.500, Ignore Condition);
			Set Status(Players Within Radius(Event Player, 2, Team 1, Surfaces), Null, Asleep, 2);
			Wait(0.500, Ignore Condition);
			Teleport(Event Player, Event Player == Global.Boss ? Nearest Walkable Position(Global.Event_Reference_Locations[0] + Vector(
				Random Real(-10, 10), 0, Random Real(-10, 10))) : Nearest Walkable Position(Global.Event_Reference_Locations[3] + Vector(
				Random Real(-10, 10), 0, Random Real(-10, 10))));
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Start Holding Button(Event Player, Button(Secondary Fire));
			Wait(1.500, Ignore Condition);
			Stop Holding Button(Event Player, Button(Secondary Fire));
		End;
		Event Player.Boss_Ability_2 = Total Time Elapsed;
	}
}

rule("Boss Ability Three")
{
	event
	{
		Ongoing - Each Player;
		Team 2;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Total Time Elapsed > Event Player.Boss_Ability_3 + Event Player.Boss_Ability3_CD;
		Distance Between(Event Player, Global.Enemy_Temp_Spawn) > 4;
		(Event Player.Player_Type == String("Warning") || Event Player == Global.Boss) == True;
		Global.Game_State != 0;
	}

	actions
	{
		If(Hero Of(Event Player) == Hero(Bastion));
			Press Button(Event Player, Button(Ability 1));
		Else If(Hero Of(Event Player) == Hero(Mercy));
			Set Ultimate Charge(Event Player, 100);
			Wait Until(Normalized Health(Event Player) <= 0.500, 99999);
			Press Button(Event Player, Button(Ultimate));
		Else If(Hero Of(Event Player) == Hero(Orisa));
			Set Ultimate Charge(Event Player, 100);
			Press Button(Event Player, Button(Ultimate));
			Set Status(All Players(Team 1), Event Player, Hacked, 5);
		Else If(Hero Of(Event Player) == Hero(Wrecking Ball));
			Set Ultimate Charge(Event Player, 100);
			Wait(0.160, Ignore Condition);
			Press Button(Event Player, Button(Ultimate));
		Else If(Hero Of(Event Player) == Hero(Moira));
			Event Player.Boss_Warning = True;
			Event Player.Moira_Bomb_Size = 0;
			Event Player.Moira_Bomb_Location = Eye Position(Event Player) + Vector(0, 4, 0);
			Create Projectile Effect(All Players(All Teams), Moira Damage Orb, Event Player, Event Player.Moira_Bomb_Location, Vector(0, 0, 0),
				Event Player.Moira_Bomb_Size, Visible To Position Direction and Size);
			Global.Lobby_Text_id_List = Last Created Entity;
			Chase Player Variable At Rate(Event Player, Moira_Bomb_Size, 0.400, 0.050, Destination and Rate);
			Wait Until(Event Player.Moira_Bomb_Size == 0.400, 99999);
			Play Effect(All Players(All Teams), Bad Explosion, Color(Black), Event Player, 20);
			Destroy Effect(Global.Lobby_Text_id_List);
			Damage(Players Within Radius(Event Player.Moira_Bomb_Location, 20, Team 1, Surfaces), Event Player, Max Health(Event Player) / 5);
			Event Player.Boss_Warning = False;
		Else If(Hero Of(Event Player) == Hero(Doomfist));
			Set Ultimate Charge(Global.Boss, 100);
			Press Button(Global.Boss, Button(Ultimate));
			Wait(0.500, Ignore Condition);
			Teleport(Event Player, Random Value In Array(All Living Players(Team 1)));
		End;
		Event Player.Boss_Ability_3 = Total Time Elapsed;
	}
}

