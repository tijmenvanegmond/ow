	{
		Subroutine;
		Play_Arcane_Pendent;
	}

	actions
	{
		Play Effect(Attacker, Good Pickup Effect, Color(Green), Victim, 1);
		Heal(Attacker, Attacker, Attacker.Arcane_Pendant_Heal);
	}
}

rule("Play Spooky Ghost")
{
	event
	{
		Subroutine;
		Play_Spooky_Ghost;
	}

	actions
	{
		Event Player.Spooky_Ghost_Stack_Count += 1;
		If(Event Player.Spooky_Ghost_Stack_Count == 5);
			Event Player.Spooky_Ghost_Roll = Random Integer(1, Round To Integer(100 / Event Player.Player_Item_Array[23], Down));
			Event Player.Current_Item_Value = Event Player.Spooky_Ghost_Roll <= 1 ? Random Integer(16, 26) : (
				Event Player.Spooky_Ghost_Roll <= 3 ? Random Integer(27, 34) : Random Integer(1, 10));
			Small Message(Event Player, Custom String("   The Ghost gave you an item!"));
			Call Subroutine(Call_Item);
			Event Player.Spooky_Ghost_Stack_Count = 0;
	}
}

rule("Play Scavenger Effect")
{
	event
	{
		Subroutine;
		Play_Scavenger;
	}

	actions
	{
		If(Random Integer(1, 100) <= Min(100, 50 + (Attacker.Player_Item_Array[33] - 1) * 5));
			Set Ability Cooldown(Attacker, Button(Secondary Fire), 0);
			Set Ability Cooldown(Attacker, Button(Ability 1), 0);
			Set Ability Cooldown(Attacker, Button(Ability 2), 0);
			Set Ability Cooldown(Attacker, Button(Crouch), 0);
			Set Ability Cooldown(Attacker, Button(Jump), 0);
		End;
	}
}

rule("Play Power Reserve Effect")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Ultimate Charge Percent(Event Player) < Event Player.Power_Reserve_Charge;
		disabled Is Using Ultimate(Event Player) == False;
		disabled Hero Of(Event Player) != Hero(D.Va);
	}

	actions
	{
		Wait Until(!Is In Alternate Form(Event Player), 99999);
		Set Ultimate Charge(Event Player, Event Player.Power_Reserve_Charge);
	}
}

rule("Play Rod of Ages Effect")
{
	event
	{
		Subroutine;
		Play_Rod_of_Ages;
	}

	actions
	{
		Abort If(Global.Temp_Player.Player_Item_Array[29] == 0);
		Global.Temp_Player.Pathfinding_Random_Value = Random Integer(1, 5) == 1 ? Random Integer(16, 24) : Random Integer(25, 34);
		Global.Temp_Player.Player_Item_Array[Global.Temp_Player.Pathfinding_Random_Value] += 1;
		Global.Temp_Player.Player_Item_Array[29] -= 1;
		Small Message(Global.Temp_Player, Custom String("   Rod Of Ages Transformed into {0}!",
			Global.Item_Names[Global.Temp_Player.Pathfinding_Random_Value]));
		Wait(0.050, Ignore Condition);
		Call Subroutine(Call_Item);
		Loop If(Global.Temp_Player.Player_Item_Array[29] > 0);
	}
}

rule("Play Oops I Fell Up")
{
	event
	{
		Ongoing - Each Player;
		Team 1;
		All;
	}

	conditions
	{
		Hero Of(Event Player) != Hero(Jetpack Cat);
		Is On Ground(Event Player) == False;
		Event Player.Player_Item_Array[34] > 0;
		Is Button Held(Event Player, Button(Jump)) == True;
		Altitude Of(Event Player) > 0.500;
		Vertical Speed Of(Event Player) < 0;
		Event Player.Oops_Check != False;
	}

	actions
	{
		Event Player.Oops_Check = False;
		Apply Impulse(Event Player, Up, Event Player.Oops_Jump_Power, To Player, Cancel Contrary Motion);
		Wait Until(Is On Ground(Event Player), 99999);
		Event Player.Oops_Check = True;
	}
}

