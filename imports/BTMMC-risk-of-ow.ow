rule("Next Stage")
{
	event
	{
		Subroutine;
		Next_Stage;
	}

	actions
	{
		Set Invisible(All Players(Team 1), All);
		All Players(Team 1).Player_Type = String("Stable");
		Resurrect(All Dead Players(Team 1));
		Teleport(All Players(Team 1), Global.Stage_Spawn);
		Call Subroutine(Reset_For_Next_Stage);
		Global.Stage_Number += 1;
		Call Subroutine(Enemy_Group_Select);
		If(Global.Crypic_Tracker == 5);
			Global.Crypic_Tracker = 1;
			Global.Game_Loop_Number += 1;
		Else;
			Global.Crypic_Tracker += 1;
		End;
		Big Message(All Players(Team 1), Custom String("Next Stage"));
		Resurrect(Global.Boss);
		Start Camera(All Players(Team 1), Vector(0, 1000, 0), Vector(5, 1000, 5), 0);
		Global.Loading_Text = Custom String("Loading.");
		Heal(All Players(Team 1), Null, 100000);
		Wait(1, Ignore Condition);
		If(Global.Cryptic_Toggle != True);
			Global.Loading_Text = Custom String("Loading. Locations");
			Call Subroutine(Event_Location_Chooser);
			Wait(0.160, Ignore Condition);
			Global.Loading_Text = Custom String("Loading. Items");
			Call Subroutine(Generate_Event_Item_Locations);
			Wait(0.160, Ignore Condition);
			Global.Loading_Text = Custom String("Loading. Boss");
			Call Subroutine(Select_Boss);
		End;
		Global.Loading_Text = Custom String("Loading..");
		Wait(1, Ignore Condition);
		Kill(Filtered Array(All Players(Team 2), Current Array Element.Player_Type != String("Boss")), Null);
		Global.Loading_Text = Custom String("Loading.. Clean-up");
		Call Subroutine(Stage_Cleanup);
		If(Global.Cryptic_Toggle == True);
			Call Subroutine(Cryptic_Cutscene);
			Global.Game_Loop_Number -= 1;
		End;
		Global.Loading_Text = Custom String("Loading.. Power-up");
		Call Subroutine(Player_Changes_Application);
		Global.Harmony_Hero = 0;
		Global.Loading_Text = Custom String("Loading...");
		Wait(2, Ignore Condition);
		All Players(Team 1).Ability_CD = 0;
		Set Invisible(All Players(Team 1), None);
		Stop Camera(All Players(Team 1));
		Filtered Array(All Players(Team 1), Current Array Element.ThirdPersonCamera == 2).ThirdPersonCamera = 1;
		Global.Possible_Enemy_Targets = All Living Players(Team 1);
		Teleport(All Players(Team 1), Global.Stage_Spawn);
		If(Global.Cryptic_Toggle == True);
			Set Objective Description(All Players(All Teams), Custom String("Defeat Kragg"), Visible To and String);
			Global.Game_State = 2;
		Else;
			Set Objective Description(All Players(All Teams), Custom String("Find the {2} {0}{1}Teleporter{0}/fg> {2}", Global.holygrail,
				Custom String("fgFF0000FF>"), Icon String(Diamond)), Visible To and String);
		End;
		Chase Global Variable At Rate(Timer_Seconds, 60, 1, Destination and Rate);
		Chase Global Variable At Rate(Spawn_Director, Global.Spawn_Director_Time, 1, Destination and Rate);
		Chase Global Variable At Rate(Scaling_Difficulty_Tracker, Global.Scaling_Difficulty_Time, 1, Destination and Rate);
		Global.Current_Budget = 0;
		Global.Loading_Text = Custom String("");
		If(Number Of Players(Team 1) == 1 && Count Of(Players On Hero(Hero(Venture), Team 1)) == 1);
			All Players(Team 1).VentureFreeItem = True;
		End;
	}
}

rule("Stage_Cleanup")
{
	event
	{
		Subroutine;
		Stage_Cleanup;
	}

	actions
	{
		For Global Variable(For_Loop_Counter, 0, Count Of(Global.Item_Positions), 1);
			Destroy Effect(Global.Item_Visual_ID[Global.For_Loop_Counter]);
			Destroy In-World Text(Global.Item_Text_ID_List[Global.For_Loop_Counter]);
		End;
		Global.Item_Positions = Empty Array;
		Global.Item_Held_Value = Empty Array;
		Global.Item_Text_ID_List = Empty Array;
	}
}

rule("Player_Changes_Application")
{
	event
	{
		Subroutine;
		Player_Changes_Application;
	}

	actions
	{
		For Global Variable(For_Loop_Counter, 0, Count Of(All Players(Team 1)), 1);
			Global.Temp_Player = All Players(Team 1)[Global.For_Loop_Counter];
			If(Global.Reality_Checker[4] == True);
				Start Forcing Player To Be Hero(Global.Temp_Player, Random Value In Array(All Heroes));
			End;
			If(Global.Reality_Checker[10] == True);
				Global.Temp_Player.Player_Ability_Check = Random Integer(0, Count Of(Global.Player_Abilities_Name) - 1);
				Call Subroutine(Player_Ability_Calculate_CD);
			End;
			If(Global.Temp_Player.Player_Item_Array[29] > 0);
				Call Subroutine(Play_Rod_of_Ages);
			End;
		End;
	}
}

rule("Reset Values for Next Stage")
{
	event
	{
		Subroutine;
		Reset_For_Next_Stage;
	}

	actions
	{
		Stop Chasing Global Variable(Timer_Seconds);
		Stop Chasing Global Variable(Spawn_Director);
		Stop Chasing Global Variable(Scaling_Difficulty_Tracker);
		Stop Chasing Global Variable(Teleporter_Charge);
		Global.Challenge_Toggle = False;
		Global.Event_Location = Global.Teleporter_Locations;
		Global.Event_Location_Name = Global.Teleporter_Locations_Name;
		Global.Teleporter_Event_Check = 0;
		Global.Teleporter_Circle = 0;
		Global.Teleporter_Charge = 0;
		Global.Spawn_Director = 0;
		Global.Event_Found_Check = Array(-1, -1, -1, -1, -1);
	}
}

rule("If Cryptic was activated")
{
	event
	{
		Subroutine;
		Cryptic_Cutscene;
	}

	actions
	{
		Global.Boss_Random_Select = String("Final Enemy");
		Call Subroutine(Select_Boss);
		Set Ultimate Charge(Global.Boss, 100);
		Set Invisible(Global.Boss, None);
		Start Scaling Player(Global.Boss, 1.500, True);
		Call Subroutine(Health_Damage_Calc_Boss);
		Call Subroutine(Boss_Cooldowns);
		Wait(0.500, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("A Chill Runs Down Your Spine..."));
		Wait(0.500, Ignore Condition);
		Wait Until(Global.Game_State == 2, 0);
		Teleport(Global.Boss, Nearest Walkable Position(Global.Event_Reference_Locations[0]));
	}
}

rule("Player Died")
{
	event
	{
		Player Died;
		Team 1;
		All;
	}

	actions
	{
		Modify Global Variable(Possible_Enemy_Targets, Remove From Array By Value, Event Player);
		If(Is In Air(Event Player) == True);
			Teleport(Event Player, Nearest Walkable Position(Event Player));
		End;
		If(Event Player.Player_Item_Array[20] > 0);
			Big Message(Event Player, Custom String("Winton"));
			Wait(3, Ignore Condition);
			Resurrect(Event Player);
			Set Status(Event Player, Null, Burning, 3);
			Set Status(Event Player, Null, Invincible, 3);
			Event Player.Player_Item_Array[20] -= 1;
			Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
			Abort;
		End;
		If(Number Of Players(Team 1) == 1 && Hero Of(Event Player) == Hero(Mercy) && Ability Cooldown(Event Player, Button(Ability 2))
			== 0);
			Big Message(All Players(All Teams), Custom String("I'm not done yet!"));
			Wait(3, Ignore Condition);
			Resurrect(Event Player);
			Set Status(Event Player, Null, Burning, 3);
			Set Status(Event Player, Null, Invincible, 3);
			Set Ability Cooldown(Event Player, Button(Ability 2), 60);
			Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
			Abort;
		End;
		If(Hero Of(Event Player) == Hero(Anran) && Ultimate Charge Percent(Event Player) == 100);
			Wait(6, Ignore Condition);
			If(Is Alive(Event Player));
				Modify Global Variable(Possible_Enemy_Targets, Append To Array, Event Player);
				Abort;
			End;
		End;
		If(Event Player.Player_Item_Array[25] > 0);
			Event Player.Player_Item_Array[25] = 0;
			Small Message(Event Player, Custom String("   Rod of Ages Broke"));
		End;
		If(Global.Reality_Checker[0] == True);
			Event Player.Player_Type = String("Down");
		Else If(Global.Reality_Checker[7] == True);
			Kill(All Players(Team 1), Null);
			All Players(Team 1).Player_Type = String("Waiting");
		Else;
			Event Player.Player_Type = String("Waiting");
			If(Number Of Living Players(Team 1) > 0);
				Small Message(Event Player, Custom String("  Oh no, you died!"));
				Wait(0.500, Ignore Condition);
				Small Message(Event Player, Custom String("  You have to let your other teammates Complete the stage to revive you!"));
			End;
			Modify Global Variable(Possible_Enemy_Targets, Remove From Array By Value, Event Player);
			For Player Variable(Victim, Enemy_Attack_Range, 0, Count Of(Victim.Player_Item_Array), 1);
				Victim.Total_Items += Victim.Player_Item_Array[Victim.Enemy_Attack_Range];
			End;
			Victim.Killed_By = Attacker;
	}
}

rule("Game Over")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Game_State >= 1;
		(Is True For All(All Players(Team 1), Current Array Element.Player_Type == String("Waiting")) || Is True For All(All Players(
			Team 1), Current Array Element.Player_Type == String("Down"))) == True;
	}

	actions
	{
		If(Number Of Players(Team 1) == 0);
			Restart Match;
		End;
		Global.Game_State = 4;
		Set Slow Motion(30);
		Stop Chasing Global Variable(Timer_Seconds);
		Stop Chasing Global Variable(Spawn_Director);
		Stop Chasing Global Variable(Scaling_Difficulty_Tracker);
		Disable Messages(All Players(Team 1));
		Destroy All Effects;
		Destroy All HUD Text;
		Destroy All Progress Bar HUD Text;
		Destroy All Icons;
		Destroy All In-World Text;
		Disable Hero HUD(All Players(Team 1));
		Disable Game Mode HUD(All Players(All Teams));
		Wait(1, Ignore Condition);
		Destroy All Dummy Bots;
		Respawn(All Players(Team 1));
		Set Slow Motion(100);
		Start Camera(All Players(Team 1), Vector(0, 1000, 0), Vector(5, 1000, 0), 0);
		Call Subroutine(Create_ScoreBoard);
	}
}

rule("Create ScoreBoard")
{
	event
	{
		Subroutine;
		Create_ScoreBoard;
	}

	actions
	{
		Wait(1, Ignore Condition);
		Create In-World Text(All Players(All Teams), Custom String("You {2} at Stage {0} on {1} Difficulty", Global.Stage_Number,
			Custom String("{0}{1}{2}{0}/fg>", Global.holygrail, Global.Rain_Difficulty == Custom String("Easy") ? Custom String(
			"fg5BFF33FF>") : (Global.Rain_Difficulty == Custom String("Normal") ? Custom String("fgF9FF33FF>") : Custom String(
			"fgFF0000FF>")), Global.Rain_Difficulty), Global.HasEscaped == True ? Custom String("Escaped") : Custom String("Died")),
			Vector(5, 1002, 0), 3, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), Vector(0, 1000, 0), 100);
		Wait(1, Ignore Condition);
		Create In-World Text(All Players(All Teams), Custom String("Time: {0}:{1} | {2}", Global.Timer_Minutes, Global.Timer_Seconds,
			Global.HasEscaped == True ? Custom String("Congratulations!") : Custom String("You Were Killed by: {0}",
			Local Player.Killed_By)), Vector(5, 1001, 0), 3, Do Not Clip, Visible To Position and String, Color(White),
			Default Visibility);
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), Vector(0, 1000, 0), 100);
		Wait(1, Ignore Condition);
		For Global Variable(Temp_Player, 0, 4, 1);
			Skip If(Players In Slot(Global.Temp_Player, Team 1) == 0, 6);
			Create In-World Text(All Players(All Teams), Custom String("{0} - {1}", Hero Icon String(Hero Of(Players In Slot(Evaluate Once(
				Global.Temp_Player), Team 1))), Evaluate Once(Players In Slot(Global.Temp_Player, Team 1))), Vector(5, 1000 - Evaluate Once(
				Global.Temp_Player) / 2, -3), 1.500, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
			Create In-World Text(All Players(All Teams), Custom String("Damage: {0}", Player Stat(Players In Slot(Evaluate Once(
				Global.Temp_Player), Team 1), All Damage Dealt)), Vector(5, 1000 - Evaluate Once(Global.Temp_Player) / 2, -1), 1.500,
				Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
			Create In-World Text(All Players(All Teams), Custom String("Kills: {0}", Player Stat(Players In Slot(Evaluate Once(
				Global.Temp_Player), Team 1), Eliminations)), Vector(5, 1000 - Evaluate Once(Global.Temp_Player) / 2, 1), 1.500, Do Not Clip,
				Visible To Position and String, Color(White), Default Visibility);
			Create In-World Text(All Players(All Teams), Custom String("Items: {0}", Players In Slot(Evaluate Once(Global.Temp_Player), Team 1)
				.Total_Items), Vector(5, 1000 - Evaluate Once(Global.Temp_Player) / 2, 3), 1.500, Do Not Clip, Visible To Position and String,
				Color(White), Default Visibility);
			Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), Vector(0, 1000, 0), 100);
			Wait(0.160, Ignore Condition);
		End;
		Create In-World Text(All Players(All Teams), Custom String("Screenshot to share with your friends!"), Vector(5, 998, 0), 1,
			Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		Create In-World Text(All Players(All Teams), Local Player == Host Player ? Custom String(
			"Press Interact to restart: Auto Restart in ({0})", Round To Integer(Global.Scoreboard_Timer, Up)) : Custom String(
			"Waiting for {0} to restart: Auto Restart in ({1})", Host Player, Round To Integer(Global.Scoreboard_Timer, Up)), Vector(5,
			997, 0), 1, Do Not Clip, Visible To Position and String, Color(White), Default Visibility);
		If(Array Contains(Global.Reality_Checker, 1) == True);
			Create In-World Text(All Players(All Teams), Custom String("Reality used"), Vector(5, 1002, 5), 1.200, Clip Against Surfaces,
				Visible To Position and String, Color(Purple), Default Visibility);
			For Global Variable(Temp_Player, 0, Count Of(Global.Alternate_Reality_Names), 1);
				Create In-World Text(All Players(All Teams), Global.Alternate_Reality_Names[Evaluate Once(Global.Temp_Player)], Vector(5,
					1001.750 - Evaluate Once(Global.Temp_Player) / 5, 5), 1, Clip Against Surfaces, Visible To Position and String,
					Global.Reality_Checker[Evaluate Once(Global.Temp_Player)] == 1 ? Color(Purple) : Color(Gray), Default Visibility);
			End;
		End;
		Chase Global Variable At Rate(Scoreboard_Timer, 0, 1, Destination and Rate);
		Wait Until(Is Button Held(Host Player, Button(Interact)), Evaluate Once(Global.Scoreboard_Timer));
		Restart Match;
	}
}

