	{
		Subroutine;
		Play_Marble_Soul;
	}

	actions
	{
		Call Subroutine(Player_Damage_Calc);
		Attacker.Damage += Event Player.Marble_Soul_Boost;
		Set Damage Dealt(Attacker, Attacker.Damage);
		Attacker.Marble_Soul_Vis = All Players(All Teams);
		Wait Until(Total Time Elapsed > Attacker.MarbleSoulTimeStamp + 3, 99999);
		Call Subroutine(Player_Damage_Calc);
		Attacker.Marble_Soul_Vis = Null;
	}
}

