settings
{
	lobby
	{
		Max Team 1 Players: 4
		Max Team 2 Players: 4
	}

	modes
	{
		disabled Deathmatch
		{
			Score To Win: 40
		}

		Team Deathmatch
		{
			Score To Win: 40

			enabled maps
			{
				Black Forest 972777519512063901
				Castillo 972777519512063901
				Ilios Well 972777519512063901
				Necropolis 972777519512068153
			}
		}
	}

	heroes
	{
		General
		{
			Lifeweaver
			{
				Life Grip and Healing Blossom Range: 200%
			}

			enabled heroes
			{
				Ana
				Lifeweaver
				Reinhardt
			}
		}
	}
}

variables
{
	global:
		0: soloSpawnedT1
		1: soloSpawnedT2
}

rule("Skip Hero Select")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Assembling Heroes == True;
	}

	actions
	{
		Set Match Time(1);
	}
}

rule("Quick Start Match")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Set Match Time(0);
	}
}

rule("Unlimited Match — Pause Time & Disable Completion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		Pause Match Time;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Scoring;
		disabled Disable Built-In Game Mode Music;
		Set Match Time(260);
	}
}

rule("Unlimited Match — Score On Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	actions
	{
		Modify Player Score(Event Player, 1);
	}
}

rule("Setup — Lock Humans To LifeWeaver")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) != Hero(Lifeweaver);
	}

	actions
	{
		Start Forcing Player To Be Hero(Event Player, Hero(Lifeweaver));
	}
}

rule("Setup — Lock AI To Reinhardt")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
		Hero Of(Event Player) != Hero(Reinhardt);
		Hero Of(Event Player) != Hero(Ana);
	}

	actions
	{
		Start Forcing Player To Be Hero(Event Player, Hero(Reinhardt));
	}
}

rule("Setup — Spawn Message")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		Wait(0.500, Ignore Condition);
		Disallow Button(Event Player, Button(Secondary Fire));
		Big Message(Event Player, Custom String("REIN & WEAVE"));
		Create HUD Text(Event Player, Custom String("Rein & Weave"), Null, Null, Left, 0, Color(Orange), Color(White), Color(White),
			Visible To and String, Default Visibility);
		Create HUD Text(Event Player, Null, Null, Custom String("Protect your LifeWeaver — eliminate theirs!"), Left, 1, Color(White),
			Color(White), Color(Orange), Visible To and String, Default Visibility);
	}
}

rule("LW — Life Grip Max 4s Cooldown")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Hero Of(Event Player) == Hero(Lifeweaver);
		Ability Cooldown(Event Player, Button(Ability 2)) > 4;
	}

	actions
	{
		Set Ability Cooldown(Event Player, Button(Ability 2), 4);
	}
}

rule("Bots — Quick Respawn")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
		Is Dead(Event Player) == True;
	}

	actions
	{
		Wait(2, Ignore Condition);
		Respawn(Event Player);
	}
}

rule("Solo — Spawn AI Commander For Team 1")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Global.soloSpawnedT1 == False;
		Count Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element) == False)) == 0;
	}

	actions
	{
		Wait(3, Ignore Condition);
		Create Dummy Bot(Hero(Ana), Team 1, 0, Null, Null);
		Global.soloSpawnedT1 = True;
	}
}

rule("Solo — Spawn AI Commander For Team 2")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Global.soloSpawnedT2 == False;
		Count Of(Filtered Array(All Players(Team 2), Is Dummy Bot(Current Array Element) == False)) == 0;
	}

	actions
	{
		Wait(3, Ignore Condition);
		Create Dummy Bot(Hero(Ana), Team 2, 0, Null, Null);
		Global.soloSpawnedT2 = True;
	}
}

rule("Score — +1 Per Rein Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	conditions
	{
		Hero Of(Victim) == Hero(Reinhardt);
	}

	actions
	{
		Modify Team Score(Team Of(Event Player), 1);
	}
}

rule("Score — +10 Per Lifeweaver Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	conditions
	{
		Hero Of(Victim) == Hero(Lifeweaver);
	}

	actions
	{
		Modify Team Score(Team Of(Event Player), 10);
	}
}

rule("Score — +5 Per Ana Kill")
{
	event
	{
		Player Dealt Final Blow;
		All;
		All;
	}

	conditions
	{
		Hero Of(Victim) == Hero(Ana);
	}

	actions
	{
		Modify Team Score(Team Of(Event Player), 5);
	}
}