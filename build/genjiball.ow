rule("Collision - ball reaches player")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballIsOut == True;
		Distance Between(Eye Position(Global.target), Global.ballPosition) <= 1.900;
	}

	actions
	{
		Call Subroutine(collisionTarget);
	}
}

rule("Collision - collision check")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballIsOut == True;
		Global.ballSpeed > 150;
	}

	actions
	{
		If(Global.ballHitPosition != Null);
			"-o--x--------o->Between last ballPosition & middlePosition"
			Global.phasePosition1 = Global.ballHitPosition + Global.phasePosition;
			Global.phasePosition1 /= 2;
			"-o-----x-----o->Between last & current ballPosition"
			Global.phasePosition = Global.ballHitPosition;
			Global.ballHitPosition = Null;
		Else;
			"-o--x--------o->Between last ballPosition & middlePosition"
			Global.phasePosition1 = Global.phasePosition + Global.ballPosition;
			Global.phasePosition1 /= 2;
			Global.phasePosition1 += Global.phasePosition;
			Global.phasePosition1 /= 2;
			"-o-----x-----o->Between last & current ballPosition"
			Global.phasePosition += Global.ballPosition;
			Global.phasePosition /= 2;
		End;
		"-o--------x--o->Between phasePosition & current ballPosition & phasePosition"
		Global.phasePosition2 = Global.phasePosition + Global.ballPosition;
		Global.phasePosition2 /= 2;
		"-o-----------x->"
		If(Distance Between(Global.ballPosition, Eye Position(Global.target)) <= 1.900);
			Call Subroutine(collisionTarget);
		"-o-----x-----o->"
		Else If(Distance Between(Global.phasePosition, Eye Position(Global.target)) <= 1.900);
			Call Subroutine(collisionTarget);
		"-o--x--------o->"
		Else If(Distance Between(Global.phasePosition1, Eye Position(Global.target)) <= 1.900);
			Call Subroutine(collisionTarget);
		"-o--------x--o->"
		Else If(Distance Between(Global.phasePosition2, Eye Position(Global.target)) <= 1.900);
			Call Subroutine(collisionTarget);
		End;
		"Save last ballPosition for next loop"
		Global.phasePosition = Evaluate Once(Global.ballPosition);
		Wait(0, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Collision - collision sub")
{
	event
	{
		Subroutine;
		collisionTarget;
	}

	actions
	{
		If(Global.ballSpeedCap == Global.ballSpeed);
			Skip If(Global.bozo_Bot && Is Dummy Bot(Global.target), 7);
		End;
		If(Global.bozo_Bot && Is Dummy Bot(Global.target));
			Press Button(Global.target, Button(Ability 2));
		End;
		Skip If(Is Using Ability 1(Global.target), 4);
		"Only when Tracing mode == true"
		Skip If(Global.tracingPoints == 0, 1);
		Skip If(Is Using Ability 2(Global.target), 2);
		Call Subroutine(deflectFail);
		Abort;
		Call Subroutine(deflectSuccess);
	}
}

rule("Collision - deflect fail sub")
{
	event
	{
		Subroutine;
		deflectFail;
	}

	actions
	{
		Kill(Global.target, Global.prevTarget);
		Call Subroutine(playDeathEffect);
		If(Number Of Living Players(All Teams) == 1);
			Call Subroutine(alert);
			Call Subroutine(deleteBall);
			Abort;
		End;
		If(Global.endlessMode);
			disabled Global.ballDirection *= -1;
			Global.target = First Of(Sorted Array(All Living Players(All Teams), Angle Between Vectors(Global.ballDirection, Direction Towards(
				Global.ballPosition, Position Of(Current Array Element)))));
		Else;
			Call Subroutine(deleteBall);
		End;
	}
}

rule("Collision - deflect success sub")
{
	event
	{
		Subroutine;
		deflectSuccess;
	}

	actions
	{
		Play Effect(All Players(All Teams), Explosion Sound, Color(White), Position Of(Global.target), 150);
		Play Effect(All Players(All Teams), Baptiste Biotic Launcher Explosion Sound, Color(White), Position Of(Global.target), 50);
		Global.prevTarget = Global.target;
		Global.target = First Of(Sorted Array(Remove From Array(All Living Players(All Teams), Global.prevTarget), Angle Between Vectors(
			Facing Direction Of(Global.target), Direction Towards(Global.target, Position Of(Current Array Element)))));
		If(Is Using Ability 1(Global.prevTarget));
			Call Subroutine(dashBall);
		End;
		Global.ballSpeed = Min(Global.ballSpeedCap, Global.ballSpeed * 1.050);
		Global.ballDirection = Facing Direction Of(Global.prevTarget) * (Global.ballMotion == 2 ? Global.ballSpeed : 1);
		If(Global.ballMotion == 0);
			Start Rule(ballCurve, Restart Rule);
		End;
	}
}

rule("Collision - play death effect sub")
{
	event
	{
		Subroutine;
		playDeathEffect;
	}

	actions
	{
		Play Effect(All Players(All Teams), Ashe Dynamite Explosion Sound, Color(Sky Blue), Position Of(Global.ballPosition), 80);
		If(Global.endlessMode);
			Play Effect(All Players(All Teams), Tracer Recall Reappear Effect, Color(White), Global.ballPosition, 2);
			Abort;
		End;
		Play Effect(All Players(All Teams), Ashe Dynamite Explosion Effect, Team 1, Position Of(Global.ballPosition), 40);
		Play Effect(All Players(All Teams), DVa Self Destruct Explosion Effect, All Teams, Position Of(Global.ballPosition), 40);
		Play Effect(All Players(All Teams), Doomfist Meteor Strike Impact Effect, Team 1, Position Of(Global.ballPosition), 40);
	}
}

rule("Collision - dash sub")
{
	event
	{
		Subroutine;
		dashBall;
	}

	actions
	{
		If(Global.prevTarget.stunCooldown <= 0);
			Set Status(Global.prevTarget, Null, Knocked Down, 1);
			Global.prevTarget.stunCooldown = 0.600;
		End;
	}
}

rule("Collision - ball curve sub")
{
	event
	{
		Subroutine;
		ballCurve;
	}

	actions
	{
		If(Global.ballMotion == 0);
			Global.ballDirectionRate = 6;
			Wait(0.045, Ignore Condition);
			Global.ballDirectionRate = Global.ballDirectionRateInit;
		End;
	}
}

rule("Collision - delete ball sub")
{
	event
	{
		Subroutine;
		deleteBall;
	}

	actions
	{
		Stop Chasing Global Variable(ballDirection);
		Stop Chasing Global Variable(ballPosition);
		Stop Chasing Global Variable(ballSpeed);
		Global.target = -1;
		Global.prevTarget = -1;
		Global.ballPosition = Vector(0, -1, 0);
		Global.ballDirection = Vector(0, 0, 0);
		Global.ballIsOut = False;
		Global.ballSpawnCountdown = 2;
		Global.ballHitPosition = Null;
		Global.phasePosition = Vector(0, -1, 0);
		Global.phasePosition1 = Vector(0, -1, 0);
		Global.phasePosition2 = Vector(0, -1, 0);
	}
}

rule("Ball behaivor - modern motion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		(Global.ballMotion == 0 || Global.ballMotion == 1) == True;
		Global.ballIsOut == True;
	}

	actions
	{
		Chase Global Variable At Rate(ballPosition,
			Global.ballPosition + Global.ballDirection * Global.ballSpeed * Global.motionMultiplier, Global.ballSpeed,
			Destination and Rate);
		Chase Global Variable At Rate(ballDirection, Direction Towards(Global.ballPosition, Eye Position(Global.target)),
			Update Every Frame(Global.ballDirectionRate), Destination and Rate);
		Chase Global Variable At Rate(ballSpeed, Global.ballSpeedCap, Global.ballAcceleration, Destination and Rate);
	}
}

rule("Ball Physics - retro motion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballMotion == 3;
		Global.ballIsOut == True;
	}

	actions
	{
		Chase Global Variable At Rate(ballPosition, Eye Position(Global.target), Global.ballSpeed, Destination and Rate);
		Chase Global Variable At Rate(ballSpeed, Global.ballSpeedCap, Global.ballAcceleration, Destination and Rate);
	}
}

rule("Ball Physics - astro motion")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballMotion == 2;
		Global.ballIsOut == True;
	}

	actions
	{
		Chase Global Variable At Rate(ballPosition, Update Every Frame(Global.ballPosition + Global.ballDirection), Update Every Frame(
			Magnitude Of(Global.ballDirection)), Destination and Rate);
		"ballDirection is the ball's velocity"
		Chase Global Variable At Rate(ballDirection, Update Every Frame(Global.ballDirection * 0.930 + Eye Position(Global.target)
			- Global.ballPosition), Update Every Frame(Square Root((Global.ballSpeed - Max(Dot Product(Global.ballDirection,
			Direction Towards(Global.ballPosition, Eye Position(Global.target))), 0)) * Global.ballSpeed) * 3), Destination and Rate);
		"ballSpeed is the ball's acceleration coefficient"
		Chase Global Variable At Rate(ballSpeed, Global.ballSpeedCap, Global.ballAcceleration, Destination and Rate);
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Ball Physics - general collision")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballIsOut == True;
		disabled Ray Cast Hit Position(Global.ballPosition, Global.ballPosition + Global.ballDirection * Global.ballSpeed * 0.033, Null,
			All Players(All Teams), False) != Global.ballPosition + Global.ballDirection * Global.ballSpeed * 0.033;
		Is In Line of Sight(Global.ballPosition, Global.ballPosition + Global.ballDirection * (
			Global.ballMotion != 2 ? Global.ballSpeed : 1) * 0.033, Barriers Do Not Block LOS) == False;
		(X Component Of(Global.ballPosition) >= 20.400 || X Component Of(Global.ballPosition) <= -20.400 || Z Component Of(
			Global.ballPosition) >= 20.400 || Z Component Of(Global.ballPosition) <= -20.400 || Y Component Of(Global.ballPosition)
			> 0.100 || Y Component Of(Global.ballPosition) < -3.500) == True;
		disabled Current Map != Map(Workshop Chamber);
		Global.ballCollisionDetected == False;
		Y Component Of(Global.ballPosition) > 7.500;
	}

	actions
	{
		Global.ballCollisionDetected = True;
		Global.ballNextFramePosition = Global.ballPosition + Global.ballDirection * Global.ballSpeed * 0.066;
		"Used for phasingprotection in Ball/Target - collision check"
		Global.ballHitPosition = Ray Cast Hit Position(Global.ballPosition, Global.ballNextFramePosition, Null, All Players(All Teams),
			False);
		If((Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) && Y Component Of(Global.ballHitPosition)
			< -0.500 && Y Component Of(Global.ballHitPosition) > -3.500);
			Global.CollisionSurfaceDistances = Array(Distance Between(Global.ballHitPosition, Vector(20, Y Component Of(
				Global.ballHitPosition), Z Component Of(Global.ballHitPosition))), Distance Between(Global.ballHitPosition, Vector(-20,
				Y Component Of(Global.ballHitPosition), Z Component Of(Global.ballHitPosition))), Distance Between(Global.ballHitPosition,
				Vector(X Component Of(Global.ballHitPosition), Y Component Of(Global.ballHitPosition), 20)), Distance Between(
				Global.ballHitPosition, Vector(X Component Of(Global.ballHitPosition), Y Component Of(Global.ballHitPosition), -20)));
			Global.CollisionSurfaceIndex = Index Of Array Value(Global.CollisionSurfaceDistances, First Of(Sorted Array(
				Global.CollisionSurfaceDistances, Current Array Element)));
			If(Global.CollisionSurfaceIndex == 0);
				If(X Component Of(Global.ballDirection) < 0);
					If(X Component Of(Global.ballDirection) < -0.025);
						Global.ballDirection *= Vector(-1, -1, 1);
					Else;
						Global.ballDirection = Vector(0.025, Y Component Of(Global.ballDirection), Z Component Of(Global.ballDirection));
					End;
				End;
			Else If(Global.CollisionSurfaceIndex == 1);
				If(X Component Of(Global.ballDirection) > 0);
					If(X Component Of(Global.ballDirection) > 0.025);
						Global.ballDirection *= Vector(-1, 1, 1);
					Else;
						Global.ballDirection = Vector(-0.025, Y Component Of(Global.ballDirection), Z Component Of(Global.ballDirection));
					End;
				End;
			Else If(Global.CollisionSurfaceIndex == 2);
				If(Z Component Of(Global.ballDirection) < 0);
					If(Z Component Of(Global.ballDirection) < -0.025);
						Global.ballDirection *= Vector(1, 1, -1);
					Else;
						Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection), 0.025);
					End;
				End;
			Else If(Global.CollisionSurfaceIndex == 3);
				If(Z Component Of(Global.ballDirection) > 0);
					If(Z Component Of(Global.ballDirection) > 0.025);
						Global.ballDirection *= Vector(1, 1, -1);
					Else;
						Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection), -0.025);
					End;
				End;
			End;
		Else;
			Global.BallCollisionSurfaceNormal = Ray Cast Hit Normal(Global.ballPosition, Global.ballNextFramePosition, Null, All Players(
				All Teams), False);
			"new reflection formula --- new direction = v - 2 * (v ∙ n) * n"
			Global.ballDirection -= 2 * Dot Product(Global.ballDirection, Global.BallCollisionSurfaceNormal)
				* Global.BallCollisionSurfaceNormal;
		End;
		Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Global.ballHitPosition, 1);
		Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Global.ballHitPosition, 30);
		Wait(0.016, Ignore Condition);
		Global.ballCollisionDetected = False;
		Loop If Condition Is True;
	}
}

rule("Ball Physics - island collision")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballIsOut == True;
		Z Component Of(Global.ballPosition) < 20.400;
		Z Component Of(Global.ballPosition) > -20.400;
		X Component Of(Global.ballPosition) < 20.400;
		X Component Of(Global.ballPosition) > -20.400;
		Y Component Of(Global.ballPosition) <= 0.100;
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
		Global.ballCollisionDetected == False;
	}

	actions
	{
		Global.ballCollisionDetected = True;
		Global.CollisionSurfaceDistances = Array(Distance Between(Global.ballPosition, Vector(X Component Of(Global.ballPosition), 0,
			Z Component Of(Global.ballPosition))), Distance Between(Global.ballPosition, Vector(20, Y Component Of(Global.ballPosition),
			Z Component Of(Global.ballPosition))), Distance Between(Global.ballPosition, Vector(-20, Y Component Of(Global.ballPosition),
			Z Component Of(Global.ballPosition))), Distance Between(Global.ballPosition, Vector(X Component Of(Global.ballPosition),
			Y Component Of(Global.ballPosition), 20)), Distance Between(Global.ballPosition, Vector(X Component Of(Global.ballPosition),
			Y Component Of(Global.ballPosition), -20)));
		Global.CollisionSurfaceIndex = Index Of Array Value(Global.CollisionSurfaceDistances, First Of(Sorted Array(
			Global.CollisionSurfaceDistances, Current Array Element)));
		If(Global.CollisionSurfaceIndex == 0);
			If(Y Component Of(Global.ballDirection) < 0);
				Global.ballDirection *= Vector(1, -1, 1);
				Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Vector(X Component Of(Global.ballPosition), 0,
					Z Component Of(Global.ballPosition)), 1);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Vector(X Component Of(Global.ballPosition), 0,
					Z Component Of(Global.ballPosition)), 30);
			End;
		Else If(Global.CollisionSurfaceIndex == 1);
			If(X Component Of(Global.ballDirection) < 0);
				If(X Component Of(Global.ballDirection) < -0.025);
					Global.ballDirection *= Vector(-1, 1, 1);
				Else;
					Global.ballDirection = Vector(0.025, Y Component Of(Global.ballDirection), Z Component Of(Global.ballDirection));
				End;
				Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Vector(20, Y Component Of(Global.ballPosition),
					Z Component Of(Global.ballPosition)), 1);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Vector(20, Y Component Of(Global.ballPosition),
					Z Component Of(Global.ballPosition)), 30);
			End;
		Else If(Global.CollisionSurfaceIndex == 2);
			If(X Component Of(Global.ballDirection) > 0);
				If(X Component Of(Global.ballDirection) > 0.025);
					Global.ballDirection *= Vector(-1, 1, 1);
				Else;
					Global.ballDirection = Vector(-0.025, Y Component Of(Global.ballDirection), Z Component Of(Global.ballDirection));
				End;
				Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Vector(-20, Y Component Of(Global.ballPosition),
					Z Component Of(Global.ballPosition)), 1);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Vector(-20, Y Component Of(
					Global.ballPosition), Z Component Of(Global.ballPosition)), 30);
			End;
		Else If(Global.CollisionSurfaceIndex == 3);
			If(Z Component Of(Global.ballDirection) < 0);
				If(Z Component Of(Global.ballDirection) < -0.025);
					Global.ballDirection *= Vector(1, 1, -1);
				Else;
					Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection), 0.025);
				End;
				Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Vector(X Component Of(Global.ballPosition),
					Y Component Of(Global.ballPosition), 20), 1);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Vector(X Component Of(Global.ballPosition),
					Y Component Of(Global.ballPosition), 20), 30);
			End;
		Else If(Global.CollisionSurfaceIndex == 4);
			If(Z Component Of(Global.ballDirection) > 0);
				If(Z Component Of(Global.ballDirection) > 0.025);
					Global.ballDirection *= Vector(1, 1, -1);
				Else;
					Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection), -0.025);
				End;
				Play Effect(All Players(All Teams), Pharah Barrage Explosion Effect, All Teams, Vector(X Component Of(Global.ballPosition),
					Y Component Of(Global.ballPosition), -20), 1);
				Play Effect(All Players(All Teams), Echo Sticky Bomb Explosion Sound, Color(White), Vector(X Component Of(Global.ballPosition),
					Y Component Of(Global.ballPosition), -20), 30);
			End;
		End;
		Wait(0.016, Ignore Condition);
		Global.ballCollisionDetected = False;
		Loop If Condition Is True;
	}
}

rule("Ball Physics - chamber x collision")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		"This collision is the lazy way but its only for chamber so who cares"
		Current Map == Map(Workshop Chamber);
		Global.ballIsOut == True;
		(X Component Of(Global.ballPosition) + 0 > 20 || X Component Of(Global.ballPosition) - 0 < -20) == True;
	}

	actions
	{
		If((X Component Of(Global.ballPosition) + 0 > 20 && X Component Of(Global.ballDirection) > 0) || (X Component Of(
			Global.ballPosition) - 0 < -20 && X Component Of(Global.ballDirection) < 0));
			Global.ballDirection = Vector(X Component Of(Global.ballDirection) * -1, Y Component Of(Global.ballDirection), Z Component Of(
				Global.ballDirection));
			Play Effect(All Players(All Teams), Bad Explosion, Color(White), Global.ballPosition, 1);
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Ball Physics - chamber y collision")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Current Map == Map(Workshop Chamber);
		Global.ballIsOut == True;
		(Y Component Of(Global.ballPosition) + 0 > 40) - (Y Component Of(Global.ballPosition) - 0 < 0) == True;
	}

	actions
	{
		If((Y Component Of(Global.ballPosition) + 0 > 40 && Y Component Of(Global.ballDirection) > 0) || (Y Component Of(
			Global.ballPosition) - 0 < 0 && Y Component Of(Global.ballDirection) < 0));
			Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection) * -1, Z Component Of(
				Global.ballDirection));
			Play Effect(All Players(All Teams), Bad Explosion, Color(White), Global.ballPosition, 1);
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Ball Physics - chamber z collision")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Current Map == Map(Workshop Chamber);
		Global.ballIsOut == True;
		(Z Component Of(Global.ballPosition) + 0 > 20 || Z Component Of(Global.ballPosition) - 0 < -20) == True;
	}

	actions
	{
		If((Z Component Of(Global.ballPosition) + 0 > 20 && Z Component Of(Global.ballDirection) > 0) || (Z Component Of(
			Global.ballPosition) - 0 < -20 && Z Component Of(Global.ballDirection) < 0));
			Global.ballDirection = Vector(X Component Of(Global.ballDirection), Y Component Of(Global.ballDirection), Z Component Of(
				Global.ballDirection) * -1);
			Play Effect(All Players(All Teams), Bad Explosion, Color(White), Global.ballPosition, 1);
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Ball Physics - water")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		"(Global.currentMap == Map(Workshop Island) || Global.currentMap == 196) == True;"
		Global.ballIsOut == True;
		(X Component Of(Global.ballPosition) > 20 || X Component Of(Global.ballPosition) < -20 || Z Component Of(Global.ballPosition)
			> 20 || Z Component Of(Global.ballPosition) < -20) == True;
		Y Component Of(Global.ballPosition) < Global.waterLevel;
		Y Component Of(Global.ballDirection) < 0;
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
	}

	actions
	{
		Global.ballDirection *= Vector(1, 0, 1);
		Play Effect(All Players(All Teams), Ring Explosion, Color(White), Global.ballPosition, 2);
	}
}

rule("Ball Physics - other map collisions")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.ballIsOut == True;
		"Naz: The global variable \"BallNoDownY\" is set in the maps section since each map is set to a distinct y coordinate"
		(Y Component Of(Global.ballPosition) < Global.BallNoDownY && Y Component Of(Global.ballDirection) < 0) == True;
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) != True;
	}

	actions
	{
		Global.ballDirection -= 2 * Dot Product(Global.ballDirection, Up) * Up;
	}
}

rule("Map restrictions - put out center")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Distance Between(Position Of(Event Player), Global.circleCenter) < Global.CenterOffLimitsSize + 0.500;
	}

	actions
	{
		Apply Impulse(Event Player, Direction Towards(Global.circleCenter, Event Player), 10, To World, Cancel Contrary Motion);
		Apply Impulse(Event Player, Up, 1.500, To World, Incorporate Contrary Motion);
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Map restrictions - player dashes too far out of bounds")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Distance Between(Position Of(Event Player), Vector(X Component Of(Global.circleCenter), Y Component Of(Position Of(Event Player)),
			Z Component Of(Global.circleCenter))) > Global.SphereSize + 5;
		"Workshop Island Fix"
		disabled (Current Map != Map(Workshop Island) && Current Map != Map(Workshop Island Night)) == True;
	}

	actions
	{
		Set Status(Event Player, Null, Rooted, 3);
		disabled Teleport(Event Player, Global.circleCenter + Vector(Random Integer(-15, 15), 8, Random Integer(-15, 15)));
		Apply Impulse(Event Player, Vector(X Component Of(Direction Towards(Position Of(Event Player), Global.circleCenter)), 0,
			Z Component Of(Direction Towards(Position Of(Event Player), Global.circleCenter))), 20, To World, Cancel Contrary Motion);
		Apply Impulse(Event Player, Up, 3, To World, Cancel Contrary Motion);
		Big Message(Event Player, Custom String("Do not dash out of the arena!"));
	}
}

rule("Map restrictions - push to circle")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Distance Between(Position Of(Event Player), Vector(X Component Of(Global.circleCenter), Y Component Of(Position Of(Event Player)),
			Z Component Of(Global.circleCenter))) > Global.SphereSize - 1.500;
		"Workshop Island Fix"
		Current Map != Map(Workshop Island);
		Current Map != Map(Workshop Island Night);
	}

	actions
	{
		Apply Impulse(Event Player, Vector(X Component Of(Direction Towards(Position Of(Event Player), Global.circleCenter)), 0,
			Z Component Of(Direction Towards(Position Of(Event Player), Global.circleCenter))), 6, To World, Cancel Contrary Motion);
		Apply Impulse(Event Player, Up, 3, To World, Incorporate Contrary Motion);
		Wait(0.250, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Map restrictions - player falls off Workshop Island")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
		Y Component Of(Position Of(Event Player)) < -0.500;
	}

	actions
	{
		"A MAN HAS FALLEN INTO THE LAKE IN WORKSHOP ISLAND! START THE NEW RESCUE RULE! HEY! BUILD THE NEW WORSHOP RULE, AND OFF TO THE RESCUE! PREPARE THE CONDITION, TELEPORT THE PLAYER, AND MAKE THE RESCUE! THE NEW 2.3.0 UPDATE FROM OVERWATCH WORKSHOP!"
		If(!Is Alive(Event Player));
			Teleport(Event Player, Global.circleCenter + Vector(Random Integer(-10, 10), 8, Random Integer(-10, 10)));
			If(Event Player == Global.target);
				If(Global.ballIsOut);
					Call Subroutine(deleteBall);
				End;
			End;
		End;
		Wait(0.500, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Map restrictions - water surface 1")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Update Every Frame(Y Component Of(Position Of(Event Player)) < 0) == True;
		Y Component Of(Position Of(Event Player)) >= -0.150;
		Y Component Of(Velocity Of(Event Player)) <= 0;
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == False;
		"Workshop Island Fix"
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
	}

	actions
	{
		Abort If(X Component Of(Position Of(Event Player)) < 20.250 && X Component Of(Position Of(Event Player))
			> -20.250 && Z Component Of(Position Of(Event Player)) < 20.250 && Z Component Of(Position Of(Event Player)) > -20.250);
		Event Player.currentGravity = 0;
		Set Gravity(Event Player, 0);
		If(Y Component Of(Velocity Of(Event Player)) < 0);
			Apply Impulse(Event Player, Down, 0.001, To World, Cancel Contrary Motion);
			Apply Impulse(Event Player, Up, 0.001, To World, Cancel Contrary Motion);
		End;
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Map restrictions - water surface 2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Y Component Of(Position Of(Event Player)) < -0.150;
		Y Component Of(Position Of(Event Player)) >= -1.250;
		Y Component Of(Velocity Of(Event Player)) <= 0;
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == False;
		"Workshop Island Fix"
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
	}

	actions
	{
		Abort If(X Component Of(Position Of(Event Player)) < 20.250 && X Component Of(Position Of(Event Player))
			> -20.250 && Z Component Of(Position Of(Event Player)) < 20.250 && Z Component Of(Position Of(Event Player)) > -20.250);
		Event Player.currentGravity = 0;
		Set Gravity(Event Player, 0);
		Apply Impulse(Event Player, Up, 1, To World, Cancel Contrary Motion);
		Wait(0.100, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Map restrictions - water resistance")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(X Component Of(Position Of(Event Player)) > 30 || X Component Of(Position Of(Event Player)) < -30 || Z Component Of(Position Of(
			Event Player)) > 30 || Z Component Of(Position Of(Event Player)) < -30) == True;
		Y Component Of(Position Of(Event Player)) <= 0;
		Y Component Of(Position Of(Event Player)) >= -1.500;
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == False;
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
	}

	actions
	{
		If(X Component Of(Position Of(Event Player)) > 32 || X Component Of(Position Of(Event Player)) < -32 || Z Component Of(Position Of(
			Event Player)) > 32 || Z Component Of(Position Of(Event Player)) < -32);
			Apply Impulse(Event Player, Direction Towards(Position Of(Event Player), Global.circleCenter) * Vector(1, 0, 1), 10, To World,
				Cancel Contrary Motion);
			Wait(0.100, Ignore Condition);
		Else;
			Apply Impulse(Event Player, Direction Towards(Position Of(Event Player), Global.circleCenter) * Vector(1, 0, 1), 5, To World,
				Incorporate Contrary Motion);
			Wait(0.050, Ignore Condition);
		End;
		Loop If Condition Is True;
	}
}

rule("Map restrictions - water")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Y Component Of(Position Of(Event Player)) < -1.500;
		Is Alive(Event Player) == True;
		"Workshop Island Fix"
		(Current Map == Map(Workshop Island) || Current Map == Map(Workshop Island Night)) == True;
	}

	actions
	{
		If(X Component Of(Position Of(Event Player)) < 35 || X Component Of(Position Of(Event Player)) > -35 || Z Component Of(Position Of(
			Event Player)) < 35 || Z Component Of(Position Of(Event Player)) > -35);
			"Prevents people from going under the ledge on Workshop Island, which caused ball to go into floor.  Used to be an annoying stunkill"
			Apply Impulse(Event Player, Up, 2, To World, Cancel Contrary Motion XYZ);
			Apply Impulse(Event Player, Direction Towards(Event Player, Global.circleCenter), 2, To World, Incorporate Contrary Motion);
		End;
		If(X Component Of(Position Of(Event Player)) > 35 || X Component Of(Position Of(Event Player)) < -35 || Z Component Of(Position Of(
			Event Player)) > 35 || Z Component Of(Position Of(Event Player)) < -35);
			Apply Impulse(Event Player, Direction Towards(Event Player, Global.circleCenter), 3, To World, Incorporate Contrary Motion);
			Apply Impulse(Event Player, Up, 0.300, To World, Cancel Contrary Motion);
		End;
		Wait(0.008, Ignore Condition);
		Loop If Condition Is True;
	}
}

