rule("Subroutine - Round end call")
{
	event
	{
		Subroutine;
		alert;
	}

	actions
	{
		Global.roundEndCall = True;
		Wait(0.016, Ignore Condition);
		Global.roundEndCall = False;
	}
}

rule("Tournament - game ends after 0 Rounds left")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.totalRounds <= 0;
		Global.tournamentMode == 1;
	}

	actions
	{
		Set Match Time(0);
		Enable Built-In Game Mode Completion;
	}
}

rule("Tournament - round counter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.roundEndCall == True;
		Global.tournamentMode == 1;
	}

	actions
	{
		Global.totalRounds = Global.totalRounds - 1;
		Wait(3, Ignore Condition);
	}
}

rule("Tournament - break round counter")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.roundEndCall == True;
		Global.tournamentMode == 1;
	}

	actions
	{
		Global.roundsUntilBreak = Global.roundsUntilBreak - 1;
		Wait(3, Ignore Condition);
	}
}

rule("Tournament - break")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.roundsUntilBreak <= 0;
		Global.breaksEnabled == True;
		Global.tournamentMode == 1;
	}

	actions
	{
		Global.setballspawncountdown = Global.breakLength;
		Big Message(All Players(All Teams), Custom String("Break time!"));
		Wait(Global.breakLength + 1, Ignore Condition);
		Global.setballspawncountdown = Global.setballspawncountdownoriginal;
		Global.roundsUntilBreak = Global.roundsUntilBreak + Global.roundsUntilBreakInit;
	}
}

rule("Tournament - forbit dashing into the water")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.tournamentMode == True;
		Y Component Of(Position Of(Event Player)) < -1;
		Y Component Of(Velocity Of(Event Player)) < 0;
		Event Player != Global.target;
		Is Using Ability 1(Event Player) == True;
	}

	actions
	{
		disabled Teleport(Event Player, Vector(X Component Of(Position Of(Event Player)), 0, Z Component Of(Position Of(Event Player))));
		Teleport(Event Player, Position Of(Event Player) - Normalize(Velocity Of(Event Player)));
		Wait(0, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("Tournament - no orbit abusing")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.tournamentMode == True;
		Event Player == Global.target;
		disabled (Angle Between Vectors(Global.ballDirection, Direction Towards(Global.ballPosition, Eye Position(Event Player)))
			< 100 && Angle Between Vectors(Global.ballDirection, Direction Towards(Global.ballPosition, Eye Position(Event Player)))
			> -100) == True;
		Global.ballIsOut == True;
		Distance Between(Eye Position(Event Player), Global.ballPosition) < 20;
		Global.ballSpeed < 80;
	}

	actions
	{
		disabled Small Message(All Players(All Teams), Custom String("Orbit start"));
		Wait(7.500, Abort When False);
		Abort If Condition Is False;
		disabled Small Message(All Players(All Teams), Custom String("...still orbitting..."));
		Set Status(Event Player, Null, Asleep, 5);
		Apply Impulse(Event Player, Global.ballDirection + Up, 10, To World, Cancel Contrary Motion XYZ);
	}
}

rule("Tracing mode - gained")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.tracingMode == True;
		Event Player == Global.target;
		Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Global.ballPosition)) <= 45;
		disabled Is In View Angle(Event Player, Global.ballPosition, 70) == True;
	}

	actions
	{
		Clear Status(Event Player, Burning);
		Stop Chasing Global Variable(tracingPoints);
		Global.tracingPoints = 0.300;
	}
}

rule("Tracing mode - lost")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.tracingMode == True;
		Event Player == Global.target;
		Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Global.ballPosition)) > 45;
		disabled Is In View Angle(Event Player, Global.ballPosition, 70) == False;
	}

	actions
	{
		Chase Global Variable At Rate(tracingPoints, 0, 1, Destination and Rate);
	}
}

rule("zBozo - spawn")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		"Currently only able to decide between 0 or 1 (false/true) bozo bots"
		Global.bozo_Bot > 0;
	}

	actions
	{
		While(Global.bozo_Bot > 0);
			Global.bozo_Bot -= 1;
			Create Dummy Bot(Hero(Genji), All Teams, 12 + Global.bozo_Bot, Null, Host Player);
			Wait(0.100, Ignore Condition);
		End;
		Global.bozo_Bot = True;
		Global.bozoHasJumped = False;
		Global.OrbitTolerance = 0;
		Global.BozoTracing = False;
	}
}

rule("zBozo - name")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
	}

	actions
	{
		Start Forcing Dummy Bot Name(Event Player, Custom String("zSh4d0Ws bozo"));
	}
}

rule("zBozo - face when Deflecting")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Distance Between(Eye Position(Event Player), Position Of(Global.ballPosition)) <= 2 * (Global.ballSpeed / 20);
		Global.target == Event Player;
		Is Dummy Bot(Event Player) == True;
		Global.ballIsOut == True;
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == False;
		Is Using Ability 2(Event Player) == False;
		Has Status(Event Player, Stunned) == False;
		Global.bozoIsGhostDashing != True;
	}

	actions
	{
		If(Event Player.canDash == True);
			If(Random Integer(0, 8) == 0);
				If(Global.ballSpeed < 80);
					Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Eye Position(Event Player),
						Eye Position(Evaluate Once(Random Value In Array(Remove From Array(All Living Players(All Teams), Event Player))))))
						+ Evaluate Once(Random Integer(-35, 35)), Evaluate Once(Random Integer(-35, 35))), 10000, To World, Direction and Turn Rate);
				Else;
					Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Eye Position(Event Player),
						Eye Position(Evaluate Once(Random Value In Array(Remove From Array(All Living Players(All Teams), Event Player))))))
						+ Evaluate Once(Random Integer(-10, 10)), Evaluate Once(Random Integer(-10, 10))), 10000, To World, Direction and Turn Rate);
				End;
				Wait Until(Global.target != Event Player || Is Alive(Event Player) != True, 99999);
				If(Distance Between(Eye Position(Event Player), Eye Position(Global.target)) < Global.ballSpeed * 0.150);
					Global.bozoWillEdash = True;
				Else If(Distance Between(Eye Position(Event Player), Eye Position(Global.target)) >= Global.ballSpeed * 0.150 && Distance Between(
						Eye Position(Event Player), Eye Position(Global.target)) < Global.ballSpeed * 0.500);
					Global.bozoWillGhostDash = True;
				End;
			Else;
				Start Facing(Event Player, Vector(Random Integer(-360, 360), Random Integer(-360, 360), Random Integer(-360, 360)), 10000,
					To World, Direction and Turn Rate);
			End;
		Else;
			If(Random Integer(0, 1) == 0);
				Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Eye Position(Event Player),
					Eye Position(Player Closest To Reticle(Event Player, All Teams)))) + Evaluate Once(Random Integer(-90, -45)), Evaluate Once(
					Random Integer(-90, 90))), 10000, To World, Direction and Turn Rate);
			Else;
				Start Facing(Event Player, Direction From Angles(Horizontal Angle From Direction(Direction Towards(Eye Position(Event Player),
					Eye Position(Player Closest To Reticle(Event Player, All Teams)))) + Evaluate Once(Random Integer(45, 90)), Evaluate Once(
					Random Integer(-90, 90))), 10000, To World, Direction and Turn Rate);
			End;
			Wait(0, Ignore Condition);
			Loop If(Is True For Any(Remove From Array(All Living Players(All Teams), Event Player), Is In View Angle(Event Player,
				Eye Position(Current Array Element), 30)));
		End;
		Wait(0.300, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("zBozo - face the Ball")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
		Distance Between(Eye Position(Event Player), Global.ballPosition) >= 2 * (Global.ballSpeed / 20);
		Is Alive(Event Player) == True;
		Global.bozoIsGhostDashing != True;
		Is Using Ability 1(Event Player) == False;
		Is Using Ability 2(Event Player) == False;
		Has Status(Event Player, Stunned) == False;
	}

	actions
	{
		Start Facing(Event Player, Direction Towards(Eye Position(Event Player), (Global.ballPosition + Eye Position(Global.target)) / 2),
			1000, To World, Direction and Turn Rate);
	}
}

rule("zBozo - Bahvior changes after round")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.roundEndCall == True;
	}

	actions
	{
		Global.bozoBehaviorModes = Random Value In Array(Array(2));
		If(Global.bozoBehaviorModes == 1);
			Global.bozoAggression = 10;
		Else If(Global.bozoBehaviorModes == 2);
			Global.bozoAggression = 5;
		End;
	}
}

rule("zBozo - Movement reworked")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Game In Progress == True;
		Is Dummy Bot(Event Player) == True;
		Global.bozoWillOrbit != True;
		disabled (X Component Of(Position Of(Event Player)) < 18 || X Component Of(Position Of(Event Player)) > -18 || Z Component Of(Position Of(
			Event Player)) < 18 || Z Component Of(Position Of(Event Player)) > -18) == True;
	}

	actions
	{
		If(X Component Of(Position Of(Event Player)) > 18 || X Component Of(Position Of(Event Player)) < -18 || Z Component Of(Position Of(
			Event Player)) > 18 || Z Component Of(Position Of(Event Player)) < -18);
			Stop Throttle In Direction(Event Player);
			Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Vector(0, 0, 0)), 1, To World,
				Replace existing throttle, None);
			Wait(Random Real(1, 1.500), Ignore Condition);
			Loop If Condition Is True;
		End;
		If(Event Player != Global.target);
			If(Distance Between(Position Of(Event Player), Position Of(Global.target)) >= Global.bozoAggression);
				Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Global.target), 0.800, To Player,
					Replace existing throttle, None);
				Wait(Random Real(0.500, 3), Ignore Condition);
				Loop If Condition Is True;
			End;
		Else;
			Start Throttle In Direction(Event Player, Direction Towards(Position Of(Event Player), Vector(Random Real(-15, 15), 0, Random Real(
				-15, 15))), 0.800, To Player, Replace existing throttle, None);
			Wait(Random Real(0.500, 3), Ignore Condition);
			Loop If Condition Is True;
		End;
	}
}

rule("zBozo - Let him Orbit")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
		Global.ballIsOut == True;
		Distance Between(Position Of(Event Player), Global.ballPosition) < 5 + Global.ballSpeed / 30;
		Global.bozoWillOrbit == True;
	}

	actions
	{
		Global.IsOrbiting = True;
		Start Throttle In Direction(Event Player, (Global.ballDirection * -1 + Direction Towards(Global.ballPosition, Eye Position(
			Event Player)) * 2) / 2, 1, To World, Replace existing throttle, Direction and Magnitude);
		disabled Start Throttle In Direction(Event Player, Random Value In Array(Array(Vector(180, 0, 0), Vector(-180, 0, 0))), 1, To Player,
			Replace existing throttle, Direction and Magnitude);
		Global.OrbitTolerance = 999;
		Wait Until(Event Player != Global.target, 99999);
		Global.IsOrbiting = False;
		Global.bozoWillOrbit = 0;
	}
}

rule("zBozo - bozos move being chosen")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == True;
		Event Player == Global.target;
	}

	actions
	{
		If(Global.bozoBehaviorModes == 1);
			If(Random Integer(1, 10) == 5);
				Global.bozoWillOrbit = True;
			End;
		End;
		disabled If(Global.bozoWillOrbit != 5);
		disabled If(Ability Cooldown(Event Player, Button(Ability 1)) == 0);
		disabled Global.bozoWillGhostDash = Random Integer(2, 6);
		disabled End;
		disabled End;
		disabled If(Global.bozoWillGhostDash != 5);
		disabled If(Global.bozoBehaviorModes == 2);
		disabled If(Ability Cooldown(Event Player, Button(Ability 1)) == 0);
		disabled Global.bozoWillEdash = Random Integer(2, 6);
		disabled End;
		disabled End;
		disabled End;
	}
}

rule("zBozo - Edash when needed")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
		Global.ballIsOut == True;
		Is Using Ability 2(Event Player) == True;
		disabled (Is Using Ability 2(Event Player) || Global.bozoWillEdash) == True;
	}

	actions
	{
		Wait Until(Event Player != Global.target && (Is Using Ability 1(Global.target) || Is Using Ability 2(Global.target)), 0.250);
		If(Event Player == Global.target);
			If(Angle Between Vectors(Global.ballDirection, Direction Towards(Global.ballPosition, Eye Position(Event Player))) < 20);
				Global.bozoWillEdash = True;
				Set Facing(Event Player, Evaluate Once(Direction Towards(Eye Position(Event Player), Global.ballPosition)), To World);
				Start Facing(Event Player, Evaluate Once(Direction Towards(Eye Position(Event Player), Global.ballPosition)), 10000, To World,
					Direction and Turn Rate);
				Wait Until(Is Button Held(Event Player, Button(Ability 1)) || Is Alive(Event Player) != True, 1);
				Global.bozoWillEdash = False;
			End;
		Else If(Event Player == Global.prevTarget);
			If(Is Using Ability 1(Global.target) || Is Using Ability 2(Global.target));
				If(Angle Between Vectors(Global.ballDirection, Direction Towards(Global.ballPosition, Eye Position(Global.target))) < 20);
					Global.bozoWillEdash = True;
					Set Facing(Event Player, Evaluate Once(Direction Towards(Eye Position(Event Player), Global.ballPosition)), To World);
					Start Facing(Event Player, Evaluate Once(Direction Towards(Eye Position(Event Player), Global.ballPosition)), 10000, To World,
						Direction and Turn Rate);
					Wait Until(Is Button Held(Event Player, Button(Ability 1)) || Is Alive(Event Player) != True, 1);
					Global.bozoWillEdash = False;
				End;
			End;
		End;
	}
}

rule("zBozo - Jumping")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
		Global.ballIsOut == True;
	}

	actions
	{
		Global.botJumping = Random Value In Array(Array(1, 2));
		If(Global.botJumping == 2);
			Press Button(Event Player, Button(Jump));
			Wait(0.350, Ignore Condition);
			Press Button(Event Player, Button(Jump));
			Wait(Random Integer(5, 15), Ignore Condition);
		Else;
			Press Button(Event Player, Button(Jump));
			Wait(Random Integer(3, 7), Ignore Condition);
		End;
		Loop;
	}
}

rule("zBozo - GhostDash")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.bozo_Bot == True;
		Is Dummy Bot(Event Player) == True;
		Global.ballIsOut == True;
		Global.bozoWillGhostDash == True;
	}

	actions
	{
		Global.bozoIsGhostDashing = True;
		If(Global.target == Event Player);
			If(Distance Between(Eye Position(Event Player), Global.ballPosition) < Global.ballSpeed * 0.300);
				Set Facing(Event Player, Evaluate Once(Facing Direction Of(Global.ballDirection)), To World);
				Start Facing(Event Player, Evaluate Once(Facing Direction Of(Global.ballDirection)), 10000, To World, Direction and Turn Rate);
			End;
		Else;
			Set Facing(Event Player, Evaluate Once(Facing Direction Of(Global.ballDirection)) * -1, To World);
			Start Facing(Event Player, Evaluate Once(Facing Direction Of(Global.ballDirection)) * -1, 1000, To World, Direction and Turn Rate);
			Wait Until(Is Button Held(Event Player, Button(Ability 1)) || Is Alive(Event Player) != True, 99999);
		End;
		Global.bozoIsGhostDashing = False;
	}
}

