			Custom String("BALL SPEED: touch grass", Global.ballSpeed), Left, -4, Null, Null, Color(Rose), Visible To and String,
			Default Visibility);
		Create HUD Text(Global.ballSpeed >= 220 && Global.ballSpeed < 350 ? All Players(All Teams) : Empty Array, Null, Null,
			Custom String("BALL SPEED: {0}", Global.ballSpeed), Left, -4, Null, Null, Color(Rose), Visible To and String,
			Default Visibility);
