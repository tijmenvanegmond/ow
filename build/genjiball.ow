rule("Initialization - player variables")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	actions
	{
		Set Status(Event Player, Null, Invincible, 9999);
		Skip If(Global.CooldownDashingEnabled, 1);
		Set Ability 1 Enabled(Event Player, False);
		Disable Built-In Game Mode Respawning(Event Player);
		Event Player.bouncePadCooldown = Global.bouncePadCooldownLength;
		Event Player.stunCooldown = 0;
		Chase Player Variable At Rate(Event Player, stunCooldown, 0, 1, None);
		Enable Death Spectate All Players(Event Player);
		Enable Death Spectate Target HUD(Event Player);
		Event Player.thirdPerson = True;
		Start Camera(Event Player, Event Player + World Vector Of(Vector(-0.500, 0, 0), Event Player, Rotation)
			+ Up * 1.500 + Facing Direction Of(Event Player) * -2, Event Player + Facing Direction Of(Event Player) * 1000, 0);
		Event Player.simpleHUD = 0;
		Disable Game Mode HUD(Event Player);
		Event Player.canDash = True;
		Event Player.canDeflect = True;
		Event Player.isDashEnabled = True;
		Event Player.antiRubberbanding = False;
		"Has to be last, to avoid variable conflicts!!"
		Wait(3, Ignore Condition);
		Small Message(Event Player, Custom String("anti-rubberbanding [{0}]", Input Binding String(Button(Melee))));
		Small Message(Event Player, Custom String("switch perspective [{0}]", Input Binding String(Button(Reload))));
		Small Message(Event Player, Custom String("simple HUD [{0}]", Input Binding String(Button(Interact))));
	}
}

