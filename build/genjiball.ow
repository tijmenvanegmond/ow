rule("Old description (for historical archival)")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Small Message(All Players(All Teams), Custom String(
			"Genji Dodgeball v5.2.1P Community Edition! Developed by u/Mazawath. Numerous updates by u/FearlessKat, u/Blink, u/TheRedstoneBla"));
		Small Message(All Players(All Teams), Custom String(
			"ELIMINATED#1572, and tumtum9000#1232. Deflect the ball when it is red to target someone else! Use jump pads to get air!"));
		Small Message(All Players(All Teams), Custom String(
			"GENJI DODGEBALL v1.0.0N Community Edition! Originally developed by u/Mazawath. Numerous updates by members of the Official Genji"));
		Small Message(All Players(All Teams), Custom String(
			"Dodgeball Server. Deflect the ball when it is red to target someone else! Use jump pads to get air!"));
	}
}

rule("Settings - Workshop settings")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.ballSpawnSpeed = Workshop Setting Integer(Custom String("ball"), Custom String("spawn speed"), 40, 0, 200, 0);
		Global.ballSpeedCap = Workshop Setting Integer(Custom String("ball"), Custom String("max speed"), 800, 60, 800, 1);
		Global.ballAcceleration = Workshop Setting Integer(Custom String("ball"), Custom String("acceleration (25 => 0.25 per second)"),
			25, 0, 300, 2) / 100;
		Global.ballMotion = Workshop Setting Combo(Custom String("ball"), Custom String("motion"), 0, Array(Custom String("modern"),
			Custom String("rapid\n~Workshop Expanse"), Custom String("astro"), Custom String("retro")), 3);
		Global.waterLevel = Workshop Setting Combo(Custom String("ball"), Custom String("water"), 0, Array(Custom String("none"),
			Custom String("minimal"), Custom String("moderate"), Custom String("flood")), 4);
		Global.bouncePadToggle = Workshop Setting Toggle(Custom String("miscellaneous"), Custom String("bounce pads"), False, 1);
		Global.mobilityMode = Workshop Setting Combo(Custom String("miscellaneous"), Custom String("mobility"), 0, Array(Custom String(
			"agile"), Custom String("balanced"), Custom String("sluggish")), 3);
		Global.tournamentMode = Workshop Setting Toggle(Custom String("tournament"), Custom String("tournament mode"), False, 0);
		Global.totalRounds = Workshop Setting Integer(Custom String("tournament"), Custom String("total rounds"), 30, 1, 50, 1);
		Global.breaksEnabled = Workshop Setting Toggle(Custom String("tournament"), Custom String("breaks"), True, 2);
		Global.roundsUntilBreak = Workshop Setting Integer(Custom String("tournament"), Custom String("run break every __ rounds"), 10, 4,
			25, 3);
		Global.breakLength = Workshop Setting Integer(Custom String("tournament"), Custom String("break length"), 60, 1, 120, 4);
		If(Workshop Setting Integer(Custom String("_custom settings"), Custom String(
			"↓  ↓  ↓  ↓  ↓  ↓  ↓  ↓  ↓  ↓        only with   \"custom\"   preset"), 0, 0, 0, 0));
		End;
		Global.matchTime = Workshop Setting Integer(Custom String("."), Custom String("match length (at least 5 minutes)"), 15, 5, 60, 0)
			* 60;
		Global.bozo_Bot = Workshop Setting Toggle(Custom String(".add-ons"), Custom String("bot"), False, 1);
		Global.duelMode = Workshop Setting Toggle(Custom String(".add-ons"), Custom String("duels"), False, 2);
		Global.endlessMode = Workshop Setting Toggle(Custom String(".add-ons"), Custom String("endless mode"), False, 3);
		Global.xray = Workshop Setting Toggle(Custom String(".add-ons"), Custom String("x-ray"), False, 4);
		Global.tracingMode = Workshop Setting Toggle(Custom String(".add-ons"), Custom String("tracing mode"), False, 5);
		Global.presetMode = Workshop Setting Combo(Custom String(".presets"), Custom String("preset"), 0, Array(Custom String("custom"),
			Custom String("default"), Custom String("v1"), Custom String("rapid\n~workshop expanse"), Custom String("v7")), 0);
		If(Global.presetMode == 1);
			Global.waterLevel = 2;
			Global.ballAcceleration = 0.250;
			Global.ballSpawnSpeed = 40;
			Global.ballSpeedCap = 800;
			Global.ballMotion = 0;
			Global.bouncePadToggle = False;
			Global.mobilityMode = 0;
		Else If(Global.presetMode == 2);
			Global.waterLevel = 0;
			Global.ballAcceleration = 0.250;
			Global.ballSpawnSpeed = 40;
			Global.ballSpeedCap = 800;
			Global.ballMotion = 0;
			Global.bouncePadToggle = False;
			Global.mobilityMode = 0;
		Else If(Global.presetMode == 3);
			Global.waterLevel = 3;
			Global.ballAcceleration = 0.500;
			Global.ballSpawnSpeed = 60;
			Global.ballSpeedCap = 300;
			Global.ballMotion = 1;
			Global.bouncePadToggle = True;
			Global.mobilityMode = 1;
		Else If(Global.presetMode == 4);
			Global.waterLevel = 3;
			Global.ballAcceleration = 0.250;
			Global.ballSpawnSpeed = 40;
			Global.ballSpeedCap = 800;
			Global.ballMotion = 0;
			Global.bouncePadToggle = True;
			Global.mobilityMode = 2;
		End;
		If(Global.ballMotion == 0);
			Global.motionMultiplier = 1;
		Else If(Global.ballMotion == 1);
			Global.motionMultiplier = 0.500;
		End;
		If(Global.mobilityMode == 0);
			Global.moveSpeed = 190;
			Global.gravity = 80;
			Global.jumpVerticalSpeed = 180;
		Else If(Global.mobilityMode == 1);
			Global.moveSpeed = 150;
			Global.gravity = 90;
			Global.jumpVerticalSpeed = 150;
		Else If(Global.mobilityMode == 2);
			Global.moveSpeed = 100;
			Global.gravity = 100;
			Global.jumpVerticalSpeed = 100;
		End;
		If(Global.waterLevel == 0);
			Global.waterLevel = -1000;
		Else If(Global.waterLevel == 1);
			Global.waterLevel = -26;
		Else If(Global.waterLevel == 2);
			Global.waterLevel = -15;
		Else If(Global.waterLevel == 3);
			Global.waterLevel = -0.500;
		End;
		If(Global.bozo_Bot);
			Global.bozo_Bot = 1;
		End;
	}
}

