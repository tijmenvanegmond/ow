rule("Controls - Shorten deflect length")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Using Ability 2(Event Player) == True;
		Is Using Ultimate(Event Player) == False;
	}

	actions
	{
		Wait(0.300, Ignore Condition);
		If(Is Dummy Bot(Event Player) == True);
			If(Global.bozoWillEdash == True || Global.bozoWillGhostDash == True);
				Press Button(Event Player, Button(Ability 1));
				Global.bozoWillGhostDash = False;
				Global.bozoWillEdash = False;
			End;
		End;
		Set Ability 2 Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Event Player.isDashEnabled = False;
		Event Player.canDeflect = False;
		Wait(0.500, Ignore Condition);
		Set Ability 2 Enabled(Event Player, True);
		Set Ability 1 Enabled(Event Player, True);
		Event Player.isDashEnabled = True;
		Event Player.canDeflect = True;
	}
}

