rule("HUD - add-ons text")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Null, Custom String(
			"-add-ons-"), Right, -7, Color(White), Color(Sky Blue), Color(Sky Blue), Visible To and String, Default Visibility);
		disabled If(Global.waterLevel == -0.500);
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String("•water: flood"),
			Null, Right, -6, Color(White), Color(Blue), Color(Aqua), Visible To and String, Default Visibility);
		disabled Else If(Global.waterLevel == -15);
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
			"•water: moderate"), Null, Right, -6, Color(White), Color(Blue), Color(Aqua), Visible To and String, Default Visibility);
		disabled Else If(Global.waterLevel == -26);
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
			"•water: minimal"), Null, Right, -6, Color(White), Color(Blue), Color(Aqua), Visible To and String, Default Visibility);
		disabled Else;
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String("•No water"),
			Null, Right, -5, Color(White), Color(Blue), Color(Aqua), Visible To and String, Default Visibility);
		disabled End;
		disabled If(Global.endlessMode);
		disabled Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String("•endless"),
			Null, Right, -2, Color(White), Color(Blue), Color(Blue), Visible To and String, Default Visibility);
		disabled End;
		If(Global.tracingMode);
			Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
				"tracing: dont lose sight with the ball!"), Null, Top, -1, Color(White), Color(White), Color(Red), Visible To and String,
				Default Visibility);
		End;
		If(Global.tournamentMode);
			Create HUD Text(All Players(All Teams), Custom String("Tournament"), Null, Null, Right, 8, Color(Black), Color(Black), Color(
				Black), Visible To and String, Default Visibility);
			Create HUD Text(All Players(All Teams), Null, Null, Custom String("ROUNDS LEFT: {0}", Global.totalRounds), Right, 9, Color(Purple),
				Color(Purple), Color(Purple), Visible To and String, Default Visibility);
			Create HUD Text(All Players(All Teams), Null, Null, Custom String("ROUNDS UNTIL BREAK: {0}", Global.roundsUntilBreak), Right, 10,
				Color(Purple), Color(Purple), Color(Purple), Visible To and String, Default Visibility);
		End;
	}
}

