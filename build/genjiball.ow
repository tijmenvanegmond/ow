rule("HUD - community text")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Null, Custom String("version 1.2.4 beta"), Null, Right, -100, Color(Orange), Color(Orange),
			Color(Orange), Visible To and String, Default Visibility);
		"Naz: Link to the Official Genji Dodgeball Discord Server"
		Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
			"welcome to genji ball"), Null, Left, -6, Color(Lime Green), Color(Lime Green), Color(Sky Blue), Visible To and String,
			Default Visibility);
		Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
			"discord.gg/genjiball"), Custom String(""), Left, -5, Color(Orange), Color(Aqua), Color(Aqua), Visible To and String,
			Default Visibility);
		Create HUD Text(Filtered Array(All Players(All Teams), Current Array Element.simpleHUD == 0), Null, Custom String(
			"workshop.codes/genjiball"), Custom String(""), Left, -5, Color(Orange), Color(Aqua), Color(Aqua), Visible To and String,
			Default Visibility);
	}
}

