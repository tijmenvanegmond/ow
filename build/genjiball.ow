			Default Visibility);
		Create HUD Text(Global.ballSpeed >= 150 && Global.ballSpeed < 200 ? All Players(All Teams) : Empty Array, Null, Null,
			Custom String("BALL SPEED: {0}", Global.ballSpeed), Left, -4, Null, Null, Color(Violet), Visible To and String,
