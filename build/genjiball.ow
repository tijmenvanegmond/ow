			Custom String("BALL SPEED: ???"), Left, -4, Null, Null, Color(Rose), Visible To and String, Default Visibility);
		Create HUD Text(Global.ballSpeed >= 400 && Global.ballSpeed < 450 ? All Players(All Teams) : Empty Array, Null, Null,
			Custom String("BALL SPEED: you good??"), Left, -4, Null, Null, Color(Rose), Visible To and String, Default Visibility);
		Create HUD Text(Global.ballSpeed >= 450 && Global.ballSpeed < 700 ? All Players(All Teams) : Empty Array, Null, Null,
