rule("Appearance - ball/target effect")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
	}

	actions
	{
		Create Effect(Remove From Array(All Players(All Teams), Global.target), Orb, Color(White), Update Every Frame(Global.ballPosition),
			0.400, Visible To Position and Radius);
		Create Projectile Effect(All Players(All Teams), Sigma Hypersphere, Null, Update Every Frame(Global.ballPosition),
			Update Every Frame(Global.ballDirection), 0.010, Visible To Position Direction and Size);
		If(!Global.RedGreenColorblindMode);
			Create Effect(Global.target, Orb, Color(Red), Update Every Frame(Global.ballPosition), 0.400, Visible To Position and Radius);
			Create Effect(Remove From Array(All Players(All Teams), Global.target), Good Aura, Color(Red), Update Every Frame(Global.target),
				1, Visible To Position and Radius);
			Create Effect(!Global.target.thirdPerson ? Global.target : Null, Good Aura, Color(Red), Update Every Frame(Global.target), 0.800,
				Visible To Position and Radius);
			Create Effect(Global.target.thirdPerson ? Global.target : Null, Good Aura, Color(Gray), Global.target, 1,
				Visible To Position and Radius);
			Create Effect(Global.target, Good Aura, Color(Blue), Update Every Frame(Global.ballPosition), 1, Visible To Position and Radius);
		Else;
			Create Effect(Global.target, Orb, Color(Blue), Update Every Frame(Global.ballPosition), 0.400, Visible To Position and Radius);
			Create Effect(All Players(All Teams), Good Aura, Color(Blue), Global.target, 1, Visible To Position and Radius);
			Create Effect(Global.target, Good Aura, Color(Blue), Eye Position(Global.target), 1, Visible To Position and Radius);
		End;
		If(Global.xray);
			Create Icon(Global.ballIsOut && !Is In Line of Sight(Eye Position(Global.target), Update Every Frame(Global.ballPosition),
				All Barriers Block LOS) ? Global.target : Null, Global.ballPosition, Heart, Visible To and Position, Color(Red), True);
		End;
	}
}

rule("Appearance - ball countdown")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create In-World Text(Global.ballIsOut ? Null : Remove From Array(All Players(All Teams), Global.target), Custom String(
			"BALL SPAWNING IN: {0}", Update Every Frame(Round To Integer(Global.ballSpawnCountdown, Up))), Vector(X Component Of(
			Global.circleCenter), Y Component Of(Global.circleCenter) + 2.500, Z Component Of(Global.circleCenter)), 2.500,
			Clip Against Surfaces, Visible To Position and String, Color(Sky Blue), Default Visibility);
		Create In-World Text(Global.ballIsOut ? Null : Global.target, Custom String("BALL SPAWNING IN: {0}", Update Every Frame(
			Round To Integer(Global.ballSpawnCountdown, Up))), Vector(X Component Of(Global.circleCenter), Y Component Of(
			Global.circleCenter) + 2.500, Z Component Of(Global.circleCenter)), 2.500, Clip Against Surfaces,
			Visible To Position and String, Color(Red), Default Visibility);
	}
}

rule("Check for <2 players")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Is Game In Progress == True;
		Number Of Players(All Teams) == 1;
	}

	actions
	{
		Global.IsInFinalDuel = False;
		Create HUD Text(All Players(All Teams), Custom String(""), Null, Null, Top, 0, Color(White), Color(White), Color(White),
			Visible To and String, Default Visibility);
		Global.WaitingForPlayersHUD = Last Text ID;
		Global.IsEnoughPlayersToStart = False;
		Stop Chasing Global Variable(ballSpawnCountdown);
		Skip If(Global.RoundInProgress == False, 1);
		Global.RoundInProgress = False;
		Pause Match Time;
	}
}

rule("Wait for more players")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Number Of Players(All Teams) > 1;
		Global.IsEnoughPlayersToStart == False;
	}

	actions
	{
		Destroy HUD Text(Global.WaitingForPlayersHUD);
		Big Message(All Players(All Teams), Custom String(""));
		Wait(5.500, Ignore Condition);
		Abort If(Number Of Players(All Teams) < 2);
		Unpause Match Time;
		Global.IsEnoughPlayersToStart = True;
		Global.target = -1;
		Global.prevTarget = -1;
	}
}

rule("Player joins game")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.hasMoved == False;
		disabled Is Game In Progress == True;
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Skip If(!Global.RoundInProgress || !Is Game In Progress, 1);
		Kill(Event Player, Null);
		Teleport(Event Player, Global.circleCenter + Vector(Random Integer(-10, 10), 8, Random Integer(-10, 10)));
		Event Player.hasMoved = True;
	}
}

rule("Controls - Dash on primary")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		"Naz: This is remnent code from a dark and lawless time in the development of this game. Leave it be..."
		disabled Custom String("{0}", Event Player) != Custom String("bytestats");
		Is Dummy Bot(Event Player) != True;
	}

	actions
	{
		If(Event Player.antiRubberbanding == True);
			Allow Button(Event Player, Button(Ability 1));
			Press Button(Event Player, Button(Ability 1));
			Disallow Button(Event Player, Button(Ability 1));
		Else;
			Press Button(Event Player, Button(Ability 1));
		End;
	}
}

rule("Controls - Dash slow (gravity shift)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Using Ability 1(Event Player) == True;
	}

	actions
	{
		Event Player.moveSpeed = 0;
		Chase Player Variable At Rate(Event Player, moveSpeed, 100, Max(Event Player.moveSpeed, 16) ^ 1.250, Destination and Rate);
		While(Event Player.moveSpeed != 100);
			Set Move Speed(Event Player, Global.moveSpeed * (Event Player.moveSpeed / 100));
			Skip If(Event Player.currentGravity == 0, 1);
			Set Gravity(Event Player, Global.gravity * (Event Player.moveSpeed / 100));
			Wait(0.100, Ignore Condition);
		End;
		Set Move Speed(Event Player, Global.moveSpeed);
		Skip If(Event Player.currentGravity == 0, 1);
		Set Gravity(Event Player, Global.gravity);
	}
}

rule("Controls - Dash cooldown")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Alive(Event Player) == True;
		Is Using Ability 1(Event Player) == True;
	}

	actions
	{
		Event Player.canDash = False;
		Wait(3.040, Ignore Condition);
		Event Player.canDash = True;
	}
}

