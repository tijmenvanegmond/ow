// Assembled from: rules/workshop-probe.ow
// DO NOT EDIT — edit the source files and re-run assemble.js


settings
{
	lobby
	{
		Return To Lobby: Never
	}

	modes
	{
		Practice Range
		Clash Stadium
		Control Stadium
		Payload Race Stadium
		Push Stadium
	}
}

variables
{
	global:
		60: ProbeHeartbeat
}

// ── rules/workshop-probe.ow ─────────────────────────────────────
// ============================================================
// WORKSHOP PROBE — minimal, unmistakable proof that Workshop
// rules are executing in the current lobby. Purely additive:
// changes nothing about gameplay.
// ============================================================



rule("[Probe] HUD heartbeat")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Custom String("WORKSHOP ACTIVE"), Custom String("map: {0} | uptime: {1}s", Current Map,
			Global.ProbeHeartbeat), Null, Left, 50, Color(Green), Color(White), Color(White), Visible To and String, Default Visibility);
		Chase Global Variable At Rate(ProbeHeartbeat, 100000000, 1, Destination and Rate);
	}
}

rule("[Probe] Plant survivor artifacts")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"If any of these outlive a switch into Stadium mode, something leaked through"
		Set Objective Description(All Players(All Teams), Custom String("WORKSHOP ARTIFACT — planted before mode switch"),
			Visible To and String);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("SURVIVOR HUD — planted at t={0}s", Round To Integer(
			Total Time Elapsed, Down)), Right, 51, Color(Orange), Color(Orange), Color(Orange), Visible To and String,
			Default Visibility);
	}
}

rule("[Probe] Ring every player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Create Effect(All Players(All Teams), Good Aura, Color(Green), Event Player, 1.500, Visible To Position and Radius);
	}
}

rule("[Probe] Join chime")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	actions
	{
		Small Message(All Players(All Teams), Custom String("Workshop saw {0} join", Event Player));
		Play Effect(All Players(All Teams), Buff Explosion Sound, Color(White), Position Of(Event Player), 100);
	}
}